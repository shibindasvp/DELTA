PORT=3035
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/delta_ecommerce?retryWrites=true&w=majority

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

NODE_ENV=development

# Email credentials
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM="DELTA Luxury Watches" <your_email@gmail.com>

# Google OAuth 2.0 (SSO)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3035/auth/google/callback

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@deltawatches.com
ADMIN_PASSWORD=your_admin_password

# Online Payment Gateway Integration (Razorpay Secure Gateway)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary Media Storage Integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
