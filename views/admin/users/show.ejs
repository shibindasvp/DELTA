<%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { _id: '', name: 'Collector', email: '', phone: '', isBlocked: false, isVerified: false, createdAt: new Date() };
%>
<%- include('../partials/header', { title: ((typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') || 'Collector') + ' — Collector Dossier | DELTA' }) %>

<div class="flex flex-1 min-h-screen bg-[#F8F9FA]">
    <%- include('../partials/sidebar', { activePage: 'users' }) %>

    <div class="flex-1 flex flex-col min-w-0">
        <%- include('../partials/navbar', { pageTitle: 'Collector Dossier' }) %>

        <main class="flex-grow p-6 sm:p-8 max-w-[1400px] w-full mx-auto space-y-6">
            
            <!-- Breadcrumbs -->
            <div class="flex items-center gap-2 text-[10px] text-zinc-400 font-medium tracking-wide">
                <a href="/admin/dashboard" class="hover:text-zinc-600">Admin</a>
                <span>›</span>
                <a href="/admin/users" class="hover:text-zinc-600">Collector Management</a>
                <span>›</span>
                <span class="text-zinc-900 font-semibold"><%= (typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') || 'Collector' %></span>
            </div>

            <%- include('../partials/flash-message') %>

            <!-- Main Layout Split -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Left 8 Columns: Collector Details, Metrics & Order History -->
                <div class="lg:col-span-8 space-y-6">
                    
                    <!-- Collector Hero Banner -->
                    <div class="bg-white border border-zinc-200/80 rounded-2xl p-6 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-6">
                        <div class="flex items-center gap-5">
                            <!-- Collector Avatar (Matching User Side) -->
                            <div class="relative w-20 h-20 rounded-full overflow-hidden border border-zinc-300 bg-[#1c1c1c] text-white flex items-center justify-center flex-shrink-0 text-3xl font-serif font-semibold shadow-sm">
                                <% if (safeUser.profileImage) { %>
                                    <img src="<%= safeUser.profileImage %>" alt="<%= (typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') %>" class="w-full h-full object-cover">
                                <% } else { %>
                                    <%= ((typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') || 'U').charAt(0).toUpperCase() %>
                                <% } %>
                            </div>

                            <div>
                                <span class="text-[10px] uppercase tracking-[0.25em] text-[#885c1d] font-semibold block mb-1">
                                    Collector Dossier
                                </span>
                                <h1 class="text-2xl sm:text-3xl font-serif font-normal text-zinc-900 tracking-tight">
                                    <%= (typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') || 'Unnamed Collector' %>
                                </h1>
                                <p class="text-xs font-mono text-zinc-500 mt-1">
                                    Member ID: <span class="text-zinc-800 font-semibold">#DX-<%= (typeof user !== 'undefined' && user && safeUser._id ? safeUser._id : '').toString().slice(-6).toUpperCase() %></span>
                                </p>
                                <div class="flex items-center gap-2 mt-2">
                                    <% if (safeUser.isBlocked) { %>
                                        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-wider font-bold text-rose-700">
                                            <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
                                            ACCOUNT BLOCKED
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase tracking-wider font-bold text-emerald-700">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                            ACCOUNT ACTIVE
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Action Button -->
                        <div>
                            <% if (safeUser.role !== 'admin') { %>
                                <% if (safeUser.isBlocked) { %>
                                    <form action="/admin/users/<%= (typeof user !== 'undefined' && user && safeUser._id ? safeUser._id : '') %>/unblock?redirect=detail" method="POST">
                                        <button type="submit" class="bg-[#0A4D2E] hover:bg-[#073620] text-white px-5 py-2.5 rounded text-xs uppercase tracking-wider font-semibold transition-colors shadow-sm cursor-pointer">
                                            Unblock Account
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/admin/users/<%= (typeof user !== 'undefined' && user && safeUser._id ? safeUser._id : '') %>/block?redirect=detail" method="POST">
                                        <button type="submit" class="bg-rose-600 hover:bg-rose-700 text-white px-5 py-2.5 rounded text-xs uppercase tracking-wider font-semibold transition-colors shadow-sm cursor-pointer">
                                            Block Account
                                        </button>
                                    </form>
                                <% } %>
                            <% } else { %>
                                <span class="text-xs uppercase tracking-wider text-zinc-400 font-mono">Protected Admin</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- 4 Metric Cards Row (Real Data) -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        <div class="bg-white border border-zinc-200/80 rounded-xl p-4 shadow-sm">
                            <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">ACCOUNT ROLE</span>
                            <span class="text-lg font-serif font-bold text-zinc-900 block font-mono uppercase"><%= safeUser.role || 'USER' %></span>
                        </div>

                        <div class="bg-white border border-zinc-200/80 rounded-xl p-4 shadow-sm">
                            <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">CREDENTIAL STATUS</span>
                            <span class="text-sm font-serif font-bold <%= safeUser.isVerified ? 'text-emerald-800' : 'text-amber-700' %> block mt-1">
                                <%= safeUser.isVerified ? 'VERIFIED' : 'PENDING' %>
                            </span>
                        </div>

                        <div class="bg-white border border-zinc-200/80 rounded-xl p-4 shadow-sm">
                            <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">MEMBER SINCE</span>
                            <span class="text-xs font-serif font-semibold text-zinc-900 block mt-1"><%= new Date(safeUser.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                        </div>

                        <div class="bg-white border border-zinc-200/80 rounded-xl p-4 shadow-sm">
                            <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block mb-1">AUTH METHOD</span>
                            <span class="text-xs font-serif font-semibold text-zinc-900 block mt-1 uppercase font-mono"><%= safeUser.authProvider || 'LOCAL' %></span>
                        </div>
                    </div>

                    <!-- Saved Delivery Addresses Section (Real Database Data) -->
                    <div class="bg-white border border-zinc-200/80 rounded-2xl p-6 shadow-sm space-y-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-lg font-serif font-normal text-zinc-900 tracking-tight">Saved Delivery Addresses</h2>
                            <span class="text-xs font-mono text-zinc-400"><%= (safeUser.addresses && safeUser.addresses.length) ? safeUser.addresses.length : 0 %> Registered</span>
                        </div>

                        <% if (safeUser.addresses && safeUser.addresses.length > 0) { %>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% safeUser.addresses.forEach(addr => { %>
                                    <div class="p-4 rounded-xl border <%= addr.isDefault ? 'border-[#0A4D2E] bg-emerald-50/20' : 'border-zinc-200 bg-white' %> space-y-2 text-xs">
                                        <div class="flex items-center justify-between">
                                            <span class="font-semibold text-zinc-900"><%= addr.fullName %></span>
                                            <% if (addr.isDefault) { %>
                                                <span class="px-2 py-0.5 rounded text-[9px] font-bold bg-emerald-100 text-emerald-800 uppercase tracking-wider">Default</span>
                                            <% } %>
                                        </div>
                                        <p class="text-zinc-600 leading-relaxed font-light">
                                            <%= addr.addressLine %><br>
                                            <%= addr.city %>, <%= addr.state %> — <%= addr.pincode %><br>
                                            <%= addr.country || 'India' %>
                                        </p>
                                        <p class="text-zinc-500 font-mono text-[11px] pt-1 border-t border-zinc-100">
                                            📞 <%= addr.phone %>
                                        </p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="py-8 px-4 text-center border border-dashed border-zinc-200 rounded-xl">
                                <p class="text-xs text-zinc-500 font-light">No delivery addresses registered by this client yet.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Order History Table (Real Database Data) -->
                    <div class="bg-white border border-zinc-200/80 rounded-2xl p-6 shadow-sm space-y-4">
                        <div class="flex items-center justify-between">
                            <h2 class="text-lg font-serif font-normal text-zinc-900 tracking-tight">Order History</h2>
                            <span class="text-xs font-mono text-zinc-400"><%= (safeUser.orders && safeUser.orders.length) ? safeUser.orders.length : 0 %> Orders</span>
                        </div>

                        <% if (safeUser.orders && safeUser.orders.length > 0) { %>
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs border-collapse">
                                    <thead>
                                        <tr class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold border-b border-zinc-100 pb-2">
                                            <th class="py-2.5">ORDER ID</th>
                                            <th class="py-2.5">ITEMS</th>
                                            <th class="py-2.5">DATE</th>
                                            <th class="py-2.5">TOTAL</th>
                                            <th class="py-2.5 text-right">STATUS</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-zinc-100 text-zinc-700 font-sans">
                                        <% safeUser.orders.forEach(order => { %>
                                            <tr class="hover:bg-zinc-50/60 transition-colors">
                                                <td class="py-3.5 font-mono font-semibold text-zinc-900">#<%= order._id.toString().slice(-6).toUpperCase() %></td>
                                                <td class="py-3.5 font-serif text-sm font-normal text-zinc-900"><%= order.itemsCount || 1 %> Timepiece(s)</td>
                                                <td class="py-3.5 font-mono text-[11px] text-zinc-500"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                                <td class="py-3.5 font-mono font-semibold text-zinc-900">₹<%= Number(order.totalAmount || 0).toLocaleString('en-IN') %></td>
                                                <td class="py-3.5 text-right">
                                                    <span class="px-2.5 py-0.5 rounded text-[8px] uppercase tracking-wider font-bold bg-emerald-100 text-emerald-800">
                                                        <%= order.status || 'FINALIZED' %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="py-12 px-4 text-center border border-dashed border-zinc-200 rounded-xl">
                                <div class="w-10 h-10 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto mb-3 text-lg">
                                    🛒
                                </div>
                                <p class="text-xs font-semibold text-zinc-800">No Orders Placed Yet</p>
                                <p class="text-[11px] text-zinc-400 max-w-md mx-auto mt-1 font-light">
                                    When <%= (typeof user !== 'undefined' && user && safeUser.name ? safeUser.name : 'Collector') || 'this client' %> places an order, purchased timepieces, reference numbers, valuation, and fulfillment statuses will appear in this ledger.
                                </p>
                            </div>
                        <% } %>
                    </div>

                </div>

                <!-- Right 4 Columns: Collector Intelligence (100% Real Database Data) -->
                <div class="lg:col-span-4 bg-white border border-zinc-200/80 rounded-2xl p-6 shadow-sm space-y-6">
                    
                    <h3 class="text-xs uppercase tracking-[0.2em] font-semibold text-zinc-900 border-b border-zinc-100 pb-3">
                        COLLECTOR INTELLIGENCE
                    </h3>

                    <!-- Contact Details -->
                    <div class="space-y-4 text-xs">
                        <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block">CONTACT DETAILS</span>
                        
                        <div class="flex items-start gap-3">
                            <svg class="w-4 h-4 text-emerald-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <div>
                                <p class="font-medium text-zinc-900"><%= (typeof user !== 'undefined' && user && safeUser.email ? safeUser.email : '') %></p>
                                <p class="text-[10px] text-zinc-400">Primary Email</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <svg class="w-4 h-4 text-emerald-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <div>
                                <p class="font-mono text-zinc-900"><%= safeUser.phone || 'Not specified' %></p>
                                <p class="text-[10px] text-zinc-400">Mobile Contact</p>
                            </div>
                        </div>

                        <div class="flex items-start gap-3">
                            <svg class="w-4 h-4 text-emerald-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <div>
                                <p class="text-zinc-900 font-light">
                                    <% if (safeUser.addresses && safeUser.addresses.length > 0) { %>
                                        <%= safeUser.addresses[0].addressLine %>, <%= safeUser.addresses[0].city %>, <%= safeUser.addresses[0].state %> — <%= safeUser.addresses[0].pincode %>
                                    <% } else { %>
                                        No shipping address saved
                                    <% } %>
                                </p>
                                <p class="text-[10px] text-zinc-400">Primary Vault Address</p>
                            </div>
                        </div>
                    </div>

                    <!-- Security & Authentication Dossier -->
                    <div class="space-y-3 pt-4 border-t border-zinc-100 text-xs">
                        <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block">SECURITY & REFERRAL DOSSIER</span>
                        <div class="p-3 bg-zinc-50 rounded-xl border border-zinc-200/60 space-y-2">
                            <div class="flex justify-between">
                                <span class="text-zinc-500">Identity Status:</span>
                                <span class="font-medium text-zinc-900"><%= safeUser.isVerified ? '✓ OTP Verified' : 'Pending Verification' %></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-zinc-500">Access Tier:</span>
                                <span class="font-medium text-[#0A4D2E] uppercase font-mono"><%= safeUser.role %> Client</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-zinc-500">Referral ID:</span>
                                <span class="font-mono font-semibold text-zinc-900"><%= safeUser.referralCode || 'None Assigned' %></span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-zinc-500">Account Status:</span>
                                <span class="font-medium <%= safeUser.isBlocked ? 'text-rose-600' : 'text-emerald-700' %>"><%= safeUser.isBlocked ? 'Blocked' : 'Active' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Account Timeline -->
                    <div class="space-y-4 pt-4 border-t border-zinc-100">
                        <span class="text-[9px] uppercase tracking-wider text-zinc-400 font-semibold block">ACCOUNT TIMELINE</span>
                        
                        <div class="space-y-3 text-xs">
                            <div class="flex items-start gap-3">
                                <div class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">✓</div>
                                <div>
                                    <p class="font-semibold text-zinc-900">Account Created</p>
                                    <p class="text-[10px] text-zinc-500"><%= safeUser.authProvider ? safeUser.authProvider.toUpperCase() : 'Local' %> registration completed.</p>
                                    <p class="text-[9px] uppercase font-mono text-zinc-400 mt-0.5"><%= new Date(safeUser.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </main>

        <footer class="mt-auto px-8 py-6 text-zinc-400 text-[10px] uppercase font-mono tracking-wider flex flex-col sm:flex-row items-center justify-between border-t border-zinc-200/80 gap-3">
            <span>© 2024 DELTA HOROLOGY. ALL RIGHTS RESERVED.</span>
            <div class="flex items-center gap-4">
                <a href="#" class="hover:text-zinc-600">PRIVACY</a>
                <a href="#" class="hover:text-zinc-600">TERMS</a>
                <span class="text-emerald-700 font-semibold">SYSTEM STATUS: OPTIMAL</span>
            </div>
        </footer>
    </div>
</div>

<%- include('../partials/footer') %>