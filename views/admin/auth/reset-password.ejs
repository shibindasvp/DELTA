<%- include('../partials/header', { title: 'Reset Administrator Credentials — DELTA Gateway' }) %>

<div class="min-h-screen grid grid-cols-1 lg:grid-cols-12 bg-white antialiased font-sans">
    
    <!-- Left Hero Column: Deep Emerald Green with Greek Delta Watermark -->
    <div class="lg:col-span-6 bg-[#004D2C] relative flex flex-col justify-between p-8 sm:p-12 lg:p-16 overflow-hidden min-h-[40vh] lg:min-h-screen text-white">
        <!-- Giant Greek Delta Watermark -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
            <span class="text-[32rem] sm:text-[40rem] font-serif text-white/5 leading-none transform translate-y-8 -translate-x-6">
                δ
            </span>
        </div>

        <!-- Top Left Brand Text -->
        <div class="relative z-10">
            <a href="/" class="text-xl font-serif text-white tracking-[0.2em] font-normal hover:opacity-80 transition-opacity">
                Delta
            </a>
        </div>

        <!-- Middle / Bottom Headline -->
        <div class="relative z-10 max-w-lg mt-auto mb-8 lg:mb-12">
            <span class="text-[10px] uppercase tracking-[0.25em] text-emerald-200/70 font-semibold block mb-2">
                SECURITY PROTOCOL
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-normal text-white tracking-tight leading-tight mb-4">
                Credential Reset
            </h1>
            <p class="text-xs sm:text-sm text-emerald-100/80 font-light leading-relaxed tracking-wide">
                Update root credentials for the Delta Horology Secure Ledger Protocol. Enter the 6-digit OTP dispatched to your registered address.
            </p>
        </div>

        <!-- Bottom Footer Tag -->
        <div class="relative z-10 text-[9px] uppercase tracking-[0.3em] text-emerald-200/50 font-medium font-mono">
            AUTHORIZATION OVERRIDE
        </div>
    </div>

    <!-- Right Form Column: Minimalist Luxury White Reset -->
    <div class="lg:col-span-6 flex flex-col justify-between p-8 sm:p-12 lg:p-16 bg-white relative">
        <div class="max-w-md w-full mx-auto my-auto py-8">
            
            <!-- Center Circular Emblem -->
            <div class="flex justify-center mb-6">
                <div class="w-16 h-16 rounded-full border border-zinc-200 bg-white flex items-center justify-center shadow-sm">
                    <span class="text-2xl font-serif text-[#004D2C] font-normal">δ</span>
                </div>
            </div>

            <!-- Title & Subtitle -->
            <div class="text-center mb-8">
                <h2 class="text-2xl sm:text-3xl font-serif font-normal text-zinc-900 tracking-tight">
                    Reset Credentials
                </h2>
                <p class="text-xs text-zinc-500 font-normal mt-1">
                    Setting new credentials for:
                </p>
                <p class="text-xs font-mono font-semibold text-zinc-900 bg-zinc-100 px-3 py-1 rounded inline-block mt-1 border border-zinc-200">
                    <%= typeof email !== 'undefined' ? email : '' %>
                </p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-6 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded text-xs flex items-center gap-2">
                    <svg class="w-4 h-4 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (typeof success !== 'undefined' && success) { %>
                <div class="mb-6 bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 rounded text-xs flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span><%= success %></span>
                </div>
            <% } %>

            <!-- Admin Reset Password Form -->
            <form action="/admin/reset-password" method="POST" class="space-y-5" id="adminResetPasswordForm" novalidate>
                <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">

                <!-- 6-Digit OTP -->
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-500 mb-2">
                        6-DIGIT VERIFICATION CODE (OTP)
                    </label>
                    <div class="relative flex items-center border border-zinc-200 focus-within:border-zinc-900 rounded p-3 transition-colors">
                        <input
                            type="text"
                            name="otp"
                            id="otp"
                            required
                            maxlength="6"
                            value="<%= (typeof oldData !== 'undefined' && oldData && oldData.otp) ? oldData.otp : (typeof otp !== 'undefined' ? otp : '') %>"
                            placeholder="Enter 6-digit code"
                            class="w-full bg-transparent text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none font-mono tracking-widest font-semibold"
                            autofocus
                        >
                    </div>
                </div>

                <!-- New Password -->
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-500 mb-2">
                        NEW PASSWORD
                    </label>
                    <div class="relative flex items-center border border-zinc-200 focus-within:border-zinc-900 rounded p-3 transition-colors">
                        <input
                            type="password"
                            name="password"
                            id="password"
                            required
                            value="<%= (typeof oldData !== 'undefined' && oldData && oldData.password) ? oldData.password : (typeof password !== 'undefined' ? password : '') %>"
                            placeholder="Enter new secure password"
                            class="w-full bg-transparent text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none font-mono"
                        >
                    </div>
                </div>

                <!-- Confirm Password -->
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-500 mb-2">
                        CONFIRM NEW PASSWORD
                    </label>
                    <div class="relative flex items-center border border-zinc-200 focus-within:border-zinc-900 rounded p-3 transition-colors">
                        <input
                            type="password"
                            name="confirmPassword"
                            id="confirmPassword"
                            required
                            value="<%= (typeof oldData !== 'undefined' && oldData && oldData.confirmPassword) ? oldData.confirmPassword : (typeof confirmPassword !== 'undefined' ? confirmPassword : '') %>"
                            placeholder="Confirm new password"
                            class="w-full bg-transparent text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none font-mono"
                        >
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button
                        type="submit"
                        class="w-full bg-[#18181b] hover:bg-black text-white py-3.5 px-4 text-xs uppercase tracking-[0.25em] font-semibold transition-all duration-200 cursor-pointer shadow-sm hover:shadow"
                    >
                        UPDATE CREDENTIALS
                    </button>
                </div>
            </form>

            <!-- Admin Resend OTP Section with Persistent Timer -->
            <div class="mt-6 text-center text-xs text-zinc-500">
                <span>Didn't receive the verification code?</span>
                <form action="/admin/resend-otp" method="POST" class="inline" id="adminResendForm">
                    <input type="hidden" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>">
                    <button
                        type="submit"
                        id="adminResendBtn"
                        disabled
                        class="text-zinc-900 font-semibold underline underline-offset-4 disabled:text-zinc-400 disabled:no-underline disabled:cursor-not-allowed ml-1 transition-colors cursor-pointer"
                    >
                        Resend Code <span id="adminTimerSpan" class="font-mono text-zinc-400"></span>
                    </button>
                </form>
            </div>

            <!-- Return to Login -->
            <div class="text-center pt-6">
                <a href="/admin/login" class="text-xs text-zinc-600 hover:text-black transition-colors font-medium inline-flex items-center gap-1.5">
                    <span>←</span>
                    <span>Return to Login</span>
                </a>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-[9px] uppercase tracking-[0.25em] text-zinc-400 font-mono">
             <%= new Date().getFullYear() %> DELTA HOROLOGY. ENCRYPTION STANDARD 4096-BIT AES.
        </div>
    </div>

</div>

<script>
    // Persistent Reload-Proof Admin Countdown Timer
    (function initAdminPersistentOtpTimer() {
        const email = "<%= typeof email !== 'undefined' ? email : '' %>";
        const storageKey = 'delta_admin_otp_target_' + encodeURIComponent(email);
        const COOLDOWN_SECONDS = 60;

        const resendBtn = document.getElementById('adminResendBtn');
        const timerSpan = document.getElementById('adminTimerSpan');
        const resendForm = document.getElementById('adminResendForm');

        let targetTimestamp = parseInt(sessionStorage.getItem(storageKey), 10);
        const now = Date.now();

        if (!targetTimestamp || isNaN(targetTimestamp) || targetTimestamp <= now) {
            targetTimestamp = now + (COOLDOWN_SECONDS * 1000);
            sessionStorage.setItem(storageKey, targetTimestamp);
        }

        function tick() {
            const currentNow = Date.now();
            const remainingSecs = Math.max(0, Math.ceil((targetTimestamp - currentNow) / 1000));

            if (remainingSecs > 0) {
                if (timerSpan) timerSpan.textContent = `(${remainingSecs}s)`;
                if (resendBtn) resendBtn.disabled = true;
            } else {
                if (timerSpan) timerSpan.textContent = '';
                if (resendBtn) resendBtn.disabled = false;
                sessionStorage.removeItem(storageKey);
                clearInterval(countdownTimer);
            }
        }

        tick();
        const countdownTimer = setInterval(tick, 1000);

        if (resendForm) {
            resendForm.addEventListener('submit', () => {
                const freshTarget = Date.now() + (COOLDOWN_SECONDS * 1000);
                sessionStorage.setItem(storageKey, freshTarget);
            });
        }
    })();
</script>

<%- include('../partials/footer') %>
