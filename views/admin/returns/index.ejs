<%- include('../partials/header', { title: 'Returns & Reverse Logistics — DELTA Administration' }) %>

<div class="flex flex-1 min-h-screen bg-[#F8F9FA]">
    <%- include('../partials/sidebar', { activePage: 'returns' }) %>

    <div class="flex-1 flex flex-col min-w-0">
        <%- include('../partials/navbar', { pageTitle: 'Returns & Reverse Logistics' }) %>

        <main class="flex-grow p-6 sm:p-8 max-w-[1400px] w-full mx-auto space-y-6">
            
            <!-- Page Heading -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#0A4D2E] font-bold">Reverse Logistics Control</span>
                        <span class="w-1.5 h-1.5 rounded-full bg-[#0A4D2E]"></span>
                        <span class="text-[10px] uppercase font-mono text-zinc-400">Vault Restocking Engine</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-serif font-normal text-zinc-900 tracking-tight">
                        Returns & Reverse Logistics
                    </h1>
                    <p class="text-xs text-zinc-500 font-light mt-1">
                        Examine collector return statements, authorize vault inventory restocks, or decline return claims.
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="/admin/returns" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-medium text-zinc-600 bg-white border border-zinc-200 rounded-xl hover:bg-zinc-50 transition-colors shadow-xs">
                        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        Refresh
                    </a>
                </div>
            </div>

            <!-- KPI Stat Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white border border-zinc-200/80 rounded-2xl p-5 shadow-xs">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase tracking-[0.15em] text-amber-700 font-bold block mb-1">Action Required</span>
                        <span class="w-2 h-2 rounded-full bg-amber-500 <%= (typeof stats !== 'undefined' && stats && stats.pendingReturns > 0) ? 'animate-pulse' : '' %>"></span>
                    </div>
                    <span class="text-3xl font-serif font-bold text-amber-800 block font-mono"><%= (typeof stats !== 'undefined' && stats) ? stats.pendingReturns : 0 %></span>
                    <span class="text-[10px] text-zinc-400 font-light block mt-1">Pending return examinations</span>
                </div>

                <div class="bg-white border border-zinc-200/80 rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] uppercase tracking-[0.15em] text-emerald-800 font-bold block mb-1">Approved & Restocked</span>
                    <span class="text-3xl font-serif font-bold text-emerald-900 block font-mono"><%= (typeof stats !== 'undefined' && stats) ? stats.completedReturns : 0 %></span>
                    <span class="text-[10px] text-zinc-400 font-light block mt-1">Vault inventory restored</span>
                </div>

                <div class="bg-white border border-zinc-200/80 rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] uppercase tracking-[0.15em] text-zinc-500 font-semibold block mb-1">Total Return Claims</span>
                    <span class="text-3xl font-serif font-bold text-zinc-900 block font-mono"><%= (typeof stats !== 'undefined' && stats) ? stats.totalReturns : 0 %></span>
                    <span class="text-[10px] text-zinc-400 font-light block mt-1">All time return requests</span>
                </div>

                <div class="bg-[#0A4D2E] text-white rounded-2xl p-5 shadow-xs">
                    <span class="text-[10px] uppercase tracking-[0.15em] text-emerald-200/90 font-bold block mb-1">Restocked Valuation</span>
                    <span class="text-2xl sm:text-3xl font-serif font-bold text-white block font-mono">₹<%= Number((typeof stats !== 'undefined' && stats && stats.returnedValuation) || 0).toLocaleString('en-IN') %></span>
                    <span class="text-[10px] text-emerald-200/70 font-light block mt-1">Reverse logistics total</span>
                </div>
            </div>

            <!-- Search, Filter & Sort Controls -->
            <div class="bg-white border border-zinc-200/80 rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
                <form action="/admin/returns" method="GET" class="space-y-3" id="adminReturnFilterForm">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3">
                        
                        <!-- Search Box (Span 5) -->
                        <div class="lg:col-span-5 relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </div>
                            <input 
                                type="text" 
                                name="search" 
                                value="<%= typeof search !== 'undefined' ? search : '' %>" 
                                placeholder="Search Order ID, Collector Name, Email, Model..." 
                                class="w-full pl-10 pr-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors"
                            >
                        </div>

                        <!-- Status Filter (Span 4) -->
                        <div class="lg:col-span-4">
                            <select 
                                name="status" 
                                onchange="document.getElementById('adminReturnFilterForm').submit()"
                                class="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs text-zinc-800 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors cursor-pointer"
                            >
                                <option value="" <%= (!status || status === 'all') ? 'selected' : '' %>>All Return Stages</option>
                                <option value="Return Requested" <%= status === 'Return Requested' ? 'selected' : '' %>>Return Requested (Action Required)</option>
                                <option value="Returned" <%= status === 'Returned' ? 'selected' : '' %>>Returned (Approved & Restocked)</option>
                            </select>
                        </div>

                        <!-- Sort Order (Span 3) -->
                        <div class="lg:col-span-3">
                            <select 
                                name="sort" 
                                onchange="document.getElementById('adminReturnFilterForm').submit()"
                                class="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs text-zinc-800 focus:outline-none focus:border-zinc-900 focus:bg-white transition-colors cursor-pointer"
                            >
                                <option value="newest" <%= (typeof sort !== 'undefined' && sort === 'newest') ? 'selected' : '' %>>Newest Return First</option>
                                <option value="oldest" <%= (typeof sort !== 'undefined' && sort === 'oldest') ? 'selected' : '' %>>Oldest First</option>
                                <option value="valuation_desc" <%= (typeof sort !== 'undefined' && sort === 'valuation_desc') ? 'selected' : '' %>>Highest Valuation</option>
                                <option value="valuation_asc" <%= (typeof sort !== 'undefined' && sort === 'valuation_asc') ? 'selected' : '' %>>Lowest Valuation</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Returns Data Table -->
            <div class="bg-white border border-zinc-200/80 rounded-2xl shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-zinc-100 bg-[#FAFAFA] flex items-center justify-between">
                    <div>
                        <h2 class="text-xs uppercase tracking-[0.2em] text-zinc-600 font-semibold">Return Dossiers</h2>
                        <p class="text-[11px] text-zinc-400 font-light mt-0.5">Authorize stock replenishment or inspect client return justification</p>
                    </div>
                    <span class="text-xs font-mono font-semibold px-2.5 py-1 bg-white border border-zinc-200 rounded-lg text-zinc-600">
                        <%= (typeof pagination !== 'undefined' && pagination) ? pagination.totalItems : returns.length %> records found
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs font-sans">
                        <thead>
                            <tr class="border-b border-zinc-100 text-[10px] uppercase tracking-[0.15em] text-zinc-400 font-medium bg-zinc-50/50">
                                <th class="py-3.5 px-6">Order ID & Date</th>
                                <th class="py-3.5 px-6">Collector Details</th>
                                <th class="py-3.5 px-6">Timepiece(s) Returned</th>
                                <th class="py-3.5 px-6">Reason for Return</th>
                                <th class="py-3.5 px-6">Status & Valuation</th>
                                <th class="py-3.5 px-6 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100">
                            <% if (typeof returns !== 'undefined' && returns && returns.length > 0) { %>
                                <% returns.forEach(ord => { %>
                                    <tr class="hover:bg-zinc-50/70 transition-colors">
                                        
                                        <!-- Order ID & Timestamps -->
                                        <td class="py-4 px-6 align-top">
                                            <div class="space-y-1">
                                                <a href="/admin/orders/<%= ord._id %>" class="font-mono font-bold text-xs text-zinc-900 hover:text-[#0A4D2E] underline block">
                                                    <%= ord.orderNumber %>
                                                </a>
                                                <% if (ord.returnRequestedAt) { %>
                                                    <span class="text-[10px] text-zinc-500 font-mono block">
                                                        Requested: <%= new Date(ord.returnRequestedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                                    </span>
                                                <% } %>
                                                <% if (ord.deliveredAt) { %>
                                                    <span class="text-[9px] text-zinc-400 font-mono block">
                                                        Delivered: <%= new Date(ord.deliveredAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) %>
                                                    </span>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Collector Info -->
                                        <td class="py-4 px-6 align-top">
                                            <div class="space-y-0.5">
                                                <span class="font-serif font-bold text-zinc-900 block text-xs"><%= ord.collectorName %></span>
                                                <a href="mailto:<%= ord.collectorEmail %>" class="text-[11px] text-zinc-500 hover:text-[#0A4D2E] block truncate max-w-[150px]">
                                                    <%= ord.collectorEmail %>
                                                </a>
                                                <span class="text-[10px] text-zinc-400 font-mono block">
                                                    <%= ord.shippingAddress?.mobile || (ord.user && ord.user.phone) || 'Phone not set' %>
                                                </span>
                                                <span class="text-[10px] text-zinc-400 block">
                                                    <%= ord.shippingAddress?.city %>, <%= ord.shippingAddress?.state %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Returned Timepieces Summary (Compact, Text-Only) -->
                                        <td class="py-4 px-6 align-top">
                                            <% 
                                                const returnSpecificItems = (ord.items || []).filter(it => it.status === 'Return Requested' || it.status === 'Returned');
                                                const displayItems = returnSpecificItems.length > 0 ? returnSpecificItems : (ord.items || []);
                                            %>
                                            <% if (displayItems && displayItems.length > 0) { %>
                                                <% 
                                                    const primaryItem = displayItems[0];
                                                    const totalUnits = displayItems.reduce((sum, it) => sum + (it.quantity || 1), 0);
                                                    const remainingCount = displayItems.length - 1;
                                                    const tooltipText = displayItems.map(it => (it.quantity || 1) + 'x ' + (it.brandName ? it.brandName + ' ' : '') + it.productName + (it.status ? ' [' + it.status + ']' : '')).join(', ');
                                                %>
                                                <div class="max-w-[220px]" title="<%= tooltipText %>">
                                                    <a href="/admin/orders/<%= ord._id %>" class="font-medium text-zinc-900 hover:text-[#0A4D2E] hover:underline block truncate text-xs">
                                                        <span class="font-bold"><%= primaryItem.quantity %>x</span> <%= primaryItem.brandName ? primaryItem.brandName + ' ' : '' %><%= primaryItem.productName %>
                                                    </a>
                                                    <% if (remainingCount > 0) { %>
                                                        <div class="flex items-center gap-1.5 mt-1">
                                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-zinc-100 text-zinc-700 border border-zinc-200/80">
                                                                +<%= remainingCount %> more timepiece<%= remainingCount > 1 ? 's' : '' %>
                                                            </span>
                                                            <span class="text-[10px] text-zinc-400 font-mono">(<%= totalUnits %> units total)</span>
                                                        </div>
                                                    <% } else { %>
                                                        <span class="text-[10px] text-zinc-400 font-mono block mt-0.5">
                                                            <%= totalUnits === 1 ? '1 unit total' : totalUnits + ' units total' %>
                                                        </span>
                                                    <% } %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-zinc-400 text-xs italic">No timepieces listed</span>
                                            <% } %>
                                        </td>

                                        <!-- Reason for Return -->
                                        <td class="py-4 px-6 align-top max-w-[260px]">
                                            <% 
                                                const retItemsWithReason = (ord.items || []).filter(it => (it.status === 'Return Requested' || it.status === 'Returned') && it.returnReason);
                                                let displayReason = "";
                                                let displayTooltip = "";
                                                if (retItemsWithReason.length === 1) {
                                                    displayReason = (retItemsWithReason[0].productName ? retItemsWithReason[0].productName + ': ' : '') + '"' + retItemsWithReason[0].returnReason + '"';
                                                    displayTooltip = displayReason;
                                                } else if (retItemsWithReason.length > 1) {
                                                    displayReason = retItemsWithReason.map(it => it.productName + ': "' + it.returnReason + '"').join(' | ');
                                                    displayTooltip = retItemsWithReason.map(it => it.productName + ': "' + it.returnReason + '"').join('\n');
                                                } else {
                                                    displayReason = ord.returnReason ? '"' + ord.returnReason + '"' : '"Mandatory client return statement on file."';
                                                    displayTooltip = ord.returnReason || 'Mandatory client return statement on file.';
                                                }
                                            %>
                                            <div class="bg-purple-50/80 border border-purple-200/80 p-2.5 rounded-xl space-y-1 text-xs text-purple-900" title="<%= displayTooltip %>">
                                                <span class="text-[9px] uppercase font-mono tracking-wider font-bold text-purple-700 block">
                                                    <%= retItemsWithReason.length === 1 ? 'Product Return Reason' : 'Collector Reason' %>
                                                </span>
                                                <p class="font-light italic text-[11px] leading-relaxed line-clamp-2">
                                                    <%= displayReason %>
                                                </p>
                                                <% if (ord.returnAdminNotes) { %>
                                                    <div class="pt-1 border-t border-purple-200/60 text-[10px] font-mono text-purple-700 truncate">
                                                        Note: <%= ord.returnAdminNotes %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Status & Valuation -->
                                        <td class="py-4 px-6 align-top">
                                            <%
                                                const retItemsList = (ord.items || []).filter(it => it.status === 'Return Requested' || it.status === 'Returned');
                                                const activeNonCancelled = (ord.items || []).filter(it => it.status !== 'Cancelled');
                                                const isSubsetValuation = retItemsList.length > 0 && retItemsList.length < activeNonCancelled.length;
                                                const retTableValuation = isSubsetValuation
                                                    ? retItemsList.reduce((sum, it) => sum + (it.itemTotal || (it.price * it.quantity)), 0)
                                                    : ord.grandTotal;
                                            %>
                                            <div class="space-y-1.5">
                                                <span class="px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider font-bold inline-block
                                                    <%= ord.orderStatus === 'Returned' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200' %>">
                                                    <%= ord.orderStatus === 'Return Requested' ? 'Review Pending' : ord.orderStatus %>
                                                </span>
                                                <div class="font-mono text-xs font-bold text-[#0A4D2E]">
                                                    ₹<%= Number(retTableValuation).toLocaleString('en-IN') %>
                                                </div>
                                                <% if (isSubsetValuation) { %>
                                                    <span class="text-[9px] text-zinc-400 font-mono block">
                                                        (₹<%= Number(ord.grandTotal).toLocaleString('en-IN') %> order)
                                                    </span>
                                                <% } %>
                                                <span class="text-[10px] text-zinc-400 font-mono block">
                                                    <%= ord.paymentMethod %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Action Buttons -->
                                        <td class="py-4 px-6 align-top text-right">
                                            <div class="flex flex-col items-end gap-1.5">
                                                <% if (ord.orderStatus === 'Return Requested') { %>
                                                    <button 
                                                        type="button" 
                                                        onclick="openApproveReturnModal('<%= ord._id %>', '<%= ord.orderNumber %>')"
                                                        class="w-full sm:w-auto px-3.5 py-1.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white text-[10px] font-semibold uppercase tracking-wider rounded-xl transition-colors cursor-pointer shadow-xs flex items-center justify-center gap-1"
                                                    >
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                        <span>Approve & Refund</span>
                                                    </button>
                                                    <button 
                                                        type="button" 
                                                        onclick="openDeclineReturnModal('<%= ord._id %>', '<%= ord.orderNumber %>')"
                                                        class="w-full sm:w-auto px-3.5 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-[10px] font-semibold uppercase tracking-wider rounded-xl transition-colors cursor-pointer flex items-center justify-center gap-1"
                                                    >
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                        <span>Decline</span>
                                                    </button>
                                                <% } else { %>
                                                    <span class="text-[10px] font-mono text-emerald-700 font-bold flex items-center gap-1">
                                                        <span>✓ Vault Restocked</span>
                                                    </span>
                                                <% } %>
                                                <a 
                                                    href="/admin/orders/<%= ord._id %>" 
                                                    class="inline-flex items-center gap-1 px-3 py-1.5 bg-zinc-900 hover:bg-black text-white rounded-xl text-[10px] font-semibold tracking-wider uppercase transition-all shadow-2xs hover:shadow-xs mt-0.5"
                                                    title="View Full Order & Return Dossier"
                                                >
                                                    <span>Details</span>
                                                    <span>→</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="p-12 text-center text-zinc-400">
                                        <div class="max-w-sm mx-auto space-y-2">
                                            <div class="w-12 h-12 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-lg">
                                                ↩
                                            </div>
                                            <h3 class="font-serif text-base text-zinc-700 font-medium">No Return Claims Found</h3>
                                            <p class="text-xs text-zinc-400 font-light">There are no client return requests matching the active filter criteria.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
                    <div class="px-6 py-4 border-t border-zinc-100 bg-white flex items-center justify-between text-xs">
                        <div class="text-zinc-500">
                            Page <span class="font-bold text-zinc-900"><%= pagination.currentPage %></span> of <span class="font-bold text-zinc-900"><%= pagination.totalPages %></span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <% if (pagination.hasPrevPage) { %>
                                <a href="/admin/returns?page=<%= pagination.prevPage %>&status=<%= status %>&search=<%= search %>&sort=<%= sort %>" class="px-3 py-1.5 border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-colors">Previous</a>
                            <% } %>
                            <% if (pagination.hasNextPage) { %>
                                <a href="/admin/returns?page=<%= pagination.nextPage %>&status=<%= status %>&search=<%= search %>&sort=<%= sort %>" class="px-3 py-1.5 border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-colors">Next</a>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- APPROVE RETURN MODAL -->
<div id="approveReturnModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-[#0A4D2E] font-bold block">Reverse Logistics Confirmation</span>
                <h3 class="text-lg font-serif text-zinc-900">Approve Return & Restock</h3>
            </div>
            <button type="button" onclick="closeApproveReturnModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-zinc-600 font-light leading-relaxed">
            You are approving the return for order <strong id="approveModalOrderNumber" class="font-mono text-zinc-900"></strong>. This action will transition the order and its items to <span class="text-emerald-700 font-bold font-mono">Returned</span>, restock inventory back into the vault, and automatically issue a net refund to the collector's DELTA Vault Wallet.
        </p>

        <form id="approveReturnForm" onsubmit="submitApproveReturn(event)" class="space-y-4 text-xs">
            <input type="hidden" id="approveModalOrderId" value="">
            <div id="approveError" class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs hidden font-mono"></div>
            
            <div class="space-y-1">
                <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-600">Administrative Notes (Optional)</label>
                <input 
                    type="text" 
                    id="approveAdminNotes" 
                    placeholder="e.g. Timepiece inspected, movement calibrated, restocked to vault..." 
                    class="w-full p-3 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none text-xs"
                >
            </div>

            <div class="pt-3 flex items-center justify-end gap-2 border-t border-zinc-100">
                <button type="button" onclick="closeApproveReturnModal()" class="px-4 py-2.5 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 font-semibold cursor-pointer">Cancel</button>
                <button type="submit" id="approveSubmitBtn" class="px-5 py-2.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-xl uppercase tracking-wider font-semibold shadow-sm cursor-pointer">Confirm, Restock & Refund</button>
            </div>
        </form>
    </div>
</div>

<!-- DECLINE RETURN MODAL -->
<div id="declineReturnModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 space-y-5 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-rose-600 font-bold block">Reverse Logistics Rejection</span>
                <h3 class="text-lg font-serif text-zinc-900">Decline Return Request</h3>
            </div>
            <button type="button" onclick="closeDeclineReturnModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Declining the return for order <strong id="declineModalOrderNumber" class="font-mono text-zinc-900"></strong> will retain the order status at <span class="font-bold text-zinc-900">Delivered</span>. Please provide a formal reason for declining this request.
        </p>

        <form id="declineReturnForm" onsubmit="submitDeclineReturn(event)" class="space-y-4 text-xs">
            <input type="hidden" id="declineModalOrderId" value="">
            
            <div class="space-y-1">
                <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-600">Decline Reason (Mandatory) *</label>
                <textarea 
                    id="declineReasonInput" 
                    required
                    rows="3"
                    placeholder="e.g. Timepiece returned with unauthorized third-party modifications or external physical wear outside warranty guidelines..." 
                    class="w-full p-3 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-rose-600 outline-none text-xs font-light"
                ></textarea>
            </div>

            <div id="declineError" class="text-rose-600 text-[11px] font-mono hidden"></div>

            <div class="pt-3 flex items-center justify-end gap-2 border-t border-zinc-100">
                <button type="button" onclick="closeDeclineReturnModal()" class="px-4 py-2.5 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 font-semibold cursor-pointer">Cancel</button>
                <button type="submit" id="declineSubmitBtn" class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl uppercase tracking-wider font-semibold shadow-sm cursor-pointer">Decline Return</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openApproveReturnModal(orderId, orderNumber) {
        document.getElementById('approveModalOrderId').value = orderId;
        document.getElementById('approveModalOrderNumber').textContent = orderNumber;
        document.getElementById('approveAdminNotes').value = '';
        const err = document.getElementById('approveError');
        if (err) err.classList.add('hidden');
        const m = document.getElementById('approveReturnModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeApproveReturnModal() {
        const m = document.getElementById('approveReturnModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function openDeclineReturnModal(orderId, orderNumber) {
        document.getElementById('declineModalOrderId').value = orderId;
        document.getElementById('declineModalOrderNumber').textContent = orderNumber;
        document.getElementById('declineReasonInput').value = '';
        const err = document.getElementById('declineError');
        if (err) err.classList.add('hidden');
        const m = document.getElementById('declineReturnModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeDeclineReturnModal() {
        const m = document.getElementById('declineReturnModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    async function submitApproveReturn(e) {
        e.preventDefault();
        const errEl = document.getElementById('approveError');
        if (errEl) errEl.classList.add('hidden');
        const orderId = document.getElementById('approveModalOrderId').value;
        const adminNotes = document.getElementById('approveAdminNotes').value.trim();
        const btn = document.getElementById('approveSubmitBtn');

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/admin/orders/' + orderId + '/return/approve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ adminNotes })
            });
            const data = await res.json();
            if (data.success) {
                if (typeof showToast === 'function') showToast(data.message, 'success');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Failed to approve return.';
                    errEl.classList.remove('hidden');
                } else {
                    alert(data.message || 'Failed to approve return.');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error approving return.';
                errEl.classList.remove('hidden');
            } else {
                alert('Connection error approving return.');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function submitDeclineReturn(e) {
        e.preventDefault();
        const orderId = document.getElementById('declineModalOrderId').value;
        const declineReason = document.getElementById('declineReasonInput').value.trim();
        const errEl = document.getElementById('declineError');
        const btn = document.getElementById('declineSubmitBtn');

        if (!declineReason) {
            if (errEl) {
                errEl.textContent = 'A reason for declining the return is required.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/admin/orders/' + orderId + '/return/decline', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ declineReason })
            });
            const data = await res.json();
            if (data.success) {
                if (typeof showToast === 'function') showToast(data.message, 'info');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Failed to decline return.';
                    errEl.classList.remove('hidden');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error declining return.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }
</script>
