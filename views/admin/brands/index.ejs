<%- include('../partials/header', { title: 'Brand Registry — DELTA Horology' }) %>

<%
    const safeBrands = (typeof brands !== 'undefined' && Array.isArray(brands)) ? brands : [];
    const safeSearch = (typeof search !== 'undefined' && search) ? search : '';
    const safeStatus = (typeof status !== 'undefined' && status) ? status : 'all';
    const safeStats = (typeof stats !== 'undefined' && stats) ? stats : { totalBrands: safeBrands.length, activeBrands: 0, unlistedBrands: 0, deletedBrands: 0 };
    const safePagination = (typeof pagination !== 'undefined' && pagination) ? pagination : {
        currentPage: 1,
        totalPages: 1,
        totalItems: safeBrands.length,
        pageLimit: 6,
        startItem: safeBrands.length > 0 ? 1 : 0,
        endItem: safeBrands.length,
        hasNextPage: false,
        hasPrevPage: false,
        nextPage: null,
        prevPage: null,
        pageNumbers: [1]
    };
    const startNum = safePagination.startItem || (safeBrands.length > 0 ? ((safePagination.currentPage - 1) * safePagination.pageLimit + 1) : 0);
    const endNum = safePagination.endItem || Math.min(safePagination.totalItems, startNum + safeBrands.length - 1);
%>

<div class="flex flex-1 min-h-screen bg-[#FBFBFC]">
    <%- include('../partials/sidebar', { activePage: 'brands' }) %>

    <div class="flex-1 flex flex-col min-w-0">
        <%- include('../partials/navbar', { pageTitle: 'Brand Registry' }) %>

        <main class="flex-grow p-6 sm:p-10 max-w-[1500px] w-full mx-auto space-y-8">
            
            <!-- 1. Header Section -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-2 border-b border-zinc-200/70">
                <div class="space-y-1.5">
                    <h1 class="text-3xl sm:text-4xl font-serif font-normal text-zinc-900 tracking-tight">
                        Brand Registry
                    </h1>
                    <p class="text-xs sm:text-sm text-zinc-500 font-light max-w-2xl leading-relaxed">
                        Manage the global horological portfolio. Define brand heritage, toggle active/inactive catalog visibility, and inspect archived maisons.
                    </p>
                </div>

                <div class="flex items-center gap-3">
                    <% if (safeStatus === 'archived' && (safeStats.deletedBrands > 0 || safeBrands.length > 0)) { %>
                        <button 
                            type="button" 
                            onclick="openPermanentDeleteAllModal()" 
                            class="inline-flex items-center gap-2 bg-rose-700 hover:bg-rose-800 text-white px-5 py-3.5 rounded-xl text-xs uppercase font-semibold tracking-[0.15em] transition-all shadow-md shadow-rose-700/20 active:scale-[0.99] cursor-pointer"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            <span>DELETE ALL ARCHIVED</span>
                        </button>
                    <% } %>
                    <button 
                        type="button" 
                        onclick="openAddModal()" 
                        class="inline-flex items-center gap-2.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white px-6 py-3.5 rounded-xl text-xs uppercase font-semibold tracking-[0.15em] transition-all shadow-md shadow-[#0A4D2E]/15 active:scale-[0.99] cursor-pointer"
                    >
                        <span class="text-base leading-none font-light">+</span>
                        <span>REGISTER NEW BRAND</span>
                    </button>
                </div>
            </div>

            <!-- Flash Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-emerald-50/90 border border-emerald-200/80 text-emerald-900 px-5 py-3.5 rounded-2xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium"><%= success %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 text-sm cursor-pointer">✕</button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-rose-50/90 border border-rose-200/80 text-rose-900 px-5 py-3.5 rounded-2xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span class="font-medium"><%= error %></span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-900 text-sm cursor-pointer">✕</button>
                </div>
            <% } %>

            <!-- Status Filter Tabs / Counter Pills -->
            <div class="flex items-center flex-wrap gap-2.5">
                <a 
                    href="/admin/brands?status=all&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %>"
                    class="px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all flex items-center gap-2 <%= (safeStatus === 'all' || !safeStatus) ? 'bg-zinc-900 text-white shadow-sm' : 'bg-white border border-zinc-200/80 text-zinc-600 hover:bg-zinc-50' %>"
                >
                    <span>All Maisons</span>
                    <span id="statTotalBrands" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold <%= (safeStatus === 'all' || !safeStatus) ? 'bg-zinc-800 text-zinc-200' : 'bg-zinc-100 text-zinc-700' %>"><%= safeStats.totalBrands || 0 %></span>
                </a>

                <a 
                    href="/admin/brands?status=active&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %>"
                    class="px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all flex items-center gap-2 <%= safeStatus === 'active' ? 'bg-[#0A4D2E] text-white shadow-sm' : 'bg-white border border-zinc-200/80 text-zinc-600 hover:bg-zinc-50' %>"
                >
                    <span class="w-2 h-2 rounded-full <%= safeStatus === 'active' ? 'bg-emerald-300' : 'bg-emerald-600' %>"></span>
                    <span>Active (Listed)</span>
                    <span id="statActiveBrands" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold <%= safeStatus === 'active' ? 'bg-emerald-900 text-emerald-200' : 'bg-emerald-50 text-emerald-700' %>"><%= safeStats.activeBrands || 0 %></span>
                </a>

                <a 
                    href="/admin/brands?status=inactive&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %>"
                    class="px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all flex items-center gap-2 <%= safeStatus === 'inactive' ? 'bg-zinc-800 text-white shadow-sm' : 'bg-white border border-zinc-200/80 text-zinc-600 hover:bg-zinc-50' %>"
                >
                    <span class="w-2 h-2 rounded-full <%= safeStatus === 'inactive' ? 'bg-zinc-300' : 'bg-zinc-400' %>"></span>
                    <span>Inactive (Unlisted)</span>
                    <span id="statUnlistedBrands" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold <%= safeStatus === 'inactive' ? 'bg-zinc-900 text-zinc-200' : 'bg-zinc-100 text-zinc-600' %>"><%= safeStats.unlistedBrands || 0 %></span>
                </a>

                <a 
                    href="/admin/brands?status=archived&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %>"
                    class="px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all flex items-center gap-2 <%= safeStatus === 'archived' ? 'bg-rose-900 text-white shadow-sm' : 'bg-white border border-zinc-200/80 text-zinc-600 hover:bg-zinc-50' %>"
                >
                    <span class="w-2 h-2 rounded-full <%= safeStatus === 'archived' ? 'bg-rose-300' : 'bg-rose-500' %>"></span>
                    <span>Archived</span>
                    <span id="statDeletedBrands" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold <%= safeStatus === 'archived' ? 'bg-rose-950 text-rose-200' : 'bg-rose-50 text-rose-700' %>"><%= safeStats.deletedBrands || 0 %></span>
                </a>
            </div>

            <!-- 2. Search Bar with Clear Button -->
            <div class="bg-white border border-zinc-200/70 rounded-2xl p-4 sm:p-5 shadow-sm">
                <form action="/admin/brands" method="GET" class="flex flex-col sm:flex-row items-center gap-4 m-0">
                    <input type="hidden" name="status" value="<%= safeStatus %>">
                    <input type="hidden" name="limit" value="<%= safePagination.pageLimit %>">

                    <div class="relative flex-1 w-full">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </span>
                        <input 
                            type="text" 
                            name="search" 
                            value="<%= safeSearch %>" 
                            placeholder="Search Maisons by name, origin region, or heritage notes..." 
                            class="w-full pl-11 pr-10 py-3 bg-zinc-50/80 hover:bg-zinc-50 focus:bg-white border border-zinc-200/90 rounded-xl text-xs sm:text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-[#0A4D2E]/10 focus:border-[#0A4D2E] transition-all"
                        >
                        <% if (safeSearch) { %>
                            <a href="/admin/brands?status=<%= safeStatus %>&limit=<%= safePagination.pageLimit %>" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-700 p-1 text-xs font-bold" title="Clear Search">
                                ✕
                            </a>
                        <% } %>
                    </div>

                    <div class="flex items-center gap-2.5 w-full sm:w-auto">
                        <button type="submit" class="flex-1 sm:flex-none px-5 py-3 bg-zinc-900 hover:bg-black text-white rounded-xl text-xs uppercase tracking-wider font-semibold transition-all cursor-pointer">
                            Filter
                        </button>
                        <% if (safeSearch || safeStatus !== 'all') { %>
                            <a href="/admin/brands?limit=<%= safePagination.pageLimit %>" class="px-4 py-3 bg-zinc-100 hover:bg-zinc-200 text-zinc-600 rounded-xl text-xs uppercase tracking-wider font-semibold transition-all">
                                Reset All
                            </a>
                        <% } %>
                    </div>
                </form>
            </div>

            <!-- 3. Luxury Brand Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                
                <% if (safeBrands.length > 0) { %>
                    <% safeBrands.forEach((b) => { %>
                        <% const isArchived = Boolean(b.isDeleted); %>
                        <div id="brand-card-<%= b._id %>" class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-7 flex flex-col justify-between space-y-6 shadow-sm hover:shadow-md transition-all relative group <%= isArchived ? 'opacity-75 bg-zinc-50/50' : '' %>">
                            
                            <!-- Card Top -->
                            <div class="space-y-4">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex items-center gap-3.5">
                                        <div class="w-12 h-12 rounded-2xl bg-zinc-50 border border-zinc-200/80 flex items-center justify-center text-lg font-serif font-bold text-[#0A4D2E] shadow-2xs group-hover:scale-105 transition-transform flex-shrink-0">
                                            <%= b.name.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <h3 class="text-base sm:text-lg font-serif font-normal text-zinc-900 leading-snug">
                                                <%= b.name %>
                                            </h3>
                                            <p class="text-[11px] font-mono text-zinc-400">
                                                <%= b.origin || 'Switzerland' %> <%= b.foundedYear ? '• Est. ' + b.foundedYear : '' %>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Status Toggle Component (Interactive Toggle Switch) -->
                                    <% if (isArchived) { %>
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            <span>Archived</span>
                                        </span>
                                    <% } else { %>
                                        <div class="flex items-center gap-2.5">
                                            <!-- Status Label Pill -->
                                            <span 
                                                id="status-badge-<%= b._id %>"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider transition-all <%= b.isActive ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80' : 'bg-zinc-100 text-zinc-500 border border-zinc-200' %>"
                                            >
                                                <span class="status-dot w-1.5 h-1.5 rounded-full <%= b.isActive ? 'bg-emerald-600 animate-pulse' : 'bg-zinc-400' %>"></span>
                                                <span class="status-label"><%= b.isActive ? 'Active' : 'Inactive' %></span>
                                            </span>

                                            <!-- iOS-style Interactive Toggle Switch -->
                                            <button 
                                                type="button" 
                                                role="switch" 
                                                aria-checked="<%= b.isActive ? 'true' : 'false' %>"
                                                onclick="toggleBrandStatusAjax('<%= b._id %>', this)"
                                                data-brand-id="<%= b._id %>"
                                                data-brand-name="<%= b.name %>"
                                                data-is-active="<%= b.isActive %>"
                                                class="brand-toggle-btn relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-[#0A4D2E] focus:ring-offset-2 <%= b.isActive ? 'bg-[#0A4D2E]' : 'bg-zinc-300' %>"
                                                title="Click to toggle Active / Inactive"
                                            >
                                                <span class="sr-only">Toggle Maison Status</span>
                                                <span 
                                                    aria-hidden="true" 
                                                    class="toggle-thumb pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out <%= b.isActive ? 'translate-x-5' : 'translate-x-0' %>"
                                                ></span>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Heritage Notes / Description -->
                                <p class="text-xs text-zinc-600 font-light leading-relaxed line-clamp-3">
                                    <%= b.description || 'Distinguished Swiss Manufacture celebrated for mechanical mastery, heritage preservation, and chronometric excellence.' %>
                                </p>
                            </div>

                            <!-- Card Bottom Actions -->
                            <div class="pt-4 border-t border-zinc-100 flex items-center justify-between gap-3 text-xs">
                                <div>
                                    <% if (b.website) { %>
                                        <a href="<%= b.website.startsWith('http') ? b.website : 'https://' + b.website %>" target="_blank" rel="noopener noreferrer" class="text-[11px] font-mono text-[#0A4D2E] hover:underline flex items-center gap-1">
                                            <span>Official Site</span>
                                            <span>↗</span>
                                        </a>
                                    <% } else { %>
                                        <span class="text-[10px] font-mono text-zinc-400">Certified Maison</span>
                                    <% } %>
                                </div>

                                <div class="flex items-center gap-2">
                                    <% if (isArchived) { %>
                                        <button 
                                            type="button" 
                                            onclick="restoreBrandAjax('<%= b._id %>', '<%= b.name %>')"
                                            class="px-3.5 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-medium transition-colors shadow-xs cursor-pointer flex items-center gap-1.5"
                                            title="Restore Maison back to active catalog"
                                        >
                                            <span>↻</span>
                                            <span>Restore</span>
                                        </button>

                                        <button 
                                            type="button" 
                                            onclick="openPermanentDeleteModal('<%= b._id %>', '<%= b.name %>')"
                                            class="px-3.5 py-1.5 bg-rose-50 hover:bg-rose-700 hover:text-white text-rose-700 border border-rose-200 hover:border-rose-700 rounded-xl text-xs font-medium transition-colors shadow-2xs cursor-pointer flex items-center gap-1.5"
                                            title="Permanently delete Maison from archive"
                                        >
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                            <span>Delete</span>
                                        </button>
                                    <% } else { %>
                                        <button 
                                            type="button" 
                                            class="edit-brand-btn px-3 py-1.5 bg-zinc-100 hover:bg-zinc-900 hover:text-white text-zinc-700 rounded-xl text-xs font-medium transition-colors cursor-pointer"
                                            data-id="<%= b._id %>"
                                            data-name="<%= b.name %>"
                                            data-origin="<%= b.origin || '' %>"
                                            data-founded="<%= b.foundedYear || '' %>"
                                            data-description="<%= b.description || '' %>"
                                            data-website="<%= b.website || '' %>"
                                            data-active="<%= b.isActive %>"
                                        >
                                            Edit
                                        </button>

                                        <button 
                                            type="button" 
                                            class="delete-brand-btn px-3 py-1.5 bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-700 border border-rose-200 hover:border-rose-600 rounded-xl text-xs font-medium transition-colors cursor-pointer"
                                            data-id="<%= b._id %>"
                                            data-name="<%= b.name %>"
                                        >
                                            Archive
                                        </button>
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-20 text-center space-y-3 bg-white rounded-3xl border border-zinc-200/80 p-8 shadow-sm">
                        <div class="w-12 h-12 rounded-2xl bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-xl">
                            🏛
                        </div>
                        <h3 class="text-base font-serif text-zinc-900 font-normal">No Manufacture Maisons Found</h3>
                        <p class="text-xs text-zinc-500 font-light max-w-sm mx-auto">
                            <% if (safeSearch) { %>
                                No Maisons matched "<%= safeSearch %>". Try resetting your search filters.
                            <% } else if (safeStatus === 'inactive') { %>
                                No inactive/unlisted Maisons currently registered.
                            <% } else if (safeStatus === 'archived') { %>
                                No archived Maisons in the registry.
                            <% } else { %>
                                Your luxury brand catalog is currently empty. Click "Register New Brand" to add your first manufacture.
                            <% } %>
                        </p>
                        <% if (safeSearch || safeStatus !== 'all') { %>
                            <div class="pt-2">
                                <a href="/admin/brands?limit=<%= safePagination.pageLimit %>" class="inline-block px-5 py-2.5 bg-zinc-900 text-white rounded-xl text-xs font-semibold uppercase tracking-wider hover:bg-black transition-colors">
                                    View All Maisons
                                </a>
                            </div>
                        <% } %>
                    </div>
                <% } %>

            </div>

            <!-- 5. Bottom Pagination Bar with Density Selector -->
            <% if (safePagination.totalItems > 0) { %>
                <div class="bg-white border border-zinc-200/70 rounded-2xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs shadow-sm">
                    <!-- Density & Range -->
                    <div class="flex items-center gap-4 text-zinc-500">
                        <span>
                            Showing <strong class="text-zinc-900"><%= startNum %></strong> to <strong class="text-zinc-900"><%= endNum %></strong> of <strong class="text-zinc-900"><%= safePagination.totalItems %></strong> Maisons
                        </span>

                        <div class="flex items-center gap-1.5 pl-3 border-l border-zinc-200">
                            <span class="text-zinc-400 uppercase tracking-wider text-[10px]">Per page:</span>
                            <select onchange="changeLimit(this.value)" class="bg-zinc-50 border border-zinc-200 text-zinc-900 rounded-lg px-2 py-1 text-xs focus:outline-none focus:border-[#0A4D2E] cursor-pointer">
                                <option value="6" <%= safePagination.pageLimit === 6 ? 'selected' : '' %>>6</option>
                                <option value="9" <%= safePagination.pageLimit === 9 ? 'selected' : '' %>>9</option>
                                <option value="18" <%= safePagination.pageLimit === 18 ? 'selected' : '' %>>18</option>
                                <option value="36" <%= safePagination.pageLimit === 36 ? 'selected' : '' %>>36</option>
                            </select>
                        </div>
                    </div>

                    <!-- Page Window Jump Buttons -->
                    <div class="flex items-center gap-1.5 font-mono">
                        <% if (safePagination.currentPage > 1) { %>
                            <a href="/admin/brands?page=1&limit=<%= safePagination.pageLimit %>&status=<%= safeStatus %>&search=<%= encodeURIComponent(safeSearch) %>" class="w-8 h-8 flex items-center justify-center rounded-lg border border-zinc-200 hover:bg-zinc-100 text-zinc-700 transition-colors" title="First Page">«</a>
                            <a href="/admin/brands?page=<%= safePagination.prevPage || 1 %>&limit=<%= safePagination.pageLimit %>&status=<%= safeStatus %>&search=<%= encodeURIComponent(safeSearch) %>" class="w-8 h-8 flex items-center justify-center rounded-lg border border-zinc-200 hover:bg-zinc-100 text-zinc-700 transition-colors" title="Previous Page">‹</a>
                        <% } %>

                        <% if (safePagination.pageNumbers && Array.isArray(safePagination.pageNumbers)) { %>
                            <% safePagination.pageNumbers.forEach(p => { %>
                                <% if (p === '...') { %>
                                    <span class="w-8 h-8 flex items-center justify-center text-zinc-400">...</span>
                                <% } else if (p === safePagination.currentPage) { %>
                                    <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-[#0A4D2E] text-white font-bold"><%= p %></span>
                                <% } else { %>
                                    <a href="/admin/brands?page=<%= p %>&limit=<%= safePagination.pageLimit %>&status=<%= safeStatus %>&search=<%= encodeURIComponent(safeSearch) %>" class="w-8 h-8 flex items-center justify-center rounded-lg border border-zinc-200 hover:bg-zinc-100 text-zinc-700 transition-colors"><%= p %></a>
                                <% } %>
                            <% }) %>
                        <% } %>

                        <% if (safePagination.hasNextPage) { %>
                            <a href="/admin/brands?page=<%= safePagination.nextPage %>&limit=<%= safePagination.pageLimit %>&status=<%= safeStatus %>&search=<%= encodeURIComponent(safeSearch) %>" class="w-8 h-8 flex items-center justify-center rounded-lg border border-zinc-200 hover:bg-zinc-100 text-zinc-700 transition-colors" title="Next Page">›</a>
                            <a href="/admin/brands?page=<%= safePagination.totalPages %>&limit=<%= safePagination.pageLimit %>&status=<%= safeStatus %>&search=<%= encodeURIComponent(safeSearch) %>" class="w-8 h-8 flex items-center justify-center rounded-lg border border-zinc-200 hover:bg-zinc-100 text-zinc-700 transition-colors" title="Last Page">»</a>
                        <% } %>
                    </div>
                </div>
            <% } %>

        </main>
    </div>
</div>

<!-- ==================================================================== -->
<!-- REGISTER NEW BRAND MODAL (WITH CLIENT-SIDE VALIDATION & TOGGLE) -->
<!-- ==================================================================== -->
<div id="addBrandModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden flex items-center justify-center p-4">
