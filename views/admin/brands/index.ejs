    <div class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl border border-zinc-200 text-center relative animate-modal-in">
        <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
        </div>

        <h3 class="text-xl font-serif font-semibold text-zinc-900 mb-1">Delete All Archived Maisons</h3>
        <p class="text-xs text-zinc-500 font-light mb-6">
            Are you sure you want to permanently delete <strong class="text-rose-700 font-semibold">ALL archived Maisons</strong>? This action is irreversible and will permanently purge all archived brands from the vault database.
        </p>

        <form action="/admin/brands/permanent-delete-all?status=archived&limit=<%= safePagination.pageLimit %>" method="POST" class="flex items-center justify-center gap-3">
            <button type="button" onclick="closePermanentDeleteAllModal()" class="px-5 py-2.5 rounded-xl border border-zinc-200 text-xs font-semibold text-zinc-600 hover:bg-zinc-100 transition-colors cursor-pointer">
                Cancel
            </button>
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-rose-700 hover:bg-rose-800 text-white text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm cursor-pointer">
                Confirm Purge All
            </button>
        </form>
    </div>
</div>

<script>
    const brandNameRegex = /^[A-Za-zÀ-ÿ0-9][A-Za-zÀ-ÿ0-9\s\-_'.,()&/+]{1,59}$/;
    const brandOriginRegex = /^[A-Za-zÀ-ÿ0-9][A-Za-zÀ-ÿ0-9\s,.'\-\/]{1,99}$/;
    const urlRegex = /^(https?:\/\/)?(www\.)?[a-zA-Z0-9\-]+(\.[a-zA-Z]{2,})+([\/?#].*)?$/;
    const currentYear = new Date().getFullYear();

    function updateModalToggleText(prefix) {
        const input = document.getElementById(prefix + 'IsActive');
        const desc = document.getElementById(prefix + 'StatusDesc');
        if (input && desc) {
            if (input.checked) {
                desc.textContent = 'Active & listed in boutique catalog';
            } else {
                desc.textContent = 'Inactive / unlisted from boutique catalog';
            }
        }
    }

    async function toggleBrandStatusAjax(brandId, btn) {
        const isCurrentlyActive = btn.dataset.isActive === 'true';
        const brandName = btn.dataset.brandName || 'Maison';
        const thumb = btn.querySelector('.toggle-thumb');
        const badge = document.getElementById('status-badge-' + brandId);
        const dot = badge ? badge.querySelector('.status-dot') : null;
        const label = badge ? badge.querySelector('.status-label') : null;

        // Optimistic UI state change
        const nextState = !isCurrentlyActive;
        btn.dataset.isActive = nextState.toString();
        btn.setAttribute('aria-checked', nextState.toString());
        
        if (nextState) {
            btn.classList.remove('bg-zinc-300');
            btn.classList.add('bg-[#0A4D2E]');
            if (thumb) {
                thumb.classList.remove('translate-x-0');
                thumb.classList.add('translate-x-5');
            }
            if (badge) {
                badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider transition-all bg-emerald-50 text-emerald-800 border border-emerald-200/80';
            }
            if (dot) dot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse';
            if (label) label.textContent = 'Active';
        } else {
            btn.classList.remove('bg-[#0A4D2E]');
            btn.classList.add('bg-zinc-300');
            if (thumb) {
                thumb.classList.remove('translate-x-5');
                thumb.classList.add('translate-x-0');
            }
            if (badge) {
                badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider transition-all bg-zinc-100 text-zinc-500 border border-zinc-200';
            }
            if (dot) dot.className = 'status-dot w-1.5 h-1.5 rounded-full bg-zinc-400';
            if (label) label.textContent = 'Inactive';
        }

        try {
            const res = await fetch(`/admin/brands/${brandId}/toggle-status`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });
            const data = await res.json();
            if (!data.success) {
                throw new Error(data.message || 'Unable to update status');
            }

            if (window.showToast) {
                window.showToast(data.message || `Brand "${brandName}" is now ${nextState ? 'Active' : 'Inactive'}.`, 'success');
            }

            // Update stats counters if present
            if (data.stats) {
                const elActive = document.getElementById('statActiveBrands');
                const elUnlisted = document.getElementById('statUnlistedBrands');
                if (elActive) elActive.textContent = data.stats.activeBrands;
                if (elUnlisted) elUnlisted.textContent = data.stats.unlistedBrands;
            }
        } catch (err) {
            if (window.showToast) {
                window.showToast(err.message || 'Connection issue.', 'error');
            } else {
                alert(err.message || 'Connection issue.');
            }
            // Reload on failure to restore true database state
            setTimeout(() => window.location.reload(), 1000);
        }
    }

    async function restoreBrandAjax(brandId, brandName) {
        if (!confirm(`Restore "${brandName}" back to the active Maison catalog?`)) return;
        try {
            const res = await fetch(`/admin/brands/${brandId}/restore`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) {
                    window.showToast(data.message || `"${brandName}" restored successfully.`, 'success');
                }
                setTimeout(() => window.location.reload(), 400);
            } else {
                alert(data.message || 'Failed to restore brand.');
            }
        } catch (e) {
            alert('Connection error.');
        }
    }

    function setFieldError(inputId, errorId, message) {
        const input = document.getElementById(inputId);
        const err = document.getElementById(errorId);
        if (err) {
            err.textContent = message;
            err.classList.remove('hidden');
        }
        if (input) {
            input.classList.remove('border-zinc-200', 'border-emerald-500/80');
            input.classList.add('border-rose-500', 'bg-rose-50/20', 'ring-1', 'ring-rose-500');
        }
    }

    function clearFieldError(inputId, errorId) {
        const input = document.getElementById(inputId);
        const err = document.getElementById(errorId);
        if (err) {
            err.textContent = '';
            err.classList.add('hidden');
        }
        if (input) {
            input.classList.remove('border-rose-500', 'bg-rose-50/20', 'ring-1', 'ring-rose-500');
            input.classList.add('border-zinc-200');
        }
    }

    function validateBrandField(prefix, field) {
        const nameVal = document.getElementById(prefix + 'Name')?.value.trim() || '';
        const originVal = document.getElementById(prefix + 'Origin')?.value.trim() || '';
        const foundedVal = document.getElementById(prefix + 'FoundedYear')?.value.trim() || '';
        const descVal = document.getElementById(prefix + 'Description')?.value.trim() || '';
        const websiteVal = document.getElementById(prefix + 'Website')?.value.trim() || '';

        if (field === 'name') {
            if (!nameVal) {
                setFieldError(prefix + 'Name', prefix + 'NameError', 'Maison name is required.');
                return false;
            } else if (nameVal.length < 2 || nameVal.length > 60) {
                setFieldError(prefix + 'Name', prefix + 'NameError', 'Maison name must be 2 to 60 characters.');
                return false;
            } else if (!brandNameRegex.test(nameVal)) {
                setFieldError(prefix + 'Name', prefix + 'NameError', 'Maison name contains invalid characters.');
                return false;
            }
            clearFieldError(prefix + 'Name', prefix + 'NameError');
            return true;
        }

        if (field === 'origin') {
            if (originVal) {
                if (originVal.length < 2 || originVal.length > 100) {
                    setFieldError(prefix + 'Origin', prefix + 'OriginError', 'Origin region must be 2 to 100 characters.');
                    return false;
                } else if (!brandOriginRegex.test(originVal)) {
                    setFieldError(prefix + 'Origin', prefix + 'OriginError', 'Origin region contains invalid characters.');
                    return false;
                }
            }
            clearFieldError(prefix + 'Origin', prefix + 'OriginError');
            return true;
        }

        if (field === 'foundedYear') {
            if (foundedVal) {
                const y = parseInt(foundedVal, 10);
                if (isNaN(y) || y < 1500 || y > currentYear) {
                    setFieldError(prefix + 'FoundedYear', prefix + 'FoundedYearError', 'Founded year must be between 1500 and ' + currentYear + '.');
                    return false;
                }
            }
            clearFieldError(prefix + 'FoundedYear', prefix + 'FoundedYearError');
            return true;
        }

        if (field === 'description') {
            if (descVal && descVal.length > 1000) {
                setFieldError(prefix + 'Description', prefix + 'DescriptionError', 'Description cannot exceed 1000 characters.');
                return false;
            }
            clearFieldError(prefix + 'Description', prefix + 'DescriptionError');
            return true;
        }

        if (field === 'website') {
            if (websiteVal) {
                if (websiteVal.length > 200) {
                    setFieldError(prefix + 'Website', prefix + 'WebsiteError', 'Website URL cannot exceed 200 characters.');
                    return false;
                } else if (!urlRegex.test(websiteVal)) {
                    setFieldError(prefix + 'Website', prefix + 'WebsiteError', 'Please enter a valid website URL.');
                    return false;
                }
            }
            clearFieldError(prefix + 'Website', prefix + 'WebsiteError');
            return true;
        }

        return true;
    }

    function openAddModal() {
        ['addName', 'addOrigin', 'addFoundedYear', 'addDescription', 'addWebsite'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = '';
            clearFieldError(id, id + 'Error');
        });
        const genErr = document.getElementById('addBrandGeneralError');
        if (genErr) {
            genErr.textContent = '';
            genErr.classList.add('hidden');
        }
        const activeBox = document.getElementById('addIsActive');
        if (activeBox) {
            activeBox.checked = true;
            updateModalToggleText('add');
        }
        document.getElementById('addBrandModal').classList.remove('hidden');
    }

    function closeAddModal() {
        document.getElementById('addBrandModal').classList.add('hidden');
    }

    function closeEditModal() {
        document.getElementById('editBrandModal').classList.add('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteBrandModal').classList.add('hidden');
    }

    function openPermanentDeleteModal(id, name) {
        const searchParam = '<%= encodeURIComponent(safeSearch) %>';
        const statusParam = '<%= encodeURIComponent(safeStatus) %>';
        const pageParam = '<%= safePagination.currentPage %>';
        const limitParam = '<%= safePagination.pageLimit %>';

        document.getElementById('permanentDeleteBrandForm').action = '/admin/brands/' + id + '/permanent-delete?status=' + statusParam + '&search=' + searchParam + '&page=' + pageParam + '&limit=' + limitParam;
        document.getElementById('permanentDeleteBrandName').textContent = name;
        document.getElementById('permanentDeleteBrandModal').classList.remove('hidden');
    }

    function closePermanentDeleteModal() {
        document.getElementById('permanentDeleteBrandModal').classList.add('hidden');
    }

    function openPermanentDeleteAllModal() {
        document.getElementById('permanentDeleteAllBrandModal').classList.remove('hidden');
    }

    function closePermanentDeleteAllModal() {
        document.getElementById('permanentDeleteAllBrandModal').classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const searchParam = '<%= encodeURIComponent(safeSearch) %>';
        const statusParam = '<%= encodeURIComponent(safeStatus) %>';
        const pageParam = '<%= safePagination.currentPage %>';
        const limitParam = '<%= safePagination.pageLimit %>';

  
        ['Name', 'Origin', 'FoundedYear', 'Description', 'Website'].forEach(f => {
            const fieldKey = f.charAt(0).toLowerCase() + f.slice(1);
            const input = document.getElementById('add' + f);
            if (input) {
                input.addEventListener('input', () => validateBrandField('add', fieldKey));
                input.addEventListener('blur', () => validateBrandField('add', fieldKey));
            }
            const editInput = document.getElementById('edit' + f);
            if (editInput) {
                editInput.addEventListener('input', () => validateBrandField('edit', fieldKey));
                editInput.addEventListener('blur', () => validateBrandField('edit', fieldKey));
            }
        });

  
        const addForm = document.getElementById('addBrandForm');
        if (addForm) {
            addForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const genErr = document.getElementById('addBrandGeneralError');
                if (genErr) genErr.classList.add('hidden');

                const validName = validateBrandField('add', 'name');
                const validOrigin = validateBrandField('add', 'origin');
                const validFounded = validateBrandField('add', 'foundedYear');
                const validDesc = validateBrandField('add', 'description');
                const validWebsite = validateBrandField('add', 'website');

                if (!validName || !validOrigin || !validFounded || !validDesc || !validWebsite) {
                    return; // Stays open!
                }

                const submitBtn = addForm.querySelector('button[type="submit"]');
                const origText = submitBtn ? submitBtn.textContent : '';
                if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving...'; }

                const payload = {
                    name: document.getElementById('addName')?.value.trim() || '',
                    origin: document.getElementById('addOrigin')?.value.trim() || '',
                    foundedYear: document.getElementById('addFoundedYear')?.value.trim() || '',
                    description: document.getElementById('addDescription')?.value.trim() || '',
                    website: document.getElementById('addWebsite')?.value.trim() || '',
                    isActive: document.getElementById('addIsActive')?.checked ?? true
                };

                try {
                    const res = await fetch(addForm.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        closeAddModal();
                        if (window.showToast) window.showToast(data.message || 'Maison registered successfully.', 'success');
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        // DO NOT CLOSE MODAL!
                        if (genErr) {
                            genErr.textContent = data.message || 'Validation issue occurred.';
                            genErr.classList.remove('hidden');
                        }
                        if (data.errors) {
                            Object.entries(data.errors).forEach(([field, msg]) => {
                                const cap = field.charAt(0).toUpperCase() + field.slice(1);
                                setFieldError('add' + cap, 'add' + cap + 'Error', msg);
                            });
                        }
                    }
                } catch (err) {
                    if (genErr) {
                        genErr.textContent = 'Connection error saving Maison.';
                        genErr.classList.remove('hidden');
                    }
                } finally {
                    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText; }
                }
            });
        }


        const editForm = document.getElementById('editBrandForm');
        if (editForm) {
            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const genErr = document.getElementById('editBrandGeneralError');
                if (genErr) genErr.classList.add('hidden');

                const validName = validateBrandField('edit', 'name');
                const validOrigin = validateBrandField('edit', 'origin');
                const validFounded = validateBrandField('edit', 'foundedYear');
                const validDesc = validateBrandField('edit', 'description');
                const validWebsite = validateBrandField('edit', 'website');

                if (!validName || !validOrigin || !validFounded || !validDesc || !validWebsite) {
                    return; // Stays open!
                }

                const submitBtn = editForm.querySelector('button[type="submit"]');
                const origText = submitBtn ? submitBtn.textContent : '';
                if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Updating...'; }

                const payload = {
                    name: document.getElementById('editName')?.value.trim() || '',
                    origin: document.getElementById('editOrigin')?.value.trim() || '',
                    foundedYear: document.getElementById('editFoundedYear')?.value.trim() || '',
                    description: document.getElementById('editDescription')?.value.trim() || '',
                    website: document.getElementById('editWebsite')?.value.trim() || '',
                    isActive: document.getElementById('editIsActive')?.checked ?? true
                };

                try {
                    const res = await fetch(editForm.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        closeEditModal();
                        if (window.showToast) window.showToast(data.message || 'Maison updated successfully.', 'success');
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        // DO NOT CLOSE MODAL!
                        if (genErr) {
                            genErr.textContent = data.message || 'Validation issue occurred.';
                            genErr.classList.remove('hidden');
                        }
                        if (data.errors) {
                            Object.entries(data.errors).forEach(([field, msg]) => {
                                const cap = field.charAt(0).toUpperCase() + field.slice(1);
                                setFieldError('edit' + cap, 'edit' + cap + 'Error', msg);
                            });
                        }
                    }
                } catch (err) {
                    if (genErr) {
                        genErr.textContent = 'Connection error updating Maison.';
                        genErr.classList.remove('hidden');
                    }
                } finally {
                    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText; }
                }
            });
        }


        document.querySelectorAll('.edit-brand-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name || '';
                const origin = btn.dataset.origin || '';
                const founded = btn.dataset.founded || '';
                const description = btn.dataset.description || '';
                const website = btn.dataset.website || '';
                const isActive = btn.dataset.active === 'true';

                ['editName', 'editOrigin', 'editFoundedYear', 'editDescription', 'editWebsite'].forEach(idKey => {
                    clearFieldError(idKey, idKey + 'Error');
                });
                const genErr = document.getElementById('editBrandGeneralError');
                if (genErr) genErr.classList.add('hidden');

                document.getElementById('editBrandForm').action = '/admin/brands/' + id + '/edit?status=' + statusParam + '&search=' + searchParam + '&page=' + pageParam + '&limit=' + limitParam;
                document.getElementById('editName').value = name;
                document.getElementById('editOrigin').value = origin;
                document.getElementById('editFoundedYear').value = founded;
                document.getElementById('editDescription').value = description;
                document.getElementById('editWebsite').value = website;
                
                const editActiveBox = document.getElementById('editIsActive');
                if (editActiveBox) {
                    editActiveBox.checked = isActive;
                    updateModalToggleText('edit');
                }

                document.getElementById('editBrandModal').classList.remove('hidden');
            });
        });


        document.querySelectorAll('.delete-brand-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name || 'Maison';

                document.getElementById('deleteBrandForm').action = '/admin/brands/' + id + '/delete?status=' + statusParam + '&search=' + searchParam + '&page=' + pageParam + '&limit=' + limitParam;
                document.getElementById('deleteBrandName').textContent = name;
                document.getElementById('deleteBrandModal').classList.remove('hidden');
            });
        });

        if (typeof window.showAdminFlash === 'function') {
            window.showAdminFlash(
                <%- JSON.stringify(typeof success !== 'undefined' ? success : null) %>,
                <%- JSON.stringify(typeof error !== 'undefined' ? error : null) %>
            );
        }
    });

    function changeLimit(limit) {
        const url = new URL(window.location.href);
        url.searchParams.set('limit', limit);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }
</script>

<%- include('../partials/footer') %>
