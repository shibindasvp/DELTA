<% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-6 bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-lg text-sm flex items-center justify-between animate-fadeIn">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span><%= success %></span>
        </div>
    </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 bg-rose-950/60 border border-rose-500/30 text-rose-300 px-4 py-3 rounded-lg text-sm flex items-center justify-between animate-fadeIn">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-rose-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= error %></span>
        </div>
    </div>
<% } %>
