<header class="bg-white border-b border-zinc-200/80 px-8 py-3.5 flex items-center justify-between shadow-[0_1px_3px_rgba(0,0,0,0.02)]">
    <!-- Left: Page Title & Search Bar -->
    <div class="flex items-center gap-8">
        <h1 class="text-sm font-semibold text-zinc-900 tracking-wide uppercase font-serif">
            <%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : 'Dashboard' %>
        </h1>
        
        <div class="relative hidden sm:block w-72">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
            <input 
                type="text" 
                placeholder="Search orders, users..." 
                class="w-full pl-9 pr-4 py-1.5 bg-[#F4F4F5] border border-transparent focus:border-zinc-300 focus:bg-white rounded-full text-xs text-zinc-900 placeholder-zinc-400 focus:outline-none transition-all font-sans"
            >
        </div>
    </div>

    <!-- Right: Notification Bell & Admin Profile -->
    <div class="flex items-center gap-5">
        <!-- Notification Bell -->
        <button type="button" class="relative text-zinc-500 hover:text-zinc-900 transition-colors p-1 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
            <span class="absolute top-0.5 right-0.5 w-2 h-2 bg-emerald-600 rounded-full"></span>
        </button>

        <!-- Admin Profile -->
        <div class="flex items-center gap-3 pl-3 border-l border-zinc-200">
            <div class="text-right hidden sm:block">
                <p class="text-xs font-semibold text-zinc-900 leading-tight">Admin</p>
                <p class="text-[10px] text-emerald-600 font-medium flex items-center justify-end gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    <span>Online</span>
                </p>
            </div>
            <div class="w-8 h-8 rounded-full bg-[#0A4D2E] text-white flex items-center justify-center text-xs font-serif font-bold shadow-sm">
                A
            </div>
        </div>
    </div>
</header>



