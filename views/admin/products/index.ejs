<%- include('../partials/header', { title: 'Timepiece Vault & Inventory — DELTA Maison' }) %>

<%
    const safeBrandId = (typeof brandId !== 'undefined' && brandId) ? brandId : ((typeof selectedBrand !== 'undefined' && selectedBrand) ? selectedBrand : '');
    const safeSearch = (typeof search !== 'undefined' && search) ? search : '';
    const safeStatus = (typeof status !== 'undefined' && status) ? status : '';
    const safeStats = (typeof stats !== 'undefined' && stats) ? stats : { totalProducts: 0, activeProducts: 0, outOfStockProducts: 0, deletedProducts: 0 };
    const safeProducts = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];
    const safeBrands = (typeof brands !== 'undefined' && Array.isArray(brands)) ? brands : [];
    const safePagination = (typeof pagination !== 'undefined' && pagination) ? pagination : { currentPage: 1, totalPages: 1, totalItems: safeProducts.length, pageLimit: 10, startItem: 1, hasNextPage: false, hasPrevPage: false, pageNumbers: [1] };
%>

<div class="flex min-h-screen bg-[#faf8f7] text-[#1b1c1c] font-sans antialiased">
    <!-- Admin Sidebar -->
    <%- include('../partials/sidebar', { activePage: 'products' }) %>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Top Admin Header -->
        <header class="h-20 bg-white border-b border-zinc-200/80 px-8 flex items-center justify-between sticky top-0 z-20 shadow-[0_2px_15px_rgba(0,0,0,0.02)]">
            <div class="flex items-center gap-4">
                <span class="text-xs uppercase tracking-[0.25em] text-[#0A4D2E] font-bold">Maison Catalog</span>
                <span class="text-zinc-300">/</span>
                <h1 class="text-lg font-serif font-normal text-zinc-900">Timepiece Vault & Inventory</h1>
            </div>

            <div class="flex items-center gap-3">
                <a
                    href="/admin/products/add"
                    class="bg-[#0A4D2E] hover:bg-[#083e25] text-white px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold transition-all shadow-sm flex items-center gap-2"
                >
                    <span>+ Add New Timepiece</span>
                </a>
            </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-1 p-8 max-w-7xl w-full mx-auto space-y-6">
            
            <!-- Flash Message Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span><%= success %></span>
                    </div>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= error %></span>
                    </div>
                </div>
            <% } %>

            <!-- Interactive KPI / Metric Filter Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <a 
                    href="/admin/products?status=<%= safeStatus === '' ? '' : '' %>"
                    class="bg-white border <%= safeStatus === '' ? 'border-zinc-900 ring-2 ring-zinc-900/10' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer"
                >
                    <span class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold block mb-1">TOTAL TIMEPIECES</span>
                    <span class="text-2xl font-serif text-zinc-900 font-normal"><%= safeStats.totalProducts || 0 %></span>
                </a>

                <a 
                    href="/admin/products?status=active"
                    class="bg-white border <%= safeStatus === 'active' ? 'border-[#0A4D2E] ring-2 ring-[#0A4D2E]/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer"
                >
                    <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-semibold block mb-1">ACTIVE IN VAULT</span>
                    <span class="text-2xl font-serif text-emerald-700 font-normal"><%= safeStats.activeProducts || 0 %></span>
                </a>

                <a 
                    href="/admin/products?status=outOfStock"
                    class="bg-white border <%= safeStatus === 'outOfStock' ? 'border-amber-600 ring-2 ring-amber-600/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer"
                >
                    <span class="text-[10px] uppercase tracking-[0.2em] text-amber-600 font-semibold block mb-1">OUT OF STOCK</span>
                    <span class="text-2xl font-serif text-amber-700 font-normal"><%= safeStats.outOfStockProducts || 0 %></span>
                </a>

                <a 
                    href="/admin/products?status=archived"
                    class="bg-white border <%= safeStatus === 'archived' ? 'border-rose-600 ring-2 ring-rose-600/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer group"
                >
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] uppercase tracking-[0.2em] text-rose-600 font-semibold block">ARCHIVED (SOFT)</span>
                        <span class="text-[9px] uppercase font-mono bg-rose-50 text-rose-700 px-1.5 py-0.5 rounded border border-rose-200">Retrieve ↺</span>
                    </div>
                    <span class="text-2xl font-serif text-rose-700 font-normal"><%= safeStats.deletedProducts || 0 %></span>
                </a>
            </div>

            <!-- Table Container -->
            <div class="bg-white border border-zinc-200/80 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                
                <!-- Table Search & Status/Brand Filter Header -->
                <div class="p-6 border-b border-zinc-100 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="text-base font-serif text-zinc-900">
                                <%= safeStatus === 'archived' ? 'Archived Timepieces Registry' : 'Timepiece Vault Registry' %>
                            </h2>
                            <% if (safeStatus === 'archived') { %>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-rose-100 text-rose-800 border border-rose-200">
                                    Archive View
                                </span>
                            <% } %>
                        </div>
                        <p class="text-xs text-zinc-500 font-light mt-0.5">
                            <%= safeStatus === 'archived' ? 'Inspect and restore soft-deleted timepieces back into the active catalog.' : 'Filter timepieces by Manufacture Maison or search by model and variant attributes.' %>
                        </p>
                    </div>

                    <!-- Search & Filter Form with Clear/Cancel Button -->
                    <form action="/admin/products" method="GET" class="flex flex-wrap items-center gap-3">
                        <input type="hidden" name="page" value="1">
                        <input type="hidden" name="limit" value="<%= safePagination.pageLimit %>">
                        
                        <!-- Status Filter Dropdown -->
                        <select
                            name="status"
                            onchange="this.form.submit()"
                            class="bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                        >
                            <option value="" <%= safeStatus === '' ? 'selected' : '' %>>All Active Timepieces</option>
                            <option value="active" <%= safeStatus === 'active' ? 'selected' : '' %>>Active Listed in Vault</option>
                            <option value="outOfStock" <%= safeStatus === 'outOfStock' ? 'selected' : '' %>>Out of Stock</option>
                            <option value="archived" <%= safeStatus === 'archived' ? 'selected' : '' %>>Archived / Soft-Deleted</option>
                        </select>

                        <!-- Brand Dropdown Filter -->
                        <select
                            name="brand"
                            onchange="this.form.submit()"
                            class="bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                        >
                            <option value="">All Manufacture Maisons</option>
                            <% if (safeBrands && safeBrands.length > 0) { %>
                                <% safeBrands.forEach(b => { %>
                                    <option value="<%= b._id %>" <%= (safeBrandId && (safeBrandId === b._id.toString() || safeBrandId === b.slug)) ? 'selected' : '' %>>
                                        <%= b.name %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>

                        <!-- Search Bar with (✕) Clear Button -->
                        <div class="relative w-60">
                            <input
                                type="text"
                                name="search"
                                value="<%= safeSearch || '' %>"
                                placeholder="Search model, dial, ref..."
                                class="w-full pl-9 pr-8 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-[#0A4D2E] focus:bg-white transition-colors"
                            >
                            <svg class="w-4 h-4 text-zinc-400 absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            
                            <% if (safeSearch || safeBrandId || safeStatus) { %>
                                <a
                                    href="/admin/products?page=1&limit=<%= safePagination.pageLimit %>"
                                    title="Reset All Filters"
                                    class="absolute right-2.5 top-2.5 text-zinc-400 hover:text-zinc-700 bg-zinc-200 hover:bg-zinc-300 w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold transition-colors"
                                >
                                    ✕
                                </a>
                            <% } %>
                        </div>

                        <button
                            type="submit"
                            class="bg-zinc-900 hover:bg-black text-white px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm cursor-pointer"
                        >
                            Filter
                        </button>
                    </form>
                </div>

                <!-- Table Content -->
                <div class="overflow-x-auto min-h-[350px]">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-zinc-100 bg-zinc-50/70 text-[10px] uppercase font-mono tracking-wider text-zinc-500 select-none">
                                <th class="py-3.5 px-6 font-semibold w-12">#</th>
                                <th class="py-3.5 px-6 font-semibold">Reference No.</th>
                                <th class="py-3.5 px-6 font-semibold">Timepiece Model</th>
                                <th class="py-3.5 px-6 font-semibold">Manufacture Maison</th>
                                <th class="py-3.5 px-6 font-semibold min-w-[240px]">Variants & Editions</th>
                                <th class="py-3.5 px-6 font-semibold">Valuation</th>
                                <th class="py-3.5 px-6 font-semibold text-center">Vault Stock</th>
                                <th class="py-3.5 px-6 font-semibold text-center">Status</th>
                                <th class="py-3.5 px-6 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 text-zinc-700">
                            <% if (safeProducts.length > 0) { %>
                                <% safeProducts.forEach((p, index) => { %>
                                    <tr class="<%= p.isDeleted ? 'bg-rose-50/30 hover:bg-rose-50/50' : 'hover:bg-zinc-50/80' %> transition-colors">
                                        
                                        <!-- Index -->
                                        <td class="py-4 px-6 font-mono text-zinc-400">
                                            <%= safePagination.startItem + index %>
                                        </td>

                                        <!-- Reference Number (Dedicated Column) -->
                                        <td class="py-4 px-6 font-mono">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold font-mono bg-zinc-900 text-white shadow-sm border border-zinc-800">
                                                <span class="text-emerald-400 font-bold">#</span>
                                                <span><%= p.modelNumber || ('REF-DLT-' + (p._id.toString().substring(18, 24).toUpperCase())) %></span>
                                            </span>
                                        </td>

                                        <!-- Thumbnail + Title -->
                                        <td class="py-4 px-6">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-xl bg-zinc-100 border border-zinc-200 overflow-hidden flex-shrink-0 shadow-sm flex items-center justify-center">
                                                    <% if (p.images && p.images.length > 0) { %>
                                                        <img src="<%= p.images[0] %>" alt="<%= p.name %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <span class="text-xs text-zinc-400">⏱</span>
                                                    <% } %>
                                                </div>
                                                <div class="max-w-xs">
                                                    <span class="font-medium text-zinc-900 block text-xs leading-snug"><%= p.name %></span>
                                                    <span class="text-[10px] text-zinc-400 font-mono"><%= p.images ? p.images.length + ' Photos' : '' %></span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Brand / Maison -->
                                        <td class="py-4 px-6">
                                            <div class="flex items-center gap-2">
                                                <span class="w-5 h-5 rounded-md bg-emerald-50 text-[#0A4D2E] text-[10px] font-serif font-bold flex items-center justify-center border border-emerald-200/50">
                                                    <%= (p.brand && p.brand.name ? p.brand.name.charAt(0) : (p.brandName ? p.brandName.charAt(0) : 'D')).toUpperCase() %>
                                                </span>
                                                <span class="font-medium text-zinc-900 text-xs">
                                                    <%= p.brand && p.brand.name ? p.brand.name : (p.brandName || 'DELTA Manufacture') %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Variants (Color, Material, Dial) -->
                                        <td class="py-4 px-6">
                                            <% if (p.variants && p.variants.length > 0) { %>
                                                <div class="flex flex-col gap-2 max-w-sm">
                                                    <div class="flex flex-wrap items-center gap-1.5">
                                                        <% p.variants.forEach((v, vIdx) => { %>
                                                            <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-white text-zinc-900 border border-zinc-200 shadow-2xs">
                                                                <span class="w-3 h-3 rounded-full border border-black/20 flex-shrink-0" style="background-color:<%= (v.colorCode && v.colorCode.trim()) ? v.colorCode : '#1b1c1c' %>"></span>
                                                                <span class="font-semibold"><%= v.color %></span>
                                                                <% if (v.stock !== undefined) { %>
                                                                    <span class="text-[10px] font-mono text-zinc-400 font-normal">• <%= v.stock %> in vault</span>
                                                                <% } %>
                                                            </div>
                                                        <% }) %>
                                                    </div>
                                                    <% if (p.variants[0] && (p.variants[0].material || p.variants[0].dial)) { %>
                                                        <div class="text-[10px] text-zinc-500 font-mono leading-tight">
                                                            <span class="text-zinc-400">Specs:</span> <%= p.variants[0].material || '' %><%= (p.variants[0].material && p.variants[0].dial) ? ' | ' : '' %><%= p.variants[0].dial || '' %>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-[11px] text-zinc-400 font-light italic">Standard Signature Edition</span>
                                            <% } %>
                                        </td>

                                        <!-- Price / Discount Price -->
                                        <td class="py-4 px-6 font-mono">
                                            <% if (p.discountPrice && p.discountPrice < p.price) { %>
                                                <div class="flex flex-col">
                                                    <span class="text-emerald-700 font-bold text-xs">₹<%= Number(p.discountPrice || 0).toLocaleString("en-IN") %></span>
                                                    <span class="text-[10px] text-zinc-400 line-through">₹<%= Number(p.price || 0).toLocaleString("en-IN") %></span>
                                                </div>
                                            <% } else { %>
                                                <span class="text-zinc-900 font-semibold text-xs">₹<%= Number(p.price || 0).toLocaleString("en-IN") %></span>
                                            <% } %>
                                        </td>

                                        <!-- Stock Quantity -->
                                        <td class="py-4 px-6 text-center">
                                            <% if (p.stock <= 0) { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                                    0 Units (Sold Out)
                                                </span>
                                            <% } else if (p.stock <= 3) { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                                    <%= p.stock %> Units (Low)
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-800">
                                                    <%= p.stock %> In Vault
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Status Badge -->
                                        <td class="py-4 px-6 text-center">
                                            <% if (p.isDeleted) { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider font-semibold bg-rose-100 text-rose-800 border border-rose-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                                                    <span>Archived</span>
                                                </span>
                                            <% } else { %>
                                                <form action="/admin/products/<%= p._id %>/toggle-status?search=<%= encodeURIComponent(safeSearch) %>&brand=<%= safeBrandId %>&status=<%= safeStatus %>&page=<%= safePagination.currentPage %>&limit=<%= safePagination.pageLimit %>" method="POST" class="inline">
                                                    <button
                                                        type="submit"
                                                        title="Click to toggle status"
                                                        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] uppercase tracking-wider font-semibold transition-transform hover:scale-105 cursor-pointer <%= p.isActive ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-zinc-100 text-zinc-500 border border-zinc-200' %>"
                                                    >
                                                        <span class="w-1.5 h-1.5 rounded-full <%= p.isActive ? 'bg-emerald-600 animate-pulse' : 'bg-zinc-400' %>"></span>
                                                        <span><%= p.isActive ? 'Listed' : 'Unlisted' %></span>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </td>

                                        <!-- Action Buttons -->
                                        <td class="py-4 px-6 text-right space-x-2">
                                            <% if (p.isDeleted) { %>
                                                <!-- Restore / Retrieve Button -->
                                                <button
                                                    type="button"
                                                    class="restore-product-btn px-3 py-1.5 bg-emerald-50 hover:bg-[#0A4D2E] hover:text-white text-[#0A4D2E] border border-emerald-300 rounded-lg text-[11px] font-semibold transition-colors cursor-pointer shadow-2xs"
                                                    data-id="<%= p._id %>"
                                                    data-name="<%= p.name %>"
                                                >
                                                    ↺ Restore
                                                </button>
                                            <% } else { %>
                                                <!-- Edit Button -->
                                                <a
                                                    href="/admin/products/<%= p._id %>/edit"
                                                    class="inline-block px-3 py-1.5 bg-zinc-100 hover:bg-zinc-900 hover:text-white text-zinc-700 rounded-lg text-[11px] font-medium transition-colors"
                                                >
                                                    Edit
                                                </a>

                                                <!-- Soft Delete Button -->
                                                <button
                                                    type="button"
                                                    class="delete-product-btn px-3 py-1.5 bg-rose-50 hover:bg-rose-600 hover:text-white text-rose-700 rounded-lg text-[11px] font-medium transition-colors cursor-pointer border border-rose-200 hover:border-rose-600"
                                                    data-id="<%= p._id %>" 
                                                    data-name="<%= p.name %>"
                                                >
                                                    Delete
                                                </button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="9" class="py-16 text-center text-zinc-500 space-y-3">
                                        <div class="w-12 h-12 rounded-2xl bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-xl">
                                            ⏱
                                        </div>
                                        <div class="text-sm font-medium text-zinc-800">
                                            <%= safeStatus === 'archived' ? 'No soft-deleted timepieces in archive' : 'No timepieces found' %>
                                        </div>
                                        <div class="text-xs text-zinc-400 max-w-sm mx-auto font-light">
                                            <% if (safeSearch || safeBrandId || safeStatus) { %>
                                                No timepieces matched your search criteria. Try clearing filters.
                                            <% } else { %>
                                                Your vault inventory is currently empty. Click "Add New Timepiece" to begin cataloging.
                                            <% } %>
                                        </div>
                                        <% if (safeSearch || safeBrandId || safeStatus) { %>
                                            <a href="/admin/products" class="inline-block mt-2 px-4 py-2 border border-zinc-300 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 transition-colors">Clear All Filters</a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Table Footer with Pagination Controls -->
                <div class="p-6 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs select-none">
                    
                    <!-- Per Page Limit Selector & Record Counter -->
                    <div class="flex items-center gap-3">
                        <span class="text-zinc-500 font-light">
                            Showing <span class="font-mono font-medium text-zinc-900"><%= safePagination.totalItems === 0 ? 0 : safePagination.startItem %></span> to 
                            <span class="font-mono font-medium text-zinc-900"><%= Math.min(safePagination.startItem + safeProducts.length - 1, safePagination.totalItems) %></span> of 
                            <span class="font-mono font-medium text-zinc-900"><%= safePagination.totalItems %></span> timepieces
                        </span>

                        <div class="flex items-center gap-1.5 ml-2 border-l border-zinc-200 pl-4">
                            <span class="text-[10px] uppercase font-mono text-zinc-400">Rows:</span>
                            <select
                                onchange="changeLimit(this.value)"
                                class="bg-zinc-50 border border-zinc-200 text-zinc-800 text-xs rounded-lg px-2 py-1 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                            >
                                <option value="10" <%= safePagination.pageLimit === 10 ? 'selected' : '' %>>10</option>
                                <option value="20" <%= safePagination.pageLimit === 20 ? 'selected' : '' %>>20</option>
                                <option value="50" <%= safePagination.pageLimit === 50 ? 'selected' : '' %>>50</option>
                            </select>
                        </div>
                    </div>

                    <!-- Pagination Links -->
                    <div class="flex items-center gap-1.5">
                        
                        <!-- First Page Jump -->
                        <% if (safePagination.currentPage > 1) { %>
                            <a
                                href="/admin/products?page=1&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStatus ? '&status=' + encodeURIComponent(safeStatus) : '' %>"
                                title="First Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                «
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                «
                            </span>
                        <% } %>

                        <!-- Prev -->
                        <% if (safePagination.hasPrevPage) { %>
                            <a
                                href="/admin/products?page=<%= safePagination.prevPage %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStatus ? '&status=' + encodeURIComponent(safeStatus) : '' %>"
                                title="Previous Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                ‹
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                ‹
                            </span>
                        <% } %>

                        <!-- Numbered Page Pills -->
                        <% if (safePagination.pageNumbers && safePagination.pageNumbers.length > 0) { %>
                            <% safePagination.pageNumbers.forEach(p => { %>
                                <% if (p === '...') { %>
                                    <span class="w-8 h-8 flex items-center justify-center text-zinc-400 font-mono text-xs">...</span>
                                <% } else if (p === safePagination.currentPage) { %>
                                    <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow">
                                        <%= p %>
                                    </span>
                                <% } else { %>
                                    <a
                                        href="/admin/products?page=<%= p %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStatus ? '&status=' + encodeURIComponent(safeStatus) : '' %>"
                                        class="w-8 h-8 rounded-lg flex items-center justify-center border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 hover:border-zinc-900 text-xs font-mono font-medium transition-colors shadow-sm"
                                    >
                                        <%= p %>
                                    </a>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow">
                                1
                            </span>
                        <% } %>

                        <!-- Next -->
                        <% if (safePagination.hasNextPage) { %>
                            <a
                                href="/admin/products?page=<%= safePagination.nextPage %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStatus ? '&status=' + encodeURIComponent(safeStatus) : '' %>"
                                title="Next Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                ›
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                ›
                            </span>
                        <% } %>

                        <!-- Last Page Jump -->
                        <% if (safePagination.currentPage < safePagination.totalPages) { %>
                            <a
                                href="/admin/products?page=<%= safePagination.totalPages %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStatus ? '&status=' + encodeURIComponent(safeStatus) : '' %>"
                                title="Last Page (<%= safePagination.totalPages %>)"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                »
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                »
                            </span>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>

        <!-- Admin Footer -->
        <%- include('../partials/footer') %>
    </div>
</div>

<!-- Delete Product Confirmation Modal (Soft Delete) -->
<div id="deleteProductModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-zinc-200 rounded-3xl max-w-md w-full p-8 text-center shadow-2xl animate-fade-in">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center text-xl mx-auto mb-4 font-bold">
            ✕
        </div>
        <h3 class="text-lg font-serif text-zinc-900 mb-2">Archive Timepiece</h3>
        <p id="deleteProductPrompt" class="text-xs text-zinc-500 font-light mb-6">
            Are you sure you want to soft-delete this timepiece? It will be archived and hidden from public sales.
        </p>

        <form id="deleteProductForm" method="POST" class="flex gap-3 justify-center">
            <button
                type="button"
                onclick="closeDeleteProductModal()"
                class="px-5 py-2.5 border border-zinc-300 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 transition-colors font-medium cursor-pointer"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-6 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors shadow cursor-pointer"
            >
                Confirm Delete
            </button>
        </form>
    </div>
</div>

<!-- Restore / Retrieve Product Confirmation Modal -->
<div id="restoreProductModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-zinc-200 rounded-3xl max-w-md w-full p-8 text-center shadow-2xl animate-fade-in">
        <div class="w-12 h-12 rounded-full bg-emerald-100 text-[#0A4D2E] flex items-center justify-center text-xl mx-auto mb-4 font-bold">
            ↺
        </div>
        <h3 class="text-lg font-serif text-zinc-900 mb-2">Restore Timepiece to Vault</h3>
        <p id="restoreProductPrompt" class="text-xs text-zinc-500 font-light mb-6">
            Are you sure you want to retrieve and restore this timepiece back to active catalog registry?
        </p>

        <form id="restoreProductForm" method="POST" class="flex gap-3 justify-center">
            <button
                type="button"
                onclick="closeRestoreProductModal()"
                class="px-5 py-2.5 border border-zinc-300 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 transition-colors font-medium cursor-pointer"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-6 py-2.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors shadow cursor-pointer"
            >
                Confirm Restore
            </button>
        </form>
    </div>
</div>

<script>
    function changeLimit(newLimit) {
        const search = '<%= encodeURIComponent(safeSearch || "") %>';
        const brandId = '<%= encodeURIComponent(safeBrandId || "") %>';
        const status = '<%= encodeURIComponent(safeStatus || "") %>';
        window.location.href = '/admin/products?page=1&limit=' + newLimit + (search ? '&search=' + search : '') + (brandId ? '&brand=' + brandId : '') + (status ? '&status=' + status : '');
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.delete-product-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                openDeleteProductModal(btn.dataset.id, btn.dataset.name);
            });
        });

        document.querySelectorAll('.restore-product-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                openRestoreProductModal(btn.dataset.id, btn.dataset.name);
            });
        });

        if (typeof window.showAdminFlash === 'function') {
            window.showAdminFlash(
                <%- JSON.stringify(typeof success !== 'undefined' ? success : null) %>,
                <%- JSON.stringify(typeof error !== 'undefined' ? error : null) %>
            );
        }
    });

    function openDeleteProductModal(id, name) {
        const search = '<%= encodeURIComponent(safeSearch || "") %>';
        const brandId = '<%= encodeURIComponent(safeBrandId || "") %>';
        const status = '<%= encodeURIComponent(safeStatus || "") %>';
        const page = '<%= safePagination.currentPage %>';
        const limit = '<%= safePagination.pageLimit %>';

        document.getElementById('deleteProductForm').action = '/admin/products/' + id + '/delete?search=' + search + '&brand=' + brandId + '&status=' + status + '&page=' + page + '&limit=' + limit;
        document.getElementById('deleteProductPrompt').textContent = 'Are you sure you want to soft-delete "' + name + '"? It will be archived and hidden from public sales.';
        document.getElementById('deleteProductModal').classList.remove('hidden');
    }

    function closeDeleteProductModal() {
        document.getElementById('deleteProductModal').classList.add('hidden');
    }

    function openRestoreProductModal(id, name) {
        const search = '<%= encodeURIComponent(safeSearch || "") %>';
        const brandId = '<%= encodeURIComponent(safeBrandId || "") %>';
        const status = '<%= encodeURIComponent(safeStatus || "") %>';
        const page = '<%= safePagination.currentPage %>';
        const limit = '<%= safePagination.pageLimit %>';

        document.getElementById('restoreProductForm').action = '/admin/products/' + id + '/restore?search=' + search + '&brand=' + brandId + '&status=' + status + '&page=' + page + '&limit=' + limit;
        document.getElementById('restoreProductPrompt').textContent = 'Are you sure you want to restore "' + name + '" back into the active catalog vault?';
        document.getElementById('restoreProductModal').classList.remove('hidden');
    }

    function closeRestoreProductModal() {
        document.getElementById('restoreProductModal').classList.add('hidden');
    }
</script>
