<script>
    // Copy code to clipboard
    function copyCode(code) {
        navigator.clipboard.writeText(code).then(() => {
            alert('Coupon code "' + code + '" copied to clipboard.');
        }).catch(() => {});
    }

    // Toggle discount type input labels and radio card styles
    function selectCouponDiscountType(prefix, discountType, options = {}) {
        const normalizedType = discountType === 'fixed' ? 'fixed' : 'percentage';
        const typeInput = document.getElementById(prefix + 'DiscountType');
        if (typeInput) {
            typeInput.value = normalizedType;
        }

        const btnPercentage = document.getElementById(prefix + 'DiscountTypeBtnPercentage');
        const btnFixed = document.getElementById(prefix + 'DiscountTypeBtnFixed');
        const activeClasses = ['border-[#0A4D2E]', 'bg-[#0A4D2E]/10', 'text-[#0A4D2E]', 'shadow-2xs'];
        const inactiveClasses = ['border-zinc-200', 'bg-zinc-50', 'text-zinc-600', 'hover:bg-zinc-100'];

        [
            [btnPercentage, normalizedType === 'percentage'],
            [btnFixed, normalizedType === 'fixed']
        ].forEach(([btn, isSelected]) => {
            if (!btn) return;
            btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
            activeClasses.forEach(cls => btn.classList.toggle(cls, isSelected));
            inactiveClasses.forEach(cls => btn.classList.toggle(cls, !isSelected));
        });

        toggleDiscountTypeLabels(prefix);

        if (!options.skipValidate) {
            const valInput = document.getElementById(prefix + 'DiscountValue');
            if (valInput && valInput.value.trim() !== '') {
                validateCouponField(prefix, 'discountValue');
            } else {
                setFieldValidationUI(prefix, 'discountValue', null);
            }
            validateCouponField(prefix, 'maxDiscountAmount');
        }
    }

    function toggleDiscountTypeLabels(prefix) {
        const typeSelect = document.getElementById(prefix + 'DiscountType');
        const valueLabel = document.getElementById(prefix + 'ValueLabel');
        const maxCapGroup = document.getElementById(prefix + 'MaxCapGroup');
        const valInput = document.getElementById(prefix + 'DiscountValue');

        if (typeSelect && valueLabel) {
            if (typeSelect.value === 'percentage') {
                valueLabel.innerHTML = 'Discount Percentage (%) <span class="text-rose-500">*</span>';
                if (maxCapGroup) maxCapGroup.classList.remove('hidden');
                if (valInput) { valInput.max = "79"; valInput.placeholder = "e.g. 15"; }
            } else {
                valueLabel.innerHTML = 'Discount Amount (₹ INR) <span class="text-rose-500">*</span>';
                if (maxCapGroup) maxCapGroup.classList.add('hidden');
                if (valInput) { valInput.removeAttribute('max'); valInput.placeholder = "e.g. 5000"; }
                setFieldValidationUI(prefix, 'maxDiscountAmount', null);
            }
        }
    }

    // ==========================================
    // JS Form Validation Engine for Coupons
    // ==========================================

    function getTodayDateString() {
        const d = new Date();
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function setFieldValidationUI(prefix, fieldName, errorMsg) {
        const inputId = prefix + fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
        const errId = inputId + 'Error';
        const input = document.getElementById(inputId);
        const errElem = document.getElementById(errId);

        if (errorMsg) {
            if (input) {
                input.classList.remove('border-zinc-200', 'bg-zinc-50', 'focus:border-[#0A4D2E]');
                input.classList.add('border-rose-400', 'bg-rose-50/40', 'focus:border-rose-500');
            }
            if (errElem) {
                errElem.textContent = errorMsg;
                errElem.classList.remove('hidden');
            }
            return false;
        } else {
            if (input) {
                input.classList.remove('border-rose-400', 'bg-rose-50/40', 'focus:border-rose-500');
                input.classList.add('border-zinc-200', 'bg-zinc-50', 'focus:border-[#0A4D2E]');
            }
            if (errElem) {
                errElem.textContent = '';
                errElem.classList.add('hidden');
            }
            return true;
        }
    }

    function clearAllCouponValidationUI(prefix) {
        const fields = ['code', 'discountValue', 'maxDiscountAmount', 'minPurchaseAmount', 'usageLimit', 'expiryDate', 'description'];
        fields.forEach(f => setFieldValidationUI(prefix, f, null));
        const genErr = document.getElementById(prefix + 'CouponError');
        if (genErr) {
            genErr.textContent = '';
            genErr.classList.add('hidden');
        }
    }

    function validateCouponField(prefix, fieldName) {
        const typeSelect = document.getElementById(prefix + 'DiscountType');
        const discountType = typeSelect ? typeSelect.value : 'percentage';

        if (fieldName === 'code') {
            const input = document.getElementById(prefix + 'Code');
            const val = input ? input.value.trim().toUpperCase() : '';
            if (!val) {
                return setFieldValidationUI(prefix, 'code', 'Coupon code is mandatory.');
            }
            if (val.length < 3) {
                return setFieldValidationUI(prefix, 'code', 'Coupon code must be at least 3 characters.');
            }
            if (val.length > 20) {
                return setFieldValidationUI(prefix, 'code', 'Coupon code cannot exceed 20 characters.');
            }
            if (!/^[A-Z0-9_-]+$/.test(val)) {
                return setFieldValidationUI(prefix, 'code', 'Only uppercase letters, numbers, hyphens (-), and underscores (_) allowed.');
            }
            return setFieldValidationUI(prefix, 'code', null);
        }

        if (fieldName === 'discountValue') {
            const input = document.getElementById(prefix + 'DiscountValue');
            const raw = input ? input.value.trim() : '';
            if (raw === '') {
                return setFieldValidationUI(prefix, 'discountValue', 'Discount value is mandatory.');
            }
            const val = Number(raw);
            if (isNaN(val) || val <= 0) {
                return setFieldValidationUI(prefix, 'discountValue', 'Discount value must be a positive number greater than 0.');
            }
            if (discountType === 'percentage') {
                if (val < 1) {
                    return setFieldValidationUI(prefix, 'discountValue', 'Percentage discount must be at least 1%.');
                }
                if (val >= 80) {
                    return setFieldValidationUI(prefix, 'discountValue', 'Percentage discount must be less than 80% (cannot be 80% or greater).');
                }
            } else {
                if (val <= 0) {
                    return setFieldValidationUI(prefix, 'discountValue', 'Fixed discount amount must be greater than zero.');
                }
            }
            return setFieldValidationUI(prefix, 'discountValue', null);
        }

        if (fieldName === 'maxDiscountAmount') {
            if (discountType === 'fixed') {
                return setFieldValidationUI(prefix, 'maxDiscountAmount', null);
            }
            const input = document.getElementById(prefix + 'MaxDiscountAmount');
            const raw = input ? input.value.trim() : '';
            if (raw !== '') {
                const val = Number(raw);
                if (isNaN(val) || val <= 0) {
                    return setFieldValidationUI(prefix, 'maxDiscountAmount', 'Maximum discount cap must be greater than ₹0.');
                }
            }
            return setFieldValidationUI(prefix, 'maxDiscountAmount', null);
        }

        if (fieldName === 'minPurchaseAmount') {
            const input = document.getElementById(prefix + 'MinPurchaseAmount');
            const raw = input ? input.value.trim() : '';
            if (raw !== '') {
                const val = Number(raw);
                if (isNaN(val) || val < 0) {
                    return setFieldValidationUI(prefix, 'minPurchaseAmount', 'Minimum purchase amount cannot be negative.');
                }
            }
            return setFieldValidationUI(prefix, 'minPurchaseAmount', null);
        }

        if (fieldName === 'usageLimit') {
            const input = document.getElementById(prefix + 'UsageLimit');
            const raw = input ? input.value.trim() : '';
            if (raw === '') {
                return setFieldValidationUI(prefix, 'usageLimit', 'Total usage limit is mandatory.');
            }
            const val = Number(raw);
            if (isNaN(val) || val < 1 || !Number.isInteger(val)) {
                return setFieldValidationUI(prefix, 'usageLimit', 'Usage limit must be a positive whole number (at least 1 redemption).');
            }
            return setFieldValidationUI(prefix, 'usageLimit', null);
        }

        if (fieldName === 'expiryDate') {
            const input = document.getElementById(prefix + 'ExpiryDate');
            const val = input ? input.value : '';
            if (!val) {
                return setFieldValidationUI(prefix, 'expiryDate', 'Expiry date is mandatory.');
            }
            const todayStr = getTodayDateString();
            if (val < todayStr) {
                return setFieldValidationUI(prefix, 'expiryDate', 'Expiry date must be set to today or a future date.');
            }
            return setFieldValidationUI(prefix, 'expiryDate', null);
        }

        if (fieldName === 'description') {
            const input = document.getElementById(prefix + 'Description');
            const raw = input ? input.value.trim() : '';
            if (raw && raw.length > 250) {
                return setFieldValidationUI(prefix, 'description', 'Description cannot exceed 250 characters.');
            }
            return setFieldValidationUI(prefix, 'description', null);
        }

        return true;
    }

    function validateCouponForm(prefix) {
        const fields = ['code', 'discountValue', 'maxDiscountAmount', 'minPurchaseAmount', 'usageLimit', 'expiryDate', 'description'];
        let isValid = true;
        let firstInvalidInput = null;

        for (const f of fields) {
            const fieldValid = validateCouponField(prefix, f);
            if (!fieldValid) {
                isValid = false;
                const inputId = prefix + f.charAt(0).toUpperCase() + f.slice(1);
                const input = document.getElementById(inputId);
                if (!firstInvalidInput && input && input.offsetParent !== null) {
                    firstInvalidInput = input;
                }
            }
        }

        const genErr = document.getElementById(prefix + 'CouponError');
        if (!isValid) {
            if (genErr) {
                genErr.textContent = 'Please correct the highlighted validation issues before proceeding.';
                genErr.classList.remove('hidden');
            }
            if (firstInvalidInput) {
                firstInvalidInput.focus();
            }
        } else {
            if (genErr) {
                genErr.textContent = '';
                genErr.classList.add('hidden');
            }
        }

        return isValid;
    }

    function initCouponFormValidation() {
        ['create', 'edit'].forEach(prefix => {
            const fields = ['code', 'discountValue', 'maxDiscountAmount', 'minPurchaseAmount', 'usageLimit', 'expiryDate', 'description'];
            fields.forEach(f => {
                const inputId = prefix + f.charAt(0).toUpperCase() + f.slice(1);
                const input = document.getElementById(inputId);
                if (input) {
                    input.addEventListener('input', () => validateCouponField(prefix, f));
                    input.addEventListener('blur', () => validateCouponField(prefix, f));
                    if (f === 'expiryDate') {
                        input.addEventListener('change', () => validateCouponField(prefix, f));
                    }
                }
            });

            const typeSelect = document.getElementById(prefix + 'DiscountType');
            if (typeSelect) {
                typeSelect.addEventListener('change', () => {
                    selectCouponDiscountType(prefix, typeSelect.value);
                });
            }
        });
    }

    // Create Modal handlers
    function openCreateCouponModal() {
        const modal = document.getElementById('createCouponModal');
        clearAllCouponValidationUI('create');
        document.getElementById('createCouponForm').reset();
        
        // Default expiry date: 90 days from today
        const expInput = document.getElementById('createExpiryDate');
        if (expInput) {
            const d = new Date();
            d.setDate(d.getDate() + 90);
            expInput.value = d.toISOString().split('T')[0];
            expInput.min = getTodayDateString();
        }
        selectCouponDiscountType('create', 'percentage', { skipValidate: true });
        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }

    function closeCreateCouponModal() {
        const modal = document.getElementById('createCouponModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    async function submitCreateCoupon(e) {
        e.preventDefault();
        const genErr = document.getElementById('createCouponError');
        if (genErr) genErr.classList.add('hidden');

        // Client-side JS Form Validation
        const isValid = validateCouponForm('create');
        if (!isValid) {
            // Keep modal open, errors already displayed
            return;
        }

        const btn = document.getElementById('createSubmitBtn');
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Creating Coupon...';
        }

        const payload = {
            code: document.getElementById('createCode').value.trim().toUpperCase(),
            description: document.getElementById('createDescription').value.trim(),
            discountType: document.getElementById('createDiscountType').value,
            discountValue: Number(document.getElementById('createDiscountValue').value),
            minPurchaseAmount: Number(document.getElementById('createMinPurchaseAmount').value) || 0,
            maxDiscountAmount: (document.getElementById('createDiscountType').value === 'percentage' && document.getElementById('createMaxDiscountAmount').value) 
                ? Number(document.getElementById('createMaxDiscountAmount').value) 
                : null,
            expiryDate: document.getElementById('createExpiryDate').value,
            usageLimit: Number(document.getElementById('createUsageLimit').value) || 100,
            isActive: document.getElementById('createIsActive').checked
        };

        try {
            const res = await fetch('/admin/coupons', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                window.location.href = '/admin/coupons?success=created';
            } else {
                // Keep modal open on server validation failure!
                if (genErr) {
                    genErr.textContent = data.message || 'Failed to create coupon.';
                    genErr.classList.remove('hidden');
                }
                if (data.message && data.message.toLowerCase().includes('already exists')) {
                    setFieldValidationUI('create', 'code', data.message);
                    document.getElementById('createCode')?.focus();
                }
            }
        } catch (e) {
            if (genErr) {
                genErr.textContent = 'Network communication error submitting coupon. Please try again.';
                genErr.classList.remove('hidden');
            }
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Create Coupon';
            }
        }
    }

    // Edit Modal handlers
    async function openEditCouponModal(id) {
        const modal = document.getElementById('editCouponModal');
        clearAllCouponValidationUI('edit');

        try {
            const res = await fetch('/admin/coupons/' + id, {
                headers: { 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (!data.success || !data.coupon) {
                alert('Could not fetch coupon details.');
                return;
            }

            const c = data.coupon;
            document.getElementById('editCouponId').value = c._id;
            document.getElementById('editCode').value = c.code;
            document.getElementById('editDescription').value = c.description || '';
            document.getElementById('editDiscountValue').value = c.discountValue;
            document.getElementById('editMinPurchaseAmount').value = c.minPurchaseAmount || 0;
            document.getElementById('editMaxDiscountAmount').value = c.maxDiscountAmount || '';
            document.getElementById('editUsageLimit').value = c.usageLimit || 100;
            document.getElementById('editIsActive').checked = Boolean(c.isActive);

            if (c.expiryDate) {
                const expInput = document.getElementById('editExpiryDate');
                expInput.value = new Date(c.expiryDate).toISOString().split('T')[0];
                expInput.min = getTodayDateString();
            }

            selectCouponDiscountType('edit', c.discountType, { skipValidate: true });
            if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
        } catch (e) {
            alert('Failed to load coupon data for editing.');
        }
    }

    function closeEditCouponModal() {
        const modal = document.getElementById('editCouponModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    async function submitEditCoupon(e) {
        e.preventDefault();
