<%- include('../partials/header', { title: 'Coupon Management — DELTA Maison' }) %>

<div class="flex min-h-screen bg-[#faf8f7] text-[#1b1c1c] font-sans antialiased">
    <!-- Admin Sidebar -->
    <%- include('../partials/sidebar', { activePage: 'coupons' }) %>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Top Admin Header -->
        <header class="h-20 bg-white border-b border-zinc-200/80 px-8 flex items-center justify-between sticky top-0 z-20 shadow-[0_2px_15px_rgba(0,0,0,0.02)]">
            <div class="flex items-center gap-4">
                <span class="text-xs uppercase tracking-[0.25em] text-[#0A4D2E] font-bold">Coupon Program</span>
                <span class="text-zinc-300">/</span>
                <h1 class="text-lg font-serif font-normal text-zinc-900">Coupon Management</h1>
            </div>

            <div class="flex items-center gap-3">
                <button
                    type="button"
                    onclick="openCreateCouponModal()"
                    class="bg-[#0A4D2E] hover:bg-[#083e25] text-white px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold transition-all shadow-sm flex items-center gap-2 cursor-pointer"
                >
                    <svg class="w-4 h-4 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    <span>+ New Coupon Code</span>
                </button>
            </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-1 p-8 max-w-7xl w-full mx-auto space-y-6">
            
            <!-- Flash Message Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium"><%= success %></span>
                    </div>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                        <span class="font-medium"><%= error %></span>
                    </div>
                </div>
            <% } %>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- Stat 1: Total Coupons -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-zinc-400 font-semibold">Total Codes</span>
                        <span class="w-2 h-2 rounded-full bg-zinc-400"></span>
                    </div>
                    <p class="text-2xl font-serif text-zinc-900 font-bold"><%= stats.allCount %></p>
                    <p class="text-[11px] text-zinc-500 font-light">Configured coupons in catalog</p>
                </div>

                <!-- Stat 2: Active Coupons -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-700 font-semibold">Active Coupons</span>
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    </div>
                    <p class="text-2xl font-serif text-emerald-700 font-bold"><%= stats.activeCount %></p>
                    <p class="text-[11px] text-zinc-500 font-light">Ready for checkout redemption</p>
                </div>

                <!-- Stat 3: Inactive -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-amber-700 font-semibold">Inactive Codes</span>
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    </div>
                    <p class="text-2xl font-serif text-amber-700 font-bold"><%= stats.inactiveCount %></p>
                    <p class="text-[11px] text-zinc-500 font-light">Paused or manually disabled</p>
                </div>

                <!-- Stat 4: Expired -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-rose-700 font-semibold">Expired Codes</span>
                        <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                    </div>
                    <p class="text-2xl font-serif text-rose-700 font-bold"><%= stats.expiredCount %></p>
                    <p class="text-[11px] text-zinc-500 font-light">Past deadline validity</p>
                </div>

            </div>

            <!-- Search, Filter & Control Toolbar -->
            <div class="bg-white rounded-2xl border border-zinc-200/80 p-4 shadow-2xs">
                <form id="couponFilterForm" method="GET" action="/admin/coupons" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 text-xs">
                    <input type="hidden" name="limit" value="<%= pagination.pageLimit %>">
                    
                    <!-- Search input -->
                    <div class="lg:col-span-4 relative">
                        <input 
                            type="text" 
                            name="search" 
                            value="<%= search %>" 
                            placeholder="Search code or description..." 
                            class="w-full pl-9 pr-4 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] focus:bg-white outline-none text-zinc-900 transition-colors placeholder:text-zinc-400"
                        >
                        <svg class="w-4 h-4 text-zinc-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>

                    <!-- Status Filter -->
                    <div class="lg:col-span-3">
                        <select 
                            name="status" 
                            onchange="this.form.submit()"
                            class="w-full px-3 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none text-zinc-800 cursor-pointer"
                        >
                            <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Statuses</option>
                            <option value="active" <%= status === 'active' ? 'selected' : '' %>>Active Only</option>
                            <option value="inactive" <%= status === 'inactive' ? 'selected' : '' %>>Inactive Only</option>
                            <option value="expired" <%= status === 'expired' ? 'selected' : '' %>>Expired Only</option>
                        </select>
                    </div>

                    <!-- Discount Type Filter -->
                    <div class="lg:col-span-2">
                        <select 
                            name="discountType" 
                            onchange="this.form.submit()"
                            class="w-full px-3 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none text-zinc-800 cursor-pointer"
                        >
                            <option value="all" <%= discountType === 'all' ? 'selected' : '' %>>All Types</option>
                            <option value="percentage" <%= discountType === 'percentage' ? 'selected' : '' %>>Percentage (%)</option>
                            <option value="fixed" <%= discountType === 'fixed' ? 'selected' : '' %>>Fixed Amount (₹)</option>
                        </select>
                    </div>

                    <!-- Sort Filter -->
                    <div class="lg:col-span-2">
                        <select 
                            name="sort" 
                            onchange="this.form.submit()"
                            class="w-full px-3 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none text-zinc-800 cursor-pointer"
                        >
                            <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest First</option>
                            <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
                            <option value="discount-high" <%= sort === 'discount-high' ? 'selected' : '' %>>Highest Discount</option>
                            <option value="discount-low" <%= sort === 'discount-low' ? 'selected' : '' %>>Lowest Discount</option>
                            <option value="expiry-soon" <%= sort === 'expiry-soon' ? 'selected' : '' %>>Expiring Soon</option>
                            <option value="code-asc" <%= sort === 'code-asc' ? 'selected' : '' %>>Code (A–Z)</option>
                        </select>
                    </div>

                    <!-- Reset Link -->
                    <div class="lg:col-span-1 flex items-center justify-end">
                        <a href="/admin/coupons" class="text-zinc-500 hover:text-zinc-900 font-mono text-[11px] underline uppercase" title="Reset all filters">Reset</a>
                    </div>

                </form>
            </div>

            <!-- Coupons Table Container -->
            <div class="bg-white rounded-3xl border border-zinc-200/80 shadow-xs overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-zinc-600">
                        <thead class="bg-[#faf8f7] border-b border-zinc-200/80 font-mono text-[10px] uppercase tracking-wider text-zinc-500">
                            <tr>
                                <th class="py-4 px-6 font-semibold">coupons Code & Dossier</th>
                                <th class="py-4 px-6 font-semibold">Discount Value</th>
                                <th class="py-4 px-6 font-semibold">Threshold</th>
                                <th class="py-4 px-6 font-semibold">Redemptions</th>
                                <th class="py-4 px-6 font-semibold">Validity</th>
                                <th class="py-4 px-6 font-semibold text-center">Status</th>
                                <th class="py-4 px-6 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 font-light">
                            <% if (coupons.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="py-12 text-center text-zinc-400">
                                        <div class="max-w-xs mx-auto space-y-2">
                                            <span class="text-3xl block">🎟️</span>
                                            <p class="font-serif text-sm font-semibold text-zinc-700">No coupons Codes Found</p>
                                            <p class="text-[11px] text-zinc-400 font-light">No coupons match your filter criteria or none have been created yet.</p>
                                            <button type="button" onclick="openCreateCouponModal()" class="mt-2 text-xs font-mono font-bold text-[#0A4D2E] hover:underline uppercase">+ Create First Code</button>
                                        </div>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% coupons.forEach(c => { %>
                                    <tr class="hover:bg-zinc-50/70 transition-colors group">
                                        
                                        <!-- Column 1: Code & Description -->
                                        <td class="py-4 px-6">
                                            <div class="space-y-1">
                                                <div class="flex items-center gap-2">
                                                    <span class="px-2.5 py-1 bg-[#0A4D2E]/10 text-[#0A4D2E] border border-[#0A4D2E]/20 rounded-lg font-mono font-bold text-xs tracking-wider">
                                                        <%= c.code %>
                                                    </span>
                                                    <button 
                                                        type="button" 
                                                        onclick="copyCode('<%= c.code %>')" 
                                                        class="text-zinc-400 hover:text-zinc-700 transition-colors p-1"
                                                        title="Copy Code to Clipboard"
                                                    >
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                                    </button>
                                                </div>
                                                <p class="text-[11px] text-zinc-500 font-light truncate max-w-xs" title="<%= c.description %>">
                                                    <%= c.description || 'Coupon Discount' %>
                                                </p>
                                            </div>
                                        </td>

                                        <!-- Column 2: Discount -->
                                        <td class="py-4 px-6 font-mono font-medium">
                                            <% if (c.discountType === 'percentage') { %>
                                                <span class="text-emerald-700 font-bold text-sm"><%= c.discountValue %>% OFF</span>
                                                <% if (c.maxDiscountAmount) { %>
                                                    <span class="block text-[10px] text-zinc-400">Cap: ₹<%= Number(c.maxDiscountAmount).toLocaleString('en-IN') %></span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-emerald-700 font-bold text-sm">₹<%= Number(c.discountValue).toLocaleString('en-IN') %> FLAT</span>
                                            <% } %>
                                        </td>

                                        <!-- Column 3: Threshold -->
                                        <td class="py-4 px-6 font-mono text-[11px]">
                                            <% if (c.minPurchaseAmount > 0) { %>
                                                <span class="text-zinc-800 font-medium">₹<%= Number(c.minPurchaseAmount).toLocaleString('en-IN') %></span>
                                                <span class="block text-[9px] text-zinc-400 uppercase">Min Cart Total</span>
                                            <% } else { %>
                                                <span class="text-zinc-400 italic">No minimum</span>
                                            <% } %>
                                        </td>

                                        <!-- Column 4: Redemptions -->
                                        <td class="py-4 px-6 font-mono">
                                            <div class="space-y-1">
                                                <div class="flex items-center justify-between text-[11px]">
                                                    <span class="font-bold text-zinc-900"><%= c.usageCount || 0 %></span>
                                                    <span class="text-zinc-400">/ <%= c.usageLimit || '∞' %></span>
                                                </div>
                                                <% if (c.usageLimit) { %>
                                                    <% const pct = Math.min(100, Math.round(((c.usageCount || 0) / c.usageLimit) * 100)); %>
                                                    <div class="w-24 h-1.5 bg-zinc-100 rounded-full overflow-hidden">
                                                        <div class="h-full <%= pct >= 90 ? 'bg-rose-500' : 'bg-[#0A4D2E]' %> rounded-full" style="width: <%= pct %>%"></div>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </td>

                                        <!-- Column 5: Validity -->
                                        <td class="py-4 px-6 font-mono text-[11px]">
                                            <% if (c.expiryDate) { %>
                                                <% const expDate = new Date(c.expiryDate); %>
                                                <span class="<%= c.isExpired ? 'text-rose-600 line-through' : 'text-zinc-800' %>">
                                                    <%= expDate.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                </span>
                                                <% if (c.isExpired) { %>
                                                    <span class="block text-[9px] uppercase font-bold text-rose-600">Expired</span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-zinc-400 italic">Permanent / No Expiry</span>
                                            <% } %>
                                        </td>

                                        <!-- Column 6: Status Toggle -->
                                        <td class="py-4 px-6 text-center">
                                            <button 
                                                type="button" 
                                                onclick="toggleCouponStatus('<%= c._id %>')" 
                                                id="statusBtn-<%= c._id %>"
                                                class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-all cursor-pointer border
                                                    <%= c.isExpired ? 'bg-zinc-100 text-zinc-400 border-zinc-200 cursor-not-allowed' : 
                                                       (c.isActive ? 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:bg-emerald-100' : 
                                                       'bg-zinc-100 text-zinc-600 border-zinc-200 hover:bg-zinc-200') %>"
                                                <%= c.isExpired ? 'disabled' : '' %>
                                                title="Click to toggle Active / Inactive state"
                                            >
                                                <%= c.computedStatus %>
                                            </button>
                                        </td>

                                        <!-- Column 7: Actions -->
                                        <td class="py-4 px-6 text-right">
                                            <div class="flex items-center justify-end gap-2">
                                                <button 
                                                    type="button" 
                                                    onclick="openEditCouponModal('<%= c._id %>')" 
                                                    class="p-2 text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors cursor-pointer" 
                                                    title="Edit Coupon Details"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                </button>
                                                <button 
                                                    type="button" 
                                                    onclick="openDeleteCouponModal('<%= c._id %>', '<%= c.code %>')" 
                                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors cursor-pointer" 
                                                    title="Delete / Archive Coupon"
                                                >
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                </button>
                                            </div>
                                        </td>

                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <% if (pagination && pagination.totalItems > 0) { %>
                    <div class="p-4 sm:p-5 bg-[#faf8f7] border-t border-zinc-200/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono select-none">
                        
                        <!-- Range & Limit Selector -->
                        <div class="flex items-center gap-4 text-zinc-500">
                            <span>
                                Showing <strong class="text-zinc-900 font-semibold"><%= pagination.startItem %>–<%= Math.min(pagination.totalItems, pagination.startItem + coupons.length - 1) %></strong> of <strong class="text-zinc-900 font-semibold"><%= pagination.totalItems %></strong> coupons
                            </span>

                            <div class="h-3.5 w-px bg-zinc-200 hidden sm:block"></div>

                            <div class="flex items-center gap-2">
                                <span class="text-zinc-400 uppercase tracking-wider text-[10px]">Per page:</span>
                                <select
                                    onchange="changeLimit(this.value)"
                                    class="bg-white border border-zinc-200 text-zinc-900 text-xs rounded-lg px-2 py-1 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                                >
                                    <option value="5" <%= pagination.pageLimit === 5 ? 'selected' : '' %>>5</option>
                                    <option value="10" <%= pagination.pageLimit === 10 ? 'selected' : '' %>>10</option>
                                    <option value="20" <%= pagination.pageLimit === 20 ? 'selected' : '' %>>20</option>
                                    <option value="50" <%= pagination.pageLimit === 50 ? 'selected' : '' %>>50</option>
                                </select>
                            </div>
                        </div>

                        <!-- Page Navigation Buttons -->
                        <div class="flex items-center gap-1.5 font-mono">
                            <!-- First Page Jump -->
                            <% if (pagination.currentPage > 1) { %>
                                <a
                                    href="/admin/coupons?page=1&limit=<%= pagination.pageLimit %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || 'all') %>&discountType=<%= encodeURIComponent(discountType || 'all') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                                    title="First Page"
                                    class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-2xs"
                                >
                                    «
                                </a>
                            <% } else { %>
                                <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                    «
                                </span>
                            <% } %>

                            <!-- Prev -->
                            <% if (pagination.hasPrevPage) { %>
                                <a
                                    href="/admin/coupons?page=<%= pagination.prevPage %>&limit=<%= pagination.pageLimit %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || 'all') %>&discountType=<%= encodeURIComponent(discountType || 'all') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                                    title="Previous Page"
                                    class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-2xs"
                                >
                                    ‹
                                </a>
                            <% } else { %>
                                <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                    ‹
                                </span>
                            <% } %>

                            <!-- Dynamic Page Numbers with Sliding Window & Ellipses -->
                            <% if (pagination.pageNumbers && pagination.pageNumbers.length > 0) { %>
                                <% pagination.pageNumbers.forEach(p => { %>
                                    <% if (p === '...') { %>
                                        <span class="w-7 text-center text-zinc-400 font-mono text-xs">…</span>
                                    <% } else if (p === pagination.currentPage) { %>
                                        <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow-2xs">
                                            <%= p %>
                                        </span>
                                    <% } else { %>
                                        <a
                                            href="/admin/coupons?page=<%= p %>&limit=<%= pagination.pageLimit %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || 'all') %>&discountType=<%= encodeURIComponent(discountType || 'all') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                                            class="w-8 h-8 rounded-lg flex items-center justify-center border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 hover:border-zinc-900 text-xs font-mono font-medium transition-colors shadow-2xs"
                                        >
                                            <%= p %>
                                        </a>
                                    <% } %>
                                <% }) %>
                            <% } else { %>
                                <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow-2xs">
                                    1
                                </span>
                            <% } %>

                            <!-- Next -->
                            <% if (pagination.hasNextPage) { %>
                                <a
                                    href="/admin/coupons?page=<%= pagination.nextPage %>&limit=<%= pagination.pageLimit %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || 'all') %>&discountType=<%= encodeURIComponent(discountType || 'all') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                                    title="Next Page"
                                    class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-2xs"
                                >
                                    ›
                                </a>
                            <% } else { %>
                                <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                    ›
                                </span>
                            <% } %>

                            <!-- Last Page Jump -->
                            <% if (pagination.currentPage < pagination.totalPages) { %>
                                <a
                                    href="/admin/coupons?page=<%= pagination.totalPages %>&limit=<%= pagination.pageLimit %>&search=<%= encodeURIComponent(search || '') %>&status=<%= encodeURIComponent(status || 'all') %>&discountType=<%= encodeURIComponent(discountType || 'all') %>&sort=<%= encodeURIComponent(sort || 'newest') %>"
                                    title="Last Page (<%= pagination.totalPages %>)"
                                    class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-2xs"
                                >
                                    »
                                </a>
                            <% } else { %>
                                <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                    »
                                </span>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
</div>

