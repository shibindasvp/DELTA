    // Toggle status handler
    async function toggleCouponStatus(id) {
        try {
            const res = await fetch('/admin/coupons/' + id + '/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                const btn = document.getElementById('statusBtn-' + id);
                if (btn) {
                    if (data.isActive) {
                        btn.textContent = 'Active';
                        btn.className = 'px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-all cursor-pointer border bg-emerald-50 text-emerald-800 border-emerald-200 hover:bg-emerald-100';
                    } else {
                        btn.textContent = 'Inactive';
                        btn.className = 'px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase transition-all cursor-pointer border bg-zinc-100 text-zinc-600 border-zinc-200 hover:bg-zinc-200';
                    }
                }
            } else {
                alert(data.message || 'Failed to toggle coupon status.');
            }
        } catch (e) {
            alert('Connection error toggling status.');
        }
    }

    // Delete Modal handlers
    function openDeleteCouponModal(id, code) {
        document.getElementById('deleteCouponId').value = id;
        document.getElementById('deleteCouponCode').textContent = code;
        const err = document.getElementById('deleteCouponError');
        if (err) err.classList.add('hidden');
        const modal = document.getElementById('deleteCouponModal');
        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }

    function closeDeleteCouponModal() {
        const modal = document.getElementById('deleteCouponModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    async function submitDeleteCoupon(e) {
        e.preventDefault();
        const id = document.getElementById('deleteCouponId').value;
        const btn = document.getElementById('deleteSubmitBtn');
        const err = document.getElementById('deleteCouponError');
        if (err) err.classList.add('hidden');
        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/admin/coupons/' + id + '/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                window.location.href = '/admin/coupons?success=deleted';
            } else {
                if (err) {
                    err.textContent = data.message || 'Failed to delete coupon.';
                    err.classList.remove('hidden');
                }
            }
        } catch (e) {
            if (err) {
                err.textContent = 'Connection error deleting coupon.';
                err.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function changeLimit(limit) {
        const url = new URL(window.location.href);
        url.searchParams.set('limit', limit);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    // Initialize Real-time Form Validation on DOM Ready
    document.addEventListener('DOMContentLoaded', () => {
        initCouponFormValidation();

        if (typeof window.showAdminFlash === 'function') {
            window.showAdminFlash(
                <%- JSON.stringify(typeof success !== 'undefined' ? success : null) %>,
                <%- JSON.stringify(typeof error !== 'undefined' ? error : null) %>
            );
        }

        // Support ?action=create or ?modal=create URL params for direct navigation
        try {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('action') === 'create' || urlParams.get('modal') === 'create' || urlParams.get('open') === 'create') {
                openCreateCouponModal();
            }
        } catch (err) {}
    });
</script>
