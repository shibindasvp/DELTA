<%- include('../partials/header', { title: 'Vault Inventory & Stock Control — DELTA Maison' }) %>

<%
    const safeBrandId = (typeof brandId !== 'undefined' && brandId) ? brandId : '';
    const safeSearch = (typeof search !== 'undefined' && search) ? search : '';
    const safeStockStatus = (typeof stockStatus !== 'undefined' && stockStatus) ? stockStatus : 'all';
    const safeSortBy = (typeof sortBy !== 'undefined' && sortBy) ? sortBy : 'updated_desc';
    const safeStats = (typeof stats !== 'undefined' && stats) ? stats : { totalProducts: 0, totalVaultUnits: 0, totalValuation: 0, inStockProducts: 0, lowStockProducts: 0, outOfStockProducts: 0, outOfStockVariantsCount: 0, lowStockVariantsCount: 0 };
    const safeProducts = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];
    const safeBrands = (typeof brands !== 'undefined' && Array.isArray(brands)) ? brands : [];
    const safePagination = (typeof pagination !== 'undefined' && pagination) ? pagination : { currentPage: 1, totalPages: 1, totalItems: safeProducts.length, pageLimit: 10, startItem: 1, hasNextPage: false, hasPrevPage: false, pageNumbers: [1] };
%>

<div class="flex min-h-screen bg-[#faf8f7] text-[#1b1c1c] font-sans antialiased">
    <!-- Admin Sidebar -->
    <%- include('../partials/sidebar', { activePage: 'inventory' }) %>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <!-- Top Admin Header -->
        <header class="h-20 bg-white border-b border-zinc-200/80 px-8 flex items-center justify-between sticky top-0 z-20 shadow-[0_2px_15px_rgba(0,0,0,0.02)]">
            <div class="flex items-center gap-4">
                <span class="text-xs uppercase tracking-[0.25em] text-[#0A4D2E] font-bold">Vault Logistics</span>
                <span class="text-zinc-300">/</span>
                <h1 class="text-lg font-serif font-normal text-zinc-900">Inventory & Stock Control</h1>
            </div>

            <div class="flex items-center gap-3">
                <a
                    href="/admin/inventory/export"
                    class="bg-zinc-100 hover:bg-zinc-200 text-zinc-800 px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold transition-all shadow-2xs flex items-center gap-2 border border-zinc-200"
                    title="Export current inventory report as CSV"
                >
                    <svg class="w-4 h-4 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>Export CSV</span>
                </a>
                
                <a
                    href="/admin/products/add"
                    class="bg-[#0A4D2E] hover:bg-[#083e25] text-white px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold transition-all shadow-sm flex items-center gap-2"
                >
                    <span>+ New Timepiece</span>
                </a>
            </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-1 p-8 max-w-7xl w-full mx-auto space-y-6">
            
            <!-- Flash Message Alerts -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium"><%= success %></span>
                    </div>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-800 px-5 py-3.5 rounded-xl text-xs flex items-center justify-between shadow-sm animate-fade-in">
                    <div class="flex items-center gap-2.5">
                        <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span><%= error %></span>
                    </div>
                </div>
            <% } %>

            <!-- Critical Stock Alert Banner -->
            <% if (safeStats.outOfStockProducts > 0 || safeStats.lowStockProducts > 0) { %>
                <div class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border-l-4 border-amber-500 bg-white p-4 rounded-xl shadow-xs flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0 font-bold">
                            ⚠️
                        </div>
                        <div>
                            <h3 class="text-xs font-semibold text-zinc-900 uppercase tracking-wider">Inventory Replenishment Notice</h3>
                            <p class="text-xs text-zinc-600 font-light mt-0.5">
                                <span class="font-semibold text-rose-700 font-mono"><%= safeStats.outOfStockProducts %></span> model(s) are completely sold out and 
                                <span class="font-semibold text-amber-700 font-mono"><%= safeStats.lowStockProducts %></span> model(s) are running low on vault reserves.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <a 
                            href="/admin/inventory?stockStatus=outOfStock"
                            class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-800 border border-rose-200 rounded-lg text-[11px] font-semibold transition-colors"
                        >
                            View Depleted (<%= safeStats.outOfStockProducts %>)
                        </a>
                        <a 
                            href="/admin/inventory?stockStatus=lowStock"
                            class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-lg text-[11px] font-semibold transition-colors"
                        >
                            View Low Stock (<%= safeStats.lowStockProducts %>)
                        </a>
                    </div>
                </div>
            <% } %>

            <!-- Interactive Metric Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- Total Vault Units -->
                <a 
                    href="/admin/inventory?stockStatus=all"
                    class="bg-white border <%= safeStockStatus === 'all' ? 'border-[#0A4D2E] ring-2 ring-[#0A4D2E]/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer"
                >
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-semibold block">TOTAL VAULT UNITS</span>
                        <span class="text-[9px] uppercase font-mono bg-zinc-100 text-zinc-600 px-1.5 py-0.5 rounded border border-zinc-200"><%= safeStats.totalProducts %> Models</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-serif text-zinc-900 font-normal"><%= safeStats.totalVaultUnits || 0 %></span>
                        <span class="text-xs text-zinc-400 font-sans">units</span>
                    </div>
                </a>

                <!-- Vault Asset Valuation -->
                <div class="bg-white border border-zinc-200/80 p-5 rounded-2xl shadow-sm">
                    <span class="text-[10px] uppercase tracking-[0.2em] text-emerald-600 font-semibold block mb-1">VAULT ASSET VALUATION</span>
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-serif text-emerald-800 font-normal">₹<%= Number(safeStats.totalValuation || 0).toLocaleString("en-IN") %></span>
                    </div>
                </div>

                <!-- Low Stock Alert -->
                <a 
                    href="/admin/inventory?stockStatus=lowStock"
                    class="bg-white border <%= safeStockStatus === 'lowStock' ? 'border-amber-600 ring-2 ring-amber-600/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer group"
                >
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] uppercase tracking-[0.2em] text-amber-600 font-semibold block">LOW STOCK ALERTS (≤ 3)</span>
                        <span class="text-[9px] uppercase font-mono bg-amber-50 text-amber-800 px-1.5 py-0.5 rounded border border-amber-200 font-bold">Action Req.</span>
                    </div>
                    <span class="text-2xl font-serif text-amber-700 font-normal"><%= safeStats.lowStockProducts || 0 %></span>
                </a>

                <!-- Sold Out / Depleted -->
                <a 
                    href="/admin/inventory?stockStatus=outOfStock"
                    class="bg-white border <%= safeStockStatus === 'outOfStock' ? 'border-rose-600 ring-2 ring-rose-600/20' : 'border-zinc-200/80 hover:border-zinc-400' %> p-5 rounded-2xl shadow-sm transition-all block cursor-pointer group"
                >
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-[10px] uppercase tracking-[0.2em] text-rose-600 font-semibold block">SOLD OUT / DEPLETED</span>
                        <span class="text-[9px] uppercase font-mono bg-rose-50 text-rose-700 px-1.5 py-0.5 rounded border border-rose-200 font-bold">0 Units</span>
                    </div>
                    <span class="text-2xl font-serif text-rose-700 font-normal"><%= safeStats.outOfStockProducts || 0 %></span>
                </a>
            </div>

            <!-- Main Table Container -->
            <div class="bg-white border border-zinc-200/80 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                
                <!-- Table Controls Header -->
                <div class="p-6 border-b border-zinc-100 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-base font-serif text-zinc-900">Maison Inventory Ledger</h2>
                        <p class="text-xs text-zinc-500 font-light mt-0.5">
                            Manage physical allocations, edition-level variant stocks, and vault reserves in real-time.
                        </p>
                    </div>

                    <!-- Filter & Search Form -->
                    <form action="/admin/inventory" method="GET" class="flex flex-wrap items-center gap-3">
                        <input type="hidden" name="page" value="1">
                        <input type="hidden" name="limit" value="<%= safePagination.pageLimit %>">
                        
                        <!-- Stock Status Filter -->
                        <select
                            name="stockStatus"
                            onchange="this.form.submit()"
                            class="bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                        >
                            <option value="all" <%= safeStockStatus === 'all' ? 'selected' : '' %>>All Stock Levels</option>
                            <option value="inStock" <%= safeStockStatus === 'inStock' ? 'selected' : '' %>>Healthy Stock (> 3 units)</option>
                            <option value="lowStock" <%= safeStockStatus === 'lowStock' ? 'selected' : '' %>>Low Stock (1-3 units)</option>
                            <option value="outOfStock" <%= safeStockStatus === 'outOfStock' ? 'selected' : '' %>>Sold Out (0 units)</option>
                        </select>

                        <!-- Brand Dropdown Filter -->
                        <select
                            name="brand"
                            onchange="this.form.submit()"
                            class="bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                        >
                            <option value="">All Manufacture Maisons</option>
                            <% if (safeBrands && safeBrands.length > 0) { %>
                                <% safeBrands.forEach(b => { %>
                                    <option value="<%= b._id %>" <%= (safeBrandId && (safeBrandId === b._id.toString() || safeBrandId === b.slug)) ? 'selected' : '' %>>
                                        <%= b.name %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>

                        <!-- Sort By Dropdown -->
                        <select
                            name="sortBy"
                            onchange="this.form.submit()"
                            class="bg-zinc-50 border border-zinc-200 text-zinc-900 text-xs rounded-xl px-3 py-2.5 focus:outline-none focus:border-[#0A4D2E] cursor-pointer font-mono"
                        >
                            <option value="updated_desc" <%= safeSortBy === 'updated_desc' ? 'selected' : '' %>>Recently Updated</option>
                            <option value="stock_asc" <%= safeSortBy === 'stock_asc' ? 'selected' : '' %>>Stock: Low → High</option>
                            <option value="stock_desc" <%= safeSortBy === 'stock_desc' ? 'selected' : '' %>>Stock: High → Low</option>
                            <option value="price_desc" <%= safeSortBy === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
                            <option value="name_asc" <%= safeSortBy === 'name_asc' ? 'selected' : '' %>>Name: A → Z</option>
                        </select>

                        <!-- Search Bar with (✕) Clear Button -->
                        <div class="relative w-56">
                            <input
                                type="text"
                                name="search"
                                value="<%= safeSearch || '' %>"
                                placeholder="Search ref, SKU, dial..."
                                class="w-full pl-9 pr-8 py-2.5 bg-zinc-50 border border-zinc-200 rounded-xl text-xs text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-[#0A4D2E] focus:bg-white transition-colors"
                            >
                            <svg class="w-4 h-4 text-zinc-400 absolute left-3 top-3 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            
                            <% if (safeSearch || safeBrandId || (safeStockStatus && safeStockStatus !== 'all') || (safeSortBy && safeSortBy !== 'updated_desc')) { %>
                                <a
                                    href="/admin/inventory?page=1&limit=<%= safePagination.pageLimit %>"
                                    title="Reset All Filters"
                                    class="absolute right-2.5 top-2.5 text-zinc-400 hover:text-zinc-700 bg-zinc-200 hover:bg-zinc-300 w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold transition-colors"
                                >
                                    ✕
                                </a>
                            <% } %>
                        </div>

                        <button
                            type="submit"
                            class="bg-zinc-900 hover:bg-black text-white px-4 py-2.5 rounded-xl text-xs font-semibold uppercase tracking-wider transition-colors shadow-sm cursor-pointer"
                        >
                            Filter
                        </button>
                    </form>
                </div>

                <!-- Table Content -->
                <div class="overflow-x-auto min-h-[350px]">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-zinc-100 bg-zinc-50/70 text-[10px] uppercase font-mono tracking-wider text-zinc-500 select-none">
                                <th class="py-3.5 px-6 font-semibold w-12">#</th>
                                <th class="py-3.5 px-6 font-semibold">Reference</th>
                                <th class="py-3.5 px-6 font-semibold">Timepiece Model</th>
                                <th class="py-3.5 px-6 font-semibold">Maison</th>
                                <th class="py-3.5 px-6 font-semibold min-w-[320px]">Edition Variants & Stock Breakdown</th>
                                <th class="py-3.5 px-6 font-semibold text-center">Total Stock</th>
                                <th class="py-3.5 px-6 font-semibold text-center">Health Status</th>
                                <th class="py-3.5 px-6 font-semibold text-right">Vault Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 text-zinc-700" id="inventoryTableBody">
                            <% if (safeProducts.length > 0) { %>
                                <% safeProducts.forEach((p, index) => { %>
                                    <tr class="hover:bg-zinc-50/80 transition-colors" id="product-row-<%= p._id %>">
                                        
                                        <!-- Index -->
                                        <td class="py-4 px-6 font-mono text-zinc-400 align-top">
                                            <%= safePagination.startItem + index %>
                                        </td>

                                        <!-- Reference Number -->
                                        <td class="py-4 px-6 font-mono align-top">
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold font-mono bg-zinc-900 text-white shadow-2xs border border-zinc-800">
                                                <span class="text-emerald-400 font-bold">#</span>
                                                <span><%= p.modelNumber || ('REF-DLT-' + (p._id.toString().substring(18, 24).toUpperCase())) %></span>
                                            </span>
                                        </td>

                                        <!-- Thumbnail + Title -->
                                        <td class="py-4 px-6 align-top">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-xl bg-zinc-100 border border-zinc-200 overflow-hidden flex-shrink-0 shadow-sm flex items-center justify-center">
                                                    <% if (p.images && p.images.length > 0) { %>
                                                        <img src="<%= p.images[0] %>" alt="<%= p.name %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <span class="text-xs text-zinc-400">⏱</span>
                                                    <% } %>
                                                </div>
                                                <div class="max-w-xs">
                                                    <span class="font-medium text-zinc-900 block text-xs leading-snug"><%= p.name %></span>
                                                    <span class="text-[10px] text-zinc-400 font-mono">
                                                        Valuation: ₹<%= Number((p.discountPrice || p.price || 0) * (p.stock || 0)).toLocaleString("en-IN") %>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Brand / Maison -->
                                        <td class="py-4 px-6 align-top">
                                            <div class="flex items-center gap-2">
                                                <span class="w-5 h-5 rounded-md bg-emerald-50 text-[#0A4D2E] text-[10px] font-serif font-bold flex items-center justify-center border border-emerald-200/50">
                                                    <%= (p.brand && p.brand.name ? p.brand.name.charAt(0) : (p.brandName ? p.brandName.charAt(0) : 'D')).toUpperCase() %>
                                                </span>
                                                <span class="font-medium text-zinc-900 text-xs">
                                                    <%= p.brand && p.brand.name ? p.brand.name : (p.brandName || 'DELTA Manufacture') %>
                                                </span>
                                            </div>
                                        </td>

                                        <!-- Edition Variants & Interactive Stock Steppers -->
                                        <td class="py-4 px-6 align-top">
                                            <% if (p.variants && p.variants.length > 0) { %>
                                                <div class="space-y-2 max-w-md">
                                                    <% p.variants.forEach((v) => { %>
                                                        <div class="flex items-center justify-between gap-3 p-2 rounded-xl bg-white border border-zinc-200/80 shadow-2xs" id="variant-card-<%= v._id %>">
                                                            
                                                            <!-- Variant Color & Specs -->
                                                            <div class="flex items-center gap-2 min-w-0">
                                                                <span class="w-3.5 h-3.5 rounded-full border border-black/20 flex-shrink-0 shadow-2xs" style="background-color: <%= (v.colorCode && v.colorCode.trim()) ? v.colorCode : '#1b1c1c' %>"></span>
                                                                <div class="truncate">
                                                                    <div class="flex items-center gap-1.5">
                                                                        <span class="font-semibold text-xs text-zinc-900 truncate"><%= v.color %></span>
                                                                        <% if (v.sku) { %>
                                                                            <span class="text-[9px] font-mono text-zinc-400 bg-zinc-100 px-1 py-0.2 rounded border border-zinc-200"><%= v.sku %></span>
                                                                        <% } %>
                                                                    </div>
                                                                    <div class="text-[10px] text-zinc-400 font-mono truncate">
                                                                        ₹<%= Number(v.discountPrice || v.price || p.price || 0).toLocaleString("en-IN") %>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            <!-- Direct Interactive Stock Stepper -->
                                                            <div class="flex items-center gap-1.5 flex-shrink-0">
                                                                <button 
                                                                    type="button" 
                                                                    onclick="quickAdjustStock('<%= p._id %>', '<%= v._id %>', -1)"
                                                                    class="w-6 h-6 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-700 flex items-center justify-center font-mono font-bold text-xs transition-colors cursor-pointer border border-zinc-200"
                                                                    title="Decrease 1 unit"
                                                                >
                                                                    -
                                                                </button>
                                                                <span 
                                                                    id="stock-val-<%= v._id %>"
                                                                    class="w-10 text-center font-mono font-bold text-xs <%= (v.stock || 0) <= 0 ? 'text-rose-600' : ((v.stock || 0) <= 3 ? 'text-amber-700' : 'text-emerald-800') %>"
                                                                >
                                                                    <%= v.stock !== undefined ? v.stock : 0 %>
                                                                </span>
                                                                <button 
                                                                    type="button" 
                                                                    onclick="quickAdjustStock('<%= p._id %>', '<%= v._id %>', 1)"
                                                                    class="w-6 h-6 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-700 flex items-center justify-center font-mono font-bold text-xs transition-colors cursor-pointer border border-zinc-200"
                                                                    title="Increase 1 unit"
                                                                >
                                                                    +
                                                                </button>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            <% } else { %>
                                                <!-- Direct Product Stepper if No Variants -->
                                                <div class="flex items-center justify-between gap-3 p-2 rounded-xl bg-white border border-zinc-200/80 shadow-2xs max-w-xs">
                                                    <span class="text-xs text-zinc-600 font-medium">Standard Master Edition</span>
                                                    <div class="flex items-center gap-1.5 flex-shrink-0">
                                                        <button 
                                                            type="button" 
                                                            onclick="quickAdjustStock('<%= p._id %>', null, -1)"
                                                            class="w-6 h-6 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-700 flex items-center justify-center font-mono font-bold text-xs transition-colors cursor-pointer border border-zinc-200"
                                                        >
                                                            -
                                                        </button>
                                                        <span 
                                                            id="stock-val-<%= p._id %>"
                                                            class="w-10 text-center font-mono font-bold text-xs <%= (p.stock || 0) <= 0 ? 'text-rose-600' : ((p.stock || 0) <= 3 ? 'text-amber-700' : 'text-emerald-800') %>"
                                                        >
                                                            <%= p.stock || 0 %>
                                                        </span>
                                                        <button 
                                                            type="button" 
                                                            onclick="quickAdjustStock('<%= p._id %>', null, 1)"
                                                            class="w-6 h-6 rounded-md bg-zinc-100 hover:bg-zinc-200 text-zinc-700 flex items-center justify-center font-mono font-bold text-xs transition-colors cursor-pointer border border-zinc-200"
                                                        >
                                                            +
                                                        </button>
                                                    </div>
                                                </div>
                                            <% } %>
                                        </td>

                                        <!-- Total Computed Stock -->
                                        <td class="py-4 px-6 text-center align-top">
                                            <div class="flex flex-col items-center">
                                                <span 
                                                    id="total-stock-<%= p._id %>"
                                                    class="text-base font-serif font-bold text-zinc-900"
                                                >
                                                    <%= p.stock || 0 %>
                                                </span>
                                                <span class="text-[9px] uppercase font-mono text-zinc-400">Total Units</span>
                                            </div>
                                        </td>

                                        <!-- Stock Status Badge -->
                                        <td class="py-4 px-6 text-center align-top" id="status-cell-<%= p._id %>">
                                            <% if (p.stock <= 0) { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                                                    <span>SOLD OUT</span>
                                                </span>
                                            <% } else if (p.stock <= 3) { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-bold bg-amber-100 text-amber-800 border border-amber-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                                                    <span>LOW STOCK</span>
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                                    <span>IN VAULT</span>
                                                </span>
                                            <% } %>
                                        </td>

                                        <!-- Actions -->
                                        <td class="py-4 px-6 text-right align-top space-x-1.5 whitespace-nowrap">
                                            <!-- Adjust Stock Modal Trigger -->
                                            <button
                                                type="button"
                                                onclick='openStockModal(<%- JSON.stringify(p) %>)'
                                                class="inline-block px-3 py-1.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-lg text-[11px] font-semibold transition-colors cursor-pointer shadow-2xs"
                                            >
                                                ⚙ Adjust Stock
                                            </button>

                                            <!-- Edit Product Link -->
                                            <a
                                                href="/admin/products/<%= p._id %>/edit"
                                                class="inline-block px-2.5 py-1.5 bg-zinc-100 hover:bg-zinc-900 hover:text-white text-zinc-700 rounded-lg text-[11px] font-medium transition-colors"
                                                title="Edit Full Specifications"
                                            >
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="py-16 text-center text-zinc-500 space-y-3">
                                        <div class="w-12 h-12 rounded-2xl bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-xl">
                                            📦
                                        </div>
                                        <div class="text-sm font-medium text-zinc-800">
                                            No timepieces found in vault inventory
                                        </div>
                                        <div class="text-xs text-zinc-400 max-w-sm mx-auto font-light">
                                            <% if (safeSearch || safeBrandId || (safeStockStatus && safeStockStatus !== 'all')) { %>
                                                No products matched your inventory search and filter criteria.
                                            <% } else { %>
                                                Your vault catalog is currently empty. Click "+ New Timepiece" to add products.
                                            <% } %>
                                        </div>
                                        <% if (safeSearch || safeBrandId || (safeStockStatus && safeStockStatus !== 'all')) { %>
                                            <a href="/admin/inventory" class="inline-block mt-2 px-4 py-2 border border-zinc-300 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 transition-colors">Clear All Filters</a>
                                        <% } %>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Table Footer with Pagination Controls -->
                <div class="p-6 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs select-none">
                    
                    <!-- Per Page Limit Selector & Record Counter -->
                    <div class="flex items-center gap-3">
                        <span class="text-zinc-500 font-light">
                            Showing <span class="font-mono font-medium text-zinc-900"><%= safePagination.totalItems === 0 ? 0 : safePagination.startItem %></span> to 
                            <span class="font-mono font-medium text-zinc-900"><%= Math.min(safePagination.startItem + safeProducts.length - 1, safePagination.totalItems) %></span> of 
                            <span class="font-mono font-medium text-zinc-900"><%= safePagination.totalItems %></span> timepieces
                        </span>

                        <div class="flex items-center gap-1.5 ml-2 border-l border-zinc-200 pl-4">
                            <span class="text-[10px] uppercase font-mono text-zinc-400">Rows:</span>
                            <select
                                onchange="changeLimit(this.value)"
                                class="bg-zinc-50 border border-zinc-200 text-zinc-800 text-xs rounded-lg px-2 py-1 focus:outline-none focus:border-[#0A4D2E] cursor-pointer"
                            >
                                <option value="10" <%= safePagination.pageLimit === 10 ? 'selected' : '' %>>10</option>
                                <option value="20" <%= safePagination.pageLimit === 20 ? 'selected' : '' %>>20</option>
                                <option value="50" <%= safePagination.pageLimit === 50 ? 'selected' : '' %>>50</option>
                            </select>
                        </div>
                    </div>

                    <!-- Pagination Links -->
                    <div class="flex items-center gap-1.5">
                        
                        <!-- First Page Jump -->
                        <% if (safePagination.currentPage > 1) { %>
                            <a
                                href="/admin/inventory?page=1&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStockStatus ? '&stockStatus=' + encodeURIComponent(safeStockStatus) : '' %><%= safeSortBy ? '&sortBy=' + encodeURIComponent(safeSortBy) : '' %>"
                                title="First Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                «
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                «
                            </span>
                        <% } %>

                        <!-- Prev -->
                        <% if (safePagination.hasPrevPage) { %>
                            <a
                                href="/admin/inventory?page=<%= safePagination.prevPage %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStockStatus ? '&stockStatus=' + encodeURIComponent(safeStockStatus) : '' %><%= safeSortBy ? '&sortBy=' + encodeURIComponent(safeSortBy) : '' %>"
                                title="Previous Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                ‹
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                ‹
                            </span>
                        <% } %>

                        <!-- Numbered Page Pills -->
                        <% if (safePagination.pageNumbers && safePagination.pageNumbers.length > 0) { %>
                            <% safePagination.pageNumbers.forEach(p => { %>
                                <% if (p === '...') { %>
                                    <span class="w-8 h-8 flex items-center justify-center text-zinc-400 font-mono text-xs">...</span>
                                <% } else if (p === safePagination.currentPage) { %>
                                    <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow">
                                        <%= p %>
                                    </span>
                                <% } else { %>
                                    <a
                                        href="/admin/inventory?page=<%= p %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStockStatus ? '&stockStatus=' + encodeURIComponent(safeStockStatus) : '' %><%= safeSortBy ? '&sortBy=' + encodeURIComponent(safeSortBy) : '' %>"
                                        class="w-8 h-8 rounded-lg flex items-center justify-center border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 hover:border-zinc-900 text-xs font-mono font-medium transition-colors shadow-sm"
                                    >
                                        <%= p %>
                                    </a>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold bg-[#0A4D2E] text-white text-xs font-mono shadow">
                                1
                            </span>
                        <% } %>

                        <!-- Next -->
                        <% if (safePagination.hasNextPage) { %>
                            <a
                                href="/admin/inventory?page=<%= safePagination.nextPage %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStockStatus ? '&stockStatus=' + encodeURIComponent(safeStockStatus) : '' %><%= safeSortBy ? '&sortBy=' + encodeURIComponent(safeSortBy) : '' %>"
                                title="Next Page"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                ›
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                ›
                            </span>
                        <% } %>

                        <!-- Last Page Jump -->
                        <% if (safePagination.currentPage < safePagination.totalPages) { %>
                            <a
                                href="/admin/inventory?page=<%= safePagination.totalPages %>&limit=<%= safePagination.pageLimit %><%= safeSearch ? '&search=' + encodeURIComponent(safeSearch) : '' %><%= safeBrandId ? '&brand=' + encodeURIComponent(safeBrandId) : '' %><%= safeStockStatus ? '&stockStatus=' + encodeURIComponent(safeStockStatus) : '' %><%= safeSortBy ? '&sortBy=' + encodeURIComponent(safeSortBy) : '' %>"
                                title="Last Page (<%= safePagination.totalPages %>)"
                                class="w-8 h-8 rounded-lg border border-zinc-200 bg-white text-zinc-700 hover:bg-zinc-100 flex items-center justify-center text-xs font-semibold transition-colors shadow-sm"
                            >
                                »
                            </a>
                        <% } else { %>
                            <span class="w-8 h-8 rounded-lg border border-zinc-100 bg-zinc-50 text-zinc-300 flex items-center justify-center text-xs cursor-not-allowed">
                                »
                            </span>
                        <% } %>
                    </div>
                </div>

            </div>
        </main>

        <!-- Admin Footer -->
        <%- include('../partials/footer') %>
    </div>
</div>

<!-- Interactive Modal for Comprehensive Stock Adjustment -->
<div id="stockAdjustModal" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-zinc-200 rounded-3xl max-w-xl w-full p-6 md:p-8 shadow-2xl animate-fade-in max-h-[90vh] overflow-y-auto">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between border-b border-zinc-100 pb-4 mb-6">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-[#0A4D2E] font-bold">Vault Allocation Management</span>
                <h3 id="modalProductTitle" class="text-base font-serif font-normal text-zinc-900 mt-1">Timepiece Title</h3>
                <span id="modalProductRef" class="text-xs font-mono text-zinc-400">#REF-DLT-XXXXXX</span>
            </div>
            <button type="button" onclick="closeStockModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center text-sm font-bold transition-colors cursor-pointer">
                ✕
            </button>
        </div>

        <form id="stockAdjustForm" onsubmit="submitStockModal(event)" class="space-y-6">
            <input type="hidden" id="modalProductId" name="productId" value="">
            <div id="modalStockError" class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs font-mono hidden"></div>
            
            <!-- Variants List -->
            <div class="space-y-4" id="modalVariantsContainer">
                <!-- Injected dynamically via JS -->
            </div>

            <!-- Reason Selector -->
            <div class="space-y-1.5">
                <label class="block text-[11px] uppercase tracking-wider font-semibold text-zinc-700">Audit Reason / Log Note</label>
                <select id="modalReason" class="w-full bg-zinc-50 border border-zinc-200 text-zinc-800 text-xs rounded-xl p-3 focus:outline-none focus:border-[#0A4D2E] cursor-pointer">
                    <option value="Genevan Workshop Restock & Inbound Shipment">Genevan Workshop Restock & Inbound Shipment</option>
                    <option value="Physical Vault Audit Count Correction">Physical Vault Audit Count Correction</option>
                    <option value="Damaged / Calibre Service Write-off">Damaged / Calibre Service Write-off</option>
                    <option value="VIP Collector Reservation Allocation">VIP Collector Reservation Allocation</option>
                    <option value="Customer Return Restocking">Customer Return Restocking</option>
                    <option value="Manual Inventory Adjustment">Manual Inventory Adjustment</option>
                </select>
            </div>

            <!-- Total Preview & Actions -->
            <div class="pt-4 border-t border-zinc-100 flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase font-mono text-zinc-400 block">Computed Master Stock</span>
                    <span id="modalTotalPreview" class="text-lg font-serif font-bold text-[#0A4D2E]">0 Units</span>
                </div>

                <div class="flex gap-2.5">
                    <button
                        type="button"
                        onclick="closeStockModal()"
                        class="px-5 py-2.5 border border-zinc-300 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:bg-zinc-100 transition-colors font-medium cursor-pointer"
                    >
                        Cancel
                    </button>
                    <button
                        type="submit"
                        id="saveStockBtn"
                        class="px-6 py-2.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors shadow-sm cursor-pointer flex items-center gap-2"
                    >
                        <span>Save Allocations</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Toast Notifications Container -->
<div id="toastContainer" class="fixed bottom-6 right-6 z-50 space-y-2 pointer-events-none"></div>

<script>
    let activeModalProduct = null;

    function changeLimit(newLimit) {
        const search = '<%= encodeURIComponent(safeSearch || "") %>';
        const brandId = '<%= encodeURIComponent(safeBrandId || "") %>';
        const stockStatus = '<%= encodeURIComponent(safeStockStatus || "") %>';
        const sortBy = '<%= encodeURIComponent(safeSortBy || "") %>';
        window.location.href = '/admin/inventory?page=1&limit=' + newLimit + 
            (search ? '&search=' + search : '') + 
            (brandId ? '&brand=' + brandId : '') + 
            (stockStatus ? '&stockStatus=' + stockStatus : '') +
            (sortBy ? '&sortBy=' + sortBy : '');
    }

    function showToast(message, isError = false) {
        const toast = document.createElement('div');
        toast.className = `p-4 rounded-xl shadow-lg border text-xs font-medium flex items-center gap-3 animate-fade-in transition-all duration-300 ${
            isError ? 'bg-rose-900 text-rose-100 border-rose-700' : 'bg-[#0A4D2E] text-white border-emerald-600'
        }`;
        toast.innerHTML = `
            <span>${isError ? '✕' : '✓'}</span>
            <span>${message}</span>
        `;
        const container = document.getElementById('toastContainer');
        container.appendChild(toast);

        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(10px)';
            setTimeout(() => toast.remove(), 300);
        }, 3500);
    }

    // 1-Click Quick Adjust Stepper via AJAX
    async function quickAdjustStock(productId, variantId, delta) {
        try {
            const spanId = variantId ? `stock-val-${variantId}` : `stock-val-${productId}`;
            const targetSpan = document.getElementById(spanId);
            const currentVal = targetSpan ? (parseInt(targetSpan.textContent, 10) || 0) : 0;
            const targetVal = Math.max(0, currentVal + delta);

            if (targetVal === currentVal && delta < 0) {
                showToast("Stock is already at 0 units.", true);
                return;
            }

            const response = await fetch('/admin/inventory/update-stock', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    productId,
                    variantId,
                    newStock: targetVal,
                    adjustmentType: 'set',
                    reason: delta > 0 ? 'Quick Restock (+1)' : 'Quick Allocation (-1)',
                    isAjax: true
                })
            });

            const resData = await response.json();

            if (!resData.success) {
                showToast(resData.message || 'Failed to update stock', true);
                return;
            }

            // Update UI
            if (targetSpan) {
                targetSpan.textContent = resData.data.variantStock;
                targetSpan.className = `w-10 text-center font-mono font-bold text-xs ${
                    resData.data.variantStock <= 0 ? 'text-rose-600' : (resData.data.variantStock <= 3 ? 'text-amber-700' : 'text-emerald-800')
                }`;
            }

            const totalSpan = document.getElementById(`total-stock-${productId}`);
            if (totalSpan) {
                totalSpan.textContent = resData.data.totalStock;
            }

            const statusCell = document.getElementById(`status-cell-${productId}`);
            if (statusCell) {
                if (resData.data.totalStock <= 0) {
                    statusCell.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-bold bg-rose-100 text-rose-800 border border-rose-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                            <span>SOLD OUT</span>
                        </span>
                    `;
                } else if (resData.data.totalStock <= 3) {
                    statusCell.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-bold bg-amber-100 text-amber-800 border border-amber-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
                            <span>LOW STOCK</span>
                        </span>
                    `;
                } else {
                    statusCell.innerHTML = `
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                            <span>IN VAULT</span>
                        </span>
                    `;
                }
            }

            showToast(`Vault stock updated: ${resData.data.totalStock} total units.`);
        } catch (err) {
            console.error('Quick update error:', err);
            showToast('Network error while updating stock.', true);
        }
    }

    // Open Comprehensive Stock Modal
    function openStockModal(product) {
        activeModalProduct = product;
        const errEl = document.getElementById('modalStockError');
        if (errEl) {
            errEl.textContent = '';
            errEl.classList.add('hidden');
        }
        document.getElementById('modalProductId').value = product._id;
        document.getElementById('modalProductTitle').textContent = product.name;
        document.getElementById('modalProductRef').textContent = product.modelNumber || `#REF-DLT-${product._id.substring(18, 24).toUpperCase()}`;

        const container = document.getElementById('modalVariantsContainer');
        container.innerHTML = '';

        if (product.variants && product.variants.length > 0) {
            product.variants.forEach((v, idx) => {
                const row = document.createElement('div');
                row.className = 'flex items-center justify-between p-3 rounded-xl bg-zinc-50 border border-zinc-200/80';
                row.innerHTML = `
                    <div class="flex items-center gap-2.5">
                        <span class="w-4 h-4 rounded-full border border-black/20 shadow-2xs" style="background-color: ${v.colorCode || '#1b1c1c'}"></span>
                        <div>
                            <span class="text-xs font-semibold text-zinc-900 block">${v.color}</span>
                            <span class="text-[10px] font-mono text-zinc-400">${v.sku || 'SKU-N/A'} • ₹${Number(v.discountPrice || v.price || product.price || 0).toLocaleString('en-IN')}</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="adjustModalInput('${v._id}', -1)" class="w-7 h-7 rounded-lg bg-white border border-zinc-200 hover:bg-zinc-100 text-zinc-700 font-mono font-bold text-xs flex items-center justify-center cursor-pointer shadow-2xs">-</button>
                        <input 
                            type="number" 
                            min="0" 
                            max="9999" 
                            id="modal-stock-${v._id}" 
                            data-variant-id="${v._id}"
                            value="${v.stock !== undefined ? v.stock : 0}" 
                            oninput="recalculateModalTotal()"
                            class="w-16 text-center font-mono font-bold text-xs bg-white border border-zinc-200 rounded-lg py-1.5 focus:outline-none focus:border-[#0A4D2E]"
                        >
                        <button type="button" onclick="adjustModalInput('${v._id}', 1)" class="w-7 h-7 rounded-lg bg-white border border-zinc-200 hover:bg-zinc-100 text-zinc-700 font-mono font-bold text-xs flex items-center justify-center cursor-pointer shadow-2xs">+</button>
                    </div>
                `;
                container.appendChild(row);
            });
        } else {
            const row = document.createElement('div');
            row.className = 'flex items-center justify-between p-3 rounded-xl bg-zinc-50 border border-zinc-200/80';
            row.innerHTML = `
                <div>
                    <span class="text-xs font-semibold text-zinc-900 block">Master Specification Stock</span>
                    <span class="text-[10px] font-mono text-zinc-400">₹${Number(product.discountPrice || product.price || 0).toLocaleString('en-IN')}</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="adjustModalInput('single', -1)" class="w-7 h-7 rounded-lg bg-white border border-zinc-200 hover:bg-zinc-100 text-zinc-700 font-mono font-bold text-xs flex items-center justify-center cursor-pointer shadow-2xs">-</button>
                    <input 
                        type="number" 
                        min="0" 
                        max="9999" 
                        id="modal-stock-single" 
                        value="${product.stock || 0}" 
                        oninput="recalculateModalTotal()"
                        class="w-16 text-center font-mono font-bold text-xs bg-white border border-zinc-200 rounded-lg py-1.5 focus:outline-none focus:border-[#0A4D2E]"
                    >
                    <button type="button" onclick="adjustModalInput('single', 1)" class="w-7 h-7 rounded-lg bg-white border border-zinc-200 hover:bg-zinc-100 text-zinc-700 font-mono font-bold text-xs flex items-center justify-center cursor-pointer shadow-2xs">+</button>
                </div>
            `;
            container.appendChild(row);
        }

        recalculateModalTotal();
        document.getElementById('stockAdjustModal').classList.remove('hidden');
    }

    function adjustModalInput(id, delta) {
        const input = document.getElementById(`modal-stock-${id}`);
        if (input) {
            let val = parseInt(input.value, 10) || 0;
            val = Math.max(0, val + delta);
            input.value = val;
            recalculateModalTotal();
        }
    }

    function recalculateModalTotal() {
        let total = 0;
        const inputs = document.querySelectorAll('#modalVariantsContainer input[type="number"]');
        inputs.forEach(inp => {
            total += Math.max(0, parseInt(inp.value, 10) || 0);
        });
        document.getElementById('modalTotalPreview').textContent = `${total} Units`;
    }

    function closeStockModal() {
        document.getElementById('stockAdjustModal').classList.add('hidden');
        activeModalProduct = null;
    }

    async function submitStockModal(e) {
        e.preventDefault();
        const errEl = document.getElementById('modalStockError');
        if (errEl) {
            errEl.textContent = '';
            errEl.classList.add('hidden');
        }
        const btn = document.getElementById('saveStockBtn');
        const originalBtnText = btn.innerHTML;
        btn.innerHTML = '<span>Saving...</span>';
        btn.disabled = true;

        try {
            const productId = document.getElementById('modalProductId').value;
            const reason = document.getElementById('modalReason').value;
            const inputs = document.querySelectorAll('#modalVariantsContainer input[type="number"]');
            
            let hasNegative = false;
            const updates = [];
            inputs.forEach(inp => {
                const variantId = inp.dataset.variantId || null;
                const rawVal = parseInt(inp.value, 10);
                if (isNaN(rawVal) || rawVal < 0) {
                    hasNegative = true;
                }
                const newStock = Math.max(0, rawVal || 0);
                updates.push({
                    productId,
                    variantId,
                    newStock,
                    adjustmentType: 'set',
                    reason
                });
            });

            if (hasNegative) {
                if (errEl) {
                    errEl.textContent = 'Stock quantities cannot be negative.';
                    errEl.classList.remove('hidden');
                }
                showToast('Stock quantities cannot be negative.', true);
                return;
            }

            const response = await fetch('/admin/inventory/bulk-update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ updates, isAjax: true })
            });

            const resData = await response.json();
            if (resData.success) {
                showToast('Timepiece allocations saved successfully.');
                closeStockModal();
                // Refresh table row or reload window smoothly
                setTimeout(() => window.location.reload(), 600);
            } else {
                if (errEl) {
                    errEl.textContent = resData.message || 'Failed to update stock allocations.';
                    errEl.classList.remove('hidden');
                }
                showToast(resData.message || 'Failed to update stock allocations', true);
            }
        } catch (err) {
            console.error('Modal submit error:', err);
            if (errEl) {
                errEl.textContent = 'Error communicating with vault inventory server.';
                errEl.classList.remove('hidden');
            }
            showToast('Error saving stock allocations', true);
        } finally {
            btn.innerHTML = originalBtnText;
            btn.disabled = false;
        }
    }
</script>
