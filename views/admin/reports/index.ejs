<%- include('../partials/header', { title: 'Sales Analytics & Reports — DELTA Horology' }) %>

<div class="flex flex-1 min-h-screen bg-[#F8F9FA]">
    <%- include('../partials/sidebar', { activePage: 'reports' }) %>

    <div class="flex-1 flex flex-col min-w-0">
        <%- include('../partials/navbar', { pageTitle: 'Sales Reports & Analytics' }) %>

        <main class="flex-grow p-6 sm:p-8 max-w-[1400px] w-full mx-auto space-y-6">
            
            <!-- Header with Export Actions -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200/80 pb-5">
                <div>
                    <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-[#c5a059] font-bold">
                        <span>REVENUE INTELLIGENCE</span>
                        <span>•</span>
                        <span>PURCHASED ALLOCATIONS ONLY</span>
                    </div>
                    <h1 class="text-2xl sm:text-3xl font-serif text-zinc-900 font-normal tracking-tight mt-1">
                        Sales Analytics & Reports
                    </h1>
                    <p class="text-xs text-zinc-500 font-light mt-0.5">
                        Audited records of verified client purchases, net realized revenue, and certified executive dossiers.
                    </p>
                </div>

                <!-- Export Action Buttons -->
                <div class="flex items-center gap-3">
                    <!-- PDF Download -->
                    <a 
                        href="/admin/reports/download-pdf?period=<%= period %>&startDate=<%= startDate %>&endDate=<%= endDate %>&status=<%= status %>&paymentMethod=<%= paymentMethod %>" 
                        target="_blank"
                        class="px-4 py-2.5 bg-white border border-zinc-200 hover:border-zinc-300 text-zinc-700 hover:text-zinc-900 rounded-xl text-xs font-semibold uppercase tracking-wider flex items-center gap-2 transition-all shadow-2xs hover:bg-zinc-50"
                        title="Download Executive PDF Sales Report"
                    >
                        <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        <span>Export PDF</span>
                    </a>

                    <!-- Excel Download -->
                    <a 
                        href="/admin/reports/download-excel?period=<%= period %>&startDate=<%= startDate %>&endDate=<%= endDate %>&status=<%= status %>&paymentMethod=<%= paymentMethod %>" 
                        class="px-4 py-2.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-xl text-xs font-semibold uppercase tracking-wider flex items-center gap-2 transition-all shadow-sm"
                        title="Download Detailed Excel (.xlsx) Spreadsheet"
                    >
                        <svg class="w-4 h-4 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        <span>Export Excel (.xlsx)</span>
                    </a>
                </div>
            </div>

            <!-- Filter Controls Panel -->
            <div class="bg-white rounded-2xl border border-zinc-200/80 p-5 shadow-2xs space-y-4">
                
                <!-- Period Selector Pills -->
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 pb-4">
                    <span class="text-[10px] uppercase font-mono tracking-wider font-semibold text-zinc-500">
                        Reporting Period:
                    </span>

                    <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
                        <a 
                            href="/admin/reports?period=daily&status=<%= status %>&paymentMethod=<%= paymentMethod %>"
                            class="px-3.5 py-1.5 rounded-lg border transition-all <%= period === 'daily' ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold shadow-xs' : 'bg-zinc-50 hover:bg-zinc-100 text-zinc-700 border-zinc-200' %>"
                        >
                            1 Day (Today)
                        </a>
                        <a 
                            href="/admin/reports?period=weekly&status=<%= status %>&paymentMethod=<%= paymentMethod %>"
                            class="px-3.5 py-1.5 rounded-lg border transition-all <%= period === 'weekly' ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold shadow-xs' : 'bg-zinc-50 hover:bg-zinc-100 text-zinc-700 border-zinc-200' %>"
                        >
                            1 Week (7 Days)
                        </a>
                        <a 
                            href="/admin/reports?period=monthly&status=<%= status %>&paymentMethod=<%= paymentMethod %>"
                            class="px-3.5 py-1.5 rounded-lg border transition-all <%= period === 'monthly' ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold shadow-xs' : 'bg-zinc-50 hover:bg-zinc-100 text-zinc-700 border-zinc-200' %>"
                        >
                            1 Month (30 Days)
                        </a>
                        <a 
                            href="/admin/reports?period=yearly&status=<%= status %>&paymentMethod=<%= paymentMethod %>"
                            class="px-3.5 py-1.5 rounded-lg border transition-all <%= period === 'yearly' ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold shadow-xs' : 'bg-zinc-50 hover:bg-zinc-100 text-zinc-700 border-zinc-200' %>"
                        >
                            1 Year (365 Days)
                        </a>
                        <button 
                            type="button" 
                            onclick="document.getElementById('customRangeContainer').classList.toggle('hidden')"
                            class="px-3.5 py-1.5 rounded-lg border transition-all <%= period === 'custom' ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold shadow-xs' : 'bg-zinc-50 hover:bg-zinc-100 text-zinc-700 border-zinc-200' %> flex items-center gap-1 cursor-pointer"
                        >
                            <span>Custom Range</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                    </div>
                </div>

                <!-- Custom Range Form (Hidden by default unless custom is active) -->
                <form id="customRangeForm" method="GET" action="/admin/reports" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 text-xs <%= period === 'custom' ? '' : 'hidden' %>" id="customRangeContainer">
                    <input type="hidden" name="period" value="custom">

                    <div class="lg:col-span-3 space-y-1">
                        <label class="block font-mono uppercase text-[9px] font-semibold text-zinc-500">From Date</label>
                        <input 
                            type="date" 
                            name="startDate" 
                            value="<%= startDate %>" 
                            required
                            class="w-full px-3 py-2 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none font-mono text-zinc-800"
                        >
                    </div>

                    <div class="lg:col-span-3 space-y-1">
                        <label class="block font-mono uppercase text-[9px] font-semibold text-zinc-500">To Date</label>
                        <input 
                            type="date" 
                            name="endDate" 
                            value="<%= endDate %>" 
                            required
                            class="w-full px-3 py-2 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none font-mono text-zinc-800"
                        >
                    </div>

                    <div class="lg:col-span-3 space-y-1">
                        <label class="block font-mono uppercase text-[9px] font-semibold text-zinc-500">Order Status</label>
                        <select name="status" class="w-full px-3 py-2 bg-zinc-50 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none text-zinc-800">
                            <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Purchased Orders</option>
                            <option value="Delivered" <%= status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                            <option value="Shipped" <%= status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                            <option value="Processing" <%= status === 'Processing' ? 'selected' : '' %>>Processing</option>
                            <option value="Pending" <%= status === 'Pending' ? 'selected' : '' %>>Pending (Paid)</option>
                        </select>
                    </div>

                    <div class="lg:col-span-3 flex items-end gap-2">
                        <button type="submit" class="w-full py-2 bg-zinc-900 hover:bg-black text-white rounded-xl uppercase tracking-wider font-semibold font-mono text-xs transition-colors cursor-pointer">
                            Apply Dates
                        </button>
                    </div>
                </form>

            </div>

            <!-- Executive KPI Metric Cards (4 Columns) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                
                <!-- 1. Total Purchases Count -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-zinc-400 font-semibold">Total Purchases</span>
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    </div>
                    <p class="text-2xl font-serif text-zinc-900 font-bold font-mono">
                        <%= Number(summary.totalOrders || 0).toLocaleString('en-IN') %>
                    </p>
                    <p class="text-[11px] text-zinc-500 font-light">
                        <%= Number(summary.totalOrders || 0).toLocaleString('en-IN') %> verified client allocations
                    </p>
                </div>

                <!-- 2. Gross Sales Valuation -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-zinc-500 font-semibold">Gross Valuation</span>
                        <span class="w-2.5 h-2.5 rounded-full bg-zinc-400"></span>
                    </div>
                    <p class="text-2xl font-serif text-zinc-900 font-bold font-mono">
                        ₹<%= Number(summary.totalGrossAmount || 0).toLocaleString('en-IN') %>
                    </p>
                    <p class="text-[11px] text-zinc-500 font-light">
                        Original retail valuation
                    </p>
                </div>

                <!-- 3. Coupon Discounts Deducted -->
                <div class="bg-white rounded-2xl p-5 border border-zinc-200/80 shadow-2xs space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-rose-700 font-semibold">Coupon Discounts</span>
                        <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                    </div>
                    <p class="text-2xl font-serif text-rose-700 font-bold font-mono">
                        -₹<%= Number(summary.totalCouponDiscount || summary.totalDiscount || 0).toLocaleString('en-IN') %>
                    </p>
                    <p class="text-[11px] text-zinc-500 font-light">
                        <%= summary.totalCouponsCount || 0 %> coupons redeemed
                    </p>
                </div>

                <!-- 4. Net Revenue Realized -->
                <div class="bg-[#0A4D2E] rounded-2xl p-5 text-white shadow-sm space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] uppercase font-mono tracking-wider text-emerald-200 font-semibold">Net Realized Revenue</span>
                        <span class="w-2.5 h-2.5 rounded-full bg-[#c5a059] animate-pulse"></span>
                    </div>
                    <p class="text-2xl font-serif text-white font-bold font-mono">
                        ₹<%= Number(summary.totalNetRevenue || 0).toLocaleString('en-IN') %>
                    </p>
                    <p class="text-[11px] text-emerald-100/70 font-light">
                        Delivered & active settled funds
                    </p>
                </div>

            </div>

            <!-- Transaction Ledger Table -->
            <div class="bg-white rounded-2xl border border-zinc-200/80 shadow-2xs overflow-hidden">
                <div class="p-5 border-b border-zinc-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-semibold text-zinc-900">Transaction Ledger</h2>
                        <p class="text-xs text-zinc-400 font-light mt-0.5">
                            Showing <%= orders.length %> of <%= pagination.totalOrders %> records for period <%= period.toUpperCase() %> (<%= startDate %> to <%= endDate %>)
                        </p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead>
                            <tr class="bg-zinc-50/70 text-[10px] font-mono uppercase tracking-wider text-zinc-500 font-semibold border-b border-zinc-200/70">
                                <th class="py-3 px-5">DATE & TIME</th>
                                <th class="py-3 px-5">ORDER NUMBER</th>
                                <th class="py-3 px-5">CLIENT / COLLECTOR</th>
                                <th class="py-3 px-5">TIMEPIECE(S)</th>
                                <th class="py-3 px-5">PAYMENT</th>
                                <th class="py-3 px-5 text-right">GROSS</th>
                                <th class="py-3 px-5 text-right">COUPON DISCOUNT</th>
                                <th class="py-3 px-5 text-right">NET TOTAL</th>
                                <th class="py-3 px-5 text-center">STATUS</th>
                                <th class="py-3 px-5 text-right">ACTION</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 text-zinc-700 font-sans">
                            <% if (orders && orders.length > 0) { %>
                                <% orders.forEach(ord => { %>
                                    <% 
                                        const gross = ord.originalSubtotal || (ord.subtotal + (ord.discountAmount || 0));
                                        const dateObj = new Date(ord.createdAt);
                                        const formattedDate = dateObj.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' });
                                        const formattedTime = dateObj.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
                                    %>
                                    <tr class="hover:bg-zinc-50/60 transition-colors">
                                        
                                        <!-- Date & Time -->
                                        <td class="py-3.5 px-5 font-mono text-[11px]">
                                            <span class="font-bold text-zinc-900 block"><%= formattedDate %></span>
                                            <span class="text-[10px] text-zinc-400"><%= formattedTime %></span>
                                        </td>

                                        <!-- Order Number -->
                                        <td class="py-3.5 px-5 font-mono">
                                            <a href="/admin/orders/<%= ord._id %>" class="font-bold text-[#0A4D2E] hover:underline">
                                                <%= ord.orderNumber %>
                                            </a>
                                        </td>

                                        <!-- Client -->
                                        <td class="py-3.5 px-5">
                                            <p class="font-semibold text-zinc-900"><%= ord.collectorName || ord.user?.name || 'Private Collector' %></p>
                                            <p class="text-[10px] text-zinc-400 font-mono"><%= ord.collectorEmail || ord.user?.email || 'N/A' %></p>
                                        </td>

                                        <!-- Items -->
                                        <td class="py-3.5 px-5 text-zinc-600 max-w-xs">
                                            <% if (ord.items && ord.items.length > 0) { %>
                                                <p class="truncate font-medium text-zinc-900" title="<%= ord.items.map(i => i.productName).join(', ') %>">
                                                    <%= ord.items[0].productName %>
                                                    <% if (ord.items.length > 1) { %>
                                                        <span class="text-zinc-400 font-normal text-[11px]">+<%= ord.items.length - 1 %> more</span>
                                                    <% } %>
                                                </p>
                                                <span class="text-[10px] text-zinc-400 font-mono"><%= ord.items.reduce((sum, i) => sum + i.quantity, 0) %> units</span>
                                            <% } else { %>
                                                <span class="text-zinc-400 italic">No items</span>
                                            <% } %>
                                        </td>

                                        <!-- Payment Method -->
                                        <td class="py-3.5 px-5 font-mono text-[11px]">
                                            <span class="inline-block px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 text-[10px] font-semibold">
                                                <%= ord.paymentMethod || 'COD' %>
                                            </span>
                                            <span class="block text-[9px] uppercase font-bold mt-0.5 <%= ord.paymentStatus === 'Completed' ? 'text-emerald-700' : ord.paymentStatus === 'Failed' ? 'text-rose-600' : 'text-amber-700' %>">
                                                <%= ord.paymentStatus || 'Pending' %>
                                            </span>
                                        </td>

                                        <!-- Gross -->
                                        <td class="py-3.5 px-5 text-right font-mono text-zinc-500">
                                            ₹<%= Number(gross || 0).toLocaleString('en-IN') %>
                                        </td>

                                        <!-- Coupon Discount -->
                                        <td class="py-3.5 px-5 text-right font-mono">
                                            <% 
                                                const couponCode = (ord.appliedCoupons && ord.appliedCoupons.length > 0)
                                                    ? ord.appliedCoupons.map(c => c.code).filter(Boolean).join(', ')
                                                    : (ord.appliedCoupon?.code || '');
                                                const couponDisc = Number(ord.discountAmount || 0);
                                            %>
                                            <% if (couponDisc > 0 || couponCode) { %>
                                                <span class="text-rose-600 font-semibold block">-₹<%= couponDisc.toLocaleString('en-IN') %></span>
                                                <% if (couponCode) { %>
                                                    <span class="inline-flex items-center gap-1 mt-0.5 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-[9px] font-bold font-mono uppercase tracking-wider">
                                                        🏷️ <%= couponCode %>
                                                    </span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-zinc-300">₹0</span>
                                            <% } %>
                                        </td>

                                        <!-- Net Total -->
                                        <td class="py-3.5 px-5 text-right font-mono font-bold text-zinc-900 text-sm">
                                            ₹<%= Number(ord.grandTotal || 0).toLocaleString('en-IN') %>
                                        </td>

                                        <!-- Status -->
                                        <td class="py-3.5 px-5 text-center font-mono">
                                            <span class="px-2.5 py-1 rounded-full text-[9px] font-bold uppercase tracking-wider inline-block
                                                <%= ord.orderStatus === 'Delivered' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 
                                                   ord.orderStatus === 'Cancelled' ? 'bg-rose-50 text-rose-800 border border-rose-200' : 
                                                   ord.orderStatus === 'Returned' ? 'bg-purple-50 text-purple-800 border border-purple-200' : 
                                                   ord.orderStatus === 'Shipped' ? 'bg-blue-50 text-blue-800 border border-blue-200' : 
                                                   'bg-amber-50 text-amber-800 border border-amber-200' %>">
                                                <%= ord.orderStatus %>
                                            </span>
                                        </td>

                                        <!-- Action -->
                                        <td class="py-3.5 px-5 text-right">
                                            <a 
                                                href="/admin/orders/<%= ord._id %>" 
                                                class="px-2.5 py-1 bg-zinc-100 hover:bg-zinc-200 text-zinc-700 hover:text-zinc-900 rounded-lg text-[10px] font-mono font-bold uppercase transition-colors"
                                            >
                                                Inspect
                                            </a>
                                        </td>

                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="10" class="py-16 text-center">
                                        <div class="space-y-2">
                                            <span class="text-3xl">📊</span>
                                            <p class="text-sm font-serif text-zinc-700">No Sales Records Found for this Period</p>
                                            <p class="text-xs text-zinc-400 font-light">Adjust your date range or filters to examine historical ledger entries.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                <% if (pagination.totalPages > 1) { %>
                    <div class="p-4 bg-[#faf8f7] border-t border-zinc-200/80 flex flex-col sm:flex-row items-center justify-between text-xs font-mono gap-3">
                        <span class="text-zinc-500">
                            Showing <%= orders.length %> of <%= pagination.totalOrders %> records (Page <%= pagination.currentPage %> of <%= pagination.totalPages %>)
                        </span>
                        
                        <div class="flex items-center gap-1.5">
                            <% if (pagination.hasPrevPage) { %>
                                <a href="/admin/reports?page=<%= pagination.currentPage - 1 %>&period=<%= period %>&startDate=<%= startDate %>&endDate=<%= endDate %>&status=<%= status %>&paymentMethod=<%= paymentMethod %>" class="px-3 py-1.5 bg-white border border-zinc-200 rounded-lg text-zinc-700 hover:bg-zinc-50 font-bold">← Prev</a>
                            <% } %>
                            <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                                <a href="/admin/reports?page=<%= p %>&period=<%= period %>&startDate=<%= startDate %>&endDate=<%= endDate %>&status=<%= status %>&paymentMethod=<%= paymentMethod %>" class="px-3 py-1.5 rounded-lg border <%= p === pagination.currentPage ? 'bg-[#0A4D2E] text-white border-[#0A4D2E] font-bold' : 'bg-white border-zinc-200 text-zinc-700 hover:bg-zinc-50' %>">
                                    <%= p %>
                                </a>
                            <% } %>
                            <% if (pagination.hasNextPage) { %>
                                <a href="/admin/reports?page=<%= pagination.currentPage + 1 %>&period=<%= period %>&startDate=<%= startDate %>&endDate=<%= endDate %>&status=<%= status %>&paymentMethod=<%= paymentMethod %>" class="px-3 py-1.5 bg-white border border-zinc-200 rounded-lg text-zinc-700 hover:bg-zinc-50 font-bold">Next →</a>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
</div>

<%- include('../partials/footer') %>
