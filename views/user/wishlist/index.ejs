<%
    const safeItems = (typeof items !== 'undefined' && Array.isArray(items)) ? items : (
        (typeof products !== 'undefined' && Array.isArray(products)) ? products.map(p => ({
            _id: p._id,
            product: p,
            variant: (p.variants && p.variants[0]) ? p.variants[0] : { color: 'Standard Edition', colorCode: '#1b1c1c', material: 'Oystersteel', dial: 'Sunburst Dial', images: p.images || [], price: p.price, discountPrice: p.discountPrice, stock: p.stock },
            availableStock: p.stock || 0,
            isOutOfStock: (p.stock || 0) <= 0,
            isProductDisabled: p.isDeleted || p.isActive === false || (p.brand && (p.brand.isDeleted || p.brand.isActive === false)),
            isPurchaseDisabled: (p.stock || 0) <= 0 || p.isDeleted || p.isActive === false
        })) : []
    );
%>
<%- include('../partials/header', { title: 'My Private Collection — DELTA' }) %>
<%- include('../partials/navbar') %>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-14">
    <div class="max-w-7xl mx-auto px-6 space-y-10" id="wishlistMainContainer">
        
        <!-- Header -->
        <div class="text-center space-y-3 max-w-2xl mx-auto">
            <h1 class="text-4xl sm:text-5xl font-serif font-normal tracking-tight text-zinc-900">
                My Private Collection
            </h1>
            <p class="text-xs sm:text-sm text-zinc-500 font-light leading-relaxed">
                A curated registry of your desired timepieces and orders. Manage your future heritage and enquire with your private client advisor.
            </p>
        </div>

        <!-- Flash Alert -->
        <%- include('../partials/flash-message') %>

        <div id="wishlistContentWrapper" class="space-y-8">
            <% if (safeItems && safeItems.length > 0) { %>
                <!-- Action Bar with Add All to Cart Button -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-200/80" id="wishlistActionBar">
                    <div class="flex items-center gap-2">
                        <span class="text-xs uppercase font-mono tracking-widest text-zinc-500 font-semibold">
                            <span id="wishlistCountHeader"><%= safeItems.length %></span> Timepiece Edition<%= safeItems.length === 1 ? '' : 's' %> Curated
                        </span>
                    </div>

                    <div class="flex items-center gap-3">
                        <button 
                            type="button" 
                            id="addAllToCartBtn"
                            onclick="addAllWishlistToCart()"
                            class="inline-flex items-center justify-center gap-2 bg-[#0A4D2E] hover:bg-[#083e25] text-white px-6 py-3 rounded-xl text-xs uppercase font-semibold tracking-[0.15em] transition-all shadow-md shadow-[#0A4D2E]/15 active:scale-[0.99] cursor-pointer"
                        >
                            <span>+ Add All to Cart</span>
                        </button>
                    </div>
                </div>

                <!-- 3-Column Wishlist Cards Grid -->
                <div id="wishlistGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% safeItems.forEach((item) => { %>
                        <%
                            const p = item.product || {};
                            const v = item.variant || {};
                            const isProductDisabled = item.isProductDisabled;
                            const isOutOfStock = item.isOutOfStock;
                            const isPurchaseDisabled = item.isPurchaseDisabled;
                            const cardId = item._id ? item._id.toString() : (p._id ? p._id.toString() : '');
                            const imageSrc = (v.images && v.images.length > 0) ? v.images[0] : (p.images && p.images.length > 0 ? p.images[0] : '');
                            const priceToDisplay = (v.discountPrice !== undefined && v.discountPrice !== null && v.discountPrice < v.price) 
                                ? v.discountPrice 
                                : ((p.discountPrice && p.discountPrice < p.price) ? p.discountPrice : (v.price || p.price || 0));
                            const regularPrice = v.price || p.price || 0;
                            const hasDiscount = (v.discountPrice !== undefined && v.discountPrice !== null && v.discountPrice < v.price) || (p.discountPrice && p.discountPrice < p.price);
                        %>
                        <div id="wishlist-card-<%= cardId %>" class="wishlist-item-card bg-white rounded-3xl border border-zinc-200/80 p-8 flex flex-col justify-between space-y-6 shadow-sm hover:shadow-md transition-all duration-300 relative group <%= isProductDisabled ? 'opacity-80' : '' %>">
                            
                            <!-- Remove button (top right) -->
                            <button 
                                type="button" 
                                onclick="removeFromWishlist('<%= cardId %>', '<%= p._id %>', '<%= v.variantId || '' %>', '<%= v.color || '' %>')"
                                class="absolute top-5 right-5 w-8 h-8 rounded-full bg-zinc-100 hover:bg-rose-50 text-zinc-400 hover:text-rose-600 flex items-center justify-center transition-colors shadow-xs cursor-pointer z-10"
                                title="Remove from Private Collection"
                            >
                                ✕
                            </button>

                            <div class="space-y-4">
                                <!-- Image Frame -->
                                <a href="/product/<%= p.slug %>?variant=<%= encodeURIComponent(v.color || '') %>" class="block aspect-square w-full rounded-2xl bg-[#f2eeeb] overflow-hidden p-6 flex items-center justify-center group-hover:scale-[1.02] transition-transform">
                                    <% if (imageSrc) { %>
                                        <img src="<%= imageSrc %>" alt="<%= p.name %> - <%= v.color %>" class="w-full h-full object-cover <%= isProductDisabled ? 'grayscale-[40%]' : '' %>">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-zinc-300 text-3xl">⏱</div>
                                    <% } %>
                                </a>

                                <!-- Title, Variant Edition Swatch & Valuation -->
                                <div class="space-y-2 pt-2 pr-6">
                                    <div class="flex items-start justify-between gap-2">
                                        <div>
                                            <h3 class="font-serif text-lg font-normal text-zinc-900 leading-snug">
                                                <%= p.brand ? (p.brand.name || p.brand) : (p.brandName || 'Manufacture') %>
                                            </h3>
                                            <p class="text-xs text-zinc-600 font-light"><%= p.name %></p>
                                        </div>
                                        <% if (isProductDisabled) { %>
                                            <span class="text-[9px] uppercase font-mono tracking-wider font-semibold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-lg border border-rose-200/80 shrink-0">
                                                Unavailable
                                            </span>
                                        <% } else if (isOutOfStock) { %>
                                            <span class="text-[9px] uppercase font-mono tracking-wider font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200/80 shrink-0">
                                                Sold Out
                                            </span>
                                        <% } else { %>
                                            <span class="text-[9px] uppercase font-mono tracking-wider font-semibold text-[#0A4D2E] bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200/80 shrink-0">
                                                In Boutique
                                            </span>
                                        <% } %>
                                    </div>

                                    <!-- Unique Variant Pill Badge -->
                                    <div class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-zinc-50 border border-zinc-200/60 w-fit">
                                        <span class="w-3 h-3 rounded-full border border-black/20 flex-shrink-0" style="background-color: <%= (v.colorCode && v.colorCode.trim()) ? v.colorCode : '#1b1c1c' %>"></span>
                                        <span class="text-[11px] font-medium text-zinc-800"><%= v.color || 'Standard Edition' %></span>
                                        <% if (v.material) { %>
                                            <span class="text-[10px] text-zinc-400 font-mono truncate">• <%= v.material %></span>
                                        <% } %>
                                    </div>

                                    <!-- Price -->
                                    <div class="flex items-baseline gap-2 pt-0.5">
                                        <p class="text-sm font-mono font-semibold text-[#0A4D2E]">₹<%= Number(priceToDisplay).toLocaleString('en-IN') %></p>
                                        <% if (hasDiscount) { %>
                                            <span class="text-[11px] text-zinc-400 line-through font-mono">₹<%= Number(regularPrice).toLocaleString('en-IN') %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="space-y-2 pt-4 border-t border-zinc-100">
                                <% if (isProductDisabled) { %>
                                    <button 
                                        type="button"
                                        id="add-cart-btn-<%= cardId %>"
                                        disabled
                                        class="w-full py-3 bg-zinc-100 text-zinc-400 text-xs font-semibold uppercase tracking-[0.2em] rounded-xl border border-zinc-200 cursor-not-allowed text-center flex items-center justify-center gap-2 select-none"
                                        title="This timepiece is currently unavailable"
                                    >
                                        <span>Currently Unavailable</span>
                                    </button>
                                <% } else if (isOutOfStock) { %>
                                    <button 
                                        type="button"
                                        id="add-cart-btn-<%= cardId %>"
                                        disabled
                                        class="w-full py-3 bg-zinc-100 text-zinc-400 text-xs font-semibold uppercase tracking-[0.2em] rounded-xl border border-zinc-200 cursor-not-allowed text-center flex items-center justify-center gap-2 select-none"
                                        title="This timepiece edition is currently sold out in the vault"
                                    >
                                        <span>Sold Out in Vault</span>
                                    </button>
                                <% } else { %>
                                    <button 
                                        type="button"
                                        id="add-cart-btn-<%= cardId %>"
                                        onclick="addFromWishlistToCart('<%= cardId %>', '<%= p._id %>', '<%= v.color || 'Standard' %>', '<%= v.variantId || '' %>')"
                                        class="w-full py-3 bg-[#1a1c1e] hover:bg-black text-white text-xs font-semibold uppercase tracking-[0.2em] rounded-xl transition-all shadow-sm cursor-pointer text-center flex items-center justify-center gap-2"
                                    >
                                        <span>Add to Cart</span>
                                    </button>
                                <% } %>
                                
                                <button 
                                    type="button" 
                                    onclick="window.location.href='/product/<%= p.slug %>?variant=<%= encodeURIComponent(v.color || '') %>'"
                                    class="w-full py-3 bg-[#24272a] hover:bg-black text-white text-xs font-semibold uppercase tracking-[0.2em] rounded-xl transition-colors cursor-pointer text-center"
                                >
                                    View Edition Dossier
                                </button>
                            </div>

                        </div>
                    <% }) %>
                </div>

            <% } else { %>
                <!-- Empty Wishlist State -->
                <div id="emptyWishlistView" class="py-24 text-center space-y-4 max-w-md mx-auto">
                    <div class="w-16 h-16 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-2xl">
                        ♡
                    </div>
                    <h3 class="text-2xl font-serif text-zinc-900">Your Private Collection is Empty</h3>
                    <p class="text-xs text-zinc-500 font-light leading-relaxed">
                        Save your desired Swiss manufacture references to track availability, allocations, and boutique appointments.
                    </p>
                    <div class="pt-2">
                        <a href="/shop" class="inline-block px-7 py-3.5 bg-zinc-900 text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black transition-colors">
                            Explore Haute Horlogerie
                        </a>
                    </div>
                </div>
            <% } %>
        </div>

    </div>
</div>

<%- include('../partials/footer') %>

<script>
    function renderEmptyWishlistView() {
        const wrapper = document.getElementById('wishlistContentWrapper');
        if (!wrapper) return;
        wrapper.innerHTML = `
            <div id="emptyWishlistView" class="py-24 text-center space-y-4 max-w-md mx-auto animate-fade-in">
                <div class="w-16 h-16 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-2xl">
                    ♡
                </div>
                <h3 class="text-2xl font-serif text-zinc-900">Your Private Collection is Empty</h3>
                <p class="text-xs text-zinc-500 font-light leading-relaxed">
                    Save your desired Swiss manufacture references to track availability, allocations, and boutique appointments.
                </p>
                <div class="pt-2">
                    <a href="/shop" class="inline-block px-7 py-3.5 bg-zinc-900 text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black transition-colors">
                        Explore Haute Horlogerie
                    </a>
                </div>
            </div>
        `;
    }

    async function removeFromWishlist(itemId, productId, variantId, variantColor) {
        try {
            const res = await fetch('/wishlist/remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ itemId, productId, variantId, variantColor })
            });
            const data = await res.json();
            
            if (res.status === 401 || data.redirect) {
                window.location.href = data.redirect || '/login';
                return;
            }
            if (data.success) {
                const card = document.getElementById('wishlist-card-' + itemId) || document.getElementById('wishlist-card-' + productId);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        card.remove();
                        const remainingCards = document.querySelectorAll('.wishlist-item-card');
                        const countHeader = document.getElementById('wishlistCountHeader');
                        if (countHeader) countHeader.textContent = remainingCards.length;
                        if (remainingCards.length === 0) {
                            renderEmptyWishlistView();
                        }
                    }, 250);
                }
                if (window.showToast) {
                    window.showToast(data.message || 'Item removed from wishlist successfully.', 'success', 3000);
                }
                if (window.updateNavbarCounters && data.wishlistCount !== undefined) {
                    window.updateNavbarCounters(undefined, data.wishlistCount);
                }
            } else {
                if (window.showToast) {
                    window.showToast(data.message || 'Unable to remove timepiece.', 'warning');
                } else {
                    alert(data.message || 'Unable to remove timepiece.');
                }
            }
        } catch (e) {
            if (window.showToast) {
                window.showToast('Wishlist connection error.', 'error');
            } else {
                alert('Wishlist connection error.');
            }
        }
    }

    async function addFromWishlistToCart(itemId, productId, variantColor, variantId) {
        const btn = document.getElementById('add-cart-btn-' + itemId);
        const originalContent = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="animate-pulse">Adding to bag...</span>';
        }

        try {
            const res = await fetch('/cart/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ productId, variantColor, variantId, quantity: 1 })
            });
            const data = await res.json();
            
            if (res.status === 401 || data.redirect) {
                window.location.href = data.redirect || '/login';
                return;
            }

            if (data.success) {
                // Also remove this item from the wishlist on the backend
                try {
                    const wishRes = await fetch('/wishlist/remove', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                        body: JSON.stringify({ itemId, productId, variantId, variantColor })
                    });
                    const wishData = await wishRes.json();
                    if (window.updateNavbarCounters && wishData.wishlistCount !== undefined) {
                        window.updateNavbarCounters(undefined, wishData.wishlistCount);
                    }
                } catch (e) {}

                if (window.showToast) {
                    window.showToast('Timepiece edition added to your shopping bag.', 'success', 3500);
                }

                if (window.updateNavbarCounters) {
                    const cartTotal = data.cartCount || (data.cart && data.cart.totalItemCount);
                    window.updateNavbarCounters(cartTotal);
                }

                // Smoothly remove the card from the wishlist view since it moved to bag
                const card = document.getElementById('wishlist-card-' + itemId) || document.getElementById('wishlist-card-' + productId);
                if (card) {
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        card.remove();
                        const remainingCards = document.querySelectorAll('.wishlist-item-card');
                        const countHeader = document.getElementById('wishlistCountHeader');
                        if (countHeader) countHeader.textContent = remainingCards.length;
                        if (remainingCards.length === 0) {
                            renderEmptyWishlistView();
                        }
                    }, 250);
                }
            } else {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
                if (window.showToast) {
                    window.showToast(data.message || 'Unable to add to shopping bag.', 'warning');
                } else {
                    alert(data.message || 'Unable to add to shopping bag.');
                }
            }
        } catch (e) {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
            if (window.showToast) {
                window.showToast('Cart connection error.', 'error');
            } else {
                alert('Cart connection error.');
            }
        }
    }

    async function addAllWishlistToCart() {
        const btn = document.getElementById('addAllToCartBtn');
        const originalText = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="animate-pulse">Adding to Bag...</span>';
        }

        try {
            const res = await fetch('/wishlist/add-all-to-cart', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
            });
            const data = await res.json();

            if (res.status === 401 || data.redirect) {
                window.location.href = data.redirect || '/login';
                return;
            }

            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }

            if (data.success) {
                if (window.showToast) {
                    window.showToast(data.message, data.toastType || 'success', 4000);
                }
                if (window.updateNavbarCounters) {
                    window.updateNavbarCounters(data.cartCount, data.wishlistCount);
                }

                // Smoothly remove successfully added cards
                if (data.addedProductIds && data.addedProductIds.length > 0) {
                    data.addedProductIds.forEach(id => {
                        const card = document.getElementById('wishlist-card-' + id);
                        if (card) {
                            card.style.opacity = '0';
                            card.style.transform = 'scale(0.95)';
                            setTimeout(() => card.remove(), 250);
                        }
                    });
                }

                // Update count header
                setTimeout(() => {
                    const remainingCards = document.querySelectorAll('.wishlist-item-card');
                    const countHeader = document.getElementById('wishlistCountHeader');
                    if (countHeader) countHeader.textContent = remainingCards.length;
                    if (remainingCards.length === 0) {
                        renderEmptyWishlistView();
                    }
                }, 300);

            } else {
                if (window.showToast) {
                    window.showToast(data.message || 'Unable to add items to shopping bag.', 'warning');
                } else {
                    alert(data.message || 'Unable to add items to shopping bag.');
                }
            }
        } catch (e) {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
            if (window.showToast) {
                window.showToast('Connection error adding items.', 'error');
            } else {
                alert('Connection error.');
            }
        }
    }
</script>
