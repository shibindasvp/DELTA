        </div>

        <!-- Valuation Breakdown -->
        <div class="p-3.5 bg-zinc-50 rounded-2xl border border-zinc-200/80 text-xs space-y-2 text-left font-mono">
            <div class="flex items-center justify-between text-zinc-500 text-[11px]">
                <span>Settlement Instrument:</span>
                <span id="rzpFailConfirmPayMethod" class="font-bold text-zinc-800">UPI</span>
            </div>
            <div class="flex items-center justify-between text-zinc-500 text-[11px]">
                <span>Order Reference:</span>
                <span id="rzpFailConfirmPayOrderRef" class="font-bold text-zinc-800 truncate max-w-[150px]"><%= order ? order.orderNumber : '' %></span>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-zinc-200 text-sm">
                <span class="text-zinc-600 font-sans font-semibold">Total Debit:</span>
                <span id="rzpFailConfirmPayAmount" class="font-bold text-[#0A4D2E] text-base">₹<%= Number(order ? order.grandTotal : 0).toLocaleString('en-IN') %></span>
            </div>
        </div>

        <!-- Confirm Actions -->
        <div class="space-y-2 pt-1">
            <button 
                type="button" 
                onclick="executeConfirmedFailRazorpayPay()" 
                class="w-full py-3.5 px-4 bg-[#0A4D2E] hover:bg-[#073620] text-white rounded-xl text-xs uppercase font-mono tracking-wider font-bold shadow-md transition-all cursor-pointer flex items-center justify-center gap-2"
            >
                <span>Yes, Authorize & Pay</span>
                <span>✓</span>
            </button>
            <button 
                type="button" 
                onclick="closeFailRzpConfirmPayModal()" 
                class="w-full py-3 px-4 bg-zinc-100 hover:bg-zinc-200 text-zinc-700 rounded-xl text-xs uppercase font-mono tracking-wider font-semibold transition-colors cursor-pointer"
            >
                Cancel / Return
            </button>
        </div>
    </div>
</div>

<!-- ========================================================= -->
<!-- RAZORPAY FAILURE RETRY CONFIRM DECLINE MODAL -->
<!-- ========================================================= -->
<div id="rzpFailConfirmDeclineModal" class="fixed inset-0 z-[60] bg-black/75 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 space-y-5 shadow-2xl relative border border-rose-200 text-center animate-in fade-in zoom-in duration-150">
        <!-- Rose Decline Medallion -->
        <div class="w-16 h-16 rounded-full bg-rose-50 text-rose-700 mx-auto flex items-center justify-center border-2 border-rose-200 shadow-xs">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
        </div>

        <div class="space-y-1.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-rose-50 text-rose-800 border border-rose-200">
                SIMULATE BANK DECLINE
            </span>
            <h3 class="text-xl font-serif font-bold text-zinc-900">Decline Payment?</h3>
            <p class="text-xs text-zinc-500 font-light leading-relaxed">
                This will simulate an issuing bank refusal. In accordance with security policy, you can re-buy this timepiece only after 5 minutes.
            </p>
        </div>

        <!-- Order Snapshot -->
        <div class="p-3.5 bg-rose-50/50 rounded-2xl border border-rose-200/60 text-xs space-y-2 text-left font-mono">
            <div class="flex items-center justify-between text-zinc-500 text-[11px]">
                <span>Simulation Type:</span>
                <span class="font-bold text-rose-700">Bank Decline / 3DS Refusal</span>
            </div>
            <div class="flex items-center justify-between text-zinc-500 text-[11px]">
                <span>Order Reference:</span>
                <span class="font-bold text-zinc-800 truncate max-w-[150px]"><%= order ? order.orderNumber : '' %></span>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-rose-200 text-sm">
                <span class="text-zinc-600 font-sans font-semibold">Unpaid Amount:</span>
                <span id="rzpFailConfirmDeclineAmount" class="font-bold text-rose-700 text-base">₹<%= Number(order ? order.grandTotal : 0).toLocaleString('en-IN') %></span>
            </div>
        </div>

        <!-- Decline Actions -->
        <div class="space-y-2 pt-1">
            <button 
                type="button" 
                onclick="executeConfirmedFailRazorpayDecline()" 
                class="w-full py-3.5 px-4 bg-rose-700 hover:bg-rose-800 text-white rounded-xl text-xs uppercase font-mono tracking-wider font-bold shadow-md transition-all cursor-pointer flex items-center justify-center gap-2"
            >
                <span>Yes, Decline Settlement</span>
                <span>✕</span>
            </button>
            <button 
                type="button" 
                onclick="closeFailRzpConfirmDeclineModal()" 
                class="w-full py-3 px-4 bg-zinc-100 hover:bg-zinc-200 text-zinc-700 rounded-xl text-xs uppercase font-mono tracking-wider font-semibold transition-colors cursor-pointer"
            >
                Cancel / Return
            </button>
        </div>
    </div>
</div>

<script>
    let activeRetryData = null;
    let cooldownRemainingSeconds = <%= typeof cooldown !== 'undefined' && cooldown && cooldown.inCooldown ? cooldown.remainingSeconds : 0 %>;
    let cooldownTimerInterval = null;

    function startCooldownTimer(seconds) {
        cooldownRemainingSeconds = seconds;
        if (cooldownTimerInterval) clearInterval(cooldownTimerInterval);

        const banner = document.getElementById('declineCooldownBanner');
        const timerDisplay = document.getElementById('cooldownTimerDisplay');

        if (seconds <= 0) {
            if (banner) banner.classList.add('hidden');
            return;
        }

        if (banner) {
            banner.classList.remove('hidden');
            banner.classList.add('flex');
        }

        const updateUI = () => {
            const mins = Math.floor(cooldownRemainingSeconds / 60);
            const secs = (cooldownRemainingSeconds % 60).toString().padStart(2, '0');
            const formatted = `${mins}:${secs}`;
            if (timerDisplay) timerDisplay.textContent = formatted;

            if (cooldownRemainingSeconds <= 0) {
                clearInterval(cooldownTimerInterval);
                if (banner) banner.classList.add('hidden');
                if (window.showToast) window.showToast('5-minute catalog security interval ended.', 'info');
            }
            cooldownRemainingSeconds--;
        };

        updateUI();
        cooldownTimerInterval = setInterval(updateUI, 1000);
    }

    function handleFailureRetryClick() {
        openRetryModal();
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (cooldownRemainingSeconds > 0) {
            startCooldownTimer(cooldownRemainingSeconds);
        }
    });

    function openRetryModal() {
        const errEl = document.getElementById('retryModalErr');
        if (errEl) errEl.classList.add('hidden');
        selectRetryGw('Razorpay');
        const m = document.getElementById('retryPaymentModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeRetryModal() {
        const m = document.getElementById('retryPaymentModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function selectRetryGw(gw) {
        const rzpRadio = document.getElementById('retryGwRzp');
        const walletRadio = document.getElementById('retryGwWallet');
        const codRadio = document.getElementById('retryGwCod');

        if (rzpRadio) rzpRadio.checked = (gw === 'Razorpay');
        if (walletRadio) walletRadio.checked = (gw === 'Wallet');
        if (codRadio) codRadio.checked = (gw === 'Cash on Delivery');

        const cardRzp = document.getElementById('retryCardRazorpay');
        const cardWallet = document.getElementById('retryCardWallet');
        const cardCod = document.getElementById('retryCardCod');

        [cardRzp, cardWallet, cardCod].forEach(c => {
            if (c) {
                c.classList.remove('border-[#0A4D2E]', 'bg-emerald-50/20');
                c.classList.add('border-zinc-200', 'bg-white');
            }
        });

        let target = cardRzp;
        if (gw === 'Wallet') target = cardWallet;
        else if (gw === 'Cash on Delivery') target = cardCod;

        if (target) {
            target.classList.add('border-[#0A4D2E]', 'bg-emerald-50/20');
            target.classList.remove('border-zinc-200', 'bg-white');
        }
    }

    async function executeRetryPayment() {
        const rzpRadio = document.getElementById('retryGwRzp');
        const walletRadio = document.getElementById('retryGwWallet');
        const codRadio = document.getElementById('retryGwCod');

        let paymentMethod = 'Razorpay';
        if (walletRadio && walletRadio.checked) paymentMethod = 'Wallet';
        else if (codRadio && codRadio.checked) paymentMethod = 'Cash on Delivery';

        const btn = document.getElementById('confirmRetryBtn');
        const errEl = document.getElementById('retryModalErr');

        if (errEl) errEl.classList.add('hidden');
        if (btn) btn.disabled = true;

        if (paymentMethod === 'Wallet' && window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Authorizing Vault Reserve Settlement',
                subtitle: 'Debiting verified reserve...',
                amount: <%= Number(order ? order.grandTotal : 0) %>,
                method: 'DELTA Vault Reserve'
            });
        } else if (paymentMethod === 'Cash on Delivery' && window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Converting to Cash on Delivery',
                subtitle: 'Allocating complimentary white-glove courier settlement...',
                amount: <%= Number(order ? order.grandTotal : 0) %>,
                method: 'Cash on Delivery'
            });
        }

        try {
            const res = await fetch('/orders/<%= order ? order._id : "" %>/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ paymentMethod })
            });
            const data = await res.json();
            if (!data.success) {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                if (errEl) {
                    errEl.textContent = data.message || 'Payment retry initialization failed.';
                    errEl.classList.remove('hidden');
                }
                return;
            }

            if (data.gateway === 'Wallet' || data.gateway === 'Cash on Delivery' || data.completed) {
                if (window.DeltaPaymentAnimation) {
                    window.DeltaPaymentAnimation.success({
                        title: paymentMethod === 'Wallet' ? 'Vault Settlement Confirmed' : 'Order Switched to Cash on Delivery',
                        subtitle: 'Allocation secured in DELTA Vault.',
                        redirectUrl: data.redirect || '/order/success/<%= order ? order._id : "" %>',
                        delayMs: 1200
                    });
                } else {
                    window.location.href = data.redirect || '/order/success/<%= order ? order._id : "" %>';
                }
                return;
            }

            activeRetryData = data;
            closeRetryModal();

            const isRealRazorpay = typeof window.Razorpay === 'function' &&
                !data.isSimulated &&
                data.keyId &&
                !data.keyId.includes('deltaVault') &&
                !data.keyId.includes('dummy') &&
                data.razorpayOrderId &&
                !data.razorpayOrderId.startsWith('order_delta_');

            if (isRealRazorpay) {
                const options = {
                    key: data.keyId,
                    amount: data.amount,
                    currency: data.currency || 'INR',
                        name: 'DELTA Haute Horlogerie',
                        description: 'Retry Settlement — Order ' + data.orderNumber,
                        order_id: data.razorpayOrderId,
                        prefill: {
                            name: data.user?.name || '',
                            email: data.user?.email || '',
                            contact: data.user?.phone || ''
                        },
                        theme: { color: '#0A4D2E' },
                        handler: async function (response) {
                            await sendRetryVerification({
                                paymentMethod: 'Razorpay',
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature
                            });
                        },
                        modal: {
                            ondismiss: function () {
                                if (window.showToast) window.showToast('Payment window was dismissed.', 'info');
                            }
                        }
                    };
                    try {
                        const rzp = new window.Razorpay(options);
                        rzp.on('payment.failed', function (resp) {
                            const desc = resp.error?.description || resp.error?.reason || 'Payment was declined.';
                            if (window.showToast) window.showToast(desc, 'error');
                        });
                        rzp.open();
                    } catch (err) {
                        console.warn("[Razorpay] Live SDK failed to open, switching to simulation fallback:", err);
                        openRzpSimModal(data);
                    }
                } else {
                    openRzpSimModal(data);
                }
        } catch (err) {
            if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
            if (errEl) {
                errEl.textContent = 'Connection error initiating payment retry.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    let currentFailureRzpTab = 'upi';
    let currentFailureRzpSubMethod = 'UPI';

    function switchFailureRzpTab(tab) {
        currentFailureRzpTab = tab;
        ['upi', 'card', 'netbanking', 'wallet'].forEach(t => {
            const btn = document.getElementById(`rzpFailTabBtn_${t}`);
            const panel = document.getElementById(`rzpFailPanel_${t}`);
            if (btn) {
                if (t === tab) {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer bg-white text-zinc-900 shadow-xs font-semibold flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.add('text-[#0A4D2E]');
                } else {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer text-zinc-500 hover:text-zinc-900 flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.remove('text-[#0A4D2E]');
                }
            }
            if (panel) {
                if (t === tab) panel.classList.remove('hidden');
                else panel.classList.add('hidden');
            }
        });
        updateFailureRzpPayButtonText();
    }

    function selectFailureRzpUpiApp(app, vpa) {
        currentFailureRzpSubMethod = app;
        const vpaInput = document.getElementById('rzpFailUpiVpaInput');
        if (vpaInput) vpaInput.value = vpa;
        ['gpay', 'phonepe', 'paytm', 'bhim'].forEach(a => {
            const btn = document.getElementById(`rzpFailUpiApp_${a}`);
            if (btn) {
                btn.className = "p-2 rounded-xl border border-zinc-200 bg-white flex flex-col items-center justify-center gap-1 text-[11px] font-semibold text-zinc-600 transition-all cursor-pointer";
            }
        });
        const activeKey = app === 'Google Pay' ? 'gpay' : app === 'PhonePe' ? 'phonepe' : app === 'Paytm' ? 'paytm' : 'bhim';
        const activeBtn = document.getElementById(`rzpFailUpiApp_${activeKey}`);
        if (activeBtn) {
            activeBtn.className = "p-2 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 flex flex-col items-center justify-center gap-1 text-[11px] font-bold text-zinc-900 transition-all cursor-pointer";
        }
        updateFailureRzpPayButtonText();
    }

    function selectFailureRzpBank(bank) {
        currentFailureRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpFailBank_${b}`);
            if (btn) btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
        });
        const key = bank.includes('HDFC') ? 'HDFC' : bank.includes('ICICI') ? 'ICICI' : bank.includes('State') ? 'SBI' : bank.includes('Axis') ? 'Axis' : bank.includes('Kotak') ? 'Kotak' : 'PNB';
        const activeBtn = document.getElementById(`rzpFailBank_${key}`);
        if (activeBtn) activeBtn.className = "p-2.5 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 text-left transition-all cursor-pointer";
        updateFailureRzpPayButtonText();
    }

    function selectFailureRzpOtherBank(bank) {
        if (!bank) return;
        currentFailureRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpFailBank_${b}`);
            if (btn) btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
        });
        updateFailureRzpPayButtonText();
    }

    function selectFailureRzpWallet(wallet) {
        currentFailureRzpSubMethod = wallet;
        updateFailureRzpPayButtonText();
    }

    function updateFailureRzpPayButtonText() {
        const btn = document.getElementById('rzpFailPayBtnLabel');
        if (!btn) return;
        const totalAmount = (activeRetryData && activeRetryData.grandTotal) 
            ? activeRetryData.grandTotal 
            : (<%= order ? order.grandTotal : 0 %>);
        const amountStr = '₹' + Number(totalAmount).toLocaleString('en-IN');
        let methodLabel = 'UPI';
        if (currentFailureRzpTab === 'upi') methodLabel = currentFailureRzpSubMethod || 'UPI';
        else if (currentFailureRzpTab === 'card') methodLabel = 'Card';
        else if (currentFailureRzpTab === 'netbanking') methodLabel = currentFailureRzpSubMethod || 'NetBanking';
        else if (currentFailureRzpTab === 'wallet') methodLabel = currentFailureRzpSubMethod || 'Wallet';
        btn.textContent = `Authorize & Pay ${amountStr} via ${methodLabel}`;
    }

    function openRzpSimModal(data) {
        const idEl = document.getElementById('simRzpOrderId');
        const amtEl = document.getElementById('simRzpAmount');
        if (idEl) idEl.textContent = data.razorpayOrderId;
        if (amtEl && data.grandTotal) amtEl.textContent = '₹' + Number(data.grandTotal).toLocaleString('en-IN');
        switchFailureRzpTab('upi');
        const m = document.getElementById('rzpSimModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }
    function closeRzpSimModal() {
        closeFailRzpConfirmPayModal();
        closeFailRzpConfirmDeclineModal();
        const m = document.getElementById('rzpSimModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function openFailRzpConfirmPayModal() {
        const m = document.getElementById('rzpFailConfirmPayModal');
        const methodEl = document.getElementById('rzpFailConfirmPayMethod');
        const orderRefEl = document.getElementById('rzpFailConfirmPayOrderRef');
        const amountEl = document.getElementById('rzpFailConfirmPayAmount');

        let methodLabel = 'UPI';
        if (currentFailureRzpTab === 'upi') methodLabel = currentFailureRzpSubMethod || 'UPI';
        else if (currentFailureRzpTab === 'card') methodLabel = 'Credit / Debit Card';
        else if (currentFailureRzpTab === 'netbanking') methodLabel = currentFailureRzpSubMethod || 'NetBanking';
        else if (currentFailureRzpTab === 'wallet') methodLabel = currentFailureRzpSubMethod || 'Digital Wallet';

        if (methodEl) methodEl.textContent = methodLabel;
        if (orderRefEl && activeRetryData) orderRefEl.textContent = activeRetryData.orderNumber || activeRetryData.razorpayOrderId;
        const totalAmount = (activeRetryData && activeRetryData.grandTotal) ? activeRetryData.grandTotal : (<%= order ? order.grandTotal : 0 %>);
        if (amountEl) amountEl.textContent = '₹' + Number(totalAmount).toLocaleString('en-IN');

        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeFailRzpConfirmPayModal() {
        const m = document.getElementById('rzpFailConfirmPayModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    async function executeConfirmedFailRazorpayPay() {
        closeFailRzpConfirmPayModal();
        await simulateRzpSuccess();
    }

    function openFailRzpConfirmDeclineModal() {
        const m = document.getElementById('rzpFailConfirmDeclineModal');
        const orderRefEl = document.getElementById('rzpFailConfirmDeclineOrderRef');
        const amountEl = document.getElementById('rzpFailConfirmDeclineAmount');
        if (orderRefEl && activeRetryData) orderRefEl.textContent = activeRetryData.orderNumber || activeRetryData.razorpayOrderId;
        const totalAmount = (activeRetryData && activeRetryData.grandTotal) ? activeRetryData.grandTotal : (<%= order ? order.grandTotal : 0 %>);
        if (amountEl) amountEl.textContent = '₹' + Number(totalAmount).toLocaleString('en-IN');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeFailRzpConfirmDeclineModal() {
        const m = document.getElementById('rzpFailConfirmDeclineModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    async function executeConfirmedFailRazorpayDecline() {
        closeFailRzpConfirmDeclineModal();
        try {
            await fetch('/orders/<%= order ? order._id : "" %>/record-decline', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason: 'Transaction authorization was declined by user/bank' })
            });
        } catch (e) {}
        simulateRzpDecline();
        startCooldownTimer(300);
    }
    function simulateRzpDecline() {
        closeRzpSimModal();
        if (window.showToast) window.showToast('Simulated payment authorization declined by issuing bank.', 'error');
    }
    async function simulateRzpSuccess() {
        if (!activeRetryData) return;
        closeRzpSimModal();
        await sendRetryVerification({
            paymentMethod: 'Razorpay',
            razorpay_order_id: activeRetryData.razorpayOrderId,
            razorpay_payment_id: activeRetryData.testPaymentId,
            razorpay_signature: activeRetryData.testSignature
        });
    }

    async function sendRetryVerification(payload) {
        if (window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Authorizing Retry Settlement',
                subtitle: 'Authenticating 256-bit cryptographic payload with bank...',
                amount: <%= Number(order ? order.grandTotal : 0) %>,
                method: payload.paymentMethod || 'Razorpay'
            });
        }
        try {
            const res = await fetch('/orders/<%= order ? order._id : "" %>/verify-retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                const redirectTarget = data.redirect || '/order/success/<%= order ? order._id : "" %>';
                if (window.DeltaPaymentAnimation) {
                    window.DeltaPaymentAnimation.success({
                        title: 'Retry Settlement Confirmed',
                        subtitle: 'Timepiece recovered & allocation secured.',
                        redirectUrl: redirectTarget,
                        delayMs: 1200
                    });
                } else {
                    window.location.href = redirectTarget;
                }
            } else {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                const errMsg = data.message || 'Payment verification failed.';
                if (window.showToast) window.showToast(errMsg, 'error');
                else alert(errMsg);
            }
        } catch (err) {
            if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
            const connErrMsg = 'Connection error verifying retry payment.';
            if (window.showToast) window.showToast(connErrMsg, 'error');
            else alert(connErrMsg);
        }
    }
</script>
<% } %>

<%- include('../partials/payment-animation') %>

<%- include('../partials/footer') %>
