<%- include('../partials/header', { title: 'Payment Incomplete — ' + (order ? order.orderNumber : 'DELTA') }) %>
<%- include('../partials/navbar') %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-10">
        
        <!-- ========================================================= -->
        <!-- LUXURY HOROLOGICAL SEAL & PAYMENT FAILURE STATEMENT -->
        <!-- ========================================================= -->
        <div class="text-center space-y-6 max-w-2xl mx-auto">
            
            <!-- Bespoke Horological Interruption / Paused Mechanism Illustration -->
            <div class="relative w-32 h-32 mx-auto flex items-center justify-center">
                <!-- Outer Soft Pulsing Aura -->
                <div class="absolute inset-0 rounded-full bg-rose-100/70 animate-pulse opacity-40"></div>
                
                <!-- Horological Chronometer Outer Gear Ring (SVG) -->
                <svg class="absolute inset-0 w-32 h-32" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="56" fill="none" stroke="#e11d48" stroke-width="1.5" stroke-dasharray="3 5" opacity="0.45"/>
                    <circle cx="60" cy="60" r="49" fill="none" stroke="#c5a059" stroke-width="1" opacity="0.3"/>
                    
                    <!-- 12-Hour Bezel Indices -->
                    <% for(let i = 0; i < 12; i++) { %>
                        <% const angle = i * 30 * (Math.PI / 180); %>
                        <% const x1 = 60 + 51 * Math.sin(angle); %>
                        <% const y1 = 60 - 51 * Math.cos(angle); %>
                        <% const x2 = 60 + 56 * Math.sin(angle); %>
                        <% const y2 = 60 - 56 * Math.cos(angle); %>
                        <line x1="<%= x1 %>" y1="<%= y1 %>" x2="<%= x2 %>" y2="<%= y2 %>" stroke="<%= i % 3 === 0 ? '#e11d48' : '#c5a059' %>" stroke-width="<%= i % 3 === 0 ? '2' : '1' %>" stroke-linecap="round"/>
                    <% } %>
                </svg>

                <!-- Inner Vault Decline Medallion -->
                <div class="w-22 h-22 rounded-full bg-gradient-to-br from-rose-600 via-rose-700 to-zinc-900 text-white flex flex-col items-center justify-center shadow-xl shadow-rose-900/25 border-4 border-white relative z-10">
                    <!-- Rose Security Decline Icon -->
                    <svg class="w-9 h-9 text-rose-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
            </div>

            <!-- Confirmation Statement -->
            <div class="space-y-3">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-rose-50 border border-rose-200">
                    <span class="w-2 h-2 rounded-full bg-rose-600 animate-pulse"></span>
                    <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-rose-800 font-bold">
                        PAYMENT INCOMPLETE • ALLOCATION HELD
                    </span>
                </div>

                <h1 class="text-3xl sm:text-5xl font-serif text-zinc-900 font-normal tracking-tight">
                    Payment Authorization Failed
                </h1>

                <p class="text-xs sm:text-sm text-zinc-500 font-light leading-relaxed max-w-xl mx-auto">
                    We could not complete the payment settlement for your timepiece order. Your reserved piece is temporarily held in vault custody. Please retry settlement using your preferred gateway or another method.
                </p>
            </div>

            <!-- Order Reference Dossier Tag -->
            <% if (order) { %>
                <div class="inline-flex items-center gap-3 px-5 py-2.5 bg-white border border-zinc-200/80 rounded-2xl shadow-xs">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 font-semibold">Order Dossier:</span>
                    <span class="font-mono font-bold text-zinc-900 text-sm tracking-wide"><%= order.orderNumber %></span>
                </div>
            <% } %>

        </div>

        <!-- ========================================================= -->
        <!-- PAYMENT FAILURE REASON & TRANSACTION DETAILS CARD -->
        <!-- ========================================================= -->
        <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-8 space-y-6 shadow-sm">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-100 pb-5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-rose-50 text-rose-700 border border-rose-200/80 flex items-center justify-center text-lg flex-shrink-0 font-bold">
                        ✕
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-rose-600 font-bold block">
                            GATEWAY TRANSACTION REPORT
                        </span>
                        <h2 class="text-xl font-serif text-zinc-900 font-normal">
                            Authorization Decline Notice
                        </h2>
                    </div>
                </div>

                <span class="self-start sm:self-auto px-3.5 py-1 bg-rose-50 border border-rose-200 text-rose-700 rounded-full font-mono text-[10px] uppercase font-bold">
                    Action Required
                </span>
            </div>

            <!-- Failure Explanation Banner -->
            <div class="p-4 rounded-2xl bg-rose-50/70 border border-rose-200 text-xs text-rose-900 space-y-1">
                <span class="text-[10px] uppercase font-mono tracking-wider font-semibold text-rose-600 block">Decline Statement / Provider Reason</span>
                <p class="font-mono text-xs font-semibold leading-relaxed">
                    "<%= reason || (order && order.paymentFailureReason) || 'The transaction authorization was declined by your banking institution or the payment session was dismissed.' %>"
                </p>
            </div>

            <!-- Transaction Metadata Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
                
                <!-- Item 1: Reference No -->
                <div class="p-4 rounded-2xl bg-[#faf8f7] border border-zinc-200/60 space-y-1">
                    <span class="text-[10px] uppercase text-zinc-400 block tracking-wider">Order Reference</span>
                    <p class="font-bold text-zinc-900 truncate"><%= order ? order.orderNumber : 'Cart Session' %></p>
                </div>

                <!-- Item 2: Timestamp -->
                <div class="p-4 rounded-2xl bg-[#faf8f7] border border-zinc-200/60 space-y-1">
                    <span class="text-[10px] uppercase text-zinc-400 block tracking-wider">Attempted At</span>
                    <p class="font-medium text-zinc-800">
                        <%= (order ? new Date(order.declinedAt || order.updatedAt || order.createdAt || Date.now()) : new Date()).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </p>
                </div>

                <!-- Item 3: Payment Method -->
                <div class="p-4 rounded-2xl bg-[#faf8f7] border border-zinc-200/60 space-y-1">
                    <span class="text-[10px] uppercase text-zinc-400 block tracking-wider">Attempted Gateway</span>
                    <p class="font-bold text-zinc-900"><%= order ? order.paymentMethod : 'Razorpay Secure Gateway' %></p>
                </div>

                <!-- Item 4: Amount Due -->
                <div class="p-4 rounded-2xl bg-[#faf8f7] border border-zinc-200/60 space-y-1">
                    <span class="text-[10px] uppercase text-zinc-400 block tracking-wider">Total Due</span>
                    <p class="font-bold text-rose-700 text-sm">
                        <% if (order && order.grandTotal) { %>
                            ₹<%= Number(order.grandTotal).toLocaleString('en-IN') %>
                        <% } else { %>
                            Pending Settlement
                        <% } %>
                    </p>
                </div>

            </div>

            <!-- Common Causes Advice Box -->
            <div class="p-4 rounded-2xl bg-zinc-50 border border-zinc-200/80 space-y-2 text-xs text-zinc-600">
                <span class="text-[10px] uppercase font-mono tracking-wider font-semibold text-zinc-500 block">Recommended Troubleshooting Steps</span>
                <ul class="list-disc list-inside space-y-1 font-light text-[11px] text-zinc-600">
                    <li>Verify that online/international transactions and e-commerce limits are enabled on your card.</li>
                    <li>Ensure you entered the correct 3D Secure OTP or authorized the push notification from your bank before the timer elapsed.</li>
                    <li>If paying via UPI, ensure the transaction amount does not exceed your bank's single-transfer UPI threshold.</li>
                    <li>You may retry using <strong class="font-semibold text-zinc-700">Razorpay Secure Gateway</strong> or switch to complimentary <strong class="font-semibold text-zinc-700">Cash on Delivery</strong>.</li>
                </ul>
            </div>

        </div>

        <!-- ========================================================= -->
        <!-- ACTION BUTTONS: RETRY AND REDIRECT BUTTONS -->
        <!-- ========================================================= -->
        <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-8 space-y-6 shadow-sm">
            <% 
                const isCooldownActive = typeof cooldown !== 'undefined' && cooldown && cooldown.inCooldown;
                const initialSeconds = isCooldownActive ? cooldown.remainingSeconds : 0;
            %>

            <!-- Cooldown Notice Strip (Visible when in 5-minute decline cooldown) -->
            <div id="declineCooldownBanner" class="<%= isCooldownActive ? 'flex' : 'hidden' %> p-4 rounded-2xl bg-amber-50 border border-amber-200 items-start gap-3.5 text-xs text-amber-900 transition-all">
                <div class="w-8 h-8 rounded-xl bg-amber-100 flex items-center justify-center shrink-0 text-amber-800 font-bold font-mono">
                    ⏱
                </div>
                <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-bold uppercase tracking-wider text-[10px] font-mono bg-amber-200/80 text-amber-900 px-2 py-0.5 rounded">
                            5-MINUTE RE-BUY COOLDOWN ACTIVE
                        </span>
                        <span class="font-mono font-bold text-amber-900 text-sm" id="cooldownTimerDisplay">
                            <%= Math.floor(initialSeconds / 60) %>:<%= (initialSeconds % 60).toString().padStart(2, '0') %>
                        </span>
                    </div>
                    <p class="text-[11px] text-amber-800 font-light leading-relaxed">
                        In accordance with vault reservation policy, following a payment decline this timepiece can be re-purchased or settled only after a 5-minute security interval.
                    </p>
                </div>
            </div>

            <div class="border-b border-zinc-100 pb-3">
                <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block">
                    TRANSACTION RESOLUTION ACTIONS
                </span>
                <h3 class="text-lg font-serif text-zinc-900">
                    Next Steps: Settle or Navigate
                </h3>
            </div>

            <!-- Primary Action CTAs -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                <!-- BUTTON 1: RETRY PAYMENT (Prominent CTA) -->
                <% if (order) { %>
                    <button 
                        type="button" 
                        id="failureRetryBtn"
                        onclick="handleFailureRetryClick()"
                        class="w-full py-4 px-5 bg-[#0A4D2E] hover:bg-[#073620] text-white rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-md flex items-center justify-center gap-2 col-span-1 sm:col-span-2 lg:col-span-1 cursor-pointer"
                    >
                        <svg class="w-4 h-4 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        <span id="failureRetryBtnText">Retry Payment</span>
                    </button>
                <% } else { %>
                    <a 
                        href="/checkout"
                        class="w-full py-4 px-5 bg-[#0A4D2E] hover:bg-[#073620] text-white rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer col-span-1 sm:col-span-2 lg:col-span-1"
                    >
                        <svg class="w-4 h-4 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                        <span>Retry Checkout</span>
                    </a>
                <% } %>

                <!-- BUTTON 2: ORDER DETAILS REDIRECT -->
                <% if (order) { %>
                    <a 
                        href="/order/details/<%= order._id %>"
                        class="w-full py-4 px-4 bg-zinc-900 hover:bg-black text-white rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer text-center"
                    >
                        <svg class="w-4 h-4 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        <span>Order Details</span>
                    </a>
                <% } else { %>
                    <a 
                        href="/profile/orders"
                        class="w-full py-4 px-4 bg-zinc-900 hover:bg-black text-white rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer text-center"
                    >
                        <span>My Orders</span>
                    </a>
                <% } %>

                <!-- BUTTON 3: RETURN TO SHOPPING BAG / CHECKOUT REDIRECT -->
                <a 
                    href="/checkout"
                    class="w-full py-4 px-4 bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-800 rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer text-center"
                >
                    <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    <span>Back to Checkout</span>
                </a>

                <!-- BUTTON 4: CONTINUE SHOPPING REDIRECT -->
                <a 
                    href="/shop"
                    class="w-full py-4 px-4 bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-800 rounded-xl text-xs uppercase font-mono font-bold tracking-wider transition-all shadow-2xs flex items-center justify-center gap-2 cursor-pointer text-center"
                >
                    <span>Browse Catalog</span>
                    <span class="text-[#c5a059]">→</span>
                </a>

            </div>

            <!-- Concierge Support Contact Note -->
            <div class="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-zinc-500 border-t border-zinc-100">
                <div class="flex items-center gap-2">
                    <span class="w-5 h-5 rounded-full bg-zinc-100 text-zinc-600 flex items-center justify-center text-[10px] font-bold">i</span>
                    <span>Need assistance with high-value bank wire or personalized concierge checkout?</span>
                </div>
                <a href="/contact" class="font-mono text-[#0A4D2E] font-bold uppercase tracking-wider hover:underline text-[11px]">
                    Contact Private Concierge →
                </a>
            </div>

        </div>

        <!-- ========================================================= -->
        <!-- RESERVED TIMEPIECES PREVIEW (IF ORDER PRESENT) -->
        <!-- ========================================================= -->
        <% if (order && order.items && order.items.length > 0) { %>
            <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-8 space-y-6 shadow-sm">
                <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
                    <div>
                        <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block mb-1">
                            RESERVATION SUMMARY
                        </span>
                        <h3 class="text-xl font-serif text-zinc-900 font-normal">
                            Held Timepiece Allocations (<%= order.items.length %> <%= order.items.length === 1 ? 'item' : 'items' %>)
                        </h3>
                    </div>
                    <span class="text-xs font-mono text-zinc-400">Order: <%= order.orderNumber %></span>
                </div>

                <div class="divide-y divide-zinc-100">
                    <% order.items.forEach(item => { %>
                        <div class="py-4 flex items-center justify-between gap-6">
                            <div class="flex items-center gap-4">
                                <div class="w-16 h-16 rounded-2xl bg-[#f2eeeb] overflow-hidden p-2 flex items-center justify-center flex-shrink-0 border border-zinc-200/60 shadow-2xs">
                                    <% if (item.variant && item.variant.image) { %>
                                        <img src="<%= item.variant.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover rounded-xl">
                                    <% } else { %>
                                        <span class="text-zinc-300 text-xl">⏱</span>
                                    <% } %>
                                </div>

                                <div class="space-y-1">
                                    <p class="text-[9px] uppercase font-mono tracking-wider text-zinc-400 font-semibold">
                                        <%= item.brandName %>
                                    </p>
                                    <h4 class="font-serif text-base text-zinc-900 font-normal">
                                        <%= item.productName %>
                                    </h4>
                                    <div class="flex items-center gap-2 text-xs text-zinc-500">
                                        <span class="font-medium text-zinc-700"><%= item.variant ? item.variant.color : 'Standard' %></span>
                                        <span>•</span>
                                        <span class="font-mono text-zinc-400">Qty: <%= item.quantity %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="text-right">
                                <p class="font-mono text-base font-semibold text-zinc-900">
                                    ₹<%= Number(item.itemTotal).toLocaleString('en-IN') %>
                                </p>
                                <span class="text-[10px] text-zinc-400 font-mono">₹<%= Number(item.price).toLocaleString('en-IN') %>/unit</span>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <!-- Final Valuation Due -->
                <div class="pt-4 border-t border-zinc-200 flex justify-between items-baseline text-base">
                    <span class="text-xs uppercase font-mono font-bold text-zinc-900">TOTAL DUE TO CONFIRM ORDER</span>
                    <span class="text-2xl font-bold font-mono text-[#0A4D2E]">₹<%= Number(order.grandTotal).toLocaleString('en-IN') %></span>
                </div>
            </div>
        <% } %>

    </div>
</div>

<!-- ========================================================= -->
<!-- INTERACTIVE RETRY PAYMENT MODAL -->
<!-- ========================================================= -->
<% if (order) { %>
<div id="retryPaymentModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-[#c5a059] font-bold block">SECURE SETTLEMENT</span>
                <h3 class="text-xl font-serif text-zinc-900">Retry Order Payment</h3>
            </div>
            <button type="button" onclick="closeRetryModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <div class="bg-[#faf8f7] border border-zinc-200/80 rounded-2xl p-4 flex items-center justify-between text-xs">
            <div>
                <span class="text-[10px] uppercase font-mono text-zinc-400 block">Order Dossier</span>
                <p class="font-mono font-bold text-zinc-900 text-sm"><%= order.orderNumber %></p>
            </div>
            <div class="text-right">
                <span class="text-[10px] uppercase font-mono text-zinc-400 block">Total Due</span>
                <p class="font-mono font-bold text-[#0A4D2E] text-base">₹<%= Number(order.grandTotal).toLocaleString('en-IN') %></p>
            </div>
        </div>

        <div class="space-y-3">
            <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-500">Choose Gateway for Retry</label>

            <!-- Option 1: Razorpay -->
            <label id="retryCardRazorpay" onclick="selectRetryGw('Razorpay')" class="p-4 rounded-2xl border-2 border-[#0A4D2E] bg-emerald-50/20 flex items-center justify-between cursor-pointer transition-all hover:border-[#0A4D2E]">
                <div class="flex items-center gap-3">
                    <input type="radio" name="retryGw" id="retryGwRzp" value="Razorpay" checked class="text-[#0A4D2E]">
                    <div>
                        <div class="flex items-center gap-2">
                            <h4 class="font-serif font-bold text-sm text-zinc-900">Razorpay Secure Gateway</h4>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-[#0A4D2E] text-white">Recommended</span>
                        </div>
                        <p class="text-[11px] text-zinc-500 font-light">Cards, UPI (GPay, PhonePe, Paytm), NetBanking</p>
                    </div>
                </div>
                <span class="font-mono text-[10px] font-bold text-[#0A4D2E]">₹ INR</span>
            </label>

            <% 
                const collectorWalletBal = typeof walletBalance !== 'undefined' ? Number(walletBalance) : 0;
                const canPayWallet = Boolean(order && collectorWalletBal >= order.grandTotal);
                const canPayCod = Boolean(order && order.grandTotal <= 1000000);
            %>

            <!-- Option 2: DELTA Vault Wallet -->
            <label id="retryCardWallet" onclick="<%= canPayWallet ? "selectRetryGw('Wallet')" : '' %>" class="p-4 rounded-2xl border <%= canPayWallet ? 'border-zinc-200 bg-white cursor-pointer hover:border-[#0A4D2E]' : 'border-zinc-200 bg-zinc-50 opacity-60 cursor-not-allowed' %> flex items-center justify-between transition-all">
                <div class="flex items-center gap-3">
                    <input type="radio" name="retryGw" id="retryGwWallet" value="Wallet" <%= canPayWallet ? '' : 'disabled' %> class="text-[#0A4D2E]">
                    <div>
                        <div class="flex items-center gap-2">
                            <h4 class="font-serif font-bold text-sm text-zinc-900">DELTA Vault Wallet</h4>
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold <%= canPayWallet ? 'bg-emerald-100 text-[#0A4D2E]' : 'bg-zinc-200 text-zinc-600' %>">
                                Bal: ₹<%= collectorWalletBal.toLocaleString('en-IN') %>
                            </span>
                        </div>
                        <p class="text-[11px] text-zinc-500 font-light">
                            <% if (canPayWallet) { %>
                                Instant one-click settlement from your verified vault liquidity reserve.
                            <% } else { %>
                                Insufficient reserve (Shortfall: ₹<%= Math.max(0, (order ? order.grandTotal : 0) - collectorWalletBal).toLocaleString('en-IN') %>). <a href="/wallet" target="_blank" class="text-[#0A4D2E] underline font-bold hover:text-black">Top-up Wallet ↗</a>
                            <% } %>
                        </p>
                    </div>
                </div>
                <span class="font-mono text-[10px] font-bold text-[#0A4D2E]">Instant</span>
            </label>

            <!-- Option 3: Cash on Delivery (COD) -->
            <label id="retryCardCod" onclick="<%= canPayCod ? "selectRetryGw('Cash on Delivery')" : '' %>" class="p-4 rounded-2xl border <%= canPayCod ? 'border-zinc-200 bg-white cursor-pointer hover:border-[#0A4D2E]' : 'border-zinc-200 bg-zinc-50 opacity-60 cursor-not-allowed' %> flex items-center justify-between transition-all">
                <div class="flex items-center gap-3">
                    <input type="radio" name="retryGw" id="retryGwCod" value="Cash on Delivery" <%= canPayCod ? '' : 'disabled' %> class="text-[#0A4D2E]">
                    <div>
                        <div class="flex items-center gap-2">
                            <h4 class="font-serif font-bold text-sm text-zinc-900">Cash on Delivery (COD)</h4>
                            <% if (canPayCod) { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-amber-100 text-amber-800">Complimentary Courier</span>
                            <% } else { %>
