<%- include('../partials/payment-animation') %>

<%- include('../partials/footer') %>

<script>
    let currentSelectedAddressId = '<%= (defaultAddress && defaultAddress._id) ? defaultAddress._id : (addresses && addresses[0] ? addresses[0]._id : "") %>';
    let currentSelectedPaymentMethod = 'Razorpay';
    let currentGrandTotal = <%= Number(summary.grandTotal || 0) %>;
    let currentSubtotal = <%= Number(summary.subtotal || 0) %>;
    let currentDiscount = <%= Number(summary.discount || 0) %>;
    let currentAppliedCoupon = <%- JSON.stringify(appliedCoupon || null) %>;
    let currentAppliedCoupons = <%- JSON.stringify(typeof appliedCoupons !== 'undefined' && Array.isArray(appliedCoupons) ? appliedCoupons : (appliedCoupon && appliedCoupon.code ? [appliedCoupon] : [])) %>;
    const initialCouponWarnings = <%- JSON.stringify(typeof couponWarnings !== 'undefined' && Array.isArray(couponWarnings) ? couponWarnings : []) %>;

    function handleCheckoutOrderError(data, fallbackMessage) {
        const msg = (data && data.message) || fallbackMessage;
        if (data && data.couponUpdate && data.couponUpdate.summary) {
            updateCheckoutTotals(
                data.couponUpdate.summary,
                data.couponUpdate.appliedCoupon,
                data.couponUpdate.appliedCoupons
            );
        }
        if (data && (data.code === 'COUPON_BLOCKED' || data.code === 'COUPON_REMOVED')) {
            showCouponFeedback(msg, 'error');
        }
        if (window.showToast) window.showToast(msg, 'error', 6000);
        else alert(msg);
    }

    function updatePayButtonText() {
        const btnText = document.getElementById('placeOrderBtnText');
        if (!btnText) return;
        if (currentSelectedPaymentMethod === 'Razorpay') {
            btnText.textContent = 'Pay via Razorpay • ₹' + currentGrandTotal.toLocaleString('en-IN');
        } else if (currentSelectedPaymentMethod === 'Wallet') {
            btnText.textContent = 'Pay via Vault Wallet • ₹' + currentGrandTotal.toLocaleString('en-IN');
        } else {
            btnText.textContent = 'Confirm & Place Order (COD) • ₹' + currentGrandTotal.toLocaleString('en-IN');
        }
    }

    // Strict regex matchers aligned with backend constants
    const ADDR_REGEX = {
        name: /^[A-Za-z][A-Za-z\s.'-]{1,49}$/,
        phone: /^[6-9]\d{9}$/,
        pincode: /^[1-9][0-9]{5}$/,
        cityState: /^[A-Za-z][A-Za-z .'-]{1,49}$/,
        addressLine: /^[A-Za-z0-9\s,.'/#&()\-]{5,200}$/
    };

    function validateAddressFields(prefix) {
        let isValid = true;

        const isAdd = prefix === 'newAddr';
        const fullNameInput = document.getElementById(isAdd ? 'newAddrFullName' : 'editFullName');
        const fullNameErr = document.getElementById(isAdd ? 'newAddrFullNameErr' : 'editFullNameErr');

        const phoneInput = document.getElementById(isAdd ? 'newAddrPhone' : 'editPhone');
        const phoneErr = document.getElementById(isAdd ? 'newAddrPhoneErr' : 'editPhoneErr');

        const addrLineInput = document.getElementById(isAdd ? 'newAddrAddressLine' : 'editAddressLine');
        const addrLineErr = document.getElementById(isAdd ? 'newAddrAddressLineErr' : 'editAddressLineErr');

        const cityInput = document.getElementById(isAdd ? 'newAddrCity' : 'editCity');
        const cityErr = document.getElementById(isAdd ? 'newAddrCityErr' : 'editCityErr');

        const stateInput = document.getElementById(isAdd ? 'newAddrState' : 'editState');
        const stateErr = document.getElementById(isAdd ? 'newAddrStateErr' : 'editStateErr');

        const pincodeInput = document.getElementById(isAdd ? 'newAddrPincode' : 'editPincode');
        const pincodeErr = document.getElementById(isAdd ? 'newAddrPincodeErr' : 'editPincodeErr');

        const checkField = (input, errSpan, validator, emptyMsg, invalidMsg) => {
            if (!input || !errSpan) return true;
            const val = (input.value || '').trim();
            if (!val) {
                errSpan.textContent = emptyMsg;
                errSpan.classList.remove('hidden');
                input.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                input.classList.remove('border-zinc-200');
                return false;
            }
            if (validator && !validator(val)) {
                errSpan.textContent = invalidMsg;
                errSpan.classList.remove('hidden');
                input.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                input.classList.remove('border-zinc-200');
                return false;
            }
            errSpan.textContent = '';
            errSpan.classList.add('hidden');
            input.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
            input.classList.add('border-zinc-200');
            return true;
        };

        const f1 = checkField(
            fullNameInput,
            fullNameErr,
            (v) => ADDR_REGEX.name.test(v),
            'Full name is required.',
            'Enter a valid name (at least 2 alphabetic characters, only letters & spaces).'
        );

        const f2 = checkField(
            phoneInput,
            phoneErr,
            (v) => ADDR_REGEX.phone.test(v),
            'Mobile phone number is required.',
            'Enter a valid 10-digit Indian phone number starting with 6, 7, 8, or 9.'
        );

        const f3 = checkField(
            addrLineInput,
            addrLineErr,
            (v) => ADDR_REGEX.addressLine.test(v) && v.length >= 5,
            'Street address is required.',
            'Address must be at least 5 characters long and contain valid street details.'
        );

        const f4 = checkField(
            cityInput,
            cityErr,
            (v) => ADDR_REGEX.cityState.test(v),
            'City is required.',
            'Enter a valid city name (letters & spaces only).'
        );

        const f5 = checkField(
            stateInput,
            stateErr,
            (v) => ADDR_REGEX.cityState.test(v),
            'State is required.',
            'Enter a valid state name (letters & spaces only).'
        );

        const f6 = checkField(
            pincodeInput,
            pincodeErr,
            (v) => ADDR_REGEX.pincode.test(v),
            'Pincode is required.',
            'Enter a valid 6-digit Indian pincode (cannot start with 0).'
        );

        return f1 && f2 && f3 && f4 && f5 && f6;
    }

    // Attach real-time input listeners to clear errors on typing
    function setupRealTimeValidation(prefix) {
        const isAdd = prefix === 'newAddr';
        const fields = [
            { id: isAdd ? 'newAddrFullName' : 'editFullName', err: isAdd ? 'newAddrFullNameErr' : 'editFullNameErr', rule: ADDR_REGEX.name, empty: 'Full name is required.', inv: 'Enter a valid name (letters only).' },
            { id: isAdd ? 'newAddrPhone' : 'editPhone', err: isAdd ? 'newAddrPhoneErr' : 'editPhoneErr', rule: ADDR_REGEX.phone, empty: 'Mobile phone number is required.', inv: 'Enter 10-digit mobile number starting with 6-9.' },
            { id: isAdd ? 'newAddrAddressLine' : 'editAddressLine', err: isAdd ? 'newAddrAddressLineErr' : 'editAddressLineErr', rule: ADDR_REGEX.addressLine, empty: 'Street address is required.', inv: 'Address must be at least 5 characters.' },
            { id: isAdd ? 'newAddrCity' : 'editCity', err: isAdd ? 'newAddrCityErr' : 'editCityErr', rule: ADDR_REGEX.cityState, empty: 'City is required.', inv: 'Enter a valid city name.' },
            { id: isAdd ? 'newAddrState' : 'editState', err: isAdd ? 'newAddrStateErr' : 'editStateErr', rule: ADDR_REGEX.cityState, empty: 'State is required.', inv: 'Enter a valid state name.' },
            { id: isAdd ? 'newAddrPincode' : 'editPincode', err: isAdd ? 'newAddrPincodeErr' : 'editPincodeErr', rule: ADDR_REGEX.pincode, empty: 'Pincode is required.', inv: 'Enter a valid 6-digit pincode.' }
        ];

        fields.forEach(f => {
            const input = document.getElementById(f.id);
            const errSpan = document.getElementById(f.err);
            if (input && errSpan) {
                input.addEventListener('input', () => {
                    if (f.id.toLowerCase().includes('phone') || f.id.toLowerCase().includes('pincode')) {
                        input.value = input.value.replace(/[^0-9]/g, '');
                    }
                    const val = input.value.trim();
                    if (val && f.rule.test(val)) {
                        errSpan.textContent = '';
                        errSpan.classList.add('hidden');
                        input.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
                        input.classList.add('border-zinc-200');
                    }
                });
                input.addEventListener('blur', () => {
                    const val = input.value.trim();
                    if (!val) {
                        errSpan.textContent = f.empty;
                        errSpan.classList.remove('hidden');
                        input.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                        input.classList.remove('border-zinc-200');
                    } else if (!f.rule.test(val)) {
                        errSpan.textContent = f.inv;
                        errSpan.classList.remove('hidden');
                        input.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                        input.classList.remove('border-zinc-200');
                    }
                });
            }
        });
    }

    function setupPincodeAutoLookup(prefix) {
        const isAdd = prefix === 'newAddr';
        const pinInput = document.getElementById(isAdd ? 'newAddrPincode' : 'editPincode');
        const cityInput = document.getElementById(isAdd ? 'newAddrCity' : 'editCity');
        const stateInput = document.getElementById(isAdd ? 'newAddrState' : 'editState');
        const pinErr = document.getElementById(isAdd ? 'newAddrPincodeErr' : 'editPincodeErr');
        const cityErr = document.getElementById(isAdd ? 'newAddrCityErr' : 'editCityErr');
        const stateErr = document.getElementById(isAdd ? 'newAddrStateErr' : 'editStateErr');

        const spinner = document.getElementById(isAdd ? 'newAddrPincodeSpinner' : 'editPincodeSpinner');

        if (!pinInput || !cityInput || !stateInput) return;

        let timer = null;
        let lastQuery = (pinInput.value || '').trim();

        const doLookup = async () => {
            const val = (pinInput.value || '').replace(/\D/g, '').slice(0, 6);
            pinInput.value = val;

            if (val.length < 6) {
                lastQuery = "";
                return;
            }

            if (!ADDR_REGEX.pincode.test(val)) {
                if (pinErr) {
                    pinErr.textContent = 'Enter a valid 6-digit Indian pincode (cannot start with 0).';
                    pinErr.classList.remove('hidden');
                }
                pinInput.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                return;
            }

            if (val === lastQuery) return;

            if (pinErr) pinErr.classList.add('hidden');
            pinInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
            if (spinner) spinner.classList.remove('hidden');

            try {
                const res = await fetch('/addresses/pincode/' + val);
                const data = await res.json();

                if (data.success && data.city && data.state) {
                    lastQuery = val;
                    cityInput.value = data.city;
                    stateInput.value = data.state;

                    if (cityErr) cityErr.classList.add('hidden');
                    cityInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
                    cityInput.classList.add('border-zinc-200');

                    if (stateErr) stateErr.classList.add('hidden');
                    stateInput.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
                    stateInput.classList.add('border-zinc-200');

                    [cityInput, stateInput].forEach(inp => {
                        inp.classList.add('border-emerald-500', 'ring-1', 'ring-emerald-500');
                        setTimeout(() => {
                            inp.classList.remove('border-emerald-500', 'ring-1', 'ring-emerald-500');
                        }, 1200);
                    });
                } else {
                    if (pinErr) {
                        pinErr.textContent = data.message || 'Invalid or unrecognized pincode.';
                        pinErr.classList.remove('hidden');
                    }
                    pinInput.classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                }
            } catch {
                // Silently fail lookup errors on network glitch
            } finally {
                if (spinner) spinner.classList.add('hidden');
            }
        };

        pinInput.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(doLookup, 200);
        });
        pinInput.addEventListener('change', doLookup);
        pinInput.addEventListener('blur', doLookup);
    }

    document.addEventListener('DOMContentLoaded', () => {
        setupRealTimeValidation('newAddr');
        setupRealTimeValidation('edit');
        setupPincodeAutoLookup('newAddr');
        setupPincodeAutoLookup('edit');
    });

    function selectAddressCard(addrId) {
        currentSelectedAddressId = addrId;
        document.querySelectorAll('.address-option-card').forEach(card => {
            card.classList.remove('border-[#0A4D2E]', 'bg-emerald-50/20', 'ring-1', 'ring-[#0A4D2E]/20', 'shadow-xs');
            card.classList.add('border-zinc-200', 'bg-white');
        });
        const activeCard = document.getElementById('address-card-' + addrId);
        if (activeCard) {
            activeCard.classList.add('border-[#0A4D2E]', 'bg-emerald-50/20', 'ring-1', 'ring-[#0A4D2E]/20', 'shadow-xs');
            activeCard.classList.remove('border-zinc-200', 'bg-white');
            const radio = activeCard.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
        }
    }

    function selectPaymentOption(method) {
        currentSelectedPaymentMethod = method;
        document.querySelectorAll('.payment-option-card').forEach(c => {
            c.classList.remove('border-[#0A4D2E]', 'bg-emerald-50/20', 'ring-1', 'ring-[#0A4D2E]/20', 'shadow-xs');
            c.classList.add('border-zinc-200', 'bg-white');
        });

        let elId = 'payment-option-razorpay';
        if (method === 'Cash on Delivery') elId = 'payment-option-cod';
        else if (method === 'Wallet') elId = 'payment-option-wallet';

        const el = document.getElementById(elId);
        if (el) {
            el.classList.add('border-[#0A4D2E]', 'bg-emerald-50/20', 'ring-1', 'ring-[#0A4D2E]/20', 'shadow-xs');
            el.classList.remove('border-zinc-200', 'bg-white');
            const radio = el.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
        }

        const btnText = document.getElementById('placeOrderBtnText');
        if (btnText) {
            updatePayButtonText();
        }
    }

    function openAddAddressModal() {
        const modal = document.getElementById('addAddressModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            const form = document.getElementById('addAddressForm');
            if (form) form.reset();
            const errEl = document.getElementById('addAddressError');
            if (errEl) errEl.classList.add('hidden');
            // Clear all field error states
            document.querySelectorAll('#addAddressForm input').forEach(input => {
                input.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
                input.classList.add('border-zinc-200');
            });
            document.querySelectorAll('#addAddressForm span[id$="Err"]').forEach(span => {
                span.textContent = '';
                span.classList.add('hidden');
            });
        }
    }

    function closeAddAddressModal() {
        const modal = document.getElementById('addAddressModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    async function openEditAddressModal(addrId) {
        try {
            const res = await fetch('/addresses/' + addrId + '/edit', {
                headers: { 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (data && data.address) {
                const a = data.address;
                document.getElementById('editAddressId').value = a._id;
                document.getElementById('editFullName').value = a.fullName || '';
                document.getElementById('editPhone').value = a.phone || '';
                document.getElementById('editAddressLine').value = a.addressLine || '';
                document.getElementById('editCity').value = a.city || '';
                document.getElementById('editState').value = a.state || '';
                document.getElementById('editPincode').value = a.pincode || '';
                document.getElementById('editAddressType').value = a.addressType || 'home';
                document.getElementById('editIsDefault').checked = Boolean(a.isDefault);

                // Clear prior errors
                const errEl = document.getElementById('editAddressError');
                if (errEl) errEl.classList.add('hidden');
                document.querySelectorAll('#editAddressForm input').forEach(input => {
                    input.classList.remove('border-rose-500', 'ring-1', 'ring-rose-500');
                    input.classList.add('border-zinc-200');
                });
                document.querySelectorAll('#editAddressForm span[id$="Err"]').forEach(span => {
                    span.textContent = '';
                    span.classList.add('hidden');
                });

                const modal = document.getElementById('editAddressModal');
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            }
        } catch (e) {
            if (window.showToast) window.showToast('Unable to load address details.', 'error');
        }
    }

    function closeEditAddressModal() {
        const modal = document.getElementById('editAddressModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    async function submitNewAddress(e) {
        e.preventDefault();

        // 1. Run rigorous client-side validation
        const isValid = validateAddressFields('newAddr');
        if (!isValid) {
            const errEl = document.getElementById('addAddressError');
            if (errEl) {
                errEl.textContent = 'Please correct the highlighted fields before submitting.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        const form = document.getElementById('addAddressForm');
        const btn = document.getElementById('saveAddressBtn');
        const errEl = document.getElementById('addAddressError');
        const formData = new FormData(form);
        const dataObj = Object.fromEntries(formData.entries());
        dataObj.isDefault = Boolean(formData.get('isDefault'));

        if (btn) btn.disabled = true;
        try {
            const res = await fetch('/addresses/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(dataObj)
            });
            const data = await res.json();
            if (res.ok && data.success && data.address) {
                closeAddAddressModal();
                if (window.showToast) window.showToast('New delivery address added.', 'success');
                window.location.reload();
            } else {
                if (data.errors) {
                    // Map field errors to individual fields
                    if (data.errors.fullName) {
                        const el = document.getElementById('newAddrFullNameErr');
                        if (el) { el.textContent = data.errors.fullName; el.classList.remove('hidden'); }
                    }
                    if (data.errors.phone) {
                        const el = document.getElementById('newAddrPhoneErr');
                        if (el) { el.textContent = data.errors.phone; el.classList.remove('hidden'); }
                    }
                    if (data.errors.addressLine) {
                        const el = document.getElementById('newAddrAddressLineErr');
                        if (el) { el.textContent = data.errors.addressLine; el.classList.remove('hidden'); }
                    }
                    if (data.errors.city) {
                        const el = document.getElementById('newAddrCityErr');
                        if (el) { el.textContent = data.errors.city; el.classList.remove('hidden'); }
                    }
                    if (data.errors.state) {
                        const el = document.getElementById('newAddrStateErr');
                        if (el) { el.textContent = data.errors.state; el.classList.remove('hidden'); }
                    }
                    if (data.errors.pincode) {
                        const el = document.getElementById('newAddrPincodeErr');
                        if (el) { el.textContent = data.errors.pincode; el.classList.remove('hidden'); }
                    }
                }
                if (errEl) {
                    errEl.textContent = data.message || 'Please verify highlighted address fields.';
                    errEl.classList.remove('hidden');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error saving address.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function submitEditAddress(e) {
        e.preventDefault();

        // 1. Run rigorous client-side validation
        const isValid = validateAddressFields('edit');
        if (!isValid) {
            const errEl = document.getElementById('editAddressError');
            if (errEl) {
                errEl.textContent = 'Please correct the highlighted fields before submitting.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        const form = document.getElementById('editAddressForm');
        const btn = document.getElementById('updateAddressBtn');
        const errEl = document.getElementById('editAddressError');
        const addrId = document.getElementById('editAddressId').value;
        const formData = new FormData(form);
        const dataObj = Object.fromEntries(formData.entries());
        dataObj.isDefault = Boolean(formData.get('isDefault'));

        if (btn) btn.disabled = true;
        try {
            const res = await fetch('/addresses/' + addrId + '/edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(dataObj)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                closeEditAddressModal();
                if (window.showToast) window.showToast('Address updated successfully.', 'success');
                window.location.reload();
            } else {
                if (data.errors) {
                    if (data.errors.fullName) {
                        const el = document.getElementById('editFullNameErr');
                        if (el) { el.textContent = data.errors.fullName; el.classList.remove('hidden'); }
                    }
                    if (data.errors.phone) {
                        const el = document.getElementById('editPhoneErr');
                        if (el) { el.textContent = data.errors.phone; el.classList.remove('hidden'); }
                    }
                    if (data.errors.addressLine) {
                        const el = document.getElementById('editAddressLineErr');
                        if (el) { el.textContent = data.errors.addressLine; el.classList.remove('hidden'); }
                    }
                    if (data.errors.city) {
                        const el = document.getElementById('editCityErr');
                        if (el) { el.textContent = data.errors.city; el.classList.remove('hidden'); }
                    }
                    if (data.errors.state) {
                        const el = document.getElementById('editStateErr');
                        if (el) { el.textContent = data.errors.state; el.classList.remove('hidden'); }
                    }
                    if (data.errors.pincode) {
                        const el = document.getElementById('editPincodeErr');
                        if (el) { el.textContent = data.errors.pincode; el.classList.remove('hidden'); }
                    }
                }
                if (errEl) {
                    errEl.textContent = data.message || 'Please verify highlighted address fields.';
                    errEl.classList.remove('hidden');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error updating address.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    // --- Online Payment Gateway State & Modals ---
    let activeRzpSession = null;
    let lastFailedPaymentDetails = null;

    function resetOrderBtn() {
        const btn = document.getElementById('placeOrderBtn');
        if (btn) btn.disabled = false;
        updatePayButtonText();
    }

    // Razorpay Tab and Method State
    let currentRzpTab = 'upi';
    let currentRzpSubMethod = 'UPI';

    function switchRzpTab(tab) {
        currentRzpTab = tab;
        ['upi', 'card', 'netbanking', 'wallet'].forEach(t => {
            const btn = document.getElementById(`rzpTabBtn_${t}`);
            const panel = document.getElementById(`rzpPanel_${t}`);
            if (btn) {
                if (t === tab) {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer bg-white text-zinc-900 shadow-xs font-semibold flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.add('text-[#0A4D2E]');
                } else {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer text-zinc-500 hover:text-zinc-900 flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.remove('text-[#0A4D2E]');
                }
            }
            if (panel) {
                if (t === tab) panel.classList.remove('hidden');
                else panel.classList.add('hidden');
            }
        });
        updateRzpPayButtonText();
    }

    function selectRzpUpiApp(app, vpa) {
        currentRzpSubMethod = app;
        const vpaInput = document.getElementById('rzpUpiVpaInput');
        if (vpaInput) vpaInput.value = vpa;
        ['gpay', 'phonepe', 'paytm', 'bhim'].forEach(a => {
            const btn = document.getElementById(`rzpUpiApp_${a}`);
            if (btn) {
                btn.className = "p-2 rounded-xl border border-zinc-200 bg-white flex flex-col items-center justify-center gap-1 text-[11px] font-semibold text-zinc-600 transition-all cursor-pointer";
            }
        });
        const activeKey = app === 'Google Pay' ? 'gpay' : app === 'PhonePe' ? 'phonepe' : app === 'Paytm' ? 'paytm' : 'bhim';
        const activeBtn = document.getElementById(`rzpUpiApp_${activeKey}`);
        if (activeBtn) {
            activeBtn.className = "p-2 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 flex flex-col items-center justify-center gap-1 text-[11px] font-bold text-zinc-900 transition-all cursor-pointer";
        }
        updateRzpPayButtonText();
    }

    function updateRzpUpiVpa(val) {
        currentRzpSubMethod = val ? `UPI (${val.split('@')[0]})` : 'UPI';
        updateRzpPayButtonText();
    }

    function formatRzpCardNumber(input) {
        let v = input.value.replace(/\D/g, '').slice(0, 16);
        let formatted = v.match(/.{1,4}/g)?.join(' ') || v;
        input.value = formatted;
        const prev = document.getElementById('rzpCardPreviewNumber');
        if (prev) prev.textContent = formatted || '•••• •••• •••• ••••';
    }

    function formatRzpCardExpiry(input) {
        let v = input.value.replace(/\D/g, '').slice(0, 4);
        if (v.length >= 3) v = v.slice(0, 2) + '/' + v.slice(2);
        input.value = v;
        const prev = document.getElementById('rzpCardPreviewExpiry');
        if (prev) prev.textContent = v || 'MM/YY';
    }

    function selectRzpBank(bank) {
        currentRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpBank_${b}`);
            if (btn) {
                btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
            }
        });
        const key = bank.includes('HDFC') ? 'HDFC' : bank.includes('ICICI') ? 'ICICI' : bank.includes('State') ? 'SBI' : bank.includes('Axis') ? 'Axis' : bank.includes('Kotak') ? 'Kotak' : 'PNB';
        const activeBtn = document.getElementById(`rzpBank_${key}`);
        if (activeBtn) {
            activeBtn.className = "p-2.5 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 text-left transition-all cursor-pointer";
        }
        const otherSel = document.getElementById('rzpOtherBanksSelect');
        if (otherSel) otherSel.value = '';
        updateRzpPayButtonText();
    }

    function selectRzpOtherBank(bank) {
        if (!bank) return;
        currentRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpBank_${b}`);
            if (btn) btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
        });
        updateRzpPayButtonText();
    }

    function selectRzpWallet(wallet) {
        currentRzpSubMethod = wallet;
        updateRzpPayButtonText();
    }

    function updateRzpPayButtonText() {
        const btn = document.getElementById('rzpPayBtnLabel');
        if (!btn || !activeRzpSession) return;
        const amountStr = '₹' + Number(activeRzpSession.initData.grandTotal).toLocaleString('en-IN');
        let methodLabel = 'UPI';
        if (currentRzpTab === 'upi') methodLabel = currentRzpSubMethod || 'UPI';
        else if (currentRzpTab === 'card') methodLabel = 'Card';
        else if (currentRzpTab === 'netbanking') methodLabel = currentRzpSubMethod || 'NetBanking';
        else if (currentRzpTab === 'wallet') methodLabel = currentRzpSubMethod || 'Wallet';
        btn.textContent = `Authorize & Pay ${amountStr} via ${methodLabel}`;
    }

    // Razorpay Simulation Handlers
    function openRazorpaySimulationModal(initData, addressId, notes) {
        activeRzpSession = { initData, addressId, notes };
        const modal = document.getElementById('razorpaySimulationModal');
        const orderIdEl = document.getElementById('rzpModalOrderId');
        const amountEl = document.getElementById('rzpModalAmount');
        const cardNamePreview = document.getElementById('rzpCardPreviewName');
        if (orderIdEl) orderIdEl.textContent = initData.razorpayOrderId;
        if (amountEl) amountEl.textContent = '₹' + Number(initData.grandTotal).toLocaleString('en-IN');
        const userName = (initData.user?.name || 'Valued Collector').toUpperCase();
        if (cardNamePreview) cardNamePreview.textContent = userName;
        switchRzpTab('upi');
        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }

    function closeRazorpaySimulationModal() {
        closeRzpConfirmPayModal();
        closeRzpConfirmDeclineModal();
        const modal = document.getElementById('razorpaySimulationModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
        resetOrderBtn();
    }

    function openRzpConfirmPayModal() {
        if (!activeRzpSession) return;
        const modal = document.getElementById('rzpConfirmPayModal');
        const methodEl = document.getElementById('rzpConfirmPayMethod');
        const orderRefEl = document.getElementById('rzpConfirmPayOrderRef');
        const amountEl = document.getElementById('rzpConfirmPayAmount');

        let methodLabel = 'UPI';
        if (currentRzpTab === 'upi') methodLabel = currentRzpSubMethod || 'UPI';
        else if (currentRzpTab === 'card') methodLabel = 'Credit / Debit Card';
        else if (currentRzpTab === 'netbanking') methodLabel = currentRzpSubMethod || 'NetBanking';
        else if (currentRzpTab === 'wallet') methodLabel = currentRzpSubMethod || 'Digital Wallet';

        if (methodEl) methodEl.textContent = methodLabel;
        if (orderRefEl) orderRefEl.textContent = activeRzpSession.initData.razorpayOrderId;
        if (amountEl) amountEl.textContent = '₹' + Number(activeRzpSession.initData.grandTotal).toLocaleString('en-IN');

        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }

    function closeRzpConfirmPayModal() {
        const modal = document.getElementById('rzpConfirmPayModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    async function executeConfirmedRazorpayPayment() {
        closeRzpConfirmPayModal();
        await confirmRazorpaySimulatedPayment();
    }

    function openRzpConfirmDeclineModal() {
        if (!activeRzpSession) return;
        const modal = document.getElementById('rzpConfirmDeclineModal');
        const orderRefEl = document.getElementById('rzpConfirmDeclineOrderRef');
        const amountEl = document.getElementById('rzpConfirmDeclineAmount');

        if (orderRefEl) orderRefEl.textContent = activeRzpSession.initData.razorpayOrderId;
        if (amountEl) amountEl.textContent = '₹' + Number(activeRzpSession.initData.grandTotal).toLocaleString('en-IN');

        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
    }

    function closeRzpConfirmDeclineModal() {
        const modal = document.getElementById('rzpConfirmDeclineModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    async function executeConfirmedRazorpayDecline() {
        closeRzpConfirmDeclineModal();
        await simulateRazorpayFailure('Transaction authorization was declined by cardholder bank / 3DS timeout.');
    }

    async function confirmRazorpaySimulatedPayment() {
        if (!activeRzpSession) return;
        const btn = document.getElementById('rzpSimulateSuccessBtn');
        if (btn) btn.disabled = true;

        if (window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Authorizing Razorpay Settlement',
                subtitle: 'Verifying ' + (currentRzpSubMethod || 'payment instrument') + ' with bank...',
                amount: activeRzpSession.initData.grandTotal,
                method: 'Razorpay ' + (currentRzpSubMethod || 'Secure')
            });
        }

        try {
            const verifyRes = await fetch('/checkout/razorpay/verify-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    addressId: activeRzpSession.addressId,
                    notes: activeRzpSession.notes,
                    razorpay_order_id: activeRzpSession.initData.razorpayOrderId,
                    razorpay_payment_id: activeRzpSession.initData.testPaymentId,
                    razorpay_signature: activeRzpSession.initData.testSignature
                })
            });
            const data = await verifyRes.json();
            if (data.success && data.redirect) {
                if (window.updateNavbarCounters) window.updateNavbarCounters(0);
                if (window.DeltaPaymentAnimation) {
                    window.DeltaPaymentAnimation.success({
                        title: 'Payment Successfully Settled',
                        subtitle: 'Allocation confirmed & recorded in DELTA Private Vault.',
                        redirectUrl: data.redirect,
                        delayMs: 1200
                    });
                } else {
                    window.location.href = data.redirect;
                }
            } else {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                closeRazorpaySimulationModal();
                showPaymentFailureModal(data.message || 'Signature verification failed.', activeRzpSession.addressId, activeRzpSession.notes, 'Razorpay', activeRzpSession.initData.razorpayOrderId);
            }
        } catch (e) {
            if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
            closeRazorpaySimulationModal();
            showPaymentFailureModal('Network connection error during Razorpay authorization.', activeRzpSession.addressId, activeRzpSession.notes, 'Razorpay', activeRzpSession.initData.razorpayOrderId);
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    async function recordAndRedirectPaymentFailure(addressId, notes, reason, razorpayOrderId) {
        try {
            const failRes = await fetch('/checkout/payment-failed', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                    addressId,
                    notes,
                    paymentMethod: 'Razorpay',
                    failureReason: reason,
                    razorpayOrderId
                })
            });
            const failData = await failRes.json();
            if (failData && failData.orderId) {
                window.location.href = failData.redirect || `/checkout/payment-failed/${failData.orderId}?reason=${encodeURIComponent(reason)}`;
                return true;
            }
        } catch (e) {}
        return false;
    }

    async function simulateRazorpayFailure(reason) {
        if (!activeRzpSession) return;
        const { addressId, notes, initData } = activeRzpSession;
        closeRazorpaySimulationModal();
        const redirected = await recordAndRedirectPaymentFailure(addressId, notes, reason, initData.razorpayOrderId);
        if (!redirected) {
            showPaymentFailureModal(reason, addressId, notes, 'Razorpay', initData.razorpayOrderId, null);
        }
    }

    // Payment Failure Modal Handlers
    function showPaymentFailureModal(reason, addressId, notes, paymentMethod, gatewayOrderId, orderId = null) {
        lastFailedPaymentDetails = { reason, addressId, notes, paymentMethod, gatewayOrderId, orderId };
        const modal = document.getElementById('paymentFailureModal');
        const msgEl = document.getElementById('paymentFailureMessage');
        const viewOrderBtn = document.getElementById('paymentFailureViewOrderBtn');
        if (msgEl) msgEl.textContent = reason || 'Payment authorization was declined or cancelled.';
        if (viewOrderBtn) {
            if (orderId) {
                viewOrderBtn.href = `/checkout/payment-failed/${orderId}?reason=${encodeURIComponent(reason || 'Payment failed')}`;
                viewOrderBtn.classList.remove('hidden');
            } else {
                viewOrderBtn.classList.add('hidden');
            }
        }
        if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
        resetOrderBtn();
    }

    function closePaymentFailureModal() {
        const modal = document.getElementById('paymentFailureModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
        resetOrderBtn();
    }

    function retryPaymentFromFailureModal() {
        closePaymentFailureModal();
        if (lastFailedPaymentDetails && lastFailedPaymentDetails.orderId) {
            window.location.href = `/checkout/payment-failed/${lastFailedPaymentDetails.orderId}?reason=${encodeURIComponent(lastFailedPaymentDetails.reason || 'Payment declined')}`;
        } else {
            submitOrder();
        }
    }

    async function switchFailedOrderToCod() {
        closePaymentFailureModal();
        if (lastFailedPaymentDetails && lastFailedPaymentDetails.orderId) {
            try {
                const res = await fetch(`/orders/${lastFailedPaymentDetails.orderId}/retry-payment`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ paymentMethod: 'Cash on Delivery' })
                });
                const data = await res.json();
                if (data.success && data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }
                if (window.showToast) window.showToast(data.message || 'Could not switch to Cash on Delivery.', 'error');
            } catch (e) {
                if (window.showToast) window.showToast('Network error switching to Cash on Delivery.', 'error');
            }
        } else {
            selectPaymentOption('Cash on Delivery');
            submitOrder();
        }
    }

    async function submitOrder() {
        const btn = document.getElementById('placeOrderBtn');
        const btnText = document.getElementById('placeOrderBtnText');

        // Verify selected address
        const radio = document.querySelector('input[name="selectedAddressId"]:checked');
        const addressId = radio ? radio.value : currentSelectedAddressId;

        if (!addressId) {
            if (window.showToast) {
                window.showToast('Please select or add a delivery destination address.', 'warning', 4000);
            } else {
                alert('Please select or add a delivery destination address.');
            }
            openAddAddressModal();
            return;
        }

        const notes = (document.getElementById('orderNotes')?.value || '').trim();

        if (btn) btn.disabled = true;

        // Route 0: DELTA Vault Wallet
        if (currentSelectedPaymentMethod === 'Wallet') {
            if (btnText) btnText.innerHTML = '<span class="animate-pulse">Authorizing Vault Settlement...</span>';
            if (window.DeltaPaymentAnimation) {
                window.DeltaPaymentAnimation.start({
                    title: 'Authorizing Vault Reserve Settlement',
                    subtitle: 'Debiting verified collector reserve...',
                    amount: currentGrandTotal,
                    method: 'DELTA Vault Reserve'
                });
            }
            try {
                const res = await fetch('/checkout/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        addressId,
                        paymentMethod: 'Wallet',
                        notes
                    })
                });
                const data = await res.json();

                if (res.status === 401 || data.redirect?.includes('/login')) {
                    if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                    window.location.href = data.redirect || '/login';
                    return;
                }

                if (data.success && data.redirect) {
                    if (window.updateNavbarCounters) window.updateNavbarCounters(0);
                    if (window.DeltaPaymentAnimation) {
                        window.DeltaPaymentAnimation.success({
                            title: 'Vault Settlement Confirmed',
                            subtitle: 'One-click timepiece allocation complete.',
                            redirectUrl: data.redirect,
                            delayMs: 1200
                        });
                    } else {
                        window.location.href = data.redirect;
                    }
                } else {
                    if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                    resetOrderBtn();
                    handleCheckoutOrderError(data, 'Unable to authorize wallet settlement.');
                }
            } catch (e) {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                resetOrderBtn();
                if (window.showToast) window.showToast('Network issue processing wallet payment.', 'error');
            }
            return;
        }

        // Route 1: Cash on Delivery (COD)
        if (currentSelectedPaymentMethod === 'Cash on Delivery') {
            if (btnText) btnText.innerHTML = '<span class="animate-pulse">Authorizing COD Order...</span>';
            if (window.DeltaPaymentAnimation) {
                window.DeltaPaymentAnimation.start({
                    title: 'Securing Timepiece Allocation',
                    subtitle: 'Registering white-glove consignment destination...',
                    amount: currentGrandTotal,
                    method: 'Cash on Delivery'
                });
            }
            try {
                const res = await fetch('/checkout/place-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({
                        addressId,
                        paymentMethod: 'Cash on Delivery',
                        notes
                    })
                });
                const data = await res.json();

                if (res.status === 401 || data.redirect?.includes('/login')) {
                    if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                    window.location.href = data.redirect || '/login';
                    return;
                }

                if (data.success && data.redirect) {
                    if (window.updateNavbarCounters) window.updateNavbarCounters(0);
                    if (window.DeltaPaymentAnimation) {
                        window.DeltaPaymentAnimation.success({
                            title: 'Order Allocation Confirmed',
                            subtitle: 'White-glove delivery dossier generated.',
                            redirectUrl: data.redirect,
                            delayMs: 1200
                        });
                    } else {
                        window.location.href = data.redirect;
                    }
                } else {
                    if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                    resetOrderBtn();
                    handleCheckoutOrderError(data, 'Unable to place order.');
                }
            } catch (e) {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                resetOrderBtn();
                if (window.showToast) window.showToast('Network issue placing order.', 'error');
            }
            return;
        }

        // Route 2: Razorpay Online Payment Gateway
        if (currentSelectedPaymentMethod === 'Razorpay') {
            if (btnText) btnText.innerHTML = '<span class="animate-pulse">Initializing Razorpay...</span>';
            try {
                const initRes = await fetch('/checkout/razorpay/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ addressId, notes })
                });
                const initData = await initRes.json();
                if (!initData.success) {
                    resetOrderBtn();
                    handleCheckoutOrderError(initData, 'Could not initiate Razorpay checkout session.');
                    return;
                }

                // Check if genuine Razorpay credentials and order are present, or if simulated sandbox is active
                const isRealRazorpay = typeof window.Razorpay === 'function' &&
                    !initData.isSimulated &&
                    initData.keyId &&
                    !initData.keyId.includes('deltaVault') &&
                    !initData.keyId.includes('dummy') &&
                    initData.razorpayOrderId &&
                    !initData.razorpayOrderId.startsWith('order_delta_');

                if (isRealRazorpay) {
                    const options = {
                        key: initData.keyId,
                        amount: initData.amount,
                        currency: initData.currency || "INR",
                        name: "DELTA Luxury Horology",
                        description: "Vault Allocation Settlement",
                        order_id: initData.razorpayOrderId,
                        prefill: {
                            name: initData.user?.name || "",
                            email: initData.user?.email || "",
                            contact: initData.user?.phone || ""
                        },
                        theme: {
                            color: "#0A4D2E"
                        },
                        handler: async function (response) {
                            rzpOutcomeHandled = true;
                            if (btnText) btnText.innerHTML = '<span class="animate-pulse">Verifying Payment...</span>';
                            if (window.DeltaPaymentAnimation) {
                                window.DeltaPaymentAnimation.start({
                                    title: 'Verifying Razorpay Settlement',
                                    subtitle: 'Validating cryptographic signature with banking network...',
                                    amount: currentGrandTotal,
                                    method: 'Razorpay Secure'
                                });
                            }
                            try {
                                const verifyRes = await fetch('/checkout/razorpay/verify-payment', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                    body: JSON.stringify({
                                        addressId,
                                        notes,
                                        razorpay_order_id: response.razorpay_order_id,
                                        razorpay_payment_id: response.razorpay_payment_id,
                                        razorpay_signature: response.razorpay_signature
                                    })
                                });
                                const verifyData = await verifyRes.json();
                                if (verifyData.success && verifyData.redirect) {
                                    if (window.updateNavbarCounters) window.updateNavbarCounters(0);
                                    if (window.DeltaPaymentAnimation) {
                                        window.DeltaPaymentAnimation.success({
                                            title: 'Payment Successfully Settled',
                                            subtitle: 'Timepiece allocation secured in DELTA Vault.',
                                            redirectUrl: verifyData.redirect,
                                            delayMs: 1200
                                        });
                                    } else {
                                        window.location.href = verifyData.redirect;
                                    }
                                } else {
                                    throw new Error(verifyData.message || 'Payment signature verification failed.');
                                }
                            } catch (vErr) {
                                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                                resetOrderBtn();
                                const reason = vErr.message || 'Payment signature verification failed.';
                                const rzpOrderId = response.razorpay_order_id || initData.razorpayOrderId;
                                const redirected = await recordAndRedirectPaymentFailure(addressId, notes, reason, rzpOrderId);
                                if (!redirected) {
                                    showPaymentFailureModal(reason, addressId, notes, 'Razorpay', rzpOrderId, null);
                                }
                            }
                        },
                        modal: {
                            ondismiss: async function () {
                                if (rzpOutcomeHandled) return;
                                rzpOutcomeHandled = true;
                                resetOrderBtn();
                                const reason = 'Payment session was dismissed or cancelled by the user.';
                                const redirected = await recordAndRedirectPaymentFailure(addressId, notes, reason, initData.razorpayOrderId);
                                if (!redirected && window.showToast) {
                                    window.showToast('Payment window closed.', 'info');
                                }
                            }
                        }
                    };

                    let rzpOutcomeHandled = false;
                    try {
                        const rzp = new window.Razorpay(options);
                        rzp.on('payment.failed', async function (resp) {
                            if (rzpOutcomeHandled) return;
                            rzpOutcomeHandled = true;
                            resetOrderBtn();
                            const errMsg = resp.error?.description || resp.error?.reason || 'Payment declined by issuing bank.';
                            const redirected = await recordAndRedirectPaymentFailure(addressId, notes, errMsg, initData.razorpayOrderId);
                            if (!redirected) {
                                showPaymentFailureModal(errMsg, addressId, notes, 'Razorpay', initData.razorpayOrderId, null);
                            }
                        });
                        rzp.open();
                    } catch (openErr) {
                        console.warn("[Razorpay] Live SDK failed to open, switching to simulation fallback:", openErr);
                        openRazorpaySimulationModal(initData, addressId, notes);
                    }
                } else {
                    // Sandbox fallback simulation modal
                    openRazorpaySimulationModal(initData, addressId, notes);
                }
            } catch (err) {
                resetOrderBtn();
                if (window.showToast) window.showToast(err.message, 'error', 5000);
                else alert(err.message);
            }
            return;
        }
    }

    // ==========================================
    // CHECKOUT COUPON MANAGEMENT
    // ==========================================

    function showCouponFeedback(message, type = 'error') {
        const feedbackEl = document.getElementById('couponFeedback');
        if (!feedbackEl) return;
        
        feedbackEl.className = 'text-xs rounded-xl p-3 ' + (
            type === 'success' 
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' 
                : 'bg-rose-50 text-rose-700 border border-rose-200'
        );
        feedbackEl.textContent = message;
        feedbackEl.classList.remove('hidden');

        setTimeout(() => {
            if (feedbackEl) feedbackEl.classList.add('hidden');
        }, 8000);
    }

    function renderCheckoutAppliedCoupons(coupons) {
        const container = document.getElementById('appliedCouponsList');
        if (!container) return;
        if (!coupons || coupons.length === 0) {
            container.innerHTML = '';
            container.classList.add('hidden');
            return;
        }
        container.classList.remove('hidden');
        container.innerHTML = coupons.map(c => `
            <div class="flex items-center justify-between p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200/90 text-emerald-900 transition-all">
                <div class="flex items-center gap-2 min-w-0">
                    <span class="font-mono font-bold text-xs uppercase tracking-wider text-[#0A4D2E]">${c.code}</span>
                    <span class="text-[10px] font-mono text-emerald-800">(-₹${Number(c.discountAmount || 0).toLocaleString('en-IN')})</span>
                </div>
                <button 
                    type="button" 
                    onclick="removeCouponFromCheckout('${c.code}')"
                    class="text-[10px] uppercase font-mono tracking-wider font-bold text-rose-700 hover:text-rose-900 bg-white hover:bg-rose-50 px-2 py-1 rounded-lg border border-rose-200 transition-colors cursor-pointer flex-shrink-0"
                    title="Remove Coupon Code"
                >
                    ✕
                </button>
            </div>
        `).join('');
    }

    function updateCheckoutTotals(summary, coupon = null, appliedCoupons = null) {
        if (!summary) return;

        currentGrandTotal = Number(summary.grandTotal || 0);
        currentDiscount = Number(summary.discount || 0);
        currentSubtotal = Number(summary.subtotal || 0);
        currentAppliedCoupon = coupon || null;
        if (appliedCoupons) {
            currentAppliedCoupons = appliedCoupons;
        } else if (summary.appliedCoupons) {
            currentAppliedCoupons = summary.appliedCoupons;
        } else if (coupon) {
            currentAppliedCoupons = [coupon];
        } else if (!coupon && (!summary.discount || summary.discount === 0)) {
            currentAppliedCoupons = [];
        }

        renderCheckoutAppliedCoupons(currentAppliedCoupons);

        const originalSubtotal = Number(summary.originalSubtotal || currentSubtotal);
        const productDiscount = Number(summary.productDiscount !== undefined ? summary.productDiscount : Math.max(0, originalSubtotal - currentSubtotal));
        const totalSavings = productDiscount + currentDiscount;

        // Catalog Value (MSRP) & Product Discount
        const origRow = document.getElementById('summaryOriginalRow');
        const origVal = document.getElementById('summaryOriginalVal');
        const prodDiscRow = document.getElementById('summaryProductDiscountRow');
        const prodDiscVal = document.getElementById('summaryProductDiscountVal');

        if (productDiscount > 0) {
            if (origRow) origRow.classList.remove('hidden');
            if (origVal) origVal.textContent = '₹' + originalSubtotal.toLocaleString('en-IN');
            if (prodDiscRow) prodDiscRow.classList.remove('hidden');
            if (prodDiscVal) prodDiscVal.textContent = '-₹' + productDiscount.toLocaleString('en-IN');
        } else {
            if (origRow) origRow.classList.add('hidden');
            if (prodDiscRow) prodDiscRow.classList.add('hidden');
        }

        // Subtotal
        const subtotalEl = document.getElementById('summarySubtotalVal');
        if (subtotalEl) subtotalEl.textContent = '₹' + currentSubtotal.toLocaleString('en-IN');

        // Coupon Discount Row
        const discountRow = document.getElementById('summaryDiscountRow');
        const discountVal = document.getElementById('summaryDiscountVal');
        const rateLabel = document.getElementById('summaryDiscountRateLabel');
        const codeBadge = document.getElementById('summaryDiscountCodeBadge');

        if (currentDiscount > 0 && currentAppliedCoupons && currentAppliedCoupons.length > 0) {
            if (discountRow) {
                discountRow.classList.remove('hidden');
                discountRow.classList.add('flex');
            }
            if (discountVal) discountVal.textContent = '-₹' + currentDiscount.toLocaleString('en-IN');
            if (codeBadge) codeBadge.textContent = currentAppliedCoupons.map(c => c.code).join(', ');
            if (rateLabel) {
                rateLabel.textContent = `${currentAppliedCoupons.length} coupon(s) applied`;
            }
        } else {
            if (discountRow) {
                discountRow.classList.add('hidden');
                discountRow.classList.remove('flex');
            }
            if (discountVal) discountVal.textContent = '-₹0';
            if (codeBadge) codeBadge.textContent = '';
            if (rateLabel) rateLabel.textContent = '';
        }

        // Taxes & Levies
        const taxEl = document.getElementById('summaryTaxVal');
        if (taxEl) taxEl.textContent = Math.round(currentSubtotal * 0.18).toLocaleString('en-IN');

        // Total Savings Banner
        const savingsBanner = document.getElementById('summaryTotalSavingsBanner');
        const savingsVal = document.getElementById('summaryTotalSavingsVal');
        if (totalSavings > 0) {
            if (savingsBanner) {
                savingsBanner.classList.remove('hidden');
                savingsBanner.classList.add('flex');
            }
            if (savingsVal) savingsVal.textContent = '₹' + totalSavings.toLocaleString('en-IN');
        } else {
            if (savingsBanner) {
                savingsBanner.classList.add('hidden');
                savingsBanner.classList.remove('flex');
            }
        }

        // Grand Total
        const grandTotalEl = document.getElementById('summaryGrandTotalVal');
        if (grandTotalEl) grandTotalEl.textContent = '₹' + currentGrandTotal.toLocaleString('en-IN');

        const couponInput = document.getElementById('checkoutCouponCode');
        if (couponInput) couponInput.value = '';

        // Update Payment Button
        updatePayButtonText();

        // Dynamically synchronize Vault Wallet payment eligibility
        syncWalletPaymentEligibility();
    }

    const collectorWalletBalance = <%= Number(typeof walletBalance !== 'undefined' ? walletBalance : (typeof wallet !== 'undefined' && wallet ? wallet.balance : 0)) %>;

    function syncWalletPaymentEligibility() {
        const walletCard = document.getElementById('payment-option-wallet');
        const walletRadio = document.getElementById('payment-radio-wallet');
        const walletDesc = document.getElementById('payment-wallet-desc');
        if (!walletCard || !walletRadio) return;

        const canPay = collectorWalletBalance >= currentGrandTotal && currentGrandTotal > 0;
        walletRadio.disabled = !canPay;

        if (canPay) {
            walletCard.classList.remove('border-zinc-200/60', 'bg-zinc-50/70', 'opacity-80', 'cursor-not-allowed');
            walletCard.classList.add('cursor-pointer');
            walletRadio.classList.remove('cursor-not-allowed');
            walletRadio.classList.add('cursor-pointer');
            if (walletDesc) {
                walletDesc.innerHTML = 'Instant one-click timepiece allocation deducted directly from your verified Vault liquidity reserve.';
            }
        } else {
            const shortfall = Math.max(0, currentGrandTotal - collectorWalletBalance);
            walletCard.classList.add('border-zinc-200/60', 'bg-zinc-50/70', 'opacity-80', 'cursor-not-allowed');
            walletCard.classList.remove('border-[#0A4D2E]', 'bg-emerald-50/20', 'ring-1', 'ring-[#0A4D2E]/20', 'shadow-xs', 'cursor-pointer');
            walletRadio.classList.add('cursor-not-allowed');
            walletRadio.classList.remove('cursor-pointer');
            if (walletDesc) {
                walletDesc.innerHTML = `<span class="text-amber-800 font-medium">Insufficient reserve balance for full settlement (Available: ₹${collectorWalletBalance.toLocaleString('en-IN')} • Shortfall: ₹${shortfall.toLocaleString('en-IN')}).</span> <a href="/wallet" target="_blank" class="text-[#0A4D2E] underline font-bold ml-1 hover:text-[#073822]">Top-up Wallet ↗</a> or choose Razorpay / Cash on Delivery.`;
            }

            if (currentSelectedPaymentMethod === 'Wallet') {
                selectPaymentOption('Razorpay');
            }
        }
    }

    async function applyCouponFromCheckout(codeOverride = null) {
        const input = document.getElementById('checkoutCouponCode');
        const code = (codeOverride || (input ? input.value : '')).trim();

        if (!code) {
            showCouponFeedback('Please enter a coupon code.', 'error');
            return;
        }

        const btn = document.getElementById('applyCouponBtn');
        const btnText = document.getElementById('applyCouponBtnText');
        const spinner = document.getElementById('applyCouponSpinner');

        if (btn) btn.disabled = true;
        if (btnText) btnText.classList.add('hidden');
        if (spinner) spinner.classList.remove('hidden');

        try {
            const res = await fetch('/checkout/apply-coupon', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ code })
            });

            const data = await res.json();

            if (!res.ok || !data.success) {
                throw new Error(data.message || 'Unable to apply coupon code.');
            }

            updateCheckoutTotals(data.summary, data.coupon, data.appliedCoupons);
            if (input) input.value = '';
            showCouponFeedback(data.message || 'Coupon code applied successfully!', 'success');
            if (window.showToast) {
                window.showToast(`Coupon code "${(data.coupon && data.coupon.code) || code}" applied: Saved ₹${Number(data.summary.discount).toLocaleString('en-IN')}`, 'success');
            }
            closeAvailableCouponsModal();
        } catch (err) {
            showCouponFeedback(err.message, 'error');
            if (window.showToast) {
                window.showToast(err.message, 'error');
            }
        } finally {
            if (btn) btn.disabled = false;
            if (btnText) btnText.classList.remove('hidden');
            if (spinner) spinner.classList.add('hidden');
        }
    }

    async function removeCouponFromCheckout(code = null) {
        const btn = document.getElementById('removeCouponBtn');
        const btnText = document.getElementById('removeCouponBtnText');
        const spinner = document.getElementById('removeCouponSpinner');

        if (btn) btn.disabled = true;
        if (btnText) btnText.classList.add('hidden');
        if (spinner) spinner.classList.remove('hidden');

        try {
            const res = await fetch('/checkout/remove-coupon', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ code })
            });

            const data = await res.json();

            if (!res.ok || !data.success) {
                throw new Error(data.message || 'Unable to remove coupon code.');
            }

            updateCheckoutTotals(data.summary, data.appliedCoupon, data.appliedCoupons);
            showCouponFeedback('Coupon code removed from your order.', 'success');
            if (window.showToast) {
                window.showToast('Coupon code removed from your order.', 'info');
            }
        } catch (err) {
            showCouponFeedback(err.message, 'error');
            if (window.showToast) {
                window.showToast(err.message, 'error');
            }
        } finally {
            if (btn) btn.disabled = false;
            if (btnText) btnText.classList.remove('hidden');
            if (spinner) spinner.classList.add('hidden');
        }
    }

    // Modal for Available Coupons
    async function openAvailableCouponsModal() {
        const modal = document.getElementById('availableCouponsModal');
        const listEl = document.getElementById('availableCouponsList');
        if (!modal) return;

        modal.classList.remove('hidden');
        modal.classList.add('flex');

        if (!listEl) return;
        listEl.innerHTML = `
            <div class="text-center py-8 text-zinc-400 text-xs font-mono">
                <span class="inline-block animate-spin h-5 w-5 border-2 border-[#0A4D2E] border-t-transparent rounded-full mb-2"></span>
                <p>Consulting catalog for available coupons...</p>
            </div>
        `;

        try {
            const res = await fetch('/api/coupons/available');
            const data = await res.json();

            if (!data.success || !data.coupons || data.coupons.length === 0) {
                listEl.innerHTML = `
                    <div class="text-center py-10 px-4 space-y-2">
                        <span class="text-2xl text-zinc-300">🎫</span>
                        <p class="text-sm font-serif text-zinc-700">No active coupons found.</p>
                        <p class="text-xs text-zinc-400 font-mono">New coupon codes will be delivered via newsletter.</p>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = data.coupons.map(c => {
                const isCurrentActive = (currentAppliedCoupons && currentAppliedCoupons.some(ac => ac && ac.code && ac.code.toUpperCase() === c.code.toUpperCase())) || (currentAppliedCoupon && currentAppliedCoupon.code && currentAppliedCoupon.code.toUpperCase() === c.code.toUpperCase());
                const isAlreadyRedeemed = c.alreadyRedeemed;
                const isEligible = c.isEligible && !isAlreadyRedeemed;
                const discountDisplay = c.discountType === 'percentage' 
                    ? `${c.discountValue}% OFF` 
                    : `₹${Number(c.discountValue).toLocaleString('en-IN')} DIRECT CREDIT`;

                return `
                    <div class="p-4 rounded-2xl border transition-all ${
                        isCurrentActive 
                            ? 'border-[#0A4D2E] bg-emerald-50/30 ring-1 ring-[#0A4D2E]/20' 
                            : isAlreadyRedeemed
                            ? 'border-zinc-100 bg-zinc-50/50 opacity-60'
                            : isEligible 
                            ? 'border-zinc-200 bg-white hover:border-[#0A4D2E]/40' 
                            : 'border-zinc-100 bg-zinc-50/60 opacity-75'
                    }">
                        <div class="flex items-start justify-between gap-3">
                            <div class="space-y-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-mono font-bold text-xs px-2.5 py-1 rounded-lg ${isAlreadyRedeemed ? 'bg-zinc-200 text-zinc-600' : 'bg-zinc-900 text-[#c5a059]'} tracking-wider">
                                        ${c.code}
                                    </span>
                                    <span class="text-[9px] uppercase font-mono font-semibold px-2 py-0.5 rounded ${
                                        isAlreadyRedeemed 
                                            ? 'bg-zinc-200 text-zinc-600' 
                                            : isEligible 
                                            ? 'bg-emerald-100 text-emerald-800' 
                                            : 'bg-amber-100 text-amber-800'
                                    }">
                                        ${isAlreadyRedeemed ? 'Already Redeemed' : isEligible ? 'Eligible' : `Min Order ₹${Number(c.minPurchaseAmount).toLocaleString('en-IN')}`}
                                    </span>
                                </div>
                                <h4 class="font-serif text-sm font-semibold text-zinc-900 pt-1">
                                    ${discountDisplay}
                                </h4>
                                <p class="text-xs text-zinc-500 font-light leading-relaxed">
                                    ${c.description}
                                </p>
                                ${c.maxDiscountAmount ? `
                                    <p class="text-[10px] text-zinc-400 font-mono">
                                        Ceiling Cap: ₹${Number(c.maxDiscountAmount).toLocaleString('en-IN')}
                                    </p>
                                ` : ''}
                            </div>

                            <div class="flex-shrink-0 pt-1">
                                ${isCurrentActive ? `
                                    <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold text-[#0A4D2E] bg-emerald-100 px-3 py-1.5 rounded-xl">
                                        ✓ Applied
                                    </span>
                                ` : isAlreadyRedeemed ? `
                                    <span class="text-[10px] font-mono text-zinc-400 bg-zinc-100 px-2.5 py-1 rounded-lg">
                                        Redeemed
                                    </span>
                                ` : isEligible ? `
                                    <button 
                                        type="button" 
                                        onclick="applyCouponFromCheckout('${c.code}')"
                                        class="px-3.5 py-1.5 bg-[#0A4D2E] hover:bg-[#073822] text-white rounded-xl text-[10px] uppercase font-mono font-bold tracking-wider transition-colors cursor-pointer shadow-xs"
                                    >
                                        Apply
                                    </button>
                                ` : `
                                    <span class="text-[10px] font-mono text-zinc-400">
                                        Ineligible
                                    </span>
                                `}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } catch (e) {
            listEl.innerHTML = `
                <div class="text-center py-6 text-rose-600 text-xs font-mono">
                    Failed to retrieve available coupons. Please try again.
                </div>
            `;
        }
    }

    function closeAvailableCouponsModal() {
        const modal = document.getElementById('availableCouponsModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (Array.isArray(initialCouponWarnings) && initialCouponWarnings.length > 0) {
            const combinedMsg = initialCouponWarnings.map(w => w.message).filter(Boolean).join(' ');
            if (combinedMsg) {
                showCouponFeedback(combinedMsg, 'error');
                if (window.showToast) window.showToast(combinedMsg, 'error', 6000);
            }
        }
    });
</script>
