<%- include('../partials/header', { title: 'Secure Checkout — DELTA' }) %>
<%- include('../partials/navbar', { activeNav: 'cart' }) %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-12">
    <div class="max-w-7xl mx-auto px-6 space-y-10">
        
        <!-- Breadcrumb / Order Step Indicator -->
        <div class="flex items-center justify-between border-b border-zinc-200/80 pb-6">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block mb-1">
                    BESPOKE ORDER
                </span>
                <h1 class="text-3xl sm:text-4xl font-serif text-zinc-900 font-normal">
                    Secure Vault Checkout
                </h1>
            </div>

            <!-- Steps Flow -->
            <div class="hidden sm:flex items-center gap-3 text-xs font-mono">
                <a href="/cart" class="text-zinc-400 hover:text-black transition-colors">1. Shopping Bag</a>
                <span class="text-zinc-300">/</span>
                <span class="text-zinc-900 font-bold border-b border-black pb-0.5">2. Destination & Payment</span>
                <span class="text-zinc-300">/</span>
                <span class="text-zinc-400">3. Confirmation</span>
            </div>
        </div>

        <!-- Flash Alert -->
        <%- include('../partials/flash-message') %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <!-- Left Column: Delivery Address & Payment Selection (7 Cols) -->
            <div class="lg:col-span-7 space-y-10">
                
                <!-- 1. Destination Address Section -->
                <section class="bg-white rounded-3xl border border-zinc-200/80 p-8 space-y-6 shadow-sm">
                    <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
                        <div class="flex items-center gap-3">
                            <span class="w-6 h-6 rounded-full bg-[#1c1c1c] text-white text-[11px] font-mono flex items-center justify-center font-bold">1</span>
                            <h2 class="text-xl font-serif text-zinc-900 font-normal">
                                Delivery Destination
                            </h2>
                        </div>

                        <button 
                            type="button" 
                            onclick="openAddAddressModal()"
                            class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-[#0A4D2E] hover:text-[#06331e] transition-colors cursor-pointer"
                        >
                            <span>+ Add New Address</span>
                        </button>
                    </div>

                    <!-- Addresses List Grid -->
                    <div id="checkoutAddressesList" class="space-y-4">
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach((addr, idx) => { %>
                                <% 
                                    const isChecked = (defaultAddress && defaultAddress._id.toString() === addr._id.toString()) || (idx === 0 && !defaultAddress);
                                %>
                                <label 
                                    id="address-card-<%= addr._id %>"
                                    class="address-option-card relative block p-5 rounded-2xl border-2 transition-all cursor-pointer <%= isChecked ? 'border-[#0A4D2E] bg-emerald-50/20 ring-1 ring-[#0A4D2E]/20 shadow-xs' : 'border-zinc-200 hover:border-zinc-300 bg-white' %>"
                                >
                                    <div class="flex items-start gap-4">
                                        <!-- Radio -->
                                        <div class="pt-0.5">
                                            <input 
                                                type="radio" 
                                                name="selectedAddressId" 
                                                value="<%= addr._id %>" 
                                                <%= isChecked ? 'checked' : '' %>
                                                onchange="selectAddressCard('<%= addr._id %>')"
                                                class="w-4 h-4 text-[#0A4D2E] focus:ring-[#0A4D2E] accent-[#0A4D2E] cursor-pointer"
                                            >
                                        </div>

                                        <!-- Address Info -->
                                        <div class="flex-1 space-y-1">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <h3 class="font-serif text-base font-semibold text-zinc-900">
                                                    <%= addr.fullName %>
                                                </h3>
                                                <span class="text-[9px] uppercase font-mono px-2 py-0.5 rounded bg-zinc-100 text-zinc-600 font-semibold">
                                                    <%= addr.addressType || 'Home' %>
                                                </span>
                                                <% if (addr.isDefault) { %>
                                                    <span class="text-[9px] uppercase font-mono px-2 py-0.5 rounded bg-[#0A4D2E] text-white font-bold">
                                                        Primary
                                                    </span>
                                                <% } %>
                                            </div>

                                            <p class="text-xs text-zinc-600 leading-relaxed font-light">
                                                <%= addr.addressLine %>, <%= addr.city %>, <%= addr.state %> — <span class="font-mono font-medium text-zinc-800"><%= addr.pincode %></span>
                                            </p>
                                            
                                            <p class="text-xs text-zinc-500 font-mono pt-1">
                                                Phone: <%= addr.phone %>
                                            </p>
                                        </div>

                                        <!-- Edit & Default Actions -->
                                        <div class="flex items-center gap-3 pt-0.5 text-[11px] font-semibold">
                                            <button 
                                                type="button" 
                                                onclick="openEditAddressModal('<%= addr._id %>')"
                                                class="text-zinc-600 hover:text-black uppercase tracking-wider transition-colors cursor-pointer"
                                            >
                                                Edit
                                            </button>
                                        </div>
                                    </div>
                                </label>
                            <% }) %>
                        <% } else { %>
                            <!-- Empty Addresses State -->
                            <div id="noAddressesNotice" class="p-8 border border-dashed border-zinc-300 rounded-2xl text-center space-y-4 bg-zinc-50/50">
                                <p class="text-xs text-zinc-600 font-light">
                                    No delivery destination is currently saved in your address book.
                                </p>
                                <button 
                                    type="button" 
                                    onclick="openAddAddressModal()"
                                    class="inline-block px-6 py-3 bg-[#1c1c1c] text-white rounded-xl text-xs uppercase font-semibold tracking-[0.15em] hover:bg-black transition-colors cursor-pointer"
                                >
                                    + Add Delivery Address
                                </button>
                            </div>
                        <% } %>
                    </div>
                </section>

                <!-- 2. Payment Method Selection (Razorpay Secure Gateway, Vault Wallet, Cash on Delivery) -->
                <section class="bg-white rounded-3xl border border-zinc-200/80 p-8 space-y-6 shadow-sm">
                    <div class="flex items-center gap-3 border-b border-zinc-100 pb-4">
                        <span class="w-6 h-6 rounded-full bg-[#1c1c1c] text-white text-[11px] font-mono flex items-center justify-center font-bold">2</span>
                        <h2 class="text-xl font-serif text-zinc-900 font-normal">
                            Order Payment Method
                        </h2>
                    </div>

                    <div class="space-y-4">
                        
                        <!-- Option 1: Razorpay Online Gateway (Primary Gateway) -->
                        <label 
                            id="payment-option-razorpay"
                            class="payment-option-card relative block p-5 rounded-2xl border-2 border-[#0A4D2E] bg-emerald-50/20 ring-1 ring-[#0A4D2E]/20 transition-all cursor-pointer shadow-xs"
                        >
                            <div class="flex items-start gap-4">
                                <div class="pt-0.5">
                                    <input 
                                        type="radio" 
                                        name="paymentMethod" 
                                        value="Razorpay" 
                                        checked 
                                        onchange="selectPaymentOption('Razorpay')"
                                        class="w-4 h-4 text-[#0A4D2E] focus:ring-[#0A4D2E] accent-[#0A4D2E] cursor-pointer"
                                    >
                                </div>
                                <div class="space-y-1.5 flex-1">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <h3 class="font-serif text-base font-semibold text-zinc-900">
                                                Razorpay Secure Gateway
                                            </h3>
                                            <span class="text-[9px] uppercase font-mono px-2.5 py-0.5 rounded-full bg-[#0A4D2E] text-white font-bold">
                                                Recommended
                                            </span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-[10px] font-mono text-zinc-500">
                                            <span class="px-2 py-0.5 rounded bg-zinc-100 border border-zinc-200 font-semibold text-zinc-700">UPI</span>
                                            <span class="px-2 py-0.5 rounded bg-zinc-100 border border-zinc-200 font-semibold text-zinc-700">Cards</span>
                                            <span class="px-2 py-0.5 rounded bg-zinc-100 border border-zinc-200 font-semibold text-zinc-700">NetBanking</span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-zinc-600 font-light leading-relaxed">
                                        Instant 256-bit encrypted settlement via Visa, MasterCard, RuPay, UPI (GPay, PhonePe, Paytm), or NetBanking.
                                    </p>
                                </div>
                            </div>
                        </label>

                        <!-- Option: DELTA Vault Wallet -->
                        <% 
                            const vaultBalance = Number(typeof walletBalance !== 'undefined' ? walletBalance : (typeof wallet !== 'undefined' && wallet ? wallet.balance : 0));
                            const canPayWithWallet = vaultBalance >= Number(summary.grandTotal || 0) && Number(summary.grandTotal || 0) > 0;
                        %>
                        <label 
                            id="payment-option-wallet"
                            class="payment-option-card relative block p-5 rounded-2xl border-2 <%= canPayWithWallet ? 'border-zinc-200 hover:border-zinc-300 bg-white cursor-pointer' : 'border-zinc-200/60 bg-zinc-50/70 opacity-80 cursor-not-allowed' %> transition-all"
                        >
                            <div class="flex items-start gap-4">
                                <div class="pt-0.5">
                                    <input 
                                        type="radio" 
                                        name="paymentMethod" 
                                        id="payment-radio-wallet"
                                        value="Wallet" 
                                        <%= canPayWithWallet ? '' : 'disabled' %>
                                        onchange="selectPaymentOption('Wallet')"
                                        class="w-4 h-4 text-[#0A4D2E] focus:ring-[#0A4D2E] accent-[#0A4D2E] <%= canPayWithWallet ? 'cursor-pointer' : 'cursor-not-allowed' %>"
                                    >
                                </div>
                                <div class="space-y-1.5 flex-1">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <h3 class="font-serif text-base font-semibold text-zinc-900 flex items-center gap-2">
                                                <span>DELTA Vault Wallet</span>
                                                <span class="text-[9px] uppercase font-mono px-2 py-0.5 rounded bg-amber-50 text-amber-800 border border-amber-200 font-bold">
                                                    Reserve Balance
                                                </span>
                                            </h3>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs font-mono">
                                            <span class="text-zinc-500">Available:</span>
                                            <span class="font-bold <%= vaultBalance > 0 ? 'text-[#0A4D2E]' : 'text-zinc-700' %>">
                                                ₹<%= vaultBalance.toLocaleString('en-IN') %>
                                            </span>
                                        </div>
                                    </div>
                                    <p id="payment-wallet-desc" class="text-xs text-zinc-600 font-light leading-relaxed">
                                        <% if (canPayWithWallet) { %>
                                            Instant one-click timepiece allocation deducted directly from your verified Vault liquidity reserve.
                                        <% } else { %>
                                            <span class="text-amber-800 font-medium">
                                                Insufficient reserve balance for full settlement (Available: ₹<%= vaultBalance.toLocaleString('en-IN') %> • Shortfall: ₹<%= (Math.max(0, Number(summary.grandTotal || 0) - vaultBalance)).toLocaleString('en-IN') %>).
                                            </span>
                                            Please choose Razorpay, Vault Wallet, or Cash on Delivery.
                                        <% } %>
                                    </p>
                                </div>
                            </div>
                        </label>

                        <!-- Option 3: Cash on Delivery (COD) -->
                        <label 
                            id="payment-option-cod"
                            class="payment-option-card relative block p-5 rounded-2xl border-2 border-zinc-200 hover:border-zinc-300 bg-white transition-all cursor-pointer"
                        >
                            <div class="flex items-start gap-4">
                                <div class="pt-0.5">
                                    <input 
                                        type="radio" 
                                        name="paymentMethod" 
                                        value="Cash on Delivery" 
                                        onchange="selectPaymentOption('Cash on Delivery')"
                                        class="w-4 h-4 text-[#0A4D2E] focus:ring-[#0A4D2E] accent-[#0A4D2E] cursor-pointer"
                                    >
                                </div>
                                <div class="space-y-1.5 flex-1">
                                    <div class="flex flex-wrap items-center justify-between gap-2">
                                        <div class="flex items-center gap-2">
                                            <h3 class="font-serif text-base font-semibold text-zinc-900">
                                                Cash on Delivery (White-Glove)
                                            </h3>
                                            <span class="text-[9px] uppercase font-mono px-2 py-0.5 rounded bg-zinc-100 text-zinc-700 font-medium">
                                                Courier Escort
                                            </span>
                                        </div>
                                        <span class="text-[10px] font-mono text-zinc-500">Pay Upon Delivery</span>
                                    </div>
                                    <p class="text-xs text-zinc-600 font-light leading-relaxed">
                                        Pay via cash, certified bank cheque, or UPI upon white-glove personal delivery and physical timepiece inspection.
                                    </p>
                                </div>
                            </div>
                        </label>

                    </div>

                    <!-- Delivery Instructions / Notes -->
                    <div class="pt-2 space-y-2">
                        <label for="orderNotes" class="block text-[10px] uppercase font-mono tracking-wider font-semibold text-zinc-500">
                            White-Glove Delivery Instructions (Optional)
                        </label>
                        <textarea 
                            id="orderNotes" 
                            name="orderNotes" 
                            rows="2" 
                            placeholder="e.g., Deliver to private reception / Call upon arrival at residence..."
                            class="w-full text-xs p-3.5 rounded-xl border border-zinc-200 focus:border-[#0A4D2E] focus:ring-1 focus:ring-[#0A4D2E] outline-none transition-colors font-light bg-zinc-50/50"
                        ></textarea>
                    </div>

                </section>

            </div>

            <!-- Right Column: Order Summary & Review (5 Cols) -->
            <div class="lg:col-span-5 space-y-6 sticky top-28">
                
                <div class="bg-white rounded-3xl border border-zinc-200/80 p-8 space-y-6 shadow-sm">
                    
                    <div class="border-b border-zinc-100 pb-4 flex items-center justify-between">
                        <h2 class="text-xl font-serif text-zinc-900 font-normal">
                            Order Summary
                        </h2>
                        <span class="text-xs font-mono text-zinc-500 font-semibold">
                            <%= cart.activeItemCount %> <%= cart.activeItemCount === 1 ? 'Timepiece' : 'Timepieces' %>
                        </span>
                    </div>

                    <!-- Products List -->
                    <div class="space-y-4 max-h-[380px] overflow-y-auto pr-1 scrollbar-thin">
                        <% cart.items.forEach(item => { %>
                            <% 
                                const p = item.product;
                                const v = item.variant || {};
                                const imgSrc = (v.images && v.images.length > 0) ? v.images[0] : ((p.images && p.images.length > 0) ? p.images[0] : '');
                            %>
                            <div class="flex items-center gap-4 py-2 border-b border-zinc-100 last:border-0">
                                <!-- Thumbnail -->
                                <div class="w-16 h-16 rounded-xl bg-[#f2eeeb] overflow-hidden p-2 flex items-center justify-center flex-shrink-0 border border-zinc-200/60">
                                    <% if (imgSrc) { %>
                                        <img src="<%= imgSrc %>" alt="<%= p.name %>" class="w-full h-full object-cover">
                                    <% } else { %>
                                        <span class="text-zinc-300 text-lg">⏱</span>
                                    <% } %>
                                </div>

                                <!-- Info -->
                                <div class="flex-1 min-w-0 space-y-0.5">
                                    <p class="text-[9px] uppercase font-mono tracking-wider text-zinc-400 font-semibold truncate">
                                        <%= p.brand ? p.brand.name : 'Manufacture' %>
                                    </p>
                                    <h4 class="font-serif text-sm font-semibold text-zinc-900 truncate">
                                        <%= p.name %>
                                    </h4>
                                    
                                    <!-- Variant Pill -->
                                    <div class="flex items-center gap-1.5 text-[10px] text-zinc-500">
                                        <span class="w-2 h-2 rounded-full border border-black/20 inline-block" style="background-color: <%= v.colorCode || '#1b1c1c' %>;"></span>
                                        <span class="font-medium text-zinc-700 truncate"><%= v.color || 'Standard Edition' %></span>
                                        <span class="font-mono text-zinc-400">× <%= item.quantity %></span>
                                    </div>
                                </div>

                                <!-- Price -->
                                <div class="text-right flex-shrink-0 space-y-0.5">
                                    <p class="font-mono text-xs font-semibold text-zinc-900">
                                        ₹<%= Number(item.itemTotal || (item.price * item.quantity)).toLocaleString('en-IN') %>
                                    </p>
                                    <% if (item.originalPrice && item.originalPrice > item.price) { %>
                                        <p class="font-mono text-[10px] text-zinc-400 line-through">
                                            ₹<%= Number(item.originalPrice * item.quantity).toLocaleString('en-IN') %>
                                        </p>
                                        <span class="inline-block text-[8px] font-mono uppercase bg-emerald-50 text-emerald-800 border border-emerald-200 px-1 py-0.2 rounded font-semibold">
                                            Save ₹<%= Number((item.originalPrice - item.price) * item.quantity).toLocaleString('en-IN') %>
                                        </span>
                                    <% } else if (item.quantity > 1) { %>
                                        <p class="font-mono text-[9px] text-zinc-400">
                                            ₹<%= Number(item.price).toLocaleString('en-IN') %>/ea
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Coupon Redemption Section -->
                    <div class="pt-4 border-t border-zinc-100 space-y-3" id="checkoutCouponSection">
                        <div class="flex items-center justify-between">
                            <label class="block text-[10px] uppercase font-mono tracking-[0.2em] font-semibold text-zinc-700">
                                Coupon / Promo Code
                            </label>
                            <button 
                                type="button" 
                                onclick="openAvailableCouponsModal()"
                                class="text-[10px] uppercase font-mono tracking-wider text-[#c5a059] hover:text-[#9e7a32] font-bold inline-flex items-center gap-1 cursor-pointer transition-colors"
                            >
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                <span>Available Coupons</span>
                            </button>
                        </div>

                        <% const hasActiveCoupon = Boolean(appliedCoupon && appliedCoupon.code); %>

                        <!-- Input Form (Always available to add multiple coupons) -->
                        <div id="couponInputContainer" class="flex gap-2 items-center">
                            <div class="relative flex-1">
                                <input 
                                    type="text" 
                                    id="checkoutCouponCode" 
                                    placeholder="e.g. DELTA10, ROYAL5" 
                                    class="w-full px-3.5 py-2.5 bg-zinc-50 border border-zinc-300 rounded-xl text-xs font-mono uppercase text-zinc-900 placeholder:normal-case placeholder:font-sans placeholder:text-zinc-400 focus:outline-none focus:border-[#0A4D2E] focus:bg-white transition-all"
                                    onkeydown="if(event.key === 'Enter'){ event.preventDefault(); applyCouponFromCheckout(); }"
                                >
                            </div>
                            <button 
                                type="button" 
                                id="applyCouponBtn"
                                onclick="applyCouponFromCheckout()" 
                                class="px-4 py-2.5 bg-[#0A4D2E] hover:bg-[#073822] text-white rounded-xl text-[10px] uppercase font-mono font-bold tracking-wider transition-colors cursor-pointer flex-shrink-0 flex items-center justify-center min-w-[72px]"
                            >
                                <span id="applyCouponBtnText">Apply</span>
                                <span id="applyCouponSpinner" class="hidden animate-spin h-3.5 w-3.5 border-2 border-white border-t-transparent rounded-full"></span>
                            </button>
                        </div>

                        <!-- Applied Coupons List (Multiple coupons supported) -->
                        <% const initialCheckoutCoupons = (typeof appliedCoupons !== 'undefined' && Array.isArray(appliedCoupons) && appliedCoupons.length > 0) ? appliedCoupons : ((typeof appliedCoupon !== 'undefined' && appliedCoupon && appliedCoupon.code) ? [appliedCoupon] : []); %>
                        <div id="appliedCouponsList" class="space-y-2 <%= initialCheckoutCoupons.length > 0 ? '' : 'hidden' %>">
                            <% initialCheckoutCoupons.forEach(function(c) { %>
                                <div class="flex items-center justify-between p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200/90 text-emerald-900 transition-all">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="font-mono font-bold text-xs uppercase tracking-wider text-[#0A4D2E]"><%= c.code %></span>
                                        <span class="text-[10px] font-mono text-emerald-800">(-₹<%= Number(c.discountAmount || 0).toLocaleString('en-IN') %>)</span>
                                    </div>
                                    <button 
                                        type="button" 
                                        onclick="removeCouponFromCheckout('<%= c.code %>')"
                                        class="text-[10px] uppercase font-mono tracking-wider font-bold text-rose-700 hover:text-rose-900 bg-white hover:bg-rose-50 px-2 py-1 rounded-lg border border-rose-200 transition-colors cursor-pointer flex-shrink-0"
                                        title="Remove Coupon Code"
                                    >
                                        ✕
                                    </button>
                                </div>
                            <% }); %>
                        </div>

                        <!-- Fallback container for legacy script references -->
                        <div id="appliedCouponContainer" class="hidden"></div>

                        <!-- Initial SSR Inactivated/Invalidated Coupon Warning Banner -->
                        <% if (typeof couponWarnings !== 'undefined' && Array.isArray(couponWarnings) && couponWarnings.length > 0) { %>
                            <div id="initialCouponWarningsBanner" class="p-3 mb-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs flex items-start gap-2">
                                <svg class="w-4 h-4 text-rose-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                </svg>
                                <div class="space-y-1">
                                    <% couponWarnings.forEach(function(w) { %>
                                        <p class="font-medium"><%= w.message %></p>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Inline Notification Feedback Box -->
                        <div id="couponFeedback" class="hidden text-xs rounded-xl p-2.5"></div>
                    </div>

                    <!-- Financial Breakdown -->
                    <div class="space-y-3.5 pt-5 border-t border-zinc-100 text-xs">
                        
                        <!-- Header / Section Title -->
                        <div class="flex items-center justify-between pb-1 border-b border-zinc-100/80">
                            <span class="text-[10px] uppercase font-mono tracking-[0.2em] font-bold text-zinc-400">
                                Valuation Breakdown
                            </span>
                            <span class="text-[10px] font-mono text-zinc-400">
                                Currency: INR (₹)
                            </span>
                        </div>

                        <!-- 1. Catalog / Retail Value (If product discount exists) -->
                        <% 
                            const origSubtotal = summary.originalSubtotal || summary.subtotal; 
                            const prodDiscount = (summary.productDiscount !== undefined) ? summary.productDiscount : Math.max(0, origSubtotal - summary.subtotal);
                        %>
                        <div id="summaryOriginalRow" class="flex justify-between text-zinc-500 <%= prodDiscount > 0 ? '' : 'hidden' %>">
                            <span>Catalog Value (MSRP)</span>
                            <span id="summaryOriginalVal" class="font-mono line-through text-zinc-400">
                                ₹<%= Number(origSubtotal).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <!-- 2. Catalog / Timepiece Discount -->
                        <div id="summaryProductDiscountRow" class="flex justify-between text-emerald-800 font-medium <%= prodDiscount > 0 ? '' : 'hidden' %>">
                            <span class="flex items-center gap-1.5">
                                <span>Vault Catalog Offer</span>
                                <span class="text-[9px] uppercase font-mono px-1.5 py-0.2 bg-emerald-100/70 text-emerald-800 rounded font-semibold">Special Edition</span>
                            </span>
                            <span id="summaryProductDiscountVal" class="font-mono text-emerald-700">
                                -₹<%= Number(prodDiscount).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <!-- 3. Bag / Timepiece Subtotal -->
                        <div class="flex justify-between text-zinc-700">
                            <span>Timepiece Subtotal</span>
                            <span id="summarySubtotalVal" class="font-mono font-semibold text-zinc-900">
                                ₹<%= Number(summary.subtotal).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <!-- 4. Coupon Discount Row -->
                        <div id="summaryDiscountRow" class="flex justify-between items-center text-emerald-800 bg-emerald-50/70 border border-emerald-200/60 p-2.5 rounded-xl transition-all <%= (summary.discount && summary.discount > 0) ? '' : 'hidden' %>">
                            <div class="space-y-0.5">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="font-semibold text-emerald-900">Coupon Discount</span>
                                    <span id="summaryDiscountCodeBadge" class="text-[10px] font-mono font-bold uppercase tracking-wider bg-zinc-900 text-[#c5a059] px-1.5 py-0.5 rounded">
                                        <%= hasActiveCoupon ? appliedCoupon.code : '' %>
                                    </span>
                                </div>
                                <span id="summaryDiscountRateLabel" class="text-[10px] font-mono text-emerald-700 block">
                                    <%= (hasActiveCoupon && appliedCoupon.discountType === 'percentage') 
                                        ? `${appliedCoupon.discountValue}% applied to allocation` 
                                        : 'Direct credit applied' %>
                                </span>
                            </div>
                            <span id="summaryDiscountVal" class="font-mono text-sm font-bold text-[#0A4D2E]">
                                -₹<%= Number(summary.discount || 0).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <!-- 5. Shipping / Delivery -->
                        <div class="flex justify-between text-zinc-600">
                            <span class="flex items-center gap-1.5">
                                <span>White-Glove Insured Courier</span>
                                <span class="text-[9px] uppercase font-mono text-zinc-400">Armoured Transit</span>
                            </span>
                            <div class="text-right">
                                <span class="text-[#0A4D2E] font-semibold uppercase text-[10px] font-mono block">Complimentary</span>
                                <span class="text-[9px] font-mono text-zinc-400 line-through">₹5,000</span>
                            </div>
                        </div>

                        <!-- 6. Taxes & Duties Breakdown -->
                        <% const estimatedTaxVal = summary.tax || Math.round(summary.subtotal * 0.18); %>
                        <div class="flex justify-between text-zinc-500 text-[11px] pt-1 border-t border-zinc-100">
                            <span class="flex items-center gap-1">
                                <span>GST (18% Statutory Levies)</span>
                            </span>
                            <span class="font-mono text-zinc-600">
                                ₹<span id="summaryTaxVal"><%= Number(estimatedTaxVal).toLocaleString('en-IN') %></span>
                                <span class="italic text-[10px] text-zinc-400 ml-1">(Included)</span>
                            </span>
                        </div>

                        <!-- 7. Total Savings Callout Banner -->
                        <% 
                            const totalSavingsVal = prodDiscount + (summary.discount || 0); 
                        %>
                        <div id="summaryTotalSavingsBanner" class="p-3 bg-gradient-to-r from-emerald-50 via-emerald-50/50 to-amber-50/40 border border-emerald-200/80 rounded-2xl flex items-center justify-between text-xs transition-all <%= totalSavingsVal > 0 ? '' : 'hidden' %>">
                            <div class="flex items-center gap-2">
                                <span class="text-base">✨</span>
                                <div>
                                    <span class="font-semibold text-emerald-900 block text-[11px]">Total Coupon Savings</span>
                                    <span class="text-[9px] text-emerald-700 font-mono">Catalog + Coupon Code</span>
                                </div>
                            </div>
                            <span id="summaryTotalSavingsVal" class="font-mono font-bold text-sm text-[#0A4D2E]">
                                ₹<%= Number(totalSavingsVal).toLocaleString('en-IN') %>
                            </span>
                        </div>

                        <!-- 8. Final Valuation Total -->
                        <div class="pt-4 border-t-2 border-zinc-900 flex items-baseline justify-between">
                            <div>
                                <span class="text-xs uppercase tracking-[0.15em] font-mono font-bold text-zinc-900 block">TOTAL VALUATION</span>
                                <span id="paymentStatusSubtext" class="text-[10px] text-zinc-400 font-mono">White-Glove Insured Settlement</span>
                            </div>
                            <div class="text-right">
                                <span id="summaryGrandTotalVal" class="text-2xl sm:text-3xl font-bold font-mono text-[#0A4D2E] block">
                                    ₹<%= Number(summary.grandTotal).toLocaleString('en-IN') %>
                                </span>
                                <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-wider block">Net All-Inclusive</span>
                            </div>
                        </div>

                    </div>

                    <!-- CTA Button -->
                    <div class="pt-2">
                        <button 
                            type="button" 
                            id="placeOrderBtn"
                            onclick="submitOrder()"
                            class="w-full py-4 px-6 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-xl text-xs uppercase font-semibold tracking-[0.2em] transition-all shadow-lg shadow-[#0A4D2E]/20 active:scale-[0.99] cursor-pointer flex items-center justify-center gap-2"
                        >
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            <span id="placeOrderBtnText">Pay via Razorpay • ₹<%= Number(summary.grandTotal).toLocaleString('en-IN') %></span>
                        </button>
                    </div>

                    <!-- Security Badge -->
                    <div class="space-y-1 text-center text-[10px] text-zinc-400 font-mono pt-2">
                        <p class="flex items-center justify-center gap-1.5 text-zinc-600 font-semibold">
                            <span>🛡 SECURE 256-BIT ENCRYPTED SETTLEMENT</span>
                        </p>
                        <p class="font-sans text-zinc-400">Delta Concierge is available for personal assistance at 1-800-DELTA-H</p>
                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

