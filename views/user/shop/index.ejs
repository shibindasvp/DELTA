<%- include('../partials/header', { title: 'The Shop — DELTA Haute Horlogerie' }) %>
<%- include('../partials/navbar') %>

<%
    const safeQuery = (typeof query !== 'undefined' && query) ? query : {};
    const safeFilterData = (typeof filterData !== 'undefined' && filterData) ? filterData : { brands: [], materials: [] };
    const safeBrands = (safeFilterData.brands && Array.isArray(safeFilterData.brands)) ? safeFilterData.brands : ((typeof brands !== 'undefined' && Array.isArray(brands)) ? brands : []);
    const safeProducts = (typeof products !== 'undefined' && Array.isArray(products)) ? products : [];
    const safePagination = (typeof pagination !== 'undefined' && pagination) ? pagination : { currentPage: 1, totalPages: 1, totalItems: safeProducts.length, pageLimit: 12, hasNextPage: false, hasPrevPage: false, pageNumbers: [1] };
%>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c]">
    
    <!-- Title & Intro -->
    <div class="pt-14 pb-8 max-w-3xl mx-auto px-6 text-center space-y-3">
        <h1 class="text-4xl sm:text-5xl font-serif font-normal tracking-tight text-zinc-900">
            The Shop
        </h1>
        <p class="text-xs sm:text-sm text-zinc-500 font-light max-w-xl mx-auto leading-relaxed">
            Curated Precision for the Discerning Collector. Discover a legacy of craftsmanship through our hand-selected timepieces.
        </p>
    </div>

    <!-- Flash Messages -->
    <div class="max-w-7xl mx-auto px-6">
        <%- include('../partials/flash-message') %>
    </div>

    <!-- Horizontal Brand Navigation Pills -->
    <div class="max-w-7xl mx-auto px-6 border-b border-zinc-200 pb-2">
        <% 
            const primaryBrands = safeBrands.slice(0, 5);
            const moreBrands = safeBrands.slice(5);
            const selectedMoreBrand = moreBrands.find(b => b.slug === safeQuery.brand);
            const isMoreBrandActive = Boolean(selectedMoreBrand);
        %>
        <div id="brandPillsContainer" class="flex items-center justify-center flex-wrap gap-4 sm:gap-8 text-[11px] uppercase tracking-[0.2em] font-medium text-zinc-500">
            <button 
                type="button" 
                onclick="applyBrandFilter('')"
                data-brand-pill=""
                class="brand-pill py-2 transition-colors border-b-2 cursor-pointer <%= !safeQuery.brand ? 'text-zinc-900 font-bold border-zinc-900' : 'border-transparent hover:text-black hover:border-zinc-300' %>"
            >
                All Brands
            </button>
            <% primaryBrands.forEach(b => { %>
                <button 
                    type="button" 
                    onclick="applyBrandFilter('<%= b.slug %>')"
                    data-brand-pill="<%= b.slug %>"
                    class="brand-pill py-2 transition-colors border-b-2 cursor-pointer <%= safeQuery.brand === b.slug ? 'text-zinc-900 font-bold border-zinc-900' : 'border-transparent hover:text-black hover:border-zinc-300' %>"
                >
                    <%= b.name %>
                </button>
            <% }) %>

            <% if (moreBrands.length > 0) { %>
                <!-- Dropdown for More Brands (Remaining Brands) -->
                <div class="relative inline-block text-left" id="moreBrandsContainer">
                    <button 
                        type="button" 
                        id="moreBrandsBtn"
                        onclick="toggleMoreBrandsDropdown(event)"
                        data-brand-pill="more-dropdown"
                        class="brand-pill py-2 transition-colors border-b-2 cursor-pointer flex items-center gap-1.5 <%= isMoreBrandActive ? 'text-zinc-900 font-bold border-zinc-900' : 'border-transparent text-zinc-500 hover:text-black hover:border-zinc-300' %>"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        <span id="moreBrandsBtnText"><%= isMoreBrandActive ? selectedMoreBrand.name : 'More Brands' %></span>
                        <svg id="moreBrandsChevron" class="w-3.5 h-3.5 transition-transform duration-200 <%= isMoreBrandActive ? 'text-zinc-900' : 'text-zinc-400' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    <!-- Dropdown Menu List -->
                    <div 
                        id="moreBrandsDropdown" 
                        class="hidden absolute left-1/2 -translate-x-1/2 sm:left-auto sm:right-0 sm:translate-x-0 mt-2 w-60 max-h-64 overflow-y-auto bg-white rounded-xl shadow-[0_15px_35px_rgba(0,0,0,0.12)] border border-zinc-200 py-1.5 z-50 text-left normal-case font-sans tracking-normal"
                    >
                        <div class="px-3 py-1.5 border-b border-zinc-100 text-[10px] font-mono uppercase tracking-wider text-zinc-400 font-semibold">
                            Select Maison (<%= moreBrands.length %>)
                        </div>
                        <% moreBrands.forEach(b => { %>
                            <button 
                                type="button" 
                                onclick="selectMoreBrand('<%= b.slug %>', '<%= b.name.replace(/'/g, "\\'") %>')"
                                data-more-brand-slug="<%= b.slug %>"
                                class="more-brand-item w-full px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-zinc-950 flex items-center justify-between transition-colors cursor-pointer text-left font-medium <%= safeQuery.brand === b.slug ? 'bg-zinc-50 font-bold text-[#0A4D2E]' : '' %>"
                            >
                                <span><%= b.name %></span>
                                <span class="checkmark <%= safeQuery.brand === b.slug ? '' : 'hidden' %> text-[#0A4D2E] text-xs font-bold">✓</span>
                            </button>
                        <% }) %>
                    </div>

                    <!-- Hidden/Synchronized Select element for test suites, form handling, and accessibility -->
                    <select 
                        id="moreBrandsSelect" 
                        name="moreBrands"
                        onchange="applyBrandFilter(this.value)"
                        class="sr-only"
                        aria-label="More Brands"
                    >
                        <option value="">More Brands</option>
                        <% moreBrands.forEach(b => { %>
                            <option value="<%= b.slug %>" <%= safeQuery.brand === b.slug ? 'selected' : '' %>>
                                <%= b.name %>
                            </option>
                        <% }) %>
                    </select>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Secondary Filter & Sorting Controls Bar -->
    <div class="max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-4 border-b border-zinc-200/60">
        
        <!-- Filter Dropdowns Group -->
        <div class="flex items-center flex-wrap gap-3 text-xs">
            
            <!-- Sort By Dropdown -->
            <div class="relative inline-block">
                <select 
                    id="sortSelect" 
                    onchange="applySort(this.value)"
                    class="bg-transparent border border-zinc-300 hover:border-zinc-400 px-3.5 py-2 rounded-xl text-xs text-zinc-800 font-medium focus:outline-none cursor-pointer pr-8 appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:9px_9px] bg-[right_10px_center] bg-no-repeat"
                >
                    <option value="newest" <%= safeQuery.sort === 'newest' ? 'selected' : '' %>>Sort By: Featured</option>
                    <option value="price_asc" <%= safeQuery.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
                    <option value="price_desc" <%= safeQuery.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
                    <option value="name_asc" <%= safeQuery.sort === 'name_asc' ? 'selected' : '' %>>Name: A to Z</option>
                    <option value="name_desc" <%= safeQuery.sort === 'name_desc' ? 'selected' : '' %>>Name: Z to A</option>
                </select>
            </div>

            <!-- Price Range Dropdown -->
            <div class="relative inline-block">
                <select 
                    id="priceFilterSelect" 
                    onchange="handlePriceSelect(this.value)"
                    class="bg-transparent border border-zinc-300 hover:border-zinc-400 px-3.5 py-2 rounded-xl text-xs text-zinc-800 font-medium focus:outline-none cursor-pointer pr-8 appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-[length:9px_9px] bg-[right_10px_center] bg-no-repeat"
                >
                    <option value="">Price Range</option>
                    <option value="0-1500000" <%= safeQuery.priceMax == 1500000 ? 'selected' : '' %>>Under ₹15 Lakhs</option>
                    <option value="1500000-3000000" <%= safeQuery.priceMin == 1500000 && safeQuery.priceMax == 3000000 ? 'selected' : '' %>>₹15L – ₹30 Lakhs</option>
                    <option value="3000000-6000000" <%= safeQuery.priceMin == 3000000 && safeQuery.priceMax == 6000000 ? 'selected' : '' %>>₹30L – ₹60 Lakhs</option>
                    <option value="6000000-999999999" <%= safeQuery.priceMin == 6000000 ? 'selected' : '' %>>Above ₹60 Lakhs</option>
                </select>
            </div>

            <!-- In-Stock Quick Toggle -->
            <button 
                type="button" 
                id="inStockToggleBtn"
                onclick="toggleInStockFilter()"
                class="px-3.5 py-2 rounded-xl border text-xs font-medium transition-colors cursor-pointer <%= safeQuery.inStockOnly ? 'bg-zinc-900 text-white border-zinc-900' : 'border-zinc-300 text-zinc-700 hover:border-zinc-400' %>"
            >
                <%= safeQuery.inStockOnly ? '✓ In-Stock Only' : 'In-Stock Only' %>
            </button>
        </div>

        <!-- Right Search & Clear All -->
        <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
            <div class="relative m-0 w-full sm:w-64">
                <input
                    type="text"
                    id="shopSearchInput"
                    value="<%= safeQuery.search || '' %>"
                    placeholder="Search timepieces..."
                    autocomplete="off"
                    oninput="handleSearchInput(this.value)"
                    class="w-full pl-8 pr-7 py-2 bg-transparent border border-zinc-300 rounded-xl text-xs text-zinc-900 focus:outline-none focus:border-black font-sans"
                >
                <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-zinc-400">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </span>
                <button 
                    type="button" 
                    id="searchClearBtn"
                    onclick="clearSearch()" 
                    class="<%= (safeQuery.search) ? '' : 'hidden' %> absolute right-2.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-black text-xs font-bold cursor-pointer"
                >✕</button>
            </div>

            <button 
                type="button" 
                onclick="clearAllFilters()" 
                class="text-[11px] uppercase tracking-wider font-semibold text-zinc-500 hover:text-black whitespace-nowrap cursor-pointer"
            >
                Clear All
            </button>
        </div>
    </div>

    <!-- 4-Column Product Grid Container -->
    <main id="shopMainGrid" class="max-w-7xl mx-auto px-6 py-12 transition-opacity duration-200">
        <% if (safeProducts && safeProducts.length > 0) { %>
            <div id="productCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-12">
                <% safeProducts.forEach(p => { %>
                    <div class="group flex flex-col justify-between space-y-3">
                        
                        <!-- Watch Studio Image Frame -->
                        <div class="relative group block aspect-square w-full rounded-2xl bg-[#f2eeeb] overflow-hidden flex items-center justify-center p-3 transition-transform duration-300 group-hover:scale-[1.02]">
                            <a href="/product/<%= p.slug %>" class="w-full h-full flex items-center justify-center">
                                <% if (p.images && p.images.length > 0) { %>
                                    <img 
                                        src="<%= p.images[0] %>" 
                                        alt="<%= p.name %>" 
                                        class="w-full h-full object-cover object-center"
                                        loading="lazy"
                                    >
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center text-zinc-300 text-3xl">⏱</div>
                                <% } %>
                            </a>

                            <!-- Wishlist Floating Heart Button -->
                            <button 
                                type="button" 
                                onclick="toggleWishlist('<%= p._id %>', this)" 
                                data-wishlist-id="<%= p._id %>"
                                class="wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm text-zinc-400 hover:text-rose-600 flex items-center justify-center transition-all shadow-xs z-10 cursor-pointer"
                                title="Save to Private Collection"
                            >
                                <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                </svg>
                            </button>

                            <!-- Sold out / Special Offer overlay -->
                            <% if (p.stock <= 0) { %>
                                <span class="absolute top-3 left-3 bg-black/80 text-white text-[9px] uppercase tracking-widest font-mono px-2 py-0.5 rounded">Sold Out</span>
                            <% } else if (p.discountPrice && p.discountPrice < p.price) { %>
                                <% const discountPct = Math.round(((p.price - p.discountPrice) / p.price) * 100); %>
                                <span class="absolute top-3 left-3 bg-[#0A4D2E] text-white text-[9px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs flex items-center gap-1 z-10">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#c5a059]"></span>
                                    <%= discountPct %>% OFF
                                </span>
                            <% } %>
                        </div>

                        <!-- Maison & Title & Variants & Price -->
                        <div class="space-y-1.5 text-left">
                            <div class="flex items-center justify-between">
                                <p class="text-[10px] uppercase tracking-[0.25em] font-sans font-semibold text-zinc-500">
                                    <%= p.brand ? p.brand.name : (p.brandName || 'MANUFACTURE') %>
                                </p>
                                <% if (p.variants && p.variants.length > 0) { %>
                                    <span class="text-[9px] uppercase font-mono tracking-wider text-zinc-400">
                                        <%= p.variants.length %> <%= p.variants.length === 1 ? 'Edition' : 'Editions' %>
                                    </span>
                                <% } %>
                            </div>
                            <a href="/product/<%= p.slug %>" class="block font-serif text-base text-zinc-900 hover:text-[#0A4D2E] transition-colors leading-snug line-clamp-1">
                                <%= p.name %>
                            </a>

                            <!-- Variant Color Swatches -->
                            <% if (p.variants && p.variants.length > 0) { %>
                                <div class="flex items-center gap-1.5 pt-0.5">
                                    <% p.variants.slice(0, 4).forEach((v, vIdx) => { %>
                                        <a 
                                            href="/product/<%= p.slug %>?variant=<%= encodeURIComponent(v.color) %>"
                                            class="w-3.5 h-3.5 rounded-full border border-black/20 shadow-2xs inline-block hover:scale-125 transition-transform" 
                                            style="background-color: <%= v.colorCode || '#1b1c1c' %>;" 
                                            title="<%= v.color %><%= v.material ? ' • ' + v.material : '' %>"
                                        ></a>
                                    <% }) %>
                                    <% if (p.variants.length > 4) { %>
                                        <span class="text-[9px] font-mono text-zinc-400">+<%= p.variants.length - 4 %></span>
                                    <% } %>
                                    <span class="text-[10px] text-zinc-500 font-light truncate ml-1">
                                        <%= p.variants[0].color %>
                                    </span>
                                </div>
                            <% } %>

                            <% if (p.discountPrice && p.discountPrice < p.price) { %>
                                <div class="flex items-baseline gap-2 pt-0.5">
                                    <span class="text-xs font-mono font-bold text-[#0A4D2E]">
                                        ₹<%= Number(p.discountPrice).toLocaleString('en-IN') %>
                                    </span>
                                    <span class="text-[11px] font-mono text-zinc-400 line-through">
                                        ₹<%= Number(p.price).toLocaleString('en-IN') %>
                                    </span>
                                </div>
                            <% } else { %>
                                <p class="text-xs font-mono font-semibold text-[#0A4D2E] pt-0.5">
                                    ₹<%= Number(p.price).toLocaleString('en-IN') %>
                                </p>
                            <% } %>
                        </div>

                    </div>
                <% }) %>
            </div>

            <!-- Pagination Container -->
            <div id="shopPaginationContainer">
                <% if (safePagination.totalPages > 1) { %>
                    <div class="pt-16 pb-8 flex items-center justify-center gap-2 font-mono text-xs select-none">
                        <% if (safePagination.hasPrevPage) { %>
                            <button type="button" onclick="goToPage(<%= safePagination.prevPage %>)" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer">‹</button>
                        <% } %>
                        <% safePagination.pageNumbers.forEach(p => { %>
                            <% if (p === '...') { %>
                                <span class="w-9 h-9 flex items-center justify-center text-zinc-400">...</span>
                            <% } else if (p === safePagination.currentPage) { %>
                                <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-900 text-white font-bold"><%= p %></span>
                            <% } else { %>
                                <button type="button" onclick="goToPage(<%= p %>)" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer"><%= p %></button>
                            <% } %>
                        <% }) %>
                        <% if (safePagination.hasNextPage) { %>
                            <button type="button" onclick="goToPage(<%= safePagination.nextPage %>)" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer">›</button>
                        <% } %>
                    </div>
                <% } %>
            </div>

        <% } else { %>
            <div id="shopEmptyState" class="py-24 text-center space-y-4 max-w-md mx-auto">
                <div class="w-16 h-16 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-2xl">
                    ⏱
                </div>
                <h3 class="text-2xl font-serif text-zinc-900">No Timepieces in Catalog</h3>
                <p class="text-xs text-zinc-500 font-light leading-relaxed">
                    No timepieces are currently listed matching your selected criteria.
                </p>
                <div class="pt-2">
                    <button type="button" onclick="clearAllFilters()" class="inline-block px-6 py-3 bg-zinc-900 text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black cursor-pointer">
                        Clear Filters & View All
                    </button>
                </div>
            </div>
        <% } %>
    </main>

</div>

<%- include('../partials/footer') %>

<script>
    // State Tracker
    const currentParams = {
        brand: "<%= safeQuery.brand || '' %>",
        search: "<%= safeQuery.search || '' %>",
        sort: "<%= safeQuery.sort || 'newest' %>",
        priceMin: "<%= safeQuery.priceMin || '' %>",
        priceMax: "<%= safeQuery.priceMax || '' %>",
        inStockOnly: <%= safeQuery.inStockOnly ? 'true' : 'false' %>,
        page: <%= safePagination.currentPage || 1 %>
    };

    const moreBrandsList = <%- JSON.stringify(moreBrands.map(b => ({ slug: b.slug, name: b.name }))) %>;

    function toggleMoreBrandsDropdown(event) {
        if (event) event.stopPropagation();
        const dropdown = document.getElementById('moreBrandsDropdown');
        const chevron = document.getElementById('moreBrandsChevron');
        const btn = document.getElementById('moreBrandsBtn');
        if (!dropdown) return;
        const isHidden = dropdown.classList.contains('hidden');
        if (isHidden) {
            dropdown.classList.remove('hidden');
            if (chevron) chevron.classList.add('rotate-180');
            if (btn) btn.setAttribute('aria-expanded', 'true');
        } else {
            dropdown.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        }
    }

    function closeMoreBrandsDropdown() {
        const dropdown = document.getElementById('moreBrandsDropdown');
        const chevron = document.getElementById('moreBrandsChevron');
        const btn = document.getElementById('moreBrandsBtn');
        if (dropdown && !dropdown.classList.contains('hidden')) {
            dropdown.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        }
    }

    function selectMoreBrand(slug, name) {
        closeMoreBrandsDropdown();
        applyBrandFilter(slug);
    }

    document.addEventListener('click', function(e) {
        const container = document.getElementById('moreBrandsContainer');
        if (container && !container.contains(e.target)) {
            closeMoreBrandsDropdown();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeMoreBrandsDropdown();
        }
    });

    let searchDebounceTimer = null;

    function handleSearchInput(val) {
        clearTimeout(searchDebounceTimer);
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) {
            if (val && val.trim()) clearBtn.classList.remove('hidden');
            else clearBtn.classList.add('hidden');
        }

        searchDebounceTimer = setTimeout(() => {
            currentParams.search = val.trim();
            currentParams.page = 1;
            ajaxFetchShop();
        }, 300);
    }

    function clearSearch() {
        const input = document.getElementById('shopSearchInput');
        if (input) input.value = '';
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) clearBtn.classList.add('hidden');
        currentParams.search = '';
        currentParams.page = 1;
        ajaxFetchShop();
    }

    function applyBrandFilter(slug) {
        currentParams.brand = slug;
        currentParams.page = 1;

        const isMore = typeof moreBrandsList !== 'undefined' && Array.isArray(moreBrandsList) && moreBrandsList.some(b => b.slug === slug);
        const moreBrandObj = isMore ? moreBrandsList.find(b => b.slug === slug) : null;

        document.querySelectorAll('.brand-pill').forEach(pill => {
            const b = pill.getAttribute('data-brand-pill');
            if (b === 'more-dropdown') {
                if (isMore) {
                    pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer flex items-center gap-1.5 text-zinc-900 font-bold border-zinc-900';
                } else {
                    pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer flex items-center gap-1.5 border-transparent text-zinc-500 hover:text-black hover:border-zinc-300';
                }
            } else {
                if (!isMore && b === slug) {
                    pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer text-zinc-900 font-bold border-zinc-900';
                } else {
                    pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer border-transparent hover:text-black hover:border-zinc-300';
                }
            }
        });

        const btnText = document.getElementById('moreBrandsBtnText');
        const chevron = document.getElementById('moreBrandsChevron');
        const selectEl = document.getElementById('moreBrandsSelect');

        if (btnText) {
            btnText.textContent = isMore ? moreBrandObj.name : 'More Brands';
        }
        if (chevron) {
            if (isMore) {
                chevron.classList.add('text-zinc-900');
                chevron.classList.remove('text-zinc-400');
            } else {
                chevron.classList.remove('text-zinc-900');
                chevron.classList.add('text-zinc-400');
            }
        }
        if (selectEl) {
            selectEl.value = isMore ? slug : '';
        }

        document.querySelectorAll('.more-brand-item').forEach(item => {
            const itemSlug = item.getAttribute('data-more-brand-slug');
            const check = item.querySelector('.checkmark');
            if (isMore && itemSlug === slug) {
                item.className = 'more-brand-item w-full px-4 py-2.5 text-xs text-zinc-900 hover:bg-zinc-50 flex items-center justify-between transition-colors cursor-pointer text-left font-bold bg-zinc-50 text-[#0A4D2E]';
                if (check) check.classList.remove('hidden');
            } else {
                item.className = 'more-brand-item w-full px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-zinc-950 flex items-center justify-between transition-colors cursor-pointer text-left font-medium';
                if (check) check.classList.add('hidden');
            }
        });

        ajaxFetchShop();
    }

    function applySort(sortVal) {
        currentParams.sort = sortVal;
        currentParams.page = 1;
        ajaxFetchShop();
    }

    function handlePriceSelect(val) {
        if (!val) {
            currentParams.priceMin = '';
            currentParams.priceMax = '';
        } else {
            const parts = val.split('-');
            currentParams.priceMin = parts[0] || '';
            currentParams.priceMax = parts[1] || '';
        }
        currentParams.page = 1;
        ajaxFetchShop();
    }

    function toggleInStockFilter() {
        currentParams.inStockOnly = !currentParams.inStockOnly;
        currentParams.page = 1;
        const btn = document.getElementById('inStockToggleBtn');
        if (btn) {
            btn.className = 'px-3.5 py-2 rounded-xl border text-xs font-medium transition-colors cursor-pointer ' +
                (currentParams.inStockOnly ? 'bg-zinc-900 text-white border-zinc-900' : 'border-zinc-300 text-zinc-700 hover:border-zinc-400');
            btn.textContent = currentParams.inStockOnly ? '✓ In-Stock Only' : 'In-Stock Only';
        }
        ajaxFetchShop();
    }

    function clearAllFilters() {
        currentParams.brand = '';
        currentParams.search = '';
        currentParams.sort = 'newest';
        currentParams.priceMin = '';
        currentParams.priceMax = '';
        currentParams.inStockOnly = false;
        currentParams.page = 1;

        const searchInput = document.getElementById('shopSearchInput');
        if (searchInput) searchInput.value = '';
        const clearBtn = document.getElementById('searchClearBtn');
        if (clearBtn) clearBtn.classList.add('hidden');

        const sortSelect = document.getElementById('sortSelect');
        if (sortSelect) sortSelect.value = 'newest';

        const priceSelect = document.getElementById('priceFilterSelect');
        if (priceSelect) priceSelect.value = '';

        const inStockBtn = document.getElementById('inStockToggleBtn');
        if (inStockBtn) {
            inStockBtn.className = 'px-3.5 py-2 rounded-xl border text-xs font-medium transition-colors cursor-pointer border-zinc-300 text-zinc-700 hover:border-zinc-400';
            inStockBtn.textContent = 'In-Stock Only';
        }

        document.querySelectorAll('.brand-pill').forEach(pill => {
            const b = pill.getAttribute('data-brand-pill');
            if (b === '') {
                pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer text-zinc-900 font-bold border-zinc-900';
            } else if (b === 'more-dropdown') {
                pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer flex items-center gap-1.5 border-transparent text-zinc-500 hover:text-black hover:border-zinc-300';
            } else {
                pill.className = 'brand-pill py-2 transition-colors border-b-2 cursor-pointer border-transparent hover:text-black hover:border-zinc-300';
            }
        });

        const btnText = document.getElementById('moreBrandsBtnText');
        const chevron = document.getElementById('moreBrandsChevron');
        const selectEl = document.getElementById('moreBrandsSelect');
        if (btnText) btnText.textContent = 'More Brands';
        if (chevron) {
            chevron.classList.remove('text-zinc-900', 'rotate-180');
            chevron.classList.add('text-zinc-400');
        }
        if (selectEl) selectEl.value = '';
        closeMoreBrandsDropdown();

        document.querySelectorAll('.more-brand-item').forEach(item => {
            item.className = 'more-brand-item w-full px-4 py-2.5 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-zinc-950 flex items-center justify-between transition-colors cursor-pointer text-left font-medium';
            const check = item.querySelector('.checkmark');
            if (check) check.classList.add('hidden');
        });

        ajaxFetchShop();
    }

    function goToPage(p) {
        currentParams.page = p;
        ajaxFetchShop(true);
    }

    async function ajaxFetchShop(scrollToTop = false) {
        const gridMain = document.getElementById('shopMainGrid');
        if (gridMain) gridMain.style.opacity = '0.5';

        const queryParams = new URLSearchParams();
        queryParams.set('ajax', 'true');
        if (currentParams.brand) queryParams.set('brand', currentParams.brand);
        if (currentParams.search) queryParams.set('search', currentParams.search);
        if (currentParams.sort) queryParams.set('sort', currentParams.sort);
        if (currentParams.priceMin) queryParams.set('priceMin', currentParams.priceMin);
        if (currentParams.priceMax) queryParams.set('priceMax', currentParams.priceMax);
        if (currentParams.inStockOnly) queryParams.set('inStockOnly', 'true');
        if (currentParams.page > 1) queryParams.set('page', currentParams.page);

        // Update URL in browser history
        const browserUrl = new URL(window.location.href);
        browserUrl.search = queryParams.toString().replace('ajax=true&', '').replace('&ajax=true', '').replace('ajax=true', '');
        window.history.pushState(null, '', browserUrl.pathname + (browserUrl.search ? browserUrl.search : ''));

        try {
            const res = await fetch('/shop?' + queryParams.toString(), {
                headers: { 'Accept': 'application/json' }
            });
            const data = await res.json();
            if (!data.success) {
                showToast('Unable to load catalog.', 'error');
                return;
            }

            renderShopProducts(data.products, data.pagination);
            syncWishlistHearts();

            if (scrollToTop && gridMain) {
                const yOffset = -100; 
                const y = gridMain.getBoundingClientRect().top + window.pageYOffset + yOffset;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        } catch (e) {
            showToast('Catalog connection error.', 'error');
        } finally {
            if (gridMain) gridMain.style.opacity = '1';
        }
    }

        function renderShopProducts(products, pagination) {
        const main = document.getElementById('shopMainGrid');
        if (!main) return;

        if (!products || products.length === 0) {
            main.innerHTML = `
                <div id="shopEmptyState" class="py-24 text-center space-y-4 max-w-md mx-auto">
                    <div class="w-16 h-16 rounded-full bg-zinc-100 text-zinc-400 flex items-center justify-center mx-auto text-2xl">
                        ⏱
                    </div>
                    <h3 class="text-2xl font-serif text-zinc-900">No Timepieces in Catalog</h3>
                    <p class="text-xs text-zinc-500 font-light leading-relaxed">
                        No timepieces are currently listed matching your selected criteria.
                    </p>
                    <div class="pt-2">
                        <button type="button" onclick="clearAllFilters()" class="inline-block px-6 py-3 bg-zinc-900 text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black cursor-pointer">
                            Clear Filters & View All
                        </button>
                    </div>
                </div>
            `;
            return;
        }

        let html = '<div id="productCardsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-12">';
        products.forEach(p => {
            const imgSrc = (p.images && p.images.length > 0) ? p.images[0] : '';
            const brandName = p.brand ? (p.brand.name || p.brand) : (p.brandName || 'MANUFACTURE');
            const priceFormatted = Number(p.discountPrice || p.price).toLocaleString('en-IN');

            html += `
                <div class="group flex flex-col justify-between space-y-3">
                    <div class="relative group block aspect-square w-full rounded-2xl bg-[#f2eeeb] overflow-hidden flex items-center justify-center p-3 transition-transform duration-300 group-hover:scale-[1.02]">
                        <a href="/product/${p.slug}" class="w-full h-full flex items-center justify-center">
                            ${imgSrc ? `<img src="${imgSrc}" alt="${p.name}" class="w-full h-full object-cover object-center" loading="lazy">` : '<div class="w-full h-full flex items-center justify-center text-zinc-300 text-3xl">⏱</div>'}
                        </a>
                        <button 
                            type="button" 
                            onclick="toggleWishlist('${p._id}', this)" 
                            data-wishlist-id="${p._id}"
                            class="wishlist-btn absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur-sm text-zinc-400 hover:text-rose-600 flex items-center justify-center transition-all shadow-xs z-10 cursor-pointer"
                            title="Save to Private Collection"
                        >
                            <svg class="w-4 h-4 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                            </svg>
                        </button>
                        ${p.stock <= 0 ? '<span class="absolute top-3 left-3 bg-black/80 text-white text-[9px] uppercase tracking-widest font-mono px-2 py-0.5 rounded">Sold Out</span>' : ((p.discountPrice && p.discountPrice < p.price) ? `<span class="absolute top-3 left-3 bg-[#0A4D2E] text-white text-[9px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs flex items-center gap-1 z-10"><span class="w-1.5 h-1.5 rounded-full bg-[#c5a059]"></span>${Math.round(((p.price - p.discountPrice) / p.price) * 100)}% OFF</span>` : '')}
                    </div>
                    <div class="space-y-1 text-left">
                        <p class="text-[10px] uppercase tracking-[0.25em] font-sans font-semibold text-zinc-500">${brandName}</p>
                        <a href="/product/${p.slug}" class="block font-serif text-base text-zinc-900 hover:text-[#0A4D2E] transition-colors leading-snug line-clamp-1">${p.name}</a>
                        ${(p.discountPrice && p.discountPrice < p.price) ? `
                            <div class="flex items-baseline gap-2 pt-0.5">
                                <span class="text-xs font-mono font-bold text-[#0A4D2E]">₹${Number(p.discountPrice).toLocaleString('en-IN')}</span>
                                <span class="text-[11px] font-mono text-zinc-400 line-through">₹${Number(p.price).toLocaleString('en-IN')}</span>
                            </div>
                        ` : `
                            <p class="text-xs font-mono font-semibold text-[#0A4D2E] pt-0.5">₹${priceFormatted}</p>
                        `}
                    </div>
                </div>
            `;
        });
        html += '</div>';

        // Pagination
        if (pagination && pagination.totalPages > 1) {
            html += '<div id="shopPaginationContainer"><div class="pt-16 pb-8 flex items-center justify-center gap-2 font-mono text-xs select-none">';
            if (pagination.hasPrevPage) {
                html += `<button type="button" onclick="goToPage(${pagination.prevPage})" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer">‹</button>`;
            }
            (pagination.pageNumbers || []).forEach(pg => {
                if (pg === '...') {
                    html += '<span class="w-9 h-9 flex items-center justify-center text-zinc-400">...</span>';
                } else if (pg === pagination.currentPage) {
                    html += `<span class="w-9 h-9 flex items-center justify-center rounded-xl bg-zinc-900 text-white font-bold">${pg}</span>`;
                } else {
                    html += `<button type="button" onclick="goToPage(${pg})" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer">${pg}</button>`;
                }
            });
            if (pagination.hasNextPage) {
                html += `<button type="button" onclick="goToPage(${pagination.nextPage})" class="w-9 h-9 flex items-center justify-center rounded-xl border border-zinc-200 hover:bg-zinc-100 text-zinc-700 cursor-pointer">›</button>`;
            }
            html += '</div></div>';
        }

        main.innerHTML = html;
        applyHeartHighlights();
    }

    let userShopWishlistIds = new Set();

    function applyHeartHighlights() {
        document.querySelectorAll('.wishlist-btn').forEach(btn => {
            const id = btn.getAttribute('data-wishlist-id');
            const svg = btn.querySelector('svg');
            if (id && userShopWishlistIds.has(id)) {
                btn.classList.add('text-rose-600', 'bg-rose-50', 'ring-1', 'ring-rose-200');
                btn.classList.remove('text-zinc-400');
                if (svg) svg.setAttribute('fill', 'currentColor');
            } else {
                btn.classList.remove('text-rose-600', 'bg-rose-50', 'ring-1', 'ring-rose-200');
                btn.classList.add('text-zinc-400');
                if (svg) svg.setAttribute('fill', 'none');
            }
        });
    }

    async function syncWishlistHearts() {
        try {
            const res = await fetch('/api/wishlist/ids');
            const data = await res.json();
            if (data && data.ids) {
                userShopWishlistIds = new Set(data.ids);
                applyHeartHighlights();
            }
        } catch (e) {}
    }

    document.addEventListener('DOMContentLoaded', () => {
        syncWishlistHearts();
    });

    async function toggleWishlist(productId, btn) {
        try {
            const res = await fetch('/wishlist/toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ productId })
            });
            const data = await res.json();
            if (res.status === 401 && data.redirect) {
                window.location.href = data.redirect;
                return;
            }
            if (data.success) {
                if (data.added) {
                    userShopWishlistIds.add(productId);
                    showToast(data.message || 'Timepiece saved to your private collection.', 'success');
                } else {
                    userShopWishlistIds.delete(productId);
                    showToast(data.message || 'Timepiece removed from collection.', 'info');
                }
                applyHeartHighlights();

                if (window.updateNavbarCounters && data.count !== undefined) {
                    window.updateNavbarCounters(undefined, data.count);
                }
            } else {
                showToast(data.message || 'Unable to update collection.', 'error');
            }
        } catch (e) {
            showToast('Connection error.', 'error');
        }
    }
</script>
