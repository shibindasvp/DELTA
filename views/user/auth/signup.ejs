<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — DELTA</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Libre Caslon Text"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        /* Background Video Cover */
        .bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translate(-50%, -50%);
            object-fit: cover;
        }

        /* Modern Card Entrance */
        @keyframes cardFadeIn {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .auth-card {
            animation: cardFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Modern Shimmer Hover Effect */
        @keyframes sweep {
            0% { transform: translateX(-150%) skewX(-20deg); }
            100% { transform: translateX(250%) skewX(-20deg); }
        }

        .btn-shimmer {
            position: relative;
            overflow: hidden;
        }

        .btn-shimmer::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 50%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
            transform: translateX(-150%) skewX(-20deg);
        }

        .btn-shimmer:hover::after {
            animation: sweep 1.3s ease-in-out infinite;
        }

        /* Error Shake Animation */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-4px); }
            40%, 80% { transform: translateX(4px); }
        }

        .input-error {
            border-color: #f43f5e !important;
            animation: shake 0.4s ease-in-out;
        }
    </style>

    <script>
        // Invalidate browser back-forward cache (bfcache) on back navigation / session change
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.getEntriesByType && window.performance.getEntriesByType("navigation")[0]?.type === "back_forward") || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.reload();
            }
        });
    </script>
</head>
<body class="relative min-h-screen flex flex-col justify-between items-center py-8 px-4 font-sans text-zinc-900 antialiased selection:bg-zinc-900 selection:text-white overflow-x-hidden">

    <!-- Live Patek Philippe Video Background Layer -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none bg-[#08090b]">
        <video 
            class="bg-video" 
            autoplay 
            loop 
            muted 
            playsinline
        >
            <source src="https://patek-res.cloudinary.com/video/upload/f_auto:video/dfsmedia/0906caea301d42b3b8bd23bd656d1711/449023-source/pp-5236p-011-8-9-product-film-loop" type="video/mp4">
        </video>
        <!-- Cinematic Dark Overlay -->
        <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/35 to-black/80"></div>
    </div>

    <!-- Top Spacer -->
    <div class="w-full"></div>

    <!-- Modern Luxury Modal Card -->
    <div class="auth-card w-full max-w-[450px] bg-white/95 backdrop-blur-2xl p-7 sm:p-9 rounded-3xl shadow-[0_30px_70px_rgba(0,0,0,0.6)] border border-white/60 relative my-auto">
        
        <!-- Header: Logo & Title -->
        <div class="text-center mb-6">
            <div>
                <span class="text-2xl font-serif select-none leading-none">δ</span>
            </div>
            <h1 class="text-2xl sm:text-[26px] font-serif text-zinc-900 font-normal tracking-tight">
                Create Account
            </h1>
            <p class="text-xs text-zinc-500 font-normal mt-1">
                Join DELTA for exclusive horology access & curation.
            </p>
        </div>

        <!-- Flash Messages -->
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="mb-4 bg-emerald-50/90 border border-emerald-200/80 text-emerald-800 px-4 py-2.5 rounded-xl text-xs flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span><%= success %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-950 font-bold ml-2 cursor-pointer">✕</button>
            </div>
        <% } %>

        <% if ((typeof error !== 'undefined' && error) || (typeof errors !== 'undefined' && errors.general)) { %>
            <div class="mb-4 bg-rose-50/90 border border-rose-200/80 text-rose-800 px-4 py-2.5 rounded-xl text-xs flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span><%= (typeof error !== 'undefined' && error) ? error : errors.general %></span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-950 font-bold ml-2 cursor-pointer">✕</button>
            </div>
        <% } %>

        <!-- Sign Up Form -->
        <form action="/signup" method="POST" id="signupForm" class="space-y-3.5" novalidate>
            
            <!-- Full Name -->
            <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-zinc-700 tracking-wide">
                    Full Name
                </label>
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-zinc-400 pointer-events-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </span>
                    <input
                        type="text"
                        name="name"
                        id="name"
                        required
                        value="<%= typeof oldData !== 'undefined' && oldData.name ? oldData.name : '' %>"
                        placeholder="John Doe"
                        class="w-full pl-10 pr-4 py-2.5 bg-zinc-50/80 hover:bg-zinc-50 focus:bg-white border border-zinc-200/90 rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-900 transition-all duration-200 shadow-sm"
                    >
                </div>
                <p id="nameError" class="text-rose-600 text-[11px] font-medium <%= typeof errors !== 'undefined' && errors.name ? '' : 'hidden' %> mt-1">
                    <%= typeof errors !== 'undefined' && errors.name ? errors.name : '' %>
                </p>
            </div>

            <!-- Email Address -->
            <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-zinc-700 tracking-wide">
                    Email Address
                </label>
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-zinc-400 pointer-events-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </span>
                    <input
                        type="email"
                        name="email"
                        id="email"
                        required
                        value="<%= typeof oldData !== 'undefined' && oldData.email ? oldData.email : '' %>"
                        placeholder="name@example.com"
                        class="w-full pl-10 pr-4 py-2.5 bg-zinc-50/80 hover:bg-zinc-50 focus:bg-white border border-zinc-200/90 rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-900 transition-all duration-200 shadow-sm"
                    >
                </div>
                <p id="emailError" class="text-rose-600 text-[11px] font-medium <%= typeof errors !== 'undefined' && errors.email ? '' : 'hidden' %> mt-1">
                    <%= typeof errors !== 'undefined' && errors.email ? errors.email : '' %>
                </p>
            </div>

            <!-- Password -->
            <div class="space-y-1">
                <div class="flex items-center justify-between">
                    <label class="block text-[11px] font-semibold text-zinc-700 tracking-wide">
                        Password
                    </label>
                </div>
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-zinc-400 pointer-events-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </span>
                    <input
                        type="password"
                        name="password"
                        id="password"
                        required
                        value="<%= typeof oldData !== 'undefined' && oldData.password ? oldData.password : '' %>"
                        placeholder="••••••••"
                        class="w-full pl-10 pr-11 py-2.5 bg-zinc-50/80 hover:bg-zinc-50 focus:bg-white border border-zinc-200/90 rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-900 transition-all duration-200 font-mono tracking-wider shadow-sm"
                    >
                    <button
                        type="button"
                        onclick="togglePasswordVisibility('password', 'passwordEye')"
                        class="absolute right-3 p-1 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition-colors focus:outline-none"
                    >
                        <svg id="passwordEye" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </button>
                </div>
                <p id="passwordError" class="text-rose-600 text-[11px] font-medium <%= typeof errors !== 'undefined' && errors.password ? '' : 'hidden' %> mt-1">
                    <%= typeof errors !== 'undefined' && errors.password ? errors.password : '' %>
                </p>
            </div>

            <!-- Confirm Password -->
            <div class="space-y-1">
                <label class="block text-[11px] font-semibold text-zinc-700 tracking-wide">
                    Confirm Password
                </label>
                <div class="relative flex items-center">
                    <span class="absolute left-3.5 text-zinc-400 pointer-events-none">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                        </svg>
                    </span>
                    <input
                        type="password"
                        name="confirmPassword"
                        id="confirmPassword"
                        required
                        value="<%= typeof oldData !== 'undefined' && oldData.confirmPassword ? oldData.confirmPassword : '' %>"
                        placeholder="••••••••"
                        class="w-full pl-10 pr-11 py-2.5 bg-zinc-50/80 hover:bg-zinc-50 focus:bg-white border border-zinc-200/90 rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900/10 focus:border-zinc-900 transition-all duration-200 font-mono tracking-wider shadow-sm"
                    >
                    <button
                        type="button"
                        onclick="togglePasswordVisibility('confirmPassword', 'confirmPasswordEye')"
                        class="absolute right-3 p-1 text-zinc-400 hover:text-zinc-700 rounded-lg hover:bg-zinc-100 transition-colors focus:outline-none"
                    >
                        <svg id="confirmPasswordEye" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    </button>
                </div>
                <p id="confirmPasswordError" class="text-rose-600 text-[11px] font-medium <%= typeof errors !== 'undefined' && errors.confirmPassword ? '' : 'hidden' %> mt-1">
                    <%= typeof errors !== 'undefined' && errors.confirmPassword ? errors.confirmPassword : '' %>
                </p>
            </div>

            <!-- Referral Code (Modern Card Badge Style) -->
            <div class="pt-0.5">
                <div class="bg-zinc-100/90 hover:bg-zinc-100 border border-zinc-200/80 px-3.5 py-2 rounded-xl flex items-center justify-between transition-colors">
                    <span class="text-[10px] uppercase tracking-[0.2em] text-zinc-600 font-semibold flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                        </svg>
                        Referral
                    </span>
                    <input
                        type="text"
                        name="referralCode"
                        id="referralCode"
                        value="<%= typeof oldData !== 'undefined' && oldData.referralCode ? oldData.referralCode : '' %>"
                        placeholder="Optional Code"
                        class="bg-transparent border-0 text-right text-xs text-zinc-800 placeholder-zinc-400 focus:outline-none font-mono tracking-wider w-1/2"
                    >
                </div>
            </div>

            <!-- Create Account Submit Button -->
            <div class="pt-2">
                <button
                    type="submit"
                    class="btn-shimmer group w-full bg-zinc-900 hover:bg-black text-white py-3.5 px-5 rounded-xl text-xs font-semibold uppercase tracking-[0.18em] transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-zinc-900/20 hover:shadow-zinc-900/30 active:scale-[0.99] cursor-pointer"
                >
                    <span>Create Account</span>
                    <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </button>
            </div>
        </form>

        <!-- Divider -->
        <div class="relative my-4 text-center">
            <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-zinc-200/80"></div></div>
            <span class="relative bg-white px-3 text-[10px] text-zinc-400 uppercase tracking-wider font-medium">or continue with</span>
        </div>

        <!-- Google OAuth Button -->
        <div>
            <a
                href="/auth/google<%= (typeof redirect !== 'undefined' && redirect) ? ('?redirect=' + encodeURIComponent(redirect)) : '' %>"
                class="w-full flex items-center justify-center gap-3 bg-zinc-50 hover:bg-zinc-100/90 border border-zinc-200/90 py-2.5 px-4 rounded-xl text-xs font-semibold text-zinc-700 hover:text-zinc-900 transition-all duration-200 shadow-sm active:scale-[0.99]"
            >
                <svg class="w-4 h-4" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                    <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                    <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                    <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                </svg>
                <span>Google</span>
            </a>
        </div>

        <!-- Already have account Link -->
        <div class="mt-5 text-center text-xs text-zinc-500">
            Already have an account?
            <a href="/login<%= (typeof oldData !== 'undefined' && oldData && oldData.email) ? '?email=' + encodeURIComponent(oldData.email) : '' %>" class="text-zinc-900 font-semibold hover:underline ml-1">
                Sign In
            </a>
        </div>
    </div>

    <!-- Bottom Footer Brand Mark -->
    <div class="text-center text-[10px] uppercase tracking-[0.35em] text-zinc-300 font-medium py-4 select-none drop-shadow-md">
        Precision • Heritage • Delta
    </div>

    <script>
        // Password Visibility Toggle
        function togglePasswordVisibility(inputId, eyeId) {
            const input = document.getElementById(inputId);
            const eye = document.getElementById(eyeId);
            if (input.type === 'password') {
                input.type = 'text';
                eye.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>';
            } else {
                input.type = 'password';
                eye.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
            }
        }

        const nameRegex = /^[A-Za-z][A-Za-z\s]{2,49}$/;
        const emailRegex = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,32}$/;

        const form = document.getElementById('signupForm');
        const nameInput = document.getElementById('name');
        const emailInput = document.getElementById('email');
        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');

        const nameError = document.getElementById('nameError');
        const emailError = document.getElementById('emailError');
        const passwordError = document.getElementById('passwordError');
        const confirmPasswordError = document.getElementById('confirmPasswordError');

        function clearAuthError(input, errEl) {
            if (errEl) {
                errEl.textContent = '';
                errEl.classList.add('hidden');
            }
            if (input) {
                input.classList.remove('input-error');
            }
        }

        // Real-time clearance of validation errors on valid input
        nameInput.addEventListener('input', () => {
            const val = nameInput.value.trim();
            if (val && nameRegex.test(val)) {
                clearAuthError(nameInput, nameError);
            }
        });

        emailInput.addEventListener('input', () => {
            const val = emailInput.value.trim();
            if (val && emailRegex.test(val)) {
                clearAuthError(emailInput, emailError);
            }
        });

        passwordInput.addEventListener('input', () => {
            if (passwordRegex.test(passwordInput.value)) {
                clearAuthError(passwordInput, passwordError);
            }
            if (confirmPasswordInput.value && passwordInput.value === confirmPasswordInput.value) {
                clearAuthError(confirmPasswordInput, confirmPasswordError);
            }
        });

        confirmPasswordInput.addEventListener('input', () => {
            if (confirmPasswordInput.value && confirmPasswordInput.value === passwordInput.value) {
                clearAuthError(confirmPasswordInput, confirmPasswordError);
            }
        });

        form.addEventListener('submit', (e) => {
            let hasError = false;
            
            // Reset validation states
            [nameError, emailError, passwordError, confirmPasswordError].forEach(el => el.classList.add('hidden'));
            [nameInput, emailInput, passwordInput, confirmPasswordInput].forEach(el => el.classList.remove('input-error'));

            if (!nameInput.value.trim() || !nameRegex.test(nameInput.value.trim())) {
                nameError.textContent = 'Name must be 3-50 letters/spaces and start with a letter.';
                nameError.classList.remove('hidden');
                nameInput.classList.add('input-error');
                hasError = true;
            }

            if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
                emailError.textContent = 'Please enter a valid email address.';
                emailError.classList.remove('hidden');
                emailInput.classList.add('input-error');
                hasError = true;
            }

            if (!passwordRegex.test(passwordInput.value)) {
                passwordError.textContent = 'Password must be 8-32 chars with uppercase, lowercase, number & special character.';
                passwordError.classList.remove('hidden');
                passwordInput.classList.add('input-error');
                hasError = true;
            }

            if (passwordInput.value !== confirmPasswordInput.value) {
                confirmPasswordError.textContent = 'Passwords do not match.';
                confirmPasswordError.classList.remove('hidden');
                confirmPasswordInput.classList.add('input-error');
                hasError = true;
            }

            if (hasError) {
                e.preventDefault();
            }
        });
    </script>
</body>
</html>