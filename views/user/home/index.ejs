<!-- Rolex Carousel & Scroll Scripts -->
<script>
    // 1. Rolex Carousel Navigation
    function scrollCarousel(direction) {
        const track = document.getElementById('rolexCarouselTrack');
        const slide = track ? track.querySelector('.rolex-carousel-slide') : null;
        if (!slide) return;
        
        const scrollAmount = (slide.offsetWidth + 24) * direction;
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    }

    // 2. Track Carousel Scroll Position to update progress bar
    const carouselTrack = document.getElementById('rolexCarouselTrack');
    const progressBar = document.getElementById('carouselProgressBar');
    const currentSlideText = document.getElementById('carouselCurrentSlide');

    if (carouselTrack && progressBar) {
        carouselTrack.addEventListener('scroll', () => {
            const maxScroll = carouselTrack.scrollWidth - carouselTrack.clientWidth;
            const scrollFraction = maxScroll > 0 ? (carouselTrack.scrollLeft / maxScroll) : 0;
            const totalSlides = 5;
            const currentIdx = Math.min(totalSlides, Math.max(1, Math.round(scrollFraction * (totalSlides - 1)) + 1));
            
            progressBar.style.width = `${Math.max(20, (currentIdx / totalSlides) * 100)}%`;
            if (currentSlideText) {
                currentSlideText.textContent = `0${currentIdx}`;
            }
        });
    }

    // 3. Scroll Reveal Observer
    document.addEventListener('DOMContentLoaded', () => {
        const revealElements = document.querySelectorAll('.delta-reveal');
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

        revealElements.forEach(el => observer.observe(el));
    });
</script>

