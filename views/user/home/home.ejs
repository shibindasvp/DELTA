<!-- Rolex Carousel & Scroll Scripts -->
<script>
    // 1. Rolex Roller Navigation
    function scrollRoller(direction) {
        const list = document.getElementById('rolexRollerList');
        const item = list ? list.querySelector('.rolex-roller-item') : null;
        if (!list || !item) return;

        const scrollStep = (item.offsetWidth + 24) * direction;
        list.scrollBy({ left: scrollStep, behavior: 'smooth' });
    }

    // 2. Roller Progress Tracker
    const rollerList = document.getElementById('rolexRollerList');
    const rollerProgressBar = document.getElementById('rollerProgressBar');
    const rollerCurrentSlide = document.getElementById('rollerCurrentSlide');
    const rollerTotalSlides = document.getElementById('rollerTotalSlides');

    if (rollerList && rollerProgressBar) {
        const updateRollerProgress = () => {
            const items = rollerList.querySelectorAll('.rolex-roller-item');
            const totalSlides = items.length || 5;
            if (rollerTotalSlides) {
                rollerTotalSlides.textContent = totalSlides < 10 ? `0${totalSlides}` : `${totalSlides}`;
            }
            const maxScroll = rollerList.scrollWidth - rollerList.clientWidth;
            const scrollFraction = maxScroll > 0 ? (rollerList.scrollLeft / maxScroll) : 0;
            const currentIdx = Math.min(totalSlides, Math.max(1, Math.round(scrollFraction * (totalSlides - 1)) + 1));

            rollerProgressBar.style.width = `${Math.max(100 / totalSlides, (currentIdx / totalSlides) * 100)}%`;
            if (rollerCurrentSlide) {
                rollerCurrentSlide.textContent = currentIdx < 10 ? `0${currentIdx}` : `${currentIdx}`;
            }
        };

        rollerList.addEventListener('scroll', updateRollerProgress, { passive: true });
        window.addEventListener('resize', updateRollerProgress);
        updateRollerProgress();
    }

    // 3. Scroll Reveal Observer
    document.addEventListener('DOMContentLoaded', () => {
        const revealElements = document.querySelectorAll('.delta-reveal');
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    obs.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

        revealElements.forEach(el => observer.observe(el));
    });

    // Modern 3D Tilt & Sapphire Glare Interaction for The Great Maisons
    document.addEventListener('DOMContentLoaded', () => {
        const tiltCards = document.querySelectorAll('.maison-card-wrapper');
        
        tiltCards.forEach(card => {
            const inner = card.querySelector('.maison-card-inner');
            const glare = card.querySelector('.maison-glare');
            if (!inner) return;

            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                
                const rotateX = ((y - centerY) / centerY) * -7;
                const rotateY = ((x - centerX) / centerX) * 7;
                
                inner.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px) scale3d(1.02, 1.02, 1.02)`;
                
                if (glare) {
                    const glareX = (x / rect.width) * 100;
                    const glareY = (y / rect.height) * 100;
                    glare.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.08) 45%, transparent 70%)`;
                }
            });

            card.addEventListener('mouseleave', () => {
                inner.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0) scale3d(1, 1, 1)';
                inner.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
            });

            card.addEventListener('mouseenter', () => {
                inner.style.transition = 'transform 0.15s ease-out, box-shadow 0.3s ease';
            });
        });
    });

</script>

