<style>
    /* Luxury Restrained Typography & Palette */
    :root {
        --delta-gold: #c5a059;
        --delta-black: #0b0c0e;
        --delta-charcoal: #141619;
        --delta-gray: #f8f8f9;
        --delta-border: rgba(255, 255, 255, 0.1);
    }

    /* Scroll Reveal Transition */
    .delta-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
    }

    .delta-reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .delay-1 { transition-delay: 100ms; }
    .delay-2 { transition-delay: 200ms; }
    .delay-3 { transition-delay: 300ms; }
    .delay-4 { transition-delay: 400ms; }
    .delay-5 { transition-delay: 500ms; }

    /* Subtle Luxury Hover Zoom */
    .delta-zoom-img {
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
    }
    .group:hover .delta-zoom-img {
        transform: scale(1.06);
    }

    /* Shimmer Button Sweep */
    @keyframes deltaShimmer {
        0% { transform: translateX(-150%) skewX(-20deg); }
        100% { transform: translateX(250%) skewX(-20deg); }
    }

    .btn-delta-shimmer {
        position: relative;
        overflow: hidden;
    }
    .btn-delta-shimmer::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 50%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
        transform: translateX(-150%) skewX(-20deg);
    }
    .btn-delta-shimmer:hover::after {
        animation: deltaShimmer 1.3s ease-in-out infinite;
    }

    /* ==========================================
       ROLEX-STYLE CAROUSEL CSS
       ========================================== */
    .rolex-carousel-track {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .rolex-carousel-track::-webkit-scrollbar {
        display: none;
    }

    .rolex-carousel-slide {
        flex: 0 0 84%;
        scroll-snap-align: start;
    }
    @media (min-width: 640px) {
        .rolex-carousel-slide {
            flex: 0 0 46%;
        }
    }
    @media (min-width: 1024px) {
        .rolex-carousel-slide {
            flex: 0 0 31.5%;
        }
    }

    .carousel-bar-segment {
        transition: width 0.3s ease;
    }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* ==========================================
       MODERN THE GREAT MAISONS ANIMATIONS
       ========================================== */
    .maison-card-wrapper {
        perspective: 1200px;
        transform-style: preserve-3d;
        will-change: transform;
    }

    .maison-card-inner {
        position: relative;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        transform-style: preserve-3d;
    }

    .maison-glare {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.5s ease;
        background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.05) 45%, transparent 70%);
        mix-blend-mode: overlay;
        z-index: 15;
    }

    .maison-card-wrapper:hover .maison-glare {
        opacity: 1;
    }

    .maison-accent-line {
        width: 0;
        height: 1.5px;
        background: linear-gradient(90deg, #c5a059, #dfba73);
        margin: 6px auto 0;
        transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .maison-card-wrapper:hover .maison-accent-line {
        width: 36px;
    }

    .maison-arrow-icon {
        display: inline-block;
        transform: translateX(-6px);
        opacity: 0;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .maison-card-wrapper:hover .maison-arrow-icon {
        transform: translateX(2px);
        opacity: 1;
    }

    @keyframes maisonFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-6px); }
    }

    .maison-floating-ambient {
        animation: maisonFloat 6s ease-in-out infinite;
    }

</style>

