<%
    const safeUser = (typeof user !== 'undefined' && user) ? user : { _id: '', name: 'Collector', email: '', authProvider: 'local' };
    const isGoogleUser = Boolean(safeUser.authProvider === 'google' || safeUser.providerId || safeUser.googleId);
    const safeHasPassword = (typeof hasPassword !== 'undefined') ? Boolean(hasPassword) : (!isGoogleUser);
    const isInitialGoogleUser = Boolean(isGoogleUser && !safeHasPassword);
%>
<%- include('../partials/header', { title: 'Security Credentials — DELTA Vault' }) %>
<%- include('../partials/navbar') %>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-12">
    <main class="max-w-xl mx-auto px-6 space-y-8">
        
        <!-- Breadcrumb & Header -->
        <div class="space-y-1.5 border-b border-zinc-200 pb-6">
            <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-zinc-400">
                <a href="/profile" class="hover:text-zinc-900 transition-colors">Client Portfolio</a>
                <span>/</span>
                <span class="text-zinc-900 font-bold">Security Credentials</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-serif font-normal tracking-tight text-zinc-900">
                Change Password
            </h1>
            <p class="text-xs text-zinc-500 font-light">
                Update your secret passphrase for secure vault authentication.
            </p>
        </div>

        <%- include('../partials/flash-message') %>

        <% if (isInitialGoogleUser) { %>
            <div class="bg-white border border-zinc-200/80 rounded-3xl p-8 sm:p-10 shadow-sm space-y-6 text-center">
                <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-700 border border-amber-200 flex items-center justify-center mx-auto text-xl shadow-xs">
                    🔒
                </div>
                <div class="space-y-2 max-w-sm mx-auto">
                    <h2 class="text-xl font-serif text-zinc-900 font-normal">
                        Direct Password Change Unavailable
                    </h2>
                    <p class="text-xs text-zinc-500 font-light leading-relaxed">
                        Your account was authenticated via Google Sign-In and does not currently have a password. In accordance with security protocol, direct password changes are not available initially. You can establish your password by performing a secure <strong>Password Reset</strong>.
                    </p>
                </div>
                <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
                    <a href="/forgot-password?email=<%= encodeURIComponent(safeUser.email) %>" class="w-full sm:w-auto px-6 py-3.5 bg-[#1c1c1c] hover:bg-black text-white text-xs uppercase font-mono font-bold tracking-wider rounded-xl transition-all shadow-md">
                        Reset Password First →
                    </a>
                    <a href="/profile" class="w-full sm:w-auto px-6 py-3.5 bg-white hover:bg-zinc-100 text-zinc-800 text-xs uppercase font-mono font-bold tracking-wider rounded-xl border border-zinc-300 transition-all">
                        Return to Portfolio
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="bg-white border border-zinc-200/80 rounded-3xl p-8 sm:p-10 shadow-sm">
                <form action="/profile/change-password" method="POST" class="space-y-5" id="changePasswordForm" novalidate>
                    
                    <!-- Current Password -->
                    <div>
                        <label for="currentPassword" class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-600 mb-2">
                            Current Password <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <input
                                type="password"
                                name="currentPassword"
                                id="currentPassword"
                                required
                                autocomplete="current-password"
                                value="<%= typeof oldData !== 'undefined' && oldData.currentPassword ? oldData.currentPassword : '' %>"
                                placeholder="Enter existing password"
                                class="w-full px-4 py-3 pr-12 bg-white border <%= typeof errors !== 'undefined' && errors.currentPassword ? 'border-rose-500' : 'border-zinc-300' %> rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 transition-all font-sans"
                            >
                            <button
                                type="button"
                                onclick="togglePassword('currentPassword', 'currentPasswordEye')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-900 transition-colors cursor-pointer"
                                aria-label="Toggle password visibility"
                            >
                                <svg id="currentPasswordEye" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                            </button>
                        </div>
                        <p id="currentPasswordError" class="text-rose-600 text-xs mt-1.5 <%= typeof errors !== 'undefined' && errors.currentPassword ? '' : 'hidden' %>">
                            <%= typeof errors !== 'undefined' && errors.currentPassword ? errors.currentPassword : '' %>
                        </p>
                    </div>

                <!-- New Password -->
                <div>
                    <label for="newPassword" class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-600 mb-2">
                        <%= safeHasPassword ? 'New Password' : 'Set Password' %> <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input
                            type="password"
                            name="newPassword"
                            id="newPassword"
                            required
                            autocomplete="new-password"
                            value="<%= typeof oldData !== 'undefined' && oldData.newPassword ? oldData.newPassword : '' %>"
                            placeholder="Minimum 8 chars (letters, numbers, symbol)"
                            class="w-full px-4 py-3 pr-12 bg-white border <%= typeof errors !== 'undefined' && errors.newPassword ? 'border-rose-500' : 'border-zinc-300' %> rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 transition-all font-sans"
                        >
                        <button
                            type="button"
                            onclick="togglePassword('newPassword', 'newPasswordEye')"
                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-900 transition-colors cursor-pointer"
                            aria-label="Toggle password visibility"
                        >
                            <svg id="newPasswordEye" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </button>
                    </div>
                    <p id="newPasswordError" class="text-rose-600 text-xs mt-1.5 <%= typeof errors !== 'undefined' && errors.newPassword ? '' : 'hidden' %>">
                        <%= typeof errors !== 'undefined' && errors.newPassword ? errors.newPassword : '' %>
                    </p>

                    <!-- Real-Time Password Strength Meter -->
                    <div id="strengthMeterContainer" class="mt-3 space-y-2">
                        <div class="flex items-center justify-between text-[10px] uppercase tracking-wider font-mono">
                            <span class="text-zinc-400">Security Rating</span>
                            <span id="strengthLabel" class="font-bold text-zinc-400">Too Short</span>
                        </div>
                        <div class="h-1.5 w-full bg-zinc-100 rounded-full overflow-hidden flex gap-1">
                            <div id="strBar1" class="h-full flex-1 bg-zinc-200 transition-colors duration-300"></div>
                            <div id="strBar2" class="h-full flex-1 bg-zinc-200 transition-colors duration-300"></div>
                            <div id="strBar3" class="h-full flex-1 bg-zinc-200 transition-colors duration-300"></div>
                            <div id="strBar4" class="h-full flex-1 bg-zinc-200 transition-colors duration-300"></div>
                        </div>
                    </div>
                </div>

                <!-- Confirm New Password -->
                <div>
                    <label for="confirmPassword" class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-600 mb-2">
                        Confirm <%= safeHasPassword ? 'New Password' : 'Password' %> <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <input
                            type="password"
                            name="confirmPassword"
                            id="confirmPassword"
                            required
                            autocomplete="new-password"
                            value="<%= typeof oldData !== 'undefined' && oldData.confirmPassword ? oldData.confirmPassword : '' %>"
                            placeholder="Re-enter password"
                            class="w-full px-4 py-3 pr-12 bg-white border <%= typeof errors !== 'undefined' && errors.confirmPassword ? 'border-rose-500' : 'border-zinc-300' %> rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 transition-all font-sans"
                        >
                        <button
                            type="button"
                            onclick="togglePassword('confirmPassword', 'confirmPasswordEye')"
                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-400 hover:text-zinc-900 transition-colors cursor-pointer"
                            aria-label="Toggle password visibility"
                        >
                            <svg id="confirmPasswordEye" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </button>
                    </div>
                    <p id="confirmPasswordError" class="text-rose-600 text-xs mt-1.5 <%= typeof errors !== 'undefined' && errors.confirmPassword ? '' : 'hidden' %>">
                        <%= typeof errors !== 'undefined' && errors.confirmPassword ? errors.confirmPassword : '' %>
                    </p>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                    <a href="/profile" class="px-6 py-3.5 border border-zinc-300 hover:border-zinc-900 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-700 hover:text-black transition-colors">
                        Cancel
                    </a>
                    <button
                        type="submit"
                        class="bg-[#1b1c1c] hover:bg-black text-white px-8 py-3.5 rounded-xl text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-200 shadow-sm cursor-pointer"
                    >
                        <%= safeHasPassword ? 'Update Password' : 'Set Password' %>
                    </button>
                </div>
            </form>
        </div>
        <% } %>
    </main>
</div>

<script>
    const hasPassword = <%= safeHasPassword ? 'true' : 'false' %>;

    function togglePassword(inputId, eyeId) {
        const input = document.getElementById(inputId);
        const eye = document.getElementById(eyeId);
        if (!input || !eye) return;

        if (input.type === 'password') {
            input.type = 'text';
            eye.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>';
        } else {
            input.type = 'password';
            eye.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>';
        }
    }

    const newPassInput = document.getElementById('newPassword');
    const strLabel = document.getElementById('strengthLabel');
    const b1 = document.getElementById('strBar1');
    const b2 = document.getElementById('strBar2');
    const b3 = document.getElementById('strBar3');
    const b4 = document.getElementById('strBar4');

    if (newPassInput) {
        newPassInput.addEventListener('input', () => {
            const v = newPassInput.value;
            let score = 0;
            if (v.length >= 8) score++;
            if (/[A-Z]/.test(v)) score++;
            if (/[0-9]/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;

            b1.className = 'h-full flex-1 bg-zinc-200 transition-colors duration-300';
            b2.className = 'h-full flex-1 bg-zinc-200 transition-colors duration-300';
            b3.className = 'h-full flex-1 bg-zinc-200 transition-colors duration-300';
            b4.className = 'h-full flex-1 bg-zinc-200 transition-colors duration-300';

            if (v.length === 0) {
                strLabel.textContent = 'Too Short';
                strLabel.className = 'font-bold text-zinc-400';
            } else if (score === 1) {
                b1.className = 'h-full flex-1 bg-rose-500 transition-colors duration-300';
                strLabel.textContent = 'Weak';
                strLabel.className = 'font-bold text-rose-600';
            } else if (score === 2) {
                b1.className = 'h-full flex-1 bg-amber-500 transition-colors duration-300';
                b2.className = 'h-full flex-1 bg-amber-500 transition-colors duration-300';
                strLabel.textContent = 'Fair';
                strLabel.className = 'font-bold text-amber-600';
            } else if (score === 3) {
                b1.className = 'h-full flex-1 bg-blue-500 transition-colors duration-300';
                b2.className = 'h-full flex-1 bg-blue-500 transition-colors duration-300';
                b3.className = 'h-full flex-1 bg-blue-500 transition-colors duration-300';
                strLabel.textContent = 'Good';
                strLabel.className = 'font-bold text-blue-600';
            } else if (score >= 4) {
                b1.className = 'h-full flex-1 bg-emerald-600 transition-colors duration-300';
                b2.className = 'h-full flex-1 bg-emerald-600 transition-colors duration-300';
                b3.className = 'h-full flex-1 bg-emerald-600 transition-colors duration-300';
                b4.className = 'h-full flex-1 bg-emerald-600 transition-colors duration-300';
                strLabel.textContent = 'Fortress Strong';
                strLabel.className = 'font-bold text-emerald-700';
            }
        });
    }

    const form = document.getElementById('changePasswordForm');
    const currentPass = document.getElementById('currentPassword');
    const confirmPass = document.getElementById('confirmPassword');
    const curErr = document.getElementById('currentPasswordError');
    const newErr = document.getElementById('newPasswordError');
    const confErr = document.getElementById('confirmPasswordError');

    if (currentPass) {
        currentPass.addEventListener('input', () => {
            if (currentPass.value) {
                if (curErr) {
                    curErr.textContent = '';
                    curErr.classList.add('hidden');
                }
            }
        });
    }

    if (newPassInput) {
        newPassInput.addEventListener('input', () => {
            if (newPassInput.value && newPassInput.value.length >= 8) {
                if (newErr) {
                    newErr.textContent = '';
                    newErr.classList.add('hidden');
                }
            }
            if (confirmPass && confirmPass.value && confirmPass.value === newPassInput.value) {
                if (confErr) {
                    confErr.textContent = '';
                    confErr.classList.add('hidden');
                }
            }
        });
    }

    if (confirmPass) {
        confirmPass.addEventListener('input', () => {
            if (confirmPass.value && confirmPass.value === newPassInput.value) {
                if (confErr) {
                    confErr.textContent = '';
                    confErr.classList.add('hidden');
                }
            }
        });
    }

    if (form) {
        form.addEventListener('submit', (e) => {
            let hasErr = false;
            if (curErr) curErr.classList.add('hidden');
            newErr.classList.add('hidden');
            confErr.classList.add('hidden');

            if (hasPassword && currentPass && !currentPass.value) {
                curErr.textContent = 'Please enter your current password.';
                curErr.classList.remove('hidden');
                hasErr = true;
            }

            if (!newPassInput.value || newPassInput.value.length < 8) {
                newErr.textContent = 'Password must be at least 8 characters long.';
                newErr.classList.remove('hidden');
                hasErr = true;
            }

            if (newPassInput.value && confirmPass.value !== newPassInput.value) {
                confErr.textContent = 'Passwords do not match.';
                confErr.classList.remove('hidden');
                hasErr = true;
            }

            if (hasErr) {
                e.preventDefault();
            }
        });
    }
</script>

<%- include('../partials/footer') %>
