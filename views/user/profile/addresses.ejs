<%- include('../partials/header', { title: 'Vault & Delivery Addresses — DELTA' }) %>
<%- include('../partials/navbar') %>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-12">
    <main class="max-w-5xl mx-auto px-6 space-y-8">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-6">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-zinc-400">
                    <a href="/profile" class="hover:text-zinc-900 transition-colors">Client Portfolio</a>
                    <span>/</span>
                    <span class="text-zinc-900 font-bold">Vault Destinations</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-serif font-normal tracking-tight text-zinc-900">
                    Delivery & Vault Addresses
                </h1>
                <p class="text-xs text-zinc-500 font-light">
                    Manage insured delivery residences and private banking vaults.
                </p>
            </div>

            <a href="/addresses/add" class="inline-flex items-center gap-2 bg-[#1b1c1c] hover:bg-black text-white px-6 py-3.5 rounded-xl text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-200 shadow-sm cursor-pointer flex-shrink-0">
                <span>+</span> Add New Address
            </a>
        </div>

        <%- include('../partials/flash-message') %>

        <!-- Address Cards Grid -->
        <% if (typeof addresses !== 'undefined' && addresses && addresses.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% addresses.forEach(addr => { %>
                    <div class="bg-white border <%= addr.isDefault ? 'border-[#0A4D2E] ring-1 ring-[#0A4D2E]' : 'border-zinc-200/80' %> rounded-3xl p-6 sm:p-8 relative flex flex-col justify-between shadow-sm transition-all hover:border-zinc-400">
                        <div class="space-y-4">
                            <div class="flex items-start justify-between gap-2 border-b border-zinc-100 pb-4">
                                <div>
                                    <span class="text-lg font-serif font-bold text-zinc-900 block"><%= addr.fullName %></span>
                                    <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-mono font-semibold capitalize"><%= addr.addressType %> Address</span>
                                </div>

                                <% if (addr.isDefault) { %>
                                    <span class="bg-emerald-50 text-[#0A4D2E] border border-emerald-200 text-[9px] uppercase tracking-widest px-3 py-1 rounded-full font-bold">
                                        ★ Default Vault
                                    </span>
                                <% } %>
                            </div>

                            <div class="space-y-1.5 text-xs text-zinc-600 leading-relaxed">
                                <p class="font-medium text-zinc-900"><%= addr.addressLine %></p>
                                <% if (addr.landmark) { %>
                                    <p class="text-zinc-500 font-light">Landmark: <%= addr.landmark %></p>
                                <% } %>
                                <p><%= addr.city %>, <%= addr.state %> — <span class="font-mono font-bold text-zinc-800"><%= addr.pincode %></span></p>
                                <p class="text-zinc-500"><%= addr.country || 'India' %></p>
                                <p class="text-zinc-700 pt-2 flex items-center gap-1.5 font-mono text-[11px] border-t border-zinc-100">
                                    <span class="text-zinc-400 font-sans">Contact:</span> <%= addr.phone %>
                                    <% if (addr.altPhone) { %>
                                        <span class="text-zinc-400 font-sans">| Alt:</span> <%= addr.altPhone %>
                                    <% } %>
                                </p>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="flex items-center justify-between border-t border-zinc-100 pt-4 mt-6 text-xs">
                            <a href="/addresses/<%= addr._id %>/edit" class="text-zinc-700 hover:text-black uppercase tracking-wider font-semibold font-mono transition-colors">
                                Edit Address →
                            </a>

                            <button
                                type="button"
                                onclick="openDeleteModal('<%= addr._id %>', '<%= addr.fullName %>')"
                                class="text-zinc-400 hover:text-rose-600 uppercase tracking-wider font-semibold font-mono transition-colors cursor-pointer"
                            >
                                Delete
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="bg-white border border-zinc-200/80 rounded-3xl p-12 text-center max-w-md mx-auto shadow-sm space-y-4">
                <div class="w-16 h-16 rounded-full bg-zinc-100 flex items-center justify-center text-2xl text-zinc-400 mx-auto">
                    📍
                </div>
                <h3 class="text-xl font-serif text-zinc-900">No Addresses Registered</h3>
                <p class="text-xs text-zinc-500 font-light leading-relaxed">
                    Register your primary residence or private banking vault for insured timepiece deliveries.
                </p>
                <div class="pt-2">
                    <a href="/addresses/add" class="inline-block bg-[#1b1c1c] hover:bg-black text-white px-7 py-3.5 rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors">
                        Add Your First Address
                    </a>
                </div>
            </div>
        <% } %>
    </main>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white border border-zinc-200 rounded-3xl max-w-md w-full p-8 text-center shadow-xl space-y-4">
        <div class="w-14 h-14 rounded-full bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600 text-2xl mx-auto">
            ⚠️
        </div>
        <h3 class="text-xl font-serif text-zinc-900">Confirm Address Deletion</h3>
        <p class="text-xs text-zinc-500 leading-relaxed">
            Are you sure you wish to delete the delivery address for <strong id="deleteAddressName" class="text-zinc-900 font-semibold"></strong>? This action cannot be undone.
        </p>

        <form id="deleteAddressForm" method="POST" class="flex gap-3 justify-center pt-2">
            <button
                type="button"
                onclick="closeDeleteModal()"
                class="px-6 py-3 border border-zinc-300 hover:border-zinc-900 rounded-xl text-xs uppercase tracking-wider text-zinc-700 hover:text-black font-semibold transition-colors cursor-pointer"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="px-6 py-3 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs uppercase tracking-wider font-semibold transition-colors shadow cursor-pointer"
            >
                Delete Address
            </button>
        </form>
    </div>
</div>

<script>
    function openDeleteModal(addressId, fullName) {
        document.getElementById('deleteAddressName').textContent = fullName;
        document.getElementById('deleteAddressForm').action = '/addresses/' + addressId + '/delete';
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
    }

    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this) closeDeleteModal();
    });
</script>

<%- include('../partials/footer') %>
