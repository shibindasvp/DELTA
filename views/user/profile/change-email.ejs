<%- include('../partials/header', { title: 'Change Email Address — DELTA Vault' }) %>
<%- include('../partials/navbar') %>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-12">
    <main class="max-w-xl mx-auto px-6 space-y-8">
        
        <!-- Breadcrumb & Header -->
        <div class="space-y-1.5 border-b border-zinc-200 pb-6">
            <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-zinc-400">
                <a href="/profile" class="hover:text-zinc-900 transition-colors">Client Portfolio</a>
                <span>/</span>
                <span class="text-zinc-900 font-bold">Change Email</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-serif font-normal tracking-tight text-zinc-900">
                Change Registered Email
            </h1>
            <p class="text-xs text-zinc-500 font-light">
                Enter your new email address. A 6-digit security code will be sent to verify ownership.
            </p>
        </div>

        <%- include('../partials/flash-message') %>

        <div class="bg-white border border-zinc-200/80 rounded-3xl p-8 sm:p-10 shadow-sm">
            <form action="/profile/change-email" method="POST" class="space-y-6" id="changeEmailForm" novalidate>
                
                <!-- Current Email Display -->
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-600 mb-2">
                        Current Registered Email
                    </label>
                    <div class="p-4 bg-zinc-50 border border-zinc-200 rounded-xl text-sm text-zinc-700 font-mono">
                        <%= typeof user !== 'undefined' && user ? user.email : '' %>
                    </div>
                </div>

                <!-- New Email Input -->
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.2em] font-semibold text-zinc-600 mb-2">
                        New Email Address
                    </label>
                    <input
                        type="email"
                        name="newEmail"
                        id="newEmail"
                        required
                        value="<%= (typeof oldData !== 'undefined' && oldData.newEmail) ? oldData.newEmail : (typeof newEmail !== 'undefined' ? newEmail : '') %>"
                        placeholder="Enter your new email address"
                        class="w-full px-4 py-3 bg-white border border-zinc-300 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 rounded-xl text-sm text-zinc-900 placeholder-zinc-400 focus:outline-none transition-all font-sans"
                        autofocus
                    >
                    <p id="emailError" class="text-rose-600 text-xs mt-1.5 hidden"></p>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                    <a href="/profile" class="px-6 py-3.5 border border-zinc-300 hover:border-zinc-900 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-700 hover:text-black transition-colors">
                        Cancel
                    </a>
                    <button
                        type="submit"
                        class="bg-[#1b1c1c] hover:bg-black text-white px-8 py-3.5 rounded-xl text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-200 shadow-sm cursor-pointer"
                    >
                        Send Verification Code →
                    </button>
                </div>
            </form>
        </div>
    </main>
</div>

<script>
    const form = document.getElementById('changeEmailForm');
    const newEmailInput = document.getElementById('newEmail');
    const emailError = document.getElementById('emailError');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    newEmailInput.addEventListener('input', () => {
        const val = newEmailInput.value.trim().toLowerCase();
        if (val && emailRegex.test(val)) {
            emailError.textContent = '';
            emailError.classList.add('hidden');
        }
    });

    form.addEventListener('submit', (e) => {
        const val = newEmailInput.value.trim().toLowerCase();
        emailError.classList.add('hidden');

        if (!val) {
            e.preventDefault();
            emailError.textContent = 'Please enter your new email address.';
            emailError.classList.remove('hidden');
            return;
        }

        if (!emailRegex.test(val)) {
            e.preventDefault();
            emailError.textContent = 'Please enter a valid email address.';
            emailError.classList.remove('hidden');
            return;
        }
    });
</script>

<%- include('../partials/footer') %>
