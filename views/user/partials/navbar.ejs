<header class="bg-white border-b border-zinc-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between relative">
        <!-- Left Brand & Links -->
        <div class="flex items-center gap-8">
            <a href="/" class="text-xl font-serif tracking-[0.25em] font-bold text-[#1c1c1c] uppercase">
                Delta
            </a>
            <nav class="hidden md:flex items-center space-x-6 text-[11px] uppercase tracking-[0.2em] font-medium">
                <a href="/" class="<%= (typeof activeNav !== 'undefined' && activeNav === 'home') ? 'text-emerald-800 font-bold' : 'text-zinc-600 hover:text-black transition-colors' %>">Home</a>
                <a href="/brands" class="<%= (typeof activeNav !== 'undefined' && activeNav === 'brands') ? 'text-emerald-800 font-bold' : 'text-zinc-600 hover:text-black transition-colors' %>">Brands</a>
                <a href="/shop" class="<%= (typeof activeNav !== 'undefined' && activeNav === 'shop') ? 'text-emerald-800 font-bold' : 'text-zinc-600 hover:text-black transition-colors' %>">Shop</a>
                <a href="/#heritage" class="text-zinc-600 hover:text-black transition-colors">Details</a>
                <a href="/#concierge" class="text-zinc-600 hover:text-black transition-colors">About Us</a>
            </nav>
        </div>

        <!-- Center Greek Delta Emblem -->
        <div class="absolute left-1/2 -translate-x-1/2 hidden sm:block">
            <a href="/" class="text-3xl font-serif text-[#1c1c1c] hover:opacity-80 transition-opacity">
                δ
            </a>
        </div>

        <!-- Right Icons & Profile Dropdown -->
        <div class="flex items-center space-x-5 text-zinc-800">
            <!-- Search -->
            <a href="/shop" title="Search Timepieces" class="hover:text-black transition-colors p-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </a>

                        <!-- Wishlist -->
            <a href="/wishlist" title="Wishlist" class="hover:text-black transition-colors p-1 relative flex items-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                <span id="navbarWishlistCount" class="hidden absolute -top-1.5 -right-2 w-4 h-4 rounded-full bg-rose-700 text-white font-mono text-[9px] font-bold flex items-center justify-center shadow-xs">0</span>
            </a>

            <!-- Shopping Cart -->
            <a href="/cart" title="Shopping Cart" class="hover:text-black transition-colors p-1 relative flex items-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                <span id="navbarCartCount" class="hidden absolute -top-1.5 -right-2 w-4 h-4 rounded-full bg-[#0A4D2E] text-white font-mono text-[9px] font-bold flex items-center justify-center shadow-xs">0</span>
            </a>

            <!-- Client Profile Dropdown Menu -->
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="relative inline-block text-left" id="userMenuContainer">
                    <!-- Dropdown Trigger Button -->
                    <button 
                        type="button" 
                        onclick="toggleUserMenu()"
                        class="flex items-center gap-1.5 p-1 text-black font-semibold hover:opacity-80 focus:outline-none cursor-pointer"
                        id="userMenuButton"
                        aria-expanded="false"
                        aria-haspopup="true"
                    >
                        <div class="w-7 h-7 rounded-full bg-[#1c1c1c] text-white flex items-center justify-center text-[11px] font-serif overflow-hidden shadow-sm">
                            <% if (user.profileImage) { %>
                                <img src="<%= user.profileImage %>" alt="<%= user.name %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                            <% } %>
                        </div>
                        <svg class="w-3 h-3 text-zinc-500 transform transition-transform duration-200" id="userMenuChevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    <!-- Dropdown Panel -->
                    <div 
                        id="userMenuDropdown"
                        class="hidden absolute right-0 mt-2.5 w-60 origin-top-right bg-white rounded-xl shadow-[0_15px_40px_rgba(0,0,0,0.12)] border border-zinc-100 py-2 z-50 transform transition-all duration-200"
                        role="menu"
                    >
                        <!-- User Info -->
                        <div class="px-4 py-2.5 border-b border-zinc-100">
                            <p class="text-[9px] uppercase tracking-[0.2em] font-semibold text-[#c5a059]">Delta Collector</p>
                            <p class="text-xs font-bold text-zinc-900 truncate"><%= user.name || 'Collector' %></p>
                            <p class="text-[11px] text-zinc-400 truncate font-light"><%= user.email || '' %></p>
                        </div>

                        <!-- Menu Links -->
                        <div class="py-1">
                            <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-black font-medium transition-colors">
                                <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                <span>My Profile & Vault</span>
                            </a>

                            <a href="/wallet" class="flex items-center gap-2.5 px-4 py-2 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-black font-medium transition-colors">
                                <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                                <span>DELTA Vault Wallet</span>
                            </a>

                            <a href="/orders" class="flex items-center gap-2.5 px-4 py-2 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-black font-medium transition-colors">
                                <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                <span>My Orders</span>
                            </a>

                            <a href="/wishlist" class="flex items-center gap-2.5 px-4 py-2 text-xs text-zinc-700 hover:bg-zinc-50 hover:text-black font-medium transition-colors">
                                <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                <span>Wishlist</span>
                            </a>
                        </div>

                        <!-- Sign Out Form -->
                        <div class="border-t border-zinc-100 pt-1 mt-1">
                            <form action="/logout" method="POST" class="m-0">
                                <button 
                                    type="submit" 
                                    class="w-full flex items-center gap-2.5 px-4 py-2 text-xs text-rose-600 hover:bg-rose-50 font-semibold transition-colors text-left cursor-pointer"
                                >
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                                    <span>Sign Out</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <a href="/login" title="Sign In" class="hover:text-black transition-colors text-[11px] uppercase tracking-widest font-medium">
                    Sign In
                </a>
            <% } %>
        </div>
    </div>
</header>

<!-- Dropdown Click & Outside-Dismiss Script -->
<script>
    function toggleUserMenu() {
        const dropdown = document.getElementById('userMenuDropdown');
        const chevron = document.getElementById('userMenuChevron');
        if (!dropdown) return;
        
        const isHidden = dropdown.classList.contains('hidden');
        if (isHidden) {
            dropdown.classList.remove('hidden');
            if (chevron) chevron.classList.add('rotate-180');
        } else {
            dropdown.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
        }
    }

    // Close when clicking anywhere outside
    document.addEventListener('click', function(event) {
        const container = document.getElementById('userMenuContainer');
        const dropdown = document.getElementById('userMenuDropdown');
        const chevron = document.getElementById('userMenuChevron');
        
        if (container && !container.contains(event.target) && dropdown && !dropdown.classList.contains('hidden')) {
            dropdown.classList.add('hidden');
            if (chevron) chevron.classList.remove('rotate-180');
        }
    });

    // Fetch live navbar cart count
    window.updateNavbarCounters = function(cartCount, wishlistCount) {
        if (cartCount !== undefined) {
            const badge = document.getElementById('navbarCartCount');
            if (badge) {
                if (cartCount > 0) {
                    badge.textContent = cartCount;
                    badge.classList.remove('hidden');
                    badge.classList.add('scale-125');
                    setTimeout(() => badge.classList.remove('scale-125'), 200);
                } else {
                    badge.classList.add('hidden');
                }
            }
        }
        if (wishlistCount !== undefined) {
            const badge = document.getElementById('navbarWishlistCount');
            if (badge) {
                if (wishlistCount > 0) {
                    badge.textContent = wishlistCount;
                    badge.classList.remove('hidden');
                    badge.classList.add('scale-125');
                    setTimeout(() => badge.classList.remove('scale-125'), 200);
                } else {
                    badge.classList.add('hidden');
                }
            }
        }
    };

    // Global Luxury Toast Notification Utility (preserve header.ejs implementation when present)
    window.showToast = window.showToast || function(msg, type = 'info', duration = 3500) {
        let container = document.getElementById('deltaToastContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'deltaToastContainer';
            container.className = 'fixed top-5 right-5 z-[99999] flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0';
            document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        const bgColors = {
            success: 'bg-[#0A4D2E] text-white border-emerald-700',
            error: 'bg-rose-900 text-white border-rose-800',
            warning: 'bg-amber-900 text-white border-amber-800',
            info: 'bg-zinc-900 text-white border-zinc-800'
        };

        const icons = {
            success: '✓',
            error: '✕',
            warning: '⚠️',
            info: 'ℹ'
        };

        toast.className = `${bgColors[type] || bgColors.info} border px-4 py-3.5 rounded-2xl shadow-xl flex items-center justify-between gap-3 text-xs pointer-events-auto transform translate-y-4 opacity-0 transition-all duration-300 backdrop-blur-md`;
        toast.innerHTML = `
            <div class="flex items-center gap-2.5">
                <span class="font-bold text-sm">${icons[type] || 'ℹ'}</span>
                <span class="font-light">${msg}</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-white/60 hover:text-white text-xs cursor-pointer">✕</button>
        `;

        container.appendChild(toast);
        requestAnimationFrame(() => {
            toast.classList.remove('translate-y-4', 'opacity-0');
        });

        setTimeout(() => {
            toast.classList.add('opacity-0', 'translate-y-2');
            setTimeout(() => toast.remove(), 300);
        }, duration);
    };

    // Initialize counts on page load
    (async function initNavbarCounts() {
        try {
            const [cartRes, wishRes] = await Promise.all([
                fetch('/api/cart/count').then(r => r.json()).catch(() => ({ count: 0 })),
                fetch('/api/wishlist/ids').then(r => r.json()).catch(() => ({ ids: [] }))
            ]);
            window.updateNavbarCounters(cartRes.count, wishRes.ids?.length || 0);
        } catch (e) {}
    })();

</script>