<%- include('../partials/header', { title: 'My Orders — DELTA Vault' }) %>
<%- include('../partials/navbar', { activeNav: 'profile' }) %>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
        
        <!-- Breadcrumbs & Header -->
        <div class="space-y-4">
            <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-zinc-400">
                <a href="/profile" class="hover:text-zinc-900 transition-colors">Client Portfolio</a>
                <span>/</span>
                <span class="text-zinc-900 font-bold">All Orders</span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-zinc-200/80 pb-6">
                <div>
                    <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block mb-1">
                        COLLECTOR DOSSIER ARCHIVE
                    </span>
                    <h1 class="text-3xl sm:text-4xl font-serif text-zinc-900 font-normal tracking-tight">
                        My Orders
                    </h1>
                    <p class="text-xs text-zinc-500 font-light mt-1">
                        Track private orders, white-glove logistics, and certified manufacture provenance.
                    </p>
                </div>

                <a href="/shop" class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#1c1c1c] hover:bg-black text-white text-xs uppercase font-semibold tracking-widest rounded-xl transition-all shadow-xs hover:shadow-md flex-shrink-0 cursor-pointer">
                    <span>Explore Timepieces</span>
                    <span>→</span>
                </a>
            </div>
        </div>

        <!-- Portfolio Navigation Tabs Bar -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none border-b border-zinc-200/60">
            <a href="/profile" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 transition-colors flex-shrink-0">
                Portfolio Overview
            </a>
            <a href="/profile/orders" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold bg-[#1c1c1c] text-white shadow-2xs flex-shrink-0 flex items-center gap-2">
                <span>Orders</span>
                <% if (typeof orders !== 'undefined' && orders && orders.length > 0) { %>
                    <span class="px-2 py-0.5 rounded-full bg-[#0A4D2E] text-white text-[10px] font-mono"><%= orders.length %></span>
                <% } %>
            </a>
            <a href="/addresses" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 transition-colors flex-shrink-0">
                Vault Destinations
            </a>
            <a href="/wishlist" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 transition-colors flex-shrink-0">
                Saved Wishlist
            </a>
            <a href="/cart" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-semibold text-zinc-500 hover:text-zinc-900 hover:bg-zinc-100 transition-colors flex-shrink-0">
                Shopping Bag
            </a>
        </div>

        <%- include('../partials/flash-message') %>

        <!-- Search & Interactive Status Filters Toolbar -->
        <div class="bg-white rounded-3xl border border-zinc-200/80 p-5 sm:p-6 shadow-xs space-y-4">
            <form action="/orders" method="GET" class="space-y-4">
                <div class="flex flex-col sm:flex-row items-center gap-3">
                    <div class="relative flex-1 w-full">
                        <input 
                            type="text" 
                            name="search" 
                            value="<%= typeof search !== 'undefined' ? search : '' %>" 
                            placeholder="Search by Order ID (DLT-...), timepiece model, brand, or location..."
                            class="w-full pl-11 pr-10 py-3.5 bg-zinc-50/80 border border-zinc-200 rounded-2xl text-xs focus:bg-white focus:border-[#0A4D2E] focus:ring-1 focus:ring-[#0A4D2E] outline-none transition-all font-light"
                        >
                        <svg class="w-4 h-4 text-zinc-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <% if (typeof search !== 'undefined' && search) { %>
                            <a href="/orders<%= (typeof status !== 'undefined' && status) ? '?status=' + encodeURIComponent(status) : '' %>" class="absolute right-3.5 top-1/2 -translate-y-1/2 w-5 h-5 rounded-full bg-zinc-200 hover:bg-zinc-300 text-zinc-600 flex items-center justify-center text-[10px] font-bold transition-colors">
                                ✕
                            </a>
                        <% } %>
                    </div>

                    <button 
                        type="submit" 
                        class="w-full sm:w-auto px-7 py-3.5 bg-[#0A4D2E] hover:bg-[#083e25] text-white rounded-2xl text-xs font-semibold uppercase tracking-wider transition-all cursor-pointer shadow-2xs hover:shadow-xs flex items-center justify-center gap-2 flex-shrink-0"
                    >
                        <span>Search Orders</span>
                    </button>
                </div>

                <!-- Status Filter Pills -->
                <div class="flex items-center gap-2 flex-wrap pt-1 border-t border-zinc-100">
                    <span class="text-[10px] uppercase font-mono text-zinc-400 tracking-wider font-semibold mr-1">Status:</span>
                    
                    <%
                        const activeStatus = (typeof status !== 'undefined' && status) ? status : '';
                        const filterOptions = [
                            { label: 'All Orders', val: '' },
                            { label: 'Payment Failed', val: 'Payment Failed', dot: 'bg-rose-500' },
                            { label: 'Pending', val: 'Pending', dot: 'bg-amber-400' },
                            { label: 'Processing', val: 'Processing', dot: 'bg-blue-400' },
                            { label: 'Shipped', val: 'Shipped', dot: 'bg-indigo-400' },
                            { label: 'Delivered', val: 'Delivered', dot: 'bg-emerald-500' },
                            { label: 'Cancelled', val: 'Cancelled', dot: 'bg-rose-500' },
                            { label: 'Return Requested', val: 'Return Requested', dot: 'bg-purple-500' }
                        ];
                    %>

                    <% filterOptions.forEach(opt => { %>
                        <% const isSelected = (activeStatus === opt.val); %>
                        <a 
                            href="/orders?status=<%= encodeURIComponent(opt.val) %><%= (typeof search !== 'undefined' && search) ? '&search=' + encodeURIComponent(search) : '' %>"
                            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium transition-all <%= isSelected ? 'bg-zinc-900 text-white shadow-2xs font-semibold' : 'bg-zinc-100/80 hover:bg-zinc-200/80 text-zinc-700' %>"
                        >
                            <% if (opt.dot) { %>
                                <span class="w-2 h-2 rounded-full <%= opt.dot %>"></span>
                            <% } %>
                            <span><%= opt.label %></span>
                        </a>
                    <% }) %>

                    <% if (activeStatus || (typeof search !== 'undefined' && search)) { %>
                        <a 
                            href="/orders" 
                            class="ml-auto text-[11px] font-mono text-[#c5a059] hover:text-black transition-colors underline underline-offset-4"
                        >
                            Clear All Filters
                        </a>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- Orders List -->
        <% if (orders && orders.length > 0) { %>
            <div class="space-y-6">
                <% orders.forEach(order => { %>
                    <%
                        let badgeStyle = 'bg-zinc-100 text-zinc-700 border-zinc-200';
                        let dotColor = 'bg-zinc-400';
                        if (order.orderStatus === 'Pending') { badgeStyle = 'bg-amber-50 text-amber-800 border-amber-200/90'; dotColor = 'bg-amber-500'; }
                        if (order.orderStatus === 'Processing') { badgeStyle = 'bg-blue-50 text-blue-800 border-blue-200/90'; dotColor = 'bg-blue-500'; }
                        if (order.orderStatus === 'Shipped') { badgeStyle = 'bg-indigo-50 text-indigo-800 border-indigo-200/90'; dotColor = 'bg-indigo-500'; }
                        if (order.orderStatus === 'Delivered') { badgeStyle = 'bg-emerald-50 text-emerald-800 border-emerald-200/90'; dotColor = 'bg-emerald-600'; }
                        if (order.orderStatus === 'Cancelled') { badgeStyle = 'bg-rose-50 text-rose-800 border-rose-200/90'; dotColor = 'bg-rose-500'; }
                        if (order.orderStatus === 'Return Requested') { badgeStyle = 'bg-purple-50 text-purple-800 border-purple-200/90'; dotColor = 'bg-purple-500'; }
                    %>

                    <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-8 space-y-6 shadow-xs hover:shadow-md transition-all duration-300">
                        
                        <!-- Card Header Bar -->
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-zinc-100 pb-5">
                            <!-- Left: ID & Metadata -->
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-3 flex-wrap">
                                    <span class="px-3 py-1 bg-zinc-50 border border-zinc-200 rounded-lg font-mono font-bold text-zinc-900 text-sm tracking-wider">
                                        <%= order.orderNumber %>
                                    </span>
                                    <% if (order.paymentStatus === 'Failed') { %>
                                        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase font-mono tracking-wider font-bold px-3 py-1 rounded-full border bg-rose-50 text-rose-700 border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span>
                                            Payment Failed
                                        </span>
                                    <% } %>
                                    <span class="inline-flex items-center gap-1.5 text-[10px] uppercase font-mono tracking-wider font-semibold px-3 py-1 rounded-full border <%= badgeStyle %>">
                                        <span class="w-1.5 h-1.5 rounded-full <%= dotColor %>"></span>
                                        <%= order.orderStatus %>
                                    </span>
                                </div>
                                <p class="text-xs text-zinc-400 font-mono flex items-center gap-2">
                                    <span>Authorized on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                                    <span>•</span>
                                    <span><%= new Date(order.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></span>
                                </p>
                            </div>

                            <!-- Right: Financials & Action Buttons -->
                            <div class="flex items-center gap-4 sm:gap-6 justify-between lg:justify-end flex-wrap">
                                <div class="text-left lg:text-right">
                                    <span class="text-[9px] font-mono text-zinc-400 uppercase tracking-widest block">Total Valuation</span>
                                    <span class="font-mono font-bold text-lg text-[#0A4D2E]">₹<%= Number(order.grandTotal).toLocaleString('en-IN') %></span>
                                </div>

                                <div class="flex items-center gap-2 flex-wrap">
                                    <% if (order.paymentStatus === 'Failed' && order.orderStatus !== 'Cancelled') { %>
                                        <a 
                                            href="/checkout/payment-failed/<%= order._id %>"
                                            class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-[#0A4D2E] hover:bg-[#073620] text-white text-xs uppercase tracking-wider font-semibold rounded-xl transition-all shadow-xs cursor-pointer"
                                            title="Retry payment authorization for this timepiece order"
                                        >
                                            <svg class="w-3.5 h-3.5 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                            <span>Retry Payment</span>
                                        </a>
                                    <% } %>

                                    <% if (order.orderStatus === 'Pending' || order.orderStatus === 'Processing') { %>
                                        <button 
                                            type="button" 
                                            onclick="openIndexCancelModal('<%= order._id %>', '<%= order.orderNumber %>')"
                                            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-xs font-semibold uppercase tracking-wider rounded-xl transition-colors shadow-2xs cursor-pointer"
                                            title="Cancel this order"
                                        >
                                            <span>✕ Cancel</span>
                                        </button>
                                    <% } %>

                                    <!-- PDF Invoice Download Button -->
                                    <a 
                                        href="/orders/<%= order._id %>/invoice" 
                                        target="_blank"
                                        class="inline-flex items-center gap-2 px-4 py-2.5 bg-zinc-50 hover:bg-zinc-100 border border-zinc-200 text-zinc-700 text-xs font-semibold uppercase tracking-wider rounded-xl transition-colors shadow-2xs"
                                        title="Download Official PDF Invoice"
                                    >
                                        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                        </svg>
                                        <span class="hidden sm:inline">Invoice PDF</span>
                                    </a>

                                    <!-- View Dossier Button -->
                                    <a 
                                        href="/order/details/<%= order._id %>"
                                        class="inline-flex items-center gap-1.5 px-5 py-2.5 bg-[#1c1c1c] hover:bg-black text-white text-xs uppercase tracking-wider font-semibold rounded-xl transition-all shadow-2xs hover:shadow-xs"
                                    >
                                        <span>View Dossier</span>
                                        <span>→</span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Items Showcase -->
                        <div class="space-y-3">
                            <% order.items.forEach(item => { %>
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-zinc-50/60 border border-zinc-200/50 hover:border-zinc-300 transition-colors">
                                    <!-- Item Details -->
                                    <div class="flex items-center gap-4">
                                        <div class="w-16 h-16 rounded-xl bg-[#f4f1ee] overflow-hidden p-1.5 flex items-center justify-center flex-shrink-0 border border-zinc-200/60">
                                            <% if (item.variant && item.variant.image) { %>
                                                <img src="<%= item.variant.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover rounded-lg">
                                            <% } else { %>
                                                <span class="text-zinc-300 text-xl">⏱</span>
                                            <% } %>
                                        </div>

                                        <div class="space-y-0.5">
                                            <span class="text-[9px] uppercase font-mono tracking-widest text-[#c5a059] font-bold block">
                                                <%= item.brandName %>
                                            </span>
                                            <h4 class="font-serif text-sm font-medium text-zinc-900">
                                                <%= item.productName %>
                                            </h4>
                                            <div class="flex items-center gap-2 text-xs text-zinc-500 flex-wrap">
                                                <span class="font-medium text-zinc-700"><%= item.variant ? item.variant.color : 'Standard Edition' %></span>
                                                <span>•</span>
                                                <span class="font-mono text-zinc-400">Qty: <%= item.quantity %></span>
                                                <span class="text-[8px] font-mono uppercase px-2 py-0.5 rounded font-bold ml-1
                                                    <%= item.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : 
                                                       (item.status === 'Out for Delivery' ? 'bg-indigo-100 text-indigo-800' : 
                                                       (item.status === 'Shipped' ? 'bg-blue-100 text-blue-800' : 
                                                       (item.status === 'Processing' ? 'bg-amber-100 text-amber-800' : 
                                                       (item.status === 'Cancelled' ? 'bg-rose-100 text-rose-700' : 
                                                       (item.status === 'Return Requested' || item.status === 'Returned' ? 'bg-purple-100 text-purple-700' : 'bg-zinc-100 text-zinc-700'))))) %>">
                                                    <%= item.status || 'Pending' %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Price -->
                                    <div class="text-left sm:text-right flex-shrink-0">
                                        <p class="font-mono text-sm font-semibold text-zinc-900">
                                            ₹<%= Number(item.itemTotal).toLocaleString('en-IN') %>
                                        </p>
                                        <span class="text-[10px] text-zinc-400 font-mono">₹<%= Number(item.price).toLocaleString('en-IN') %> / unit</span>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Logistics & Fulfillment Summary Footer -->
                        <div class="pt-4 border-t border-zinc-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-zinc-500 font-light">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-zinc-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <p class="truncate">
                                    Insured delivery destination: <span class="text-zinc-800 font-medium"><%= order.shippingAddress.fullName %></span> (<%= order.shippingAddress.city %>, <%= order.shippingAddress.state %>)
                                </p>
                            </div>

                            <div class="flex items-center gap-2 text-zinc-400 font-mono text-[11px] self-end sm:self-auto">
                                <span><%= order.paymentMethod %></span>
                                <span>•</span>
                                <span class="<%= order.paymentStatus === 'Completed' ? 'text-emerald-700 font-semibold' : 'text-zinc-600' %>">
                                    <%= order.paymentStatus === 'Pending' ? 'Pay upon delivery' : order.paymentStatus %>
                                </span>
                            </div>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State / No Search Results -->
            <div class="bg-white rounded-3xl border border-dashed border-zinc-300 p-12 sm:p-16 text-center space-y-5 max-w-lg mx-auto shadow-xs">
                <div class="w-18 h-18 rounded-full bg-zinc-50 border border-zinc-200 text-zinc-400 flex items-center justify-center mx-auto text-3xl shadow-inner">
                    ⏱
                </div>
                <div class="space-y-1">
                    <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block">
                        <%= (typeof search !== 'undefined' && search) ? 'SEARCH QUERY ACTIVE' : 'NO ACTIVE ORDERS' %>
                    </span>
                    <h3 class="text-2xl font-serif text-zinc-900 font-normal">
                        <%= (typeof search !== 'undefined' && search) ? 'No Matching Orders Found' : 'Your Order Archive is Empty' %>
                    </h3>
                </div>
                <p class="text-xs text-zinc-500 font-light leading-relaxed max-w-sm mx-auto">
                    <%= (typeof search !== 'undefined' && search) 
                        ? 'We could not locate any order records matching "' + search + '". Try searching by reference number or model.' 
                        : 'Certified Swiss timepieces ordered through the DELTA Vault checkout will be permanently archived and tracked here.' %>
                </p>
                <div class="pt-2">
                    <% if ((typeof search !== 'undefined' && search) || (typeof status !== 'undefined' && status)) { %>
                        <a href="/orders" class="inline-block px-7 py-3.5 bg-zinc-900 text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black transition-colors shadow-xs">
                            Clear Search & Reset Filters
                        </a>
                    <% } else { %>
                        <a href="/shop" class="inline-block px-7 py-3.5 bg-[#1c1c1c] text-white rounded-xl text-xs uppercase tracking-wider font-semibold hover:bg-black transition-colors shadow-xs">
                            Explore Haute Horlogerie Catalog
                        </a>
                    <% } %>
                </div>
            </div>
        <% } %>

    </div>
</div>

<!-- ========================================================= -->
<!-- CANCEL ORDER MODAL (ORDERS LIST) -->
<!-- ========================================================= -->
<div id="indexCancelOrderModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-rose-600 font-bold block">Order Cancellation</span>
                <h3 class="text-xl font-serif text-zinc-900">Cancel Order</h3>
            </div>
            <button type="button" onclick="closeIndexCancelModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Cancel order <span id="indexCancelOrderNumber" class="font-mono font-bold text-zinc-900"></span>? All allocated timepieces will be restored to vault stock.
        </p>

        <form id="indexCancelOrderForm" onsubmit="submitIndexCancelOrder(event)" class="space-y-4 text-xs">
            <input type="hidden" id="indexCancelOrderId">

            <div class="space-y-1">
                <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-600">Reason for Cancellation <span class="text-rose-500">*</span></label>
                <select id="indexCancelReasonPreset" required onchange="applyIndexCancelPreset(this.value)" class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none bg-white text-xs font-light text-zinc-800 cursor-pointer mb-2">
                    <option value="">Select cancellation reason *</option>
                    <option value="Changed mind / Decided on a different timepiece">Changed mind / Decided on a different timepiece</option>
                    <option value="Ordered by mistake / Duplicate order placed">Ordered by mistake / Duplicate order placed</option>
                    <option value="Incorrect variant, dial, or case material selected">Incorrect variant, dial, or case material selected</option>
                    <option value="Found alternative edition or brand elsewhere">Found alternative edition or brand elsewhere</option>
                    <option value="Delivery timeframe or waiting period is too long">Delivery timeframe or waiting period is too long</option>
                    <option value="Payment or billing adjustment required">Payment or billing adjustment required</option>
                    <option value="Other">Other (Specify in text box below)</option>
                </select>
                <textarea id="indexCancelReason" name="reason" rows="2" placeholder="Additional details or specific reason (optional if selected from dropdown)..." class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none font-light"></textarea>
            </div>

            <div id="indexCancelError" class="text-rose-600 text-xs hidden pt-1 font-mono"></div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-zinc-100">
                <button type="button" onclick="closeIndexCancelModal()" class="px-5 py-3 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 uppercase tracking-wider font-semibold cursor-pointer">Back</button>
                <button type="submit" id="confirmIndexCancelBtn" class="px-6 py-3 bg-rose-700 hover:bg-rose-800 text-white rounded-xl uppercase tracking-wider font-semibold shadow-sm cursor-pointer">Cancel Order</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openIndexCancelModal(orderId, orderNumber) {
        document.getElementById('indexCancelOrderId').value = orderId;
        document.getElementById('indexCancelOrderNumber').textContent = orderNumber;
        document.getElementById('indexCancelReasonPreset').value = '';
        document.getElementById('indexCancelReason').value = '';
        const errEl = document.getElementById('indexCancelError');
        if (errEl) errEl.classList.add('hidden');
        const m = document.getElementById('indexCancelOrderModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeIndexCancelModal() {
        const m = document.getElementById('indexCancelOrderModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function applyIndexCancelPreset(val) {
        const txt = document.getElementById('indexCancelReason');
        if (val && val !== 'Other') {
            if (txt) txt.value = val;
        } else if (val === 'Other') {
            if (txt) { txt.value = ''; txt.focus(); }
        }
    }

    async function submitIndexCancelOrder(e) {
        e.preventDefault();
        const orderId = document.getElementById('indexCancelOrderId').value;
        const preset = document.getElementById('indexCancelReasonPreset').value;
        const customReason = document.getElementById('indexCancelReason').value.trim();
        const finalReason = customReason || preset;
        const errEl = document.getElementById('indexCancelError');
        const btn = document.getElementById('confirmIndexCancelBtn');

        if (!finalReason) {
            if (errEl) {
                errEl.textContent = 'Please choose or provide a reason for cancelling this order.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/orders/' + orderId + '/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason: finalReason })
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) window.showToast('Order cancelled and inventory restored.', 'info');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Unable to cancel order.';
                    errEl.classList.remove('hidden');
                } else {
                    alert(data.message || 'Unable to cancel order.');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error cancelling order.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }
</script>

