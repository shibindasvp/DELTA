                <h3 class="text-xl font-serif text-zinc-900">Retry Order Payment</h3>
            </div>
            <button type="button" onclick="closeRetryPaymentModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
