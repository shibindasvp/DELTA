                <span class="text-[10px] uppercase font-mono text-zinc-400 block">Total Due</span>
                <p class="font-mono font-bold text-[#0A4D2E] text-base">₹<%= Number(order.grandTotal).toLocaleString('en-IN') %></p>
            </div>
