<%
    // 5-Day Return Window Calculation
    let isReturnEligible = false;
    let returnDaysLeft = 0;
    let returnDeadlineFormatted = '';
    let returnExpired = false;
    const isOrderReturnDeclined = order.returnDeclined || (order.returnAdminNotes && order.returnAdminNotes.toLowerCase().includes('decline'));

    if (order.orderStatus === 'Delivered') {
        const deliveryDate = new Date(order.deliveredAt || order.updatedAt || order.createdAt);
        const returnDeadline = new Date(deliveryDate.getTime() + 5 * 24 * 60 * 60 * 1000);
        const msRemaining = returnDeadline.getTime() - Date.now();
        
        if (msRemaining > 0 && !isOrderReturnDeclined) {
            isReturnEligible = true;
            returnDaysLeft = Math.max(1, Math.ceil(msRemaining / (1000 * 60 * 60 * 24)));
        } else if (msRemaining <= 0) {
            returnExpired = true;
        }
        returnDeadlineFormatted = returnDeadline.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' });
    }
%>

<%- include('../partials/header', { title: 'Order Details — ' + order.orderNumber + ' | DELTA Vault' }) %>
<%- include('../partials/navbar', { activeNav: 'profile' }) %>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="bg-[#faf8f7] min-h-screen text-[#1b1c1c] py-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-8">
        
        <!-- Flash Alert if present -->
        <%- include('../partials/flash-message') %>

        <!-- Breadcrumbs & Header -->
        <div class="space-y-4">
            <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-zinc-400">
                <a href="/profile" class="hover:text-zinc-900 transition-colors">Client Portfolio</a>
                <span>/</span>
                <a href="/profile/orders" class="hover:text-zinc-900 transition-colors">Orders</a>
                <span>/</span>
                <span class="text-zinc-900 font-bold"><%= order.orderNumber %></span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-zinc-200/80 pb-6">
                <div class="space-y-1">
                    <div class="flex items-center gap-3">
                        <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block">
                            ORDER DETAILS
                        </span>
                        <%
                            let badgeClass = 'bg-zinc-100 text-zinc-700 border-zinc-200';
                            let dotColor = 'bg-zinc-400';
                            if (order.orderStatus === 'Pending') { badgeClass = 'bg-amber-50 text-amber-800 border-amber-200/90'; dotColor = 'bg-amber-500'; }
                            if (order.orderStatus === 'Processing') { badgeClass = 'bg-blue-50 text-blue-800 border-blue-200/90'; dotColor = 'bg-blue-500'; }
                            if (order.orderStatus === 'Shipped') { badgeClass = 'bg-indigo-50 text-indigo-800 border-indigo-200/90'; dotColor = 'bg-indigo-500'; }
                            if (order.orderStatus === 'Delivered') { badgeClass = 'bg-emerald-50 text-[#0A4D2E] border-emerald-200/90'; dotColor = 'bg-emerald-600'; }
                            if (order.orderStatus === 'Cancelled') { badgeClass = 'bg-rose-50 text-rose-800 border-rose-200/90'; dotColor = 'bg-rose-500'; }
                            if (order.orderStatus === 'Return Requested') { badgeClass = 'bg-purple-50 text-purple-800 border-purple-200/90'; dotColor = 'bg-purple-500'; }
                        %>
                        <span class="inline-flex items-center gap-1.5 text-[10px] uppercase font-mono tracking-wider font-semibold px-3 py-0.5 rounded-full border <%= badgeClass %>">
                            <span class="w-1.5 h-1.5 rounded-full <%= dotColor %>"></span>
                            <%= order.orderStatus %>
                        </span>
                    </div>

                    <h1 class="text-3xl font-serif text-zinc-900 font-normal tracking-tight">
                        Order Ref: <span class="font-mono font-bold"><%= order.orderNumber %></span>
                    </h1>
                    <p class="text-xs text-zinc-400 font-mono">
                        Authorized on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </p>
                </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-3 flex-wrap">
                <% if (order.orderStatus === 'Pending' || order.orderStatus === 'Processing') { %>
                    <button 
                        type="button" 
                        onclick="openCancelOrderModal()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 rounded-xl text-xs uppercase font-semibold tracking-wider transition-colors shadow-2xs cursor-pointer"
                        title="Cancel this order"
                    >
                        <span>✕ Cancel Order</span>
                    </button>
                <% } %>

                <!-- PDF Invoice Download -->
                <a 
                    href="/orders/<%= order._id %>/invoice" 
                    target="_blank"
                    class="inline-flex items-center gap-2 px-5 py-2.5 bg-white hover:bg-zinc-50 border border-zinc-300 text-zinc-700 rounded-xl text-xs uppercase font-semibold tracking-wider transition-colors shadow-2xs cursor-pointer"
                    title="Download Official PDF Invoice"
                >
                    <svg class="w-4 h-4 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    <span>Download PDF Invoice</span>
                </a>
            </div>
        </div>
    </div>

        <!-- Online Payment Failure / Incomplete Alert Banner -->
        <% if (order.paymentStatus === 'Failed') { %>
            <div class="bg-gradient-to-r from-rose-50 via-rose-50/80 to-amber-50/40 border border-rose-200/90 rounded-2xl p-6 text-xs text-rose-900 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-5">
                <div class="flex items-start sm:items-center gap-4">
                    <div class="w-11 h-11 rounded-2xl bg-rose-100/90 text-rose-700 flex items-center justify-center text-lg flex-shrink-0 font-bold border border-rose-200 shadow-2xs">
                        ✕
                    </div>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] font-mono uppercase tracking-widest text-rose-600 font-bold">Action Required</span>
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
                            <span class="text-[10px] font-mono text-rose-600 font-semibold">Payment Incomplete</span>
                        </div>
                        <h4 class="font-serif font-bold text-base text-zinc-900">Payment Authorization Incomplete</h4>
                        <p class="font-light text-rose-800 leading-relaxed max-w-2xl">
                            <%= order.paymentFailureReason || 'The online payment for this order was not completed or authorization was declined.' %>
                            Your timepiece reservation remains secured in vault hold. Please retry payment settlement to authorize dispatch.
                        </p>
                    </div>
                </div>
                <button 
                    type="button" 
                    onclick="openRetryPaymentModal()"
                    class="self-start sm:self-auto px-6 py-3.5 bg-[#0A4D2E] hover:bg-[#073620] text-white rounded-xl text-xs uppercase font-mono tracking-wider font-semibold shadow-md transition-all cursor-pointer flex-shrink-0 flex items-center gap-2.5"
                >
                    <svg class="w-4 h-4 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <span>Retry Settlement Now</span>
                </button>
            </div>
        <% } %>

        <!-- Cancellation / Return / In-Transit / Delivered 5-Day Policy Banner -->
        <% if (order.orderStatus === 'Cancelled') { %>
            <div class="bg-rose-50 border border-rose-200 rounded-2xl p-6 text-xs text-rose-800 space-y-1">
                <h4 class="font-serif font-bold text-sm">Order Cancelled</h4>
                <p class="font-light">
                    Reason: <%= order.cancellationReason || 'Collector requested cancellation' %>
                </p>
                <% if (order.cancelledAt) { %>
                    <p class="font-mono text-[11px] text-rose-600">Cancelled on <%= new Date(order.cancelledAt).toLocaleString('en-IN') %></p>
                <% } %>
                <% if (order.refundAmount && order.refundAmount > 0) { %>
                    <div class="mt-2.5 pt-2.5 border-t border-rose-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px]">
                        <span class="font-medium text-emerald-900 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-600 flex-shrink-0"></span>
                            <span>Direct refund of <strong class="font-mono text-emerald-950 font-bold">₹<%= Number(order.refundAmount).toLocaleString('en-IN') %></strong> credited immediately to your DELTA Vault Wallet.</span>
                        </span>
                        <a href="/wallet" class="self-start sm:self-auto font-mono font-bold text-[#0A4D2E] hover:underline bg-white/80 px-2.5 py-1 rounded-lg border border-emerald-200 flex-shrink-0">
                            View Wallet Ledger →
                        </a>
                    </div>
                <% } %>
            </div>
        <% } else if (order.orderStatus === 'Return Requested' || (order.items && order.items.some(i => i.status === 'Return Requested'))) { %>
            <% 
                const returnReqItems = (order.items || []).filter(i => i.status === 'Return Requested');
                const isSingleItemReturn = returnReqItems.length === 1 && (order.items || []).filter(i => i.status !== 'Cancelled').length > 1;
            %>
            <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6 text-xs text-purple-800 space-y-2">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                    <h4 class="font-serif font-bold text-sm">
                        <%= isSingleItemReturn ? 'Single Timepiece Return Under Review' : 'Return Request Under Review' %>
                    </h4>
                    <% if (order.returnRequestedAt || (returnReqItems[0] && returnReqItems[0].returnRequestedAt)) { %>
                        <p class="font-mono text-[11px] text-purple-600">
                            Requested on <%= new Date(order.returnRequestedAt || returnReqItems[0].returnRequestedAt).toLocaleString('en-IN') %>
                        </p>
                    <% } %>
                </div>

                <% if (isSingleItemReturn) { %>
                    <p class="font-light">
                        Return requested for <strong class="font-semibold text-purple-950"><%= returnReqItems[0].productName %></strong>:
                    </p>
                    <div class="bg-white/80 border border-purple-200/80 rounded-xl p-3 text-purple-950 font-mono text-[11px]">
                        Reason: "<%= returnReqItems[0].returnReason || order.returnReason || 'No statement provided.' %>"
                    </div>
                <% } else if (returnReqItems.length > 1) { %>
                    <p class="font-light">Returned Item Reasons:</p>
                    <div class="space-y-1.5">
                        <% returnReqItems.forEach(rItem => { %>
                            <div class="bg-white/80 border border-purple-200/80 rounded-xl p-2.5 text-purple-950 text-[11px]">
                                <strong class="font-semibold text-purple-950"><%= rItem.productName %>:</strong>
                                <span class="italic font-mono">"<%= rItem.returnReason || order.returnReason || 'No statement provided.' %>"</span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="font-light">
                        Mandatory Reason Provided: <%= order.returnReason || (order.items && order.items.find(i => i.returnReason)?.returnReason) || 'No statement provided.' %>
                    </p>
                <% } %>

                <div class="mt-2.5 pt-2.5 border-t border-purple-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] text-purple-900">
                    <span class="font-medium flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse flex-shrink-0"></span>
                        <span>Refund will be credited to your DELTA Vault Wallet immediately upon administrator inspection and return confirmation.</span>
                    </span>
                    <span class="self-start sm:self-auto font-mono text-[10px] text-purple-800 bg-white/90 px-2.5 py-1 rounded-lg border border-purple-200 font-bold flex-shrink-0">
                        Pending Admin Confirmation
                    </span>
                </div>
            </div>
        <% } else if (order.orderStatus === 'Returned') { %>
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-6 text-xs text-emerald-900 space-y-1">
                <h4 class="font-serif font-bold text-sm">Timepiece Return Completed & Restocked</h4>
                <p class="font-light">
                    Mandatory Reason Provided: <%= order.returnReason || (order.items && order.items.find(i => i.returnReason)?.returnReason) || 'Return processed' %>
                </p>
                <% if (order.returnedAt) { %>
                    <p class="font-mono text-[11px] text-emerald-700">Completed on <%= new Date(order.returnedAt).toLocaleString('en-IN') %></p>
                <% } %>
                <% if (order.refundAmount && order.refundAmount > 0) { %>
                    <div class="mt-2.5 pt-2.5 border-t border-emerald-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px]">
                        <span class="font-medium text-emerald-900 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-600 flex-shrink-0"></span>
                            <span>Return confirmed by administration. Refund of <strong class="font-mono text-emerald-950 font-bold">₹<%= Number(order.refundAmount).toLocaleString('en-IN') %></strong> credited to your DELTA Vault Wallet reserve.</span>
                        </span>
                        <a href="/wallet" class="self-start sm:self-auto font-mono font-bold text-[#0A4D2E] hover:underline bg-white/80 px-2.5 py-1 rounded-lg border border-emerald-200 flex-shrink-0">
                            View Wallet Ledger →
                        </a>
                    </div>
                <% } %>
            </div>
        <% } else if (order.orderStatus === 'Shipped' || order.orderStatus === 'Out for Delivery') { %>
            <div class="bg-indigo-50/80 border border-indigo-200/90 rounded-2xl p-5 text-xs text-indigo-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-base flex-shrink-0">
                        🚚
                    </span>
                    <div>
                        <h4 class="font-serif font-bold text-sm">Dispatched with White-Glove Courier</h4>
                        <p class="font-light text-indigo-700/90">This timepiece order is in active transit and can no longer be cancelled. A return may be requested upon safe delivery.</p>
                    </div>
                </div>
                <span class="self-start sm:self-auto px-3 py-1 bg-white border border-indigo-200 rounded-full font-mono text-[10px] uppercase font-bold text-indigo-800 flex-shrink-0">
                    Non-Cancellable in Transit
                </span>
            </div>
        <% } else if (order.orderStatus === 'Delivered' && isOrderReturnDeclined) { %>
            <div class="bg-zinc-100/90 border border-zinc-200 rounded-2xl p-5 text-xs text-zinc-700 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center text-base flex-shrink-0 font-bold">
                        ✕
                    </span>
                    <div>
                        <h4 class="font-serif font-bold text-sm text-zinc-900">Return Request Declined</h4>
                        <p class="font-light text-zinc-600">
                            <%= order.returnAdminNotes || 'A previous return request for this order was reviewed and declined by the concierge. Timepieces with a declined return request are not eligible for another return request.' %>
                        </p>
                    </div>
                </div>
                <span class="self-start sm:self-auto px-3.5 py-1.5 bg-white border border-rose-200 text-rose-700 rounded-full font-mono text-[10px] uppercase font-bold flex-shrink-0 shadow-2xs">
                    Return Ineligible
                </span>
            </div>
        <% } else if (order.orderStatus === 'Delivered' && isReturnEligible) { %>
            <div class="bg-emerald-50/80 border border-emerald-200/90 rounded-2xl p-5 text-xs text-emerald-950 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center text-base flex-shrink-0 font-bold">
                        ✓
                    </span>
                    <div>
                        <h4 class="font-serif font-bold text-sm">Timepiece Safely Received</h4>
                        <p class="font-light text-emerald-800/90">
                            Delivered destination verified. 5-day vault return policy active until <span class="font-medium underline"><%= returnDeadlineFormatted %></span> (<%= returnDaysLeft %> <%= returnDaysLeft === 1 ? 'day' : 'days' %> remaining). Use the <span class="font-semibold text-purple-900 font-mono">"Return Piece"</span> button on any individual timepiece below to initiate a return.
                        </p>
                    </div>
                </div>
                <span class="self-start sm:self-auto px-3.5 py-1.5 bg-white border border-emerald-200 text-[#0A4D2E] rounded-full font-mono text-[10px] uppercase font-bold flex-shrink-0 shadow-2xs">
                    5-Day Return Window Active (<%= returnDaysLeft %>d)
                </span>
            </div>
        <% } else if (order.orderStatus === 'Delivered' && returnExpired) { %>
            <div class="bg-zinc-100/90 border border-zinc-200 rounded-2xl p-5 text-xs text-zinc-700 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-2xs">
                <div class="flex items-center gap-3">
                    <span class="w-9 h-9 rounded-full bg-zinc-200 text-zinc-500 flex items-center justify-center text-base flex-shrink-0">
                        🔒
                    </span>
                    <div>
                        <h4 class="font-serif font-bold text-sm text-zinc-900">Provenance & Delivery Sealed</h4>
                        <p class="font-light text-zinc-500">
                            The 5-day return window closed on <%= returnDeadlineFormatted %>. Provenance certificate and warranty are permanently registered to your collector archive.
                        </p>
                    </div>
                </div>
                <span class="self-start sm:self-auto px-3.5 py-1 bg-white border border-zinc-200 rounded-full font-mono text-[10px] uppercase font-bold text-zinc-500 flex-shrink-0">
                    Return Window Closed
                </span>
            </div>
        <% } %>

        <!-- Tracking Timeline Status Bar -->
        <div class="bg-white rounded-3xl border border-zinc-200/80 p-8 shadow-sm space-y-6">
            <div class="flex items-center justify-between">
                <h2 class="text-xs uppercase font-mono tracking-[0.2em] text-[#c5a059] font-bold">
                    Order Fulfillment Timeline
                </h2>
                <span class="inline-flex items-center gap-1.5 text-[10px] uppercase font-mono tracking-wider font-semibold px-3 py-1 rounded-full border <%= badgeClass %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= dotColor %>"></span>
                    <%= order.orderStatus %>
                </span>
            </div>

            <%
                const timelineSteps = [
                    { id: 'Pending', label: 'Vault Authentication', desc: 'Order Placed' },
                    { id: 'Processing', label: 'Bespoke Packaging', desc: 'Preparing Allocation' },
                    { id: 'Shipped', label: 'White-Glove Transit', desc: 'Dispatched with Courier' },
                    { id: 'Out for Delivery', label: 'Courier Dispatch', desc: 'Out for Delivery' },
                    { id: 'Delivered', label: 'Safely Received', desc: 'Delivered to Vault' }
                ];
                
                const stepOrder = ['Pending', 'Processing', 'Shipped', 'Out for Delivery', 'Delivered'];
                const currentIdx = stepOrder.indexOf(order.orderStatus);
            %>

            <% if (order.orderStatus === 'Cancelled') { %>
                <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-3 text-rose-800 text-xs">
                    <span class="w-8 h-8 rounded-full bg-rose-200 text-rose-700 flex items-center justify-center font-bold text-sm">✕</span>
                    <div>
                        <p class="font-bold font-serif text-sm">Order Terminated / Cancelled</p>
                        <p class="text-[11px] text-rose-600">This order was cancelled and inventory stock has been returned to vault reserves.</p>
                    </div>
                </div>
            <% } else if (order.orderStatus === 'Returned') { %>
                <div class="p-4 bg-purple-50 border border-purple-200 rounded-2xl flex items-center gap-3 text-purple-900 text-xs">
                    <span class="w-8 h-8 rounded-full bg-purple-200 text-purple-700 flex items-center justify-center font-bold text-sm">↩</span>
                    <div>
                        <p class="font-bold font-serif text-sm">Return Completed & Restocked</p>
                        <p class="text-[11px] text-purple-700">The timepiece was returned to vault custody and verified by our horological team.</p>
                    </div>
                </div>
            <% } else { %>
                <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 relative">
                    <% timelineSteps.forEach((st, idx) => { %>
                        <% const isDone = (currentIdx !== -1 && idx <= currentIdx) || (order.orderStatus === 'Return Requested'); %>
                        <div class="space-y-2 text-center sm:text-left">
                            <div class="flex items-center gap-2">
                                <span class="w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-bold transition-all <%= isDone ? 'bg-[#0A4D2E] text-white shadow-sm' : 'bg-zinc-100 text-zinc-400' %>">
                                    <%= isDone ? '✓' : idx + 1 %>
                                </span>
                                <div class="hidden sm:block flex-1 h-0.5 <%= (idx < currentIdx || (order.orderStatus === 'Return Requested' && idx < 4)) ? 'bg-[#0A4D2E]' : 'bg-zinc-200' %>"></div>
                            </div>
                            <h4 class="text-xs font-serif font-semibold <%= isDone ? 'text-zinc-900' : 'text-zinc-400' %>">
                                <%= st.id %>
                            </h4>
                            <p class="text-[10px] text-zinc-400 font-light">
                                <%= st.label %>
                            </p>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- 2 Column Details: Items + Shipping & Valuation Info -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left 8 Cols: Items Purchased & Support Dossier -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Ordered Timepieces Card -->
                <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 sm:p-8 space-y-6 shadow-xs">
                    <div class="border-b border-zinc-100 pb-4 flex items-center justify-between">
                        <div>
                            <span class="text-[10px] uppercase font-mono tracking-[0.25em] text-[#c5a059] font-bold block mb-1">
                                MANUFACTURE SPECIFICATIONS
                            </span>
                            <h3 class="text-xl font-serif text-zinc-900 font-normal">
                                Ordered Timepieces <span class="text-xs font-mono text-zinc-400 font-normal ml-1">(<%= order.items.length %> <%= order.items.length === 1 ? 'item' : 'items' %>)</span>
                            </h3>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <% order.items.forEach(item => { %>
                            <div class="p-5 rounded-2xl bg-zinc-50/70 border border-zinc-200/60 hover:border-zinc-300 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-5">
                                <div class="flex items-start sm:items-center gap-4">
                                    <div class="w-20 h-20 rounded-2xl bg-[#f4f1ee] overflow-hidden p-2 flex items-center justify-center flex-shrink-0 border border-zinc-200/70 shadow-2xs">
                                        <% if (item.variant && item.variant.image) { %>
                                            <img src="<%= item.variant.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover rounded-xl">
                                        <% } else { %>
                                            <span class="text-zinc-300 text-2xl">⏱</span>
                                        <% } %>
                                    </div>

                                    <div class="space-y-1.5">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="text-[10px] uppercase font-mono tracking-widest text-[#c5a059] font-bold block">
                                                <%= item.brandName %>
                                            </span>
                                            <span class="text-[9px] font-mono uppercase px-2.5 py-0.5 rounded-full font-bold
                                                <%= item.status === 'Delivered' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 
                                                   (item.status === 'Out for Delivery' ? 'bg-indigo-100 text-indigo-800 border border-indigo-200' : 
                                                   (item.status === 'Shipped' ? 'bg-blue-100 text-blue-800 border border-blue-200' : 
                                                   (item.status === 'Processing' ? 'bg-amber-100 text-amber-800 border border-amber-200' : 
                                                   (item.status === 'Cancelled' ? 'bg-rose-100 text-rose-700 border border-rose-200' : 
                                                   (item.status === 'Return Requested' || item.status === 'Returned' ? 'bg-purple-100 text-purple-700 border border-purple-200' : 'bg-zinc-100 text-zinc-700 border border-zinc-200'))))) %>">
                                                <%= item.status || 'Pending' %>
                                            </span>
                                        </div>

                                        <h4 class="font-serif text-base text-zinc-900 font-normal">
                                            <%= item.productName %>
                                        </h4>

                                        <div class="flex items-center gap-2 text-xs text-zinc-600 flex-wrap pt-0.5">
                                            <span class="px-2.5 py-0.5 bg-white border border-zinc-200 rounded-md font-medium text-zinc-800 text-[11px] shadow-2xs">
                                                <%= item.variant ? item.variant.color : 'Standard Edition' %>
                                            </span>
                                            <% if (item.variant && item.variant.material) { %>
                                                <span class="px-2 py-0.5 bg-white border border-zinc-200 rounded-md text-[10px] text-zinc-500 font-mono shadow-2xs">
                                                    <%= item.variant.material %>
                                                </span>
                                            <% } %>
                                            <span class="px-2 py-0.5 bg-white border border-zinc-200 rounded-md text-[10px] text-zinc-700 font-mono font-semibold shadow-2xs">
                                                Qty: <%= item.quantity %>
                                            </span>
                                        </div>

                                        <% if (item.cancellationReason) { %>
                                            <p class="text-[10px] text-rose-600 font-mono pt-1">Cancellation Note: "<%= item.cancellationReason %>"</p>
                                        <% } %>
                                        <% const displayItemReturnReason = item.returnReason || ((item.status === 'Return Requested' || item.status === 'Returned') ? order.returnReason : ''); %>
                                        <% if (displayItemReturnReason) { %>
                                            <p class="text-[10px] text-purple-600 font-mono pt-1">Return Reason: "<%= displayItemReturnReason %>"</p>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-2 border-t sm:border-t-0 pt-3 sm:pt-0 border-zinc-200/60 flex-shrink-0">
                                    <div>
                                        <p class="font-mono text-base font-bold text-zinc-900 sm:text-right">
                                            ₹<%= Number(item.itemTotal).toLocaleString('en-IN') %>
                                        </p>
                                        <span class="text-[10px] text-zinc-400 font-mono block sm:text-right">
                                            ₹<%= Number(item.price).toLocaleString('en-IN') %> / unit
                                        </span>
                                    </div>

                                    <!-- Action Buttons per Item -->
                                    <div class="flex items-center gap-2 mt-1">
                                        <!-- Specific Product Cancel Button (Allowed only when item is Pending/Processing before shipping) -->
                                        <% if (item.status !== 'Cancelled' && (item.status === 'Pending' || item.status === 'Processing')) { %>
                                            <button 
                                                type="button" 
                                                onclick="openCancelItemModal('<%= item._id %>', '<%= item.productName %>')"
                                                class="px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-[10px] uppercase font-mono tracking-wider font-semibold transition-colors cursor-pointer"
                                            >
                                                Cancel Piece
                                            </button>
                                        <% } %>

                                        <!-- Specific Product Return Button (Allowed only when item is Delivered within 5-day window and not declined) -->
                                        <%
                                            const itemDeliveryDate = new Date(item.deliveredAt || order.deliveredAt || order.updatedAt || order.createdAt);
                                            const itemReturnDeadline = new Date(itemDeliveryDate.getTime() + 5 * 24 * 60 * 60 * 1000);
                                            const itemMsRemaining = itemReturnDeadline.getTime() - Date.now();
                                            const isItemDeclined = item.returnDeclined || (item.returnAdminNotes && item.returnAdminNotes.toLowerCase().includes('decline'));
                                            const isItemReturnEligible = item.status === 'Delivered' && (itemMsRemaining > 0) && !isItemDeclined;
                                            const itemDaysLeft = Math.max(1, Math.ceil(itemMsRemaining / (1000 * 60 * 60 * 24)));
                                        %>
                                        <% if (isItemDeclined) { %>
                                            <span class="px-3 py-1 bg-zinc-100 text-zinc-500 border border-zinc-200 rounded-xl text-[10px] uppercase font-mono tracking-wider font-semibold" title="<%= item.returnAdminNotes || 'Return Request Declined' %>">
                                                Return Declined
                                            </span>
                                        <% } else if (isItemReturnEligible) { %>
                                            <button 
                                                type="button" 
                                                onclick="openReturnItemModal('<%= item._id %>', '<%= item.productName %>')"
                                                class="px-3.5 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 rounded-xl text-[11px] uppercase font-mono tracking-wider font-semibold transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs hover:shadow-xs"
                                                title="Initiate Return for this specific timepiece"
                                            >
                                                <span>Return Piece</span>
                                                <span class="text-[10px] font-mono text-purple-600 bg-white/80 px-1.5 py-0.2 rounded border border-purple-200/60"><%= itemDaysLeft %>d left</span>
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Right 4 Cols: Address & Valuation Recap -->
            <div class="lg:col-span-4 space-y-6">
                
                <!-- Destination Card -->
                <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 space-y-4 shadow-sm">
                    <span class="text-[10px] uppercase font-mono tracking-[0.2em] text-[#c5a059] font-bold block">Delivery Destination</span>
                    
                    <div class="space-y-1 text-xs text-zinc-600">
                        <h4 class="font-serif text-base font-semibold text-zinc-900"><%= order.shippingAddress.fullName %></h4>
                        <p class="font-light"><%= order.shippingAddress.street %></p>
                        <p class="font-light"><%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> — <span class="font-mono font-medium"><%= order.shippingAddress.postalCode %></span></p>
                        <p class="font-mono text-zinc-500 pt-1">Phone: <%= order.shippingAddress.mobile %></p>
                    </div>

                    <div class="pt-3 border-t border-zinc-100 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] uppercase font-mono text-zinc-400 block">Payment Method</span>
                            <% if (order.paymentStatus === 'Completed') { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-emerald-50 text-[#0A4D2E] border border-emerald-200">
                                    Authorized & Paid
                                </span>
                            <% } else if (order.paymentStatus === 'Refunded') { %>
                                <a href="/wallet" class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-emerald-50 text-[#0A4D2E] border border-emerald-200 hover:bg-emerald-100 transition-colors" title="View in Vault Wallet">
                                    Refunded to Vault Wallet ↗
                                </a>
                            <% } else if (order.paymentStatus === 'Failed') { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                    Authorization Failed
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                    <%= order.paymentMethod === 'Cash on Delivery' ? 'Pay Upon Delivery' : 'Pending Payment' %>
                                </span>
                            <% } %>
                        </div>
                        <p class="font-serif text-sm font-semibold text-zinc-900"><%= order.paymentMethod %></p>

                        <% if (order.razorpayPaymentId) { %>
                            <p class="text-[10px] text-zinc-500 font-mono">
                                Razorpay Ref: <span class="text-zinc-800 font-medium"><%= order.razorpayPaymentId %></span>
                            </p>
                        <% } else if (order.paypalCaptureId) { %>
                            <p class="text-[10px] text-zinc-500 font-mono">
                                PayPal Ref: <span class="text-zinc-800 font-medium"><%= order.paypalCaptureId %></span>
                            </p>
                        <% } %>

                        <% if (order.paidAt) { %>
                            <p class="text-[10px] text-zinc-400 font-mono">
                                Paid on <%= new Date(order.paidAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            </p>
                        <% } %>

                        <% if (order.paymentStatus === 'Failed') { %>
                            <% 
                                const isDetailCooldown = typeof cooldown !== 'undefined' && cooldown && cooldown.inCooldown;
                                const detailSecs = isDetailCooldown ? cooldown.remainingSeconds : 0;
                            %>
                            <div class="pt-1.5 space-y-1.5">
                                <div id="detailCooldownBadge" class="<%= isDetailCooldown ? 'flex' : 'hidden' %> p-2 rounded-xl bg-amber-50 border border-amber-200/80 text-[10px] text-amber-800 items-center justify-between font-mono">
                                    <span>⏱ 5-MIN RE-BUY COOLDOWN</span>
                                    <span id="detailCooldownBadgeTimer" class="font-bold"><%= Math.floor(detailSecs / 60) %>:<%= (detailSecs % 60).toString().padStart(2, '0') %></span>
                                </div>
                                <button 
                                    type="button" 
                                    id="detailRetryBtn"
                                    onclick="handleDetailRetryClick()"
                                    class="w-full py-2 px-3 bg-[#0A4D2E] hover:bg-[#073620] text-white rounded-xl text-[11px] uppercase font-mono tracking-wider font-semibold transition-all shadow-xs flex items-center justify-center gap-1.5 cursor-pointer"
                                >
                                    <svg class="w-3.5 h-3.5 text-[#c5a059]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                                    <span id="detailRetryBtnText">Retry Settlement</span>
                                </button>
                            </div>
                        <% } %>
                    </div>

                    <% if (order.notes) { %>
                        <div class="pt-3 border-t border-zinc-100 text-xs">
                            <span class="text-[10px] uppercase font-mono text-zinc-400 block mb-1">Collector Notes</span>
                            <p class="font-light text-zinc-600 italic">"<%= order.notes %>"</p>
                        </div>
                    <% } %>
                </div>

                <!-- Financial Card -->
                <div class="bg-white rounded-3xl border border-zinc-200/80 p-6 space-y-3 shadow-sm text-xs">
                    <span class="text-[10px] uppercase font-mono tracking-[0.2em] text-[#c5a059] font-bold block mb-2">Valuation Summary</span>

                    <% 
                        const hasMod = (order.cancelledAmount && order.cancelledAmount > 0) || (order.returnedAmount && order.returnedAmount > 0);
                        const origSubVal = Number(order.originalSubtotal) || (hasMod ? (Number(order.subtotal || 0) + Number(order.cancelledAmount || 0) + Number(order.returnedAmount || 0)) : Number(order.subtotal || 0));
                    %>
                    <div class="flex justify-between text-zinc-600">
                        <span><%= hasMod ? 'Original Subtotal' : 'Items Subtotal' %></span>
                        <span class="font-mono font-medium text-zinc-900">₹<%= origSubVal.toLocaleString('en-IN') %></span>
                    </div>

                    <% if (order.cancelledAmount && order.cancelledAmount > 0) { %>
                        <div class="flex justify-between text-rose-600">
                            <span>Cancelled Deductions</span>
                            <span class="font-mono font-medium">-₹<%= Number(order.cancelledAmount).toLocaleString('en-IN') %></span>
                        </div>
                    <% } %>

                    <% if (order.returnedAmount && order.returnedAmount > 0) { %>
                        <div class="flex justify-between text-purple-700 font-medium">
                            <span>Returned / Restocked</span>
                            <span class="font-mono">-₹<%= Number(order.returnedAmount).toLocaleString('en-IN') %></span>
                        </div>
                    <% } %>

                    <% if (order.discountAmount && order.discountAmount > 0) { %>
                        <div class="flex justify-between text-emerald-700 font-semibold">
                            <span>Coupon Discount <%= order.appliedCoupon?.code ? '(' + order.appliedCoupon.code + ')' : '' %></span>
                            <span class="font-mono">-₹<%= Number(order.discountAmount).toLocaleString('en-IN') %></span>
                        </div>
                    <% } %>

                    <div class="flex justify-between text-zinc-600">
                        <span>White-Glove Courier</span>
                        <span class="font-mono text-[#0A4D2E] font-semibold uppercase text-[10px]">Complimentary</span>
                    </div>

                    <% 
                        const activeSub = Number(order.subtotal || 0);
                        const displayGst = order.taxAmount ? Number(order.taxAmount) : Math.round(activeSub * 0.18);
                    %>
                    <div class="flex justify-between text-zinc-600 text-xs">
                        <span>Statutory Taxes (GST 18%)</span>
                        <span class="font-mono font-medium text-zinc-900">₹<%= displayGst.toLocaleString('en-IN') %> <span class="italic text-[10px] text-zinc-400 font-normal">(Included)</span></span>
                    </div>

                    <div class="pt-3 border-t border-zinc-200 flex justify-between items-baseline">
                        <span class="text-xs uppercase font-mono font-bold text-zinc-900">TOTAL VALUATION</span>
                        <span class="text-xl font-bold font-mono text-[#0A4D2E]">₹<%= Number(order.grandTotal || 0).toLocaleString('en-IN') %></span>
                    </div>

                    <% if (order.refundAmount && order.refundAmount > 0) { %>
                        <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-2xl flex flex-col gap-1 text-xs">
                            <div class="flex items-center justify-between text-[#0A4D2E] font-medium">
                                <span class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                    <span>Vault Wallet Refund</span>
                                </span>
                                <span class="font-mono font-bold text-sm">+₹<%= Number(order.refundAmount).toLocaleString('en-IN') %></span>
                            </div>
                            <div class="flex items-center justify-between text-[11px] text-zinc-500 font-light pt-1 border-t border-emerald-100">
                                <span>Credited to liquid reserve</span>
                                <a href="/wallet" class="text-[#0A4D2E] font-medium hover:underline font-mono">View Wallet Ledger →</a>
                            </div>
                        </div>
                    <% } %>
                </div>

            </div>

        </div>

    <!-- ========================================================= -->
<!-- CANCEL SPECIFIC ITEM MODAL -->
<!-- ========================================================= -->
<div id="cancelItemModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-rose-600 font-bold block">Item Cancellation</span>
                <h3 class="text-xl font-serif text-zinc-900">Cancel Specific Timepiece</h3>
            </div>
            <button type="button" onclick="closeCancelItemModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Cancel <span id="cancelItemName" class="font-serif font-semibold text-zinc-900"></span> from your order? Its allocated unit will be immediately returned to vault inventory.
        </p>

        <form id="cancelItemForm" onsubmit="submitCancelItem(event)" class="space-y-4 text-xs">
            <input type="hidden" id="cancelItemId" name="itemId">

            <div class="space-y-1">
                <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-600">Reason for Cancellation <span class="text-rose-500">*</span></label>
                <select id="cancelItemReasonPreset" required onchange="applyCancelItemPreset(this.value)" class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none bg-white text-xs font-light text-zinc-800 cursor-pointer mb-2">
                    <option value="">Select cancellation reason *</option>
                    <option value="Changed mind / Decided on a different timepiece">Changed mind / Decided on a different timepiece</option>
                    <option value="Ordered by mistake / Duplicate order placed">Ordered by mistake / Duplicate order placed</option>
                    <option value="Incorrect variant, dial, or case material selected">Incorrect variant, dial, or case material selected</option>
                    <option value="Found alternative edition or brand elsewhere">Found alternative edition or brand elsewhere</option>
                    <option value="Delivery timeframe or waiting period is too long">Delivery timeframe or waiting period is too long</option>
                    <option value="Payment or billing adjustment required">Payment or billing adjustment required</option>
                    <option value="Other">Other (Specify in text box below)</option>
                </select>
                <textarea id="cancelItemReason" name="reason" rows="2" placeholder="Additional details or specific reason (optional if selected from dropdown)..." class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none font-light"></textarea>
            </div>

            <div id="cancelItemError" class="text-rose-600 text-xs hidden pt-1 font-mono"></div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-zinc-100">
                <button type="button" onclick="closeCancelItemModal()" class="px-5 py-3 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 uppercase tracking-wider font-semibold cursor-pointer">Back</button>
                <button type="submit" id="confirmCancelItemBtn" class="px-6 py-3 bg-rose-700 hover:bg-rose-800 text-white rounded-xl uppercase tracking-wider font-semibold shadow-sm cursor-pointer">Cancel Piece</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================= -->
<!-- CANCEL ENTIRE ORDER MODAL -->
<!-- ========================================================= -->
<div id="cancelOrderModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-8 space-y-6 shadow-2xl relative">
        <div class="flex items-center justify-between border-b border-zinc-100 pb-4">
            <div>
                <span class="text-[10px] uppercase font-mono tracking-widest text-rose-600 font-bold block">Order Cancellation</span>
                <h3 class="text-xl font-serif text-zinc-900">Cancel Entire Order</h3>
            </div>
            <button type="button" onclick="closeCancelOrderModal()" class="w-8 h-8 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-500 flex items-center justify-center transition-colors cursor-pointer">✕</button>
        </div>

        <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Cancel order <span class="font-mono font-bold text-zinc-900"><%= order.orderNumber %></span>? All reserved pieces will be restored to vault reserves.
        </p>

        <form id="cancelOrderForm" onsubmit="submitCancelOrder(event)" class="space-y-4 text-xs">
            <div class="space-y-1">
                <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-600">Reason for Cancellation <span class="text-rose-500">*</span></label>
                <select id="cancelOrderReasonPreset" required onchange="applyCancelOrderPreset(this.value)" class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none bg-white text-xs font-light text-zinc-800 cursor-pointer mb-2">
                    <option value="">Select cancellation reason *</option>
                    <option value="Changed mind / Decided on a different timepiece">Changed mind / Decided on a different timepiece</option>
                    <option value="Ordered by mistake / Duplicate order placed">Ordered by mistake / Duplicate order placed</option>
                    <option value="Incorrect variant, dial, or case material selected">Incorrect variant, dial, or case material selected</option>
                    <option value="Found alternative edition or brand elsewhere">Found alternative edition or brand elsewhere</option>
                    <option value="Delivery timeframe or waiting period is too long">Delivery timeframe or waiting period is too long</option>
                    <option value="Payment or billing adjustment required">Payment or billing adjustment required</option>
                    <option value="Other">Other (Specify in text box below)</option>
                </select>
                <textarea id="cancelOrderReason" name="reason" rows="2" placeholder="Additional details or specific reason (optional if selected from dropdown)..." class="w-full p-3 border border-zinc-200 rounded-xl focus:border-[#0A4D2E] outline-none font-light"></textarea>
            </div>

            <div id="cancelOrderError" class="text-rose-600 text-xs hidden pt-1 font-mono"></div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-zinc-100">
                <button type="button" onclick="closeCancelOrderModal()" class="px-5 py-3 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 uppercase tracking-wider font-semibold cursor-pointer">Back</button>
                <button type="submit" id="confirmCancelOrderBtn" class="px-6 py-3 bg-rose-700 hover:bg-rose-800 text-white rounded-xl uppercase tracking-wider font-semibold shadow-sm cursor-pointer">Cancel Entire Order</button>
            </div>
        </form>
    </div>
</div>

<script>
    // --- Cancel Specific Item ---
    function openCancelItemModal(itemId, itemName) {
        document.getElementById('cancelItemId').value = itemId;
        document.getElementById('cancelItemName').textContent = itemName;
        document.getElementById('cancelItemReasonPreset').value = '';
        document.getElementById('cancelItemReason').value = '';
        const errEl = document.getElementById('cancelItemError');
        if (errEl) errEl.classList.add('hidden');
        const m = document.getElementById('cancelItemModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }
    function closeCancelItemModal() {
        const m = document.getElementById('cancelItemModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }
    function applyCancelItemPreset(val) {
        const txt = document.getElementById('cancelItemReason');
        if (val && val !== 'Other') {
            if (txt) txt.value = val;
        } else if (val === 'Other') {
            if (txt) { txt.value = ''; txt.focus(); }
        }
    }
    async function submitCancelItem(e) {
        e.preventDefault();
        const itemId = document.getElementById('cancelItemId').value;
        const preset = document.getElementById('cancelItemReasonPreset').value;
        const customReason = document.getElementById('cancelItemReason').value.trim();
        const finalReason = customReason || preset;
        const errEl = document.getElementById('cancelItemError');
        const btn = document.getElementById('confirmCancelItemBtn');

        if (!finalReason) {
            if (errEl) {
                errEl.textContent = 'Please choose or provide a reason for cancelling this timepiece.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/orders/<%= order._id %>/items/' + itemId + '/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason: finalReason })
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) window.showToast('Timepiece item cancelled and stock returned to vault.', 'info');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Unable to cancel timepiece.';
                    errEl.classList.remove('hidden');
                } else {
                    alert(data.message || 'Unable to cancel timepiece.');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error cancelling timepiece.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    // --- Cancel Entire Order ---
    function openCancelOrderModal() {
        document.getElementById('cancelOrderReasonPreset').value = '';
        document.getElementById('cancelOrderReason').value = '';
        const errEl = document.getElementById('cancelOrderError');
        if (errEl) errEl.classList.add('hidden');
        const m = document.getElementById('cancelOrderModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }
    function closeCancelOrderModal() {
        const m = document.getElementById('cancelOrderModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }
    function applyCancelOrderPreset(val) {
        const txt = document.getElementById('cancelOrderReason');
        if (val && val !== 'Other') {
            if (txt) txt.value = val;
        } else if (val === 'Other') {
            if (txt) { txt.value = ''; txt.focus(); }
        }
    }
    async function submitCancelOrder(e) {
        e.preventDefault();
        const preset = document.getElementById('cancelOrderReasonPreset').value;
        const customReason = document.getElementById('cancelOrderReason').value.trim();
        const finalReason = customReason || preset;
        const errEl = document.getElementById('cancelOrderError');
        const btn = document.getElementById('confirmCancelOrderBtn');

        if (!finalReason) {
            if (errEl) {
                errEl.textContent = 'Please choose or provide a reason for cancelling this order.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/orders/<%= order._id %>/cancel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason: finalReason })
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) window.showToast('Order cancelled and all stock returned to vault.', 'info');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Unable to cancel order.';
                    errEl.classList.remove('hidden');
                } else {
                    alert(data.message || 'Unable to cancel order.');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error cancelling order.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    // --- Return Single Item (MANDATORY REASON) ---
    function openReturnItemModal(itemId, itemName) {
        document.getElementById('returnItemId').value = itemId;
        document.getElementById('returnItemName').textContent = itemName;
        document.getElementById('returnItemReason').value = '';
        document.getElementById('returnItemReasonPreset').value = '';
        const errEl = document.getElementById('returnItemError');
        if (errEl) errEl.classList.add('hidden');
        const m = document.getElementById('returnItemModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }
    function closeReturnItemModal() {
        const m = document.getElementById('returnItemModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }
    function applyReturnItemPreset(val) {
        if (val && val !== 'Other') {
            document.getElementById('returnItemReason').value = val;
        } else if (val === 'Other') {
            document.getElementById('returnItemReason').value = '';
            document.getElementById('returnItemReason').focus();
        }
    }
    async function submitReturnItem(e) {
        e.preventDefault();
        const itemId = document.getElementById('returnItemId').value;
        const reason = document.getElementById('returnItemReason').value.trim();
        const errEl = document.getElementById('returnItemError');
        const btn = document.getElementById('confirmReturnItemBtn');

        if (!reason) {
            if (errEl) {
                errEl.textContent = 'A reason for return is strictly mandatory.';
                errEl.classList.remove('hidden');
            }
            return;
        }

        if (btn) btn.disabled = true;

        try {
            const res = await fetch('/orders/<%= order._id %>/items/' + itemId + '/return', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason })
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) window.showToast('Timepiece return request submitted. Concierge will contact you.', 'info');
                window.location.reload();
            } else {
                if (errEl) {
                    errEl.textContent = data.message || 'Unable to request return for this timepiece.';
                    errEl.classList.remove('hidden');
                }
            }
        } catch (err) {
            if (errEl) {
                errEl.textContent = 'Connection error requesting return.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }
</script>

