                    </div>
                </div>
                <div class="flex items-center gap-1 font-mono text-[10px] font-bold text-[#0A4D2E]">
                    <span>₹ INR</span>
                </div>
            </label>

            <!-- Gateway Option 3: Cash on Delivery -->
            <% const canRetryCod = Number(order.grandTotal || 0) <= 1000000; %>
            <label 
                id="retryCardCod" 
                onclick="<%= canRetryCod ? "selectRetryGateway('Cash on Delivery')" : "" %>" 
                class="p-4 rounded-2xl border-2 <%= canRetryCod ? 'border-zinc-200 bg-white cursor-pointer hover:border-[#0A4D2E]' : 'border-zinc-200/60 bg-zinc-50/70 opacity-70 cursor-not-allowed' %> flex items-center justify-between transition-all"
            >
                <div class="flex items-center gap-3">
                    <input 
                        type="radio" 
                        name="retryGateway" 
                        id="retryGwCod" 
                        value="Cash on Delivery" 
                        <%= canRetryCod ? '' : 'disabled' %>
                        class="text-[#0A4D2E] focus:ring-[#0A4D2E] <%= canRetryCod ? 'cursor-pointer' : 'cursor-not-allowed' %>"
                    >
                    <div>
                        <div class="flex items-center gap-2">
                            <h4 class="font-serif font-bold text-sm text-zinc-900">Cash on Delivery (COD)</h4>
                            <% if (canRetryCod) { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-amber-50 text-amber-800 border border-amber-200">
                                    Complimentary Courier
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-mono uppercase font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                    Limit: ₹10,00,000
                                </span>
                            <% } %>
                        </div>
                        <p class="text-[11px] text-zinc-500 font-light">
                            <% if (canRetryCod) { %>
                                Pay upon white-glove insured delivery at your verified address.
                            <% } else { %>
                                Not available for orders exceeding ₹10,00,000 threshold.
                            <% } %>
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-1 font-mono text-[10px] font-bold text-zinc-600">
                    <span>On Delivery</span>
                </div>
            </label>
        </div>

        <div id="retryPaymentError" class="text-rose-600 text-xs hidden pt-1 font-mono"></div>

        <div class="pt-4 flex items-center justify-end gap-3 border-t border-zinc-100">
            <button type="button" onclick="closeRetryPaymentModal()" class="px-5 py-3 border border-zinc-200 rounded-xl text-zinc-700 hover:bg-zinc-50 uppercase tracking-wider font-semibold text-xs cursor-pointer">Cancel</button>
