                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-1 font-mono text-[10px] font-bold text-[#0A4D2E]">
                    <span>Vault</span>
                </div>
            </label>

            <!-- Gateway Option 1: Razorpay (Primary) -->
            <label id="retryCardRazorpay" onclick="selectRetryGateway('Razorpay')" class="p-4 rounded-2xl border-2 border-[#0A4D2E] bg-emerald-50/20 flex items-center justify-between cursor-pointer transition-all hover:border-[#0A4D2E]">
