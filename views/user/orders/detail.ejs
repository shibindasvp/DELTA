                    <input 
                        type="radio" 
                        name="retryGateway" 
                        id="retryGwWallet" 
                        value="Wallet" 
                        <%= canRetryWithWallet ? '' : 'disabled' %>
                        class="text-[#0A4D2E] focus:ring-[#0A4D2E] <%= canRetryWithWallet ? 'cursor-pointer' : 'cursor-not-allowed' %>"
                    >
                    <div>
                        <div class="flex items-center gap-2">
