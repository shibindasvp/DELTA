<script>
    // Global variable for current retry session
    let currentRetrySession = null;
    let detailCooldownRemaining = <%= typeof cooldown !== 'undefined' && cooldown && cooldown.inCooldown ? cooldown.remainingSeconds : 0 %>;
    let detailCooldownInterval = null;

    function startDetailCooldownTimer(seconds) {
        detailCooldownRemaining = seconds;
        if (detailCooldownInterval) clearInterval(detailCooldownInterval);

        const badge = document.getElementById('detailCooldownBadge');
        const badgeTimer = document.getElementById('detailCooldownBadgeTimer');

        if (seconds <= 0) {
            if (badge) badge.classList.add('hidden');
            return;
        }

        if (badge) {
            badge.classList.remove('hidden');
            badge.classList.add('flex');
        }

        const updateUI = () => {
            const mins = Math.floor(detailCooldownRemaining / 60);
            const secs = (detailCooldownRemaining % 60).toString().padStart(2, '0');
            const formatted = `${mins}:${secs}`;
            if (badgeTimer) badgeTimer.textContent = formatted;

            if (detailCooldownRemaining <= 0) {
                clearInterval(detailCooldownInterval);
                if (badge) badge.classList.add('hidden');
                if (window.showToast) window.showToast('5-minute catalog security interval ended.', 'info');
            }
            detailCooldownRemaining--;
        };

        updateUI();
        detailCooldownInterval = setInterval(updateUI, 1000);
    }

    function handleDetailRetryClick() {
        openRetryPaymentModal();
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (detailCooldownRemaining > 0) {
            startDetailCooldownTimer(detailCooldownRemaining);
        }
    });

    function openRetryPaymentModal() {
        const errEl = document.getElementById('retryPaymentError');
        if (errEl) errEl.classList.add('hidden');
        selectRetryGateway('Razorpay');
        const m = document.getElementById('retryPaymentModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeRetryPaymentModal() {
        const m = document.getElementById('retryPaymentModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function selectRetryGateway(gw) {
        const rzpRadio = document.getElementById('retryGwRazorpay');
        const walletRadio = document.getElementById('retryGwWallet');
        const codRadio = document.getElementById('retryGwCod');
        if (rzpRadio) rzpRadio.checked = (gw === 'Razorpay');
        if (walletRadio) walletRadio.checked = (gw === 'Wallet');
        if (codRadio) codRadio.checked = (gw === 'Cash on Delivery');

        const cardRzp = document.getElementById('retryCardRazorpay');
        const cardWallet = document.getElementById('retryCardWallet');
        const cardCod = document.getElementById('retryCardCod');

        [cardRzp, cardWallet, cardCod].forEach(c => {
            if (c) {
                c.classList.remove('border-[#0A4D2E]', 'bg-emerald-50/20');
                c.classList.add('border-zinc-200', 'bg-white');
            }
        });

        let target = cardRzp;
        if (gw === 'Wallet') target = cardWallet;
        else if (gw === 'Cash on Delivery') target = cardCod;

        if (target) {
            target.classList.add('border-[#0A4D2E]', 'bg-emerald-50/20');
            target.classList.remove('border-zinc-200', 'bg-white');
        }
    }

    async function submitRetryPayment() {
        const rzpRadio = document.getElementById('retryGwRazorpay');
        const walletRadio = document.getElementById('retryGwWallet');
        const codRadio = document.getElementById('retryGwCod');

        let paymentMethod = 'Razorpay';
        if (walletRadio && walletRadio.checked) paymentMethod = 'Wallet';
        else if (codRadio && codRadio.checked) paymentMethod = 'Cash on Delivery';

        const btn = document.getElementById('confirmRetryPaymentBtn');
        const errEl = document.getElementById('retryPaymentError');

        if (errEl) errEl.classList.add('hidden');
        if (btn) btn.disabled = true;

        if (paymentMethod === 'Wallet' && window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Authorizing Vault Reserve Settlement',
                subtitle: 'Debiting verified reserve...',
                amount: <%= Number(order.grandTotal || 0) %>,
                method: 'DELTA Vault Reserve'
            });
        } else if (paymentMethod === 'Cash on Delivery' && window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Converting to Cash on Delivery',
                subtitle: 'Allocating complimentary white-glove courier settlement...',
                amount: <%= Number(order.grandTotal || 0) %>,
                method: 'Cash on Delivery'
            });
        }

        try {
            const res = await fetch('/orders/<%= order._id %>/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ paymentMethod })
            });

            const data = await res.json();

            if (!data.success) {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                if (errEl) {
                    errEl.textContent = data.message || 'Payment retry initialization failed.';
                    errEl.classList.remove('hidden');
                }
                return;
            }

            if (data.gateway === 'Wallet' || data.gateway === 'Cash on Delivery' || data.completed) {
                if (window.DeltaPaymentAnimation) {
                    window.DeltaPaymentAnimation.success({
                        title: paymentMethod === 'Wallet' ? 'Vault Settlement Confirmed' : 'Order Switched to Cash on Delivery',
                        subtitle: 'Retry allocation complete.',
                        redirectUrl: data.redirect || ('/order/success/<%= order._id %>'),
                        delayMs: 1200
                    });
                } else {
                    if (window.showToast) window.showToast('Order payment authorized via ' + paymentMethod + '!', 'success');
                    window.location.href = data.redirect || ('/order/success/<%= order._id %>');
                }
                return;
            }

            currentRetrySession = data;
            closeRetryPaymentModal();

            handleRazorpayRetryFlow(data);
        } catch (err) {
            if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
            if (errEl) {
                errEl.textContent = 'Connection error initiating payment retry.';
                errEl.classList.remove('hidden');
            }
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    function handleRazorpayRetryFlow(data) {
        // If live Razorpay SDK is present and real test/live credentials are valid
        const isRealRazorpay = typeof window.Razorpay === 'function' &&
            !data.isSimulated &&
            data.keyId &&
            !data.keyId.includes('deltaVault') &&
            !data.keyId.includes('dummy') &&
            data.razorpayOrderId &&
            !data.razorpayOrderId.startsWith('order_delta_');

        if (isRealRazorpay) {
            const options = {
                key: data.keyId,
                amount: data.amount,
                currency: data.currency || 'INR',
                name: 'DELTA Haute Horlogerie',
                description: 'Retry Settlement — Order ' + data.orderNumber,
                order_id: data.razorpayOrderId,
                prefill: {
                    name: data.user?.name || '',
                    email: data.user?.email || '',
                    contact: data.user?.phone || ''
                },
                theme: { color: '#0A4D2E' },
                handler: async function (response) {
                    await verifyRetryPaymentWithServer({
                        paymentMethod: 'Razorpay',
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature
                    });
                },
                modal: {
                    ondismiss: function () {
                        if (window.showToast) window.showToast('Payment window was dismissed.', 'info');
                    }
                }
            };
            try {
                const rzp = new window.Razorpay(options);
                rzp.on('payment.failed', function (resp) {
                    const desc = resp.error?.description || resp.error?.reason || 'Payment was declined.';
                    if (window.showToast) window.showToast(desc, 'error');
                });
                rzp.open();
            } catch (err) {
                console.warn("[Razorpay] Live SDK failed to open, switching to simulation fallback:", err);
                openRazorpayRetrySimModal(data);
            }
        } else {
            // Open Razorpay Sandbox Simulation Fallback Modal
            openRazorpayRetrySimModal(data);
        }
    }

    let currentRetryRzpTab = 'upi';
    let currentRetryRzpSubMethod = 'UPI';

    function switchRetryRzpTab(tab) {
        currentRetryRzpTab = tab;
        ['upi', 'card', 'netbanking', 'wallet'].forEach(t => {
            const btn = document.getElementById(`rzpRetryTabBtn_${t}`);
            const panel = document.getElementById(`rzpRetryPanel_${t}`);
            if (btn) {
                if (t === tab) {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer bg-white text-zinc-900 shadow-xs font-semibold flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.add('text-[#0A4D2E]');
                } else {
                    btn.className = "py-2 px-1 text-center rounded-xl transition-all cursor-pointer text-zinc-500 hover:text-zinc-900 flex flex-col items-center gap-1";
                    const svg = btn.querySelector('svg');
                    if (svg) svg.classList.remove('text-[#0A4D2E]');
                }
            }
            if (panel) {
                if (t === tab) panel.classList.remove('hidden');
                else panel.classList.add('hidden');
            }
        });
        updateRetryRzpPayButtonText();
    }

    function selectRetryRzpUpiApp(app, vpa) {
        currentRetryRzpSubMethod = app;
        const vpaInput = document.getElementById('rzpRetryUpiVpaInput');
        if (vpaInput) vpaInput.value = vpa;
        ['gpay', 'phonepe', 'paytm', 'bhim'].forEach(a => {
            const btn = document.getElementById(`rzpRetryUpiApp_${a}`);
            if (btn) {
                btn.className = "p-2 rounded-xl border border-zinc-200 bg-white flex flex-col items-center justify-center gap-1 text-[11px] font-semibold text-zinc-600 transition-all cursor-pointer";
            }
        });
        const activeKey = app === 'Google Pay' ? 'gpay' : app === 'PhonePe' ? 'phonepe' : app === 'Paytm' ? 'paytm' : 'bhim';
        const activeBtn = document.getElementById(`rzpRetryUpiApp_${activeKey}`);
        if (activeBtn) {
            activeBtn.className = "p-2 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 flex flex-col items-center justify-center gap-1 text-[11px] font-bold text-zinc-900 transition-all cursor-pointer";
        }
        updateRetryRzpPayButtonText();
    }

    function selectRetryRzpBank(bank) {
        currentRetryRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpRetryBank_${b}`);
            if (btn) btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
        });
        const key = bank.includes('HDFC') ? 'HDFC' : bank.includes('ICICI') ? 'ICICI' : bank.includes('State') ? 'SBI' : bank.includes('Axis') ? 'Axis' : bank.includes('Kotak') ? 'Kotak' : 'PNB';
        const activeBtn = document.getElementById(`rzpRetryBank_${key}`);
        if (activeBtn) activeBtn.className = "p-2.5 rounded-xl border-2 border-[#0A4D2E] bg-emerald-50/40 text-left transition-all cursor-pointer";
        updateRetryRzpPayButtonText();
    }

    function selectRetryRzpOtherBank(bank) {
        if (!bank) return;
        currentRetryRzpSubMethod = bank;
        ['HDFC', 'ICICI', 'SBI', 'Axis', 'Kotak', 'PNB'].forEach(b => {
            const btn = document.getElementById(`rzpRetryBank_${b}`);
            if (btn) btn.className = "p-2.5 rounded-xl border border-zinc-200 bg-white text-left transition-all cursor-pointer hover:border-[#0A4D2E]";
        });
        updateRetryRzpPayButtonText();
    }

    function selectRetryRzpWallet(wallet) {
        currentRetryRzpSubMethod = wallet;
        updateRetryRzpPayButtonText();
    }

    function updateRetryRzpPayButtonText() {
        const btn = document.getElementById('rzpRetryPayBtnLabel');
        if (!btn || !currentRetrySession) return;
        const amountStr = '₹' + Number(currentRetrySession.grandTotal).toLocaleString('en-IN');
        let methodLabel = 'UPI';
        if (currentRetryRzpTab === 'upi') methodLabel = currentRetryRzpSubMethod || 'UPI';
        else if (currentRetryRzpTab === 'card') methodLabel = 'Card';
        else if (currentRetryRzpTab === 'netbanking') methodLabel = currentRetryRzpSubMethod || 'NetBanking';
        else if (currentRetryRzpTab === 'wallet') methodLabel = currentRetryRzpSubMethod || 'Wallet';
        btn.textContent = `Authorize & Pay ${amountStr} via ${methodLabel}`;
    }

    function openRazorpayRetrySimModal(data) {
        const orderIdEl = document.getElementById('rzpRetryOrderId');
        const amountEl = document.getElementById('rzpRetryAmount');
        if (orderIdEl) orderIdEl.textContent = data.razorpayOrderId;
        if (amountEl) amountEl.textContent = '₹' + Number(data.grandTotal).toLocaleString('en-IN');
        switchRetryRzpTab('upi');
        const m = document.getElementById('razorpayRetrySimModal');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeRazorpayRetrySimModal() {
        closeRetryRzpConfirmPayModal();
        closeRetryRzpConfirmDeclineModal();
        const m = document.getElementById('razorpayRetrySimModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    function openRetryRzpConfirmPayModal() {
        const m = document.getElementById('rzpRetryConfirmPayModal');
        const methodEl = document.getElementById('rzpRetryConfirmPayMethod');
        const orderRefEl = document.getElementById('rzpRetryConfirmPayOrderRef');
        const amountEl = document.getElementById('rzpRetryConfirmPayAmount');

        let methodLabel = 'UPI';
        if (currentRetryRzpTab === 'upi') methodLabel = currentRetryRzpSubMethod || 'UPI';
        else if (currentRetryRzpTab === 'card') methodLabel = 'Credit / Debit Card';
        else if (currentRetryRzpTab === 'netbanking') methodLabel = currentRetryRzpSubMethod || 'NetBanking';
        else if (currentRetryRzpTab === 'wallet') methodLabel = currentRetryRzpSubMethod || 'Digital Wallet';

        if (methodEl) methodEl.textContent = methodLabel;
        if (orderRefEl && currentRetrySession) orderRefEl.textContent = currentRetrySession.orderNumber || currentRetrySession.razorpayOrderId;
        if (amountEl && currentRetrySession) amountEl.textContent = '₹' + Number(currentRetrySession.grandTotal).toLocaleString('en-IN');

        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeRetryRzpConfirmPayModal() {
        const m = document.getElementById('rzpRetryConfirmPayModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    async function executeConfirmedRetryRazorpayPay() {
        closeRetryRzpConfirmPayModal();
        await simulateSuccessfulRazorpayRetry();
    }

    function openRetryRzpConfirmDeclineModal() {
        const m = document.getElementById('rzpRetryConfirmDeclineModal');
        const amountEl = document.getElementById('rzpRetryConfirmDeclineAmount');
        if (amountEl && currentRetrySession) amountEl.textContent = '₹' + Number(currentRetrySession.grandTotal).toLocaleString('en-IN');
        if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function closeRetryRzpConfirmDeclineModal() {
        const m = document.getElementById('rzpRetryConfirmDeclineModal');
        if (m) { m.classList.add('hidden'); m.classList.remove('flex'); }
    }

    async function executeConfirmedRetryRazorpayDecline() {
        closeRetryRzpConfirmDeclineModal();
        try {
            await fetch('/orders/<%= order._id %>/record-decline', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ reason: 'Transaction authorization was declined by user/bank' })
            });
        } catch (e) {}
        simulateDeclinedRazorpayRetry();
        startDetailCooldownTimer(300);
    }

    async function simulateSuccessfulRazorpayRetry() {
        if (!currentRetrySession) return;
        closeRazorpayRetrySimModal();
        await verifyRetryPaymentWithServer({
            paymentMethod: 'Razorpay',
            razorpay_order_id: currentRetrySession.razorpayOrderId,
            razorpay_payment_id: currentRetrySession.testPaymentId,
            razorpay_signature: currentRetrySession.testSignature
        });
    }

    function simulateDeclinedRazorpayRetry() {
        closeRazorpayRetrySimModal();
        if (window.showToast) window.showToast('Simulated payment authorization declined.', 'error');
    }

    async function verifyRetryPaymentWithServer(payload) {
        if (window.DeltaPaymentAnimation) {
            window.DeltaPaymentAnimation.start({
                title: 'Authorizing Retry Settlement',
                subtitle: 'Authenticating 256-bit cryptographic payload with bank...',
                amount: <%= Number(order.grandTotal || 0) %>,
                method: payload.paymentMethod || 'Razorpay'
            });
        }
        try {
            const res = await fetch('/orders/<%= order._id %>/verify-retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (window.showToast) window.showToast('Payment successfully authorized! Order confirmed.', 'success');
                if (window.DeltaPaymentAnimation) {
                    window.DeltaPaymentAnimation.success({
                        title: 'Retry Settlement Confirmed',
                        subtitle: 'Order state updated to Completed in Private Vault.',
                        redirectUrl: window.location.href,
                        delayMs: 1200
                    });
                } else {
                    window.location.reload();
                }
            } else {
                if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
                const errMsg = data.message || 'Payment verification failed.';
                if (window.showToast) window.showToast(errMsg, 'error');
                else alert(errMsg);
            }
        } catch (err) {
            if (window.DeltaPaymentAnimation) window.DeltaPaymentAnimation.hide();
            const connErrMsg = 'Connection error verifying retry payment.';
            if (window.showToast) window.showToast(connErrMsg, 'error');
            else alert(connErrMsg);
        }
    }
</script>

