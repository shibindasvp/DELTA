            <label class="block font-mono uppercase text-[10px] font-semibold text-zinc-500">Select Payment Gateway</label>

            <!-- Gateway Option: DELTA Vault Wallet -->
            <% 
                const retryVaultBalance = Number(typeof walletBalance !== 'undefined' ? walletBalance : 0);
                const canRetryWithWallet = retryVaultBalance >= Number(order.grandTotal || 0);
            %>
            <label 
                id="retryCardWallet" 
                onclick="<%= canRetryWithWallet ? "selectRetryGateway('Wallet')" : "" %>" 
